/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/style/img/*
  Cache-Control: public, max-age=2592000

/3d/*
  Cache-Control: public, max-age=2592000

# CSP je Report-Only: browser samo prijavljuje prekrsaje u konzoli, nista ne blokira.
# Kad konzola bude cista na svim stranama, preimenovati u Content-Security-Policy.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://ajax.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: data: https://api.hsforms.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cdn.jsdelivr.net; frame-src https://www.google.com https://www.googletagmanager.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
