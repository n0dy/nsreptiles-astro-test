---
import type { Locale } from '../config/site';
import { UI } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const t = UI[Astro.props.lang];
---
<div class="cart-overlay" id="cartOverlay"></div>
<aside class="cart-panel" id="cartPanel" aria-label={t.cart}>
  <div class="cart-head">
    <h3>{t.cart} <span class="cart-count" id="cartCount">0</span></h3>
    <button class="cart-close" id="cartClose" aria-label={t.close}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"></path></svg>
    </button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-foot" id="cartFoot">
    <div class="cart-total"><span>{t.total}</span><b id="cartTotal">0 din</b></div>
    <a href={t.cartUrl} class="btn btn-primary">{t.goToCart}</a>
    <button class="btn btn-outline" id="cartContinue">{t.continueShopping}</button>
  </div>
</aside>
