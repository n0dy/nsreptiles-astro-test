---
import { twoTone } from '../lib/two-tone';
import type { Locale } from '../config/site';

interface Props {
  lang: Locale;
  /** sme da sadrzi <b> - nas tekst iz i18n, ne korisnicki unos */
  title: string;
  items: { q: Record<Locale, string>; a: Record<Locale, string> }[];
}
const { lang, title, items } = Astro.props;
---
<section class="section faq">
  <div class="wrap">
    <div class="section-head reveal" style="text-align: center; max-width: 640px; margin: 0 auto 46px">
      <h2 class="sec-title" set:html={twoTone(title)} />
    </div>
    <div class="faq-list reveal">
      {items.map((f) => (
        <div class="faq-item">
          <button class="faq-q">{f.q[lang]}<span class="ic">+</span></button>
          <div class="faq-a"><p>{f.a[lang]}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
