---
import { twoTone } from '../lib/two-tone';
import type { Locale } from '../config/site';

interface Props {
  lang: Locale;
  /** sme da sadrzi <b> - nas tekst iz i18n, ne korisnicki unos */
  title?: string;
  items: { q: Partial<Record<Locale, string>>; a: Partial<Record<Locale, string>> }[];
}
const DEFAULT_TITLE = { sr: 'Česta <b>pitanja</b>', en: 'Frequently asked <b>questions</b>', ru: 'Частые <b>вопросы</b>' };
const { lang, title = DEFAULT_TITLE[lang] } = Astro.props;
// pitanja bez prevoda se ne prikazuju; schema se pravi iz istog niza kao vidljiv tekst
const items = Astro.props.items.filter((f) => f.q[lang] && f.a[lang]);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q[lang],
    acceptedAnswer: { '@type': 'Answer', text: f.a[lang] },
  })),
};
---
{items.length > 0 && (
<>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}></script>
<section class="section faq">
  <div class="wrap">
    <div class="section-head reveal" style="text-align: center; max-width: 640px; margin: 0 auto 46px">
      <h2 class="sec-title" set:html={twoTone(title)} />
    </div>
    <div class="faq-list reveal">
      {items.map((f) => (
        <div class="faq-item">
          <button class="faq-q">{f.q[lang]}<span class="ic">+</span></button>
          <div class="faq-a"><p>{f.a[lang]}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
</>
)}
