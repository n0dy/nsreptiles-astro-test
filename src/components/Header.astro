---
import type { Locale } from '../config/site';
import { NAV, type NavKey } from '../i18n/nav';
import { HOME, UI } from '../i18n/ui';

interface Props {
  lang: Locale;
  active?: NavKey;
}
const { lang, active } = Astro.props;
const n = NAV[lang];
const chev = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href={HOME[lang]} class="logo">NS REPT<span class="logo-i">I</span>LES</a>
    <nav aria-label={n.menu}>
      <ul class="nav-links">
        {n.main.map((item) =>
          item.key === 'animals' ? (
            <li class="has-dropdown">
              <a href={item.href} class:list={['dd-toggle', active === item.key && 'active']} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
              <ul class="dropdown">
                {n.animalsSub.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
              </ul>
            </li>
          ) : (
            <li><a href={item.href} class:list={[active === item.key && 'active']} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a></li>
          )
        )}
      </ul>
    </nav>
    <div class="nav-tools">
      <!-- shortcut: korpa jos ne vodi nigde, dok ne postoji prodavnica -->
      <button type="button" class="nav-cart" aria-label={UI[lang].cart}>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.7 12.4a1.8 1.8 0 0 0 1.8 1.4h8.7a1.8 1.8 0 0 0 1.8-1.4L22 7H6"></path></svg>
        <span class="nav-cart-n">0</span>
      </button>
      <a href={n.contact.href} class="nav-tickets">{n.contact.label}</a>
      <button class="burger" aria-label={n.menu} aria-controls="mobileMenu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <ul>
      {n.main.map((item) =>
        item.key === 'animals' ? (
          <li class="m-has-sub">
            <button type="button" class="m-toggle" aria-expanded="false">{item.label}<Fragment set:html={chev} /></button>
            <ul class="m-sub">
              <li><a href={item.href}>{n.allAnimals}</a></li>
              {n.animalsSub.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            </ul>
          </li>
        ) : (
          <li><a href={item.href}>{item.label}</a></li>
        )
      )}
      <li><a href={n.contact.href}>{n.contact.label}</a></li>
    </ul>
  </div>
</header>
