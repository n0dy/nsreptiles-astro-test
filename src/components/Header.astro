---
import type { Locale } from '../config/site';
import { NAV, type NavKey } from '../i18n/nav';
import { HOME, UI } from '../i18n/ui';
import { localizePath } from '../i18n/routes';

interface Props {
  lang: Locale;
  active?: NavKey;
}
const { lang, active } = Astro.props;
const n = NAV[lang];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href={HOME[lang]} class="logo">NS REPT<span class="logo-i">I</span>LES</a>
    <nav aria-label={n.menu}>
      <ul class="nav-links">
        {n.main.map((item) =>
          item.key === 'animals' ? (
            <li class="has-dropdown">
              <a href={item.href} class:list={['dd-toggle', active === item.key && 'active']} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
              <ul class="dropdown">
                {n.animalsSub.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
              </ul>
            </li>
          ) : (
            <li><a href={item.href} class:list={[active === item.key && 'active']} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a></li>
          )
        )}
      </ul>
    </nav>
    <div class="nav-tools">
      <button type="button" class="nav-search" aria-label={UI[lang].search} aria-haspopup="dialog" aria-controls="searchDlg">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg>
      </button>
      {/* korpa privremeno sklonjena dok ne postoji prodavnica (2026-11-28); vratiti ovaj blok:
      <button type="button" class="nav-cart" aria-label={UI[lang].cart}>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"></circle><path d="M2 3h3l2.7 12.4a1.8 1.8 0 0 0 1.8 1.4h8.7a1.8 1.8 0 0 0 1.8-1.4L22 7H6"></path></svg>
        <span class="nav-cart-n">0</span>
      </button>
      */}
      <a href={n.contact.href} class="nav-tickets">{n.contact.label}</a>
      <button class="burger" aria-label={n.menu} aria-controls="mobileMenu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
<div class="mobile-menu" id="mobileMenu">
  <ul>
    {n.main.map((item) =>
      item.key === 'animals' ? (
        <li class="m-has-sub">
          <a href={item.href}>{item.label}</a>
          <ul class="m-sub">
            {n.animalsSub.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
          </ul>
        </li>
      ) : (
        <li><a href={item.href}>{item.label}</a></li>
      )
    )}
    <li><a href={n.contact.href}>{n.contact.label}</a></li>
  </ul>
</div>
<dialog class="search-dlg" id="searchDlg" aria-label={UI[lang].search} data-empty={UI[lang].searchEmpty} data-error={UI[lang].searchError}>
  <form class="search-box" role="search" action={localizePath('/pretraga.html', lang)} method="get">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg>
    <input type="search" name="q" class="search-input" required placeholder={UI[lang].searchPlaceholder} aria-label={UI[lang].search} autocomplete="off" spellcheck="false" />
    <button type="submit" class="search-go">{UI[lang].search}</button>
    <button type="button" class="search-close" aria-label={UI[lang].close}>Esc</button>
  </form>
  <p class="search-status" role="status" aria-live="polite"></p>
  <ul class="search-results"></ul>
</dialog>
<script src="../scripts/search.js"></script>
