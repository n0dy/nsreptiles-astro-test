---
import { twoTone } from '../lib/two-tone';
import Base from '../layouts/Base.astro';
import '../styles/oprema.css';
import '../styles/proizvod.css';
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { SITE, whatsappLink, type Locale } from '../config/site';
import { HOME } from '../i18n/ui';
import { localizePath, translationsFor } from '../i18n/routes';
import { TERRARIUM_GUIDES } from '../i18n/guides';
import { priceLabel, productSchema, categoryText, dimsOf, sizeNeighbors, getProducts, productViewOrSr, type ProductView, type Product } from '../lib/products';

interface Props {
  view: ProductView;
  related: Product[];
}
const { view: v, related } = Astro.props;
const d = v.product.data;
const lang: Locale = v.lang;
const cat = categoryText(lang, v.category);

const UI = {
  sr: { home: 'Početna', crumbs: 'Putanja', specs: 'Specifikacije', price: 'Cena', call: 'Pozovite nas', inquiry: 'Pošalji upit', also: 'Moglo bi vam se svideti', wa: (n: string) => `Zdravo, zanima me ${n}.` },
  en: { home: 'Home', crumbs: 'Breadcrumb', specs: 'Specifications', price: 'Price', call: 'Call us', inquiry: 'Send an inquiry', also: 'You might also like', wa: (n: string) => `Hello, I'm interested in ${n}.` },
  ru: { home: 'Главная', crumbs: 'Навигация', specs: 'Характеристики', price: 'Цена', call: 'Позвоните нам', inquiry: 'Отправить запрос', also: 'Вам может понравиться', wa: (n: string) => `Здравствуйте, меня интересует ${n}.` },
}[lang];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: UI.home, item: SITE.url + HOME[lang] },
    { '@type': 'ListItem', position: 2, name: cat.crumb, item: SITE.url + cat.listing },
    { '@type': 'ListItem', position: 3, name: v.name },
  ],
};
// Blok "Velicina i izbor": cinjenice izracunate iz mera, da strane razlicitih velicina ne budu isti tekst.
// Preporuke po duzini su iste kao u vodicu na listingu terarijuma (do 30 / 30-60 / preko 60 cm).
const dims = dimsOf(v.product);
const neighbors = dims ? sizeNeighbors(v.product, await getProducts()) : {};
const [smaller, larger] = await Promise.all([neighbors.smaller, neighbors.larger].map((n) => n && productViewOrSr(n, lang)));
const isAquarium = v.category === 'akvarijumi' && !v.product.id.includes('ter-akvarijum');
const SIZE = {
  sr: {
    title: 'Veličina i izbor',
    base: (d: NonNullable<typeof dims>) => `Dno je ${d.l}x${d.w} cm (${(d.l * d.w).toLocaleString('sr-RS')} cm²), visina ${d.h} cm, a ukupna zapremina oko ${d.liters} L.`,
    fit: ['Ova dužina odgovara paucima skakačima, bogomoljkama i manjim gekonima.', 'Ova dužina odgovara leopard gekonima, crested gekonima i mladim zmijama.', 'Ova dužina odgovara kukuruznim smukovima, loptastim pitonima i mladim bradatim agamama.', 'Ove mere odgovaraju odraslim bradatim agamama, loptastim pitonima i kornjačama.'],
    water: (d: NonNullable<typeof dims>) => `Napunjen sadrži oko ${d.liters} kg vode, pa ga postavite na ravnu i čvrstu podlogu. ${d.liters >= 50 ? 'Ova zapremina lako drži stabilne parametre vode, pa je dobar izbor i za početnike.' : 'Kod manje zapremine parametri vode se brže menjaju, pa ih proveravajte češće.'}`,
    smaller: 'Prva manja zapremina:', larger: 'Prva veća zapremina:',
  },
  en: {
    title: 'Size and choice',
    base: (d: NonNullable<typeof dims>) => `The floor is ${d.l}x${d.w} cm (${(d.l * d.w).toLocaleString('en')} cm²), the height is ${d.h} cm and the total volume is about ${d.liters} L.`,
    fit: ['This length suits jumping spiders, mantises and smaller geckos.', 'This length suits leopard geckos, crested geckos and young snakes.', 'This length suits corn snakes, ball pythons and juvenile bearded dragons.', 'These dimensions suit adult bearded dragons, ball pythons and tortoises.'],
    water: (d: NonNullable<typeof dims>) => `When full it holds about ${d.liters} kg of water, so place it on a flat, solid surface. ${d.liters >= 50 ? 'This volume keeps water parameters stable easily, so it is a good choice for beginners too.' : 'In a smaller volume water parameters change faster, so check them more often.'}`,
    smaller: 'Next smaller volume:', larger: 'Next larger volume:',
  },
  ru: {
    title: 'Размер и выбор',
    base: (d: NonNullable<typeof dims>) => `Дно ${d.l}x${d.w} см (${(d.l * d.w).toLocaleString('ru')} см²), высота ${d.h} см, общий объём около ${d.liters} л.`,
    fit: ['Такая длина подходит паукам-скакунам, богомолам и небольшим гекконам.', 'Такая длина подходит леопардовым гекконам, реснитчатым гекконам и молодым змеям.', 'Такая длина подходит маисовым полозам, королевским питонам и молодым бородатым агамам.', 'Такие размеры подходят взрослым бородатым агамам, королевским питонам и черепахам.'],
    water: (d: NonNullable<typeof dims>) => `В наполненном виде он вмещает около ${d.liters} кг воды, поэтому ставьте его на ровную и прочную поверхность. ${d.liters >= 50 ? 'Такой объём легко удерживает стабильные параметры воды, поэтому подходит и начинающим.' : 'В меньшем объёме параметры воды меняются быстрее, проверяйте их чаще.'}`,
    smaller: 'Ближайший меньший объём:', larger: 'Ближайший больший объём:',
  },
}[lang];
// odrasla bradata agama trazi dno od bar 100x40 cm (vodic preporucuje 100x50x50); manji terarijumi je ne navode
const fitsAdultDragon = !!dims && dims.l >= 100 && dims.w >= 40;
const isDragon = (item: string) => /bradat|bearded dragon|бородат/i.test(item);
// vodic za vrstu kojoj ova duzina odgovara (isto pravilo kao recenica ispod)
const sizeGuide = dims && v.category === 'terarijumi' && dims.l > 30
  ? TERRARIUM_GUIDES[dims.l <= 60 ? 'leopard-gekon' : fitsAdultDragon ? 'bradata-agama' : 'loptasti-piton']
  : undefined;
const sizeText = dims && [SIZE.base(dims), isAquarium ? SIZE.water(dims) : v.category === 'terarijumi' ? SIZE.fit[dims.l <= 30 ? 0 : dims.l <= 60 ? 1 : fitsAdultDragon ? 3 : 2] : ''].join(' ');

// bez prevoda proizvoda jezicki meni vodi na listing kategorije tog jezika
const own = translationsFor(v.path);
const langLinks = {
  sr: own.sr ?? categoryText('sr', v.category).listing,
  en: own.en ?? categoryText('en', v.category).listing,
  ru: own.ru ?? categoryText('ru', v.category).listing,
};
---
<Base
  lang={lang}
  title={v.seo.title}
  description={v.seo.description}
  keywords={v.seo.keywords}
  path={v.path}
  image={d.image}
  ogType="product"
  ogTitle={v.seo.ogTitle}
  ogDescription={v.seo.ogDescription}
  schema={[productSchema(v), breadcrumb]}
  translations={own}
  langLinks={langLinks}
>
  <section class="pd">
    <div class="wrap">
      <nav class="pd-breadcrumb" data-pagefind-ignore aria-label={UI.crumbs}>
        <a href={HOME[lang]}>{UI.home}</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href={cat.listing}>{cat.crumb}</a>
        <span class="sep" aria-hidden="true">›</span>
        <span class="cur" aria-current="page">{v.name}</span>
      </nav>
      <div class="pd-main">
        <div class="pd-media reveal">
          <img data-pagefind-meta="image[src]" src={d.image} alt={v.imageAlt} width="600" height="600" fetchpriority="high" />
        </div>
        <div class="pd-info reveal">
          <div class="pd-cat">{v.label}</div>
          <h1>{v.name}</h1>
          <p class="pd-lead" set:html={v.lead} />
          <div class="pd-specs">
            <h2>{UI.specs}</h2>
            <div class="pd-specs-grid">
              {v.specs.map((s) => (
                <div class="pd-spec"><span class="pd-spec-k">{s.k}</span><span class="pd-spec-v">{s.v}</span></div>
              ))}
            </div>
          </div>
          <div class="pd-price">
            <span class="pd-price-k">{UI.price}</span>
            <span class="pd-price-v" data-pagefind-meta="price">{priceLabel(v)}</span>
          </div>
          <div class="pd-cta">
            <a href={`tel:${SITE.phone}`} class="btn btn-outline" onclick="gtag('event', 'kontakt_click', {'metod': 'telefon'})">
              <Icon name="phone" />
              {UI.call}
            </a>
            <a href={whatsappLink(UI.wa(v.name))} target="_blank" rel="noopener" class="btn btn-outline" onclick="gtag('event', 'kontakt_click', {'metod': 'whatsapp'})">
              <Icon name="whatsapp" />
              WhatsApp
            </a>
            <a href={`${localizePath('/kontakt.html', lang)}?proizvod=${encodeURIComponent(v.name)}`} class="btn btn-primary pd-inquiry">
              {UI.inquiry}
            </a>
          </div>
          <div class="pd-desc">
            {v.description.map((b) =>
              b.type === 'h2' ? <h2>{b.text}</h2>
              : b.type === 'p' ? <p set:html={b.html} />
              : <ul>{b.items.filter((i) => v.category !== 'terarijumi' || fitsAdultDragon || !isDragon(i)).map((i) => <li set:html={i} />)}</ul>
            )}
            {dims && (
              <>
                <h2>{SIZE.title}</h2>
                <p>{sizeText}</p>
                {sizeGuide && <p><a href={localizePath(sizeGuide.href, lang)}>{sizeGuide.label[lang]}</a></p>}
                {(smaller || larger) && (
                  <p>
                    {smaller && <>{SIZE.smaller} <a href={smaller.path}>{smaller.name}</a>. </>}
                    {larger && <>{SIZE.larger} <a href={larger.path}>{larger.name}</a>.</>}
                  </p>
                )}
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="pd-related section" data-pagefind-ignore>
      <div class="wrap">
        <div class="sec-head reveal">
          <h2 class="sec-title" set:html={twoTone(UI.also)} />
        </div>
        <div class="op-grid">
          {related.map((r) => <ProductCard product={r} lang={lang} />)}
        </div>
      </div>
    </section>
  )}
</Base>
