---
import { SITE, whatsappLink } from '../config/site';

interface Props {
  /** sme da sadrzi <b> - nas tekst iz i18n, ne korisnicki unos */
  title: string;
  text: string;
  callLabel: string;
  /** unapred popunjena WhatsApp poruka */
  waText?: string;
}
const { title, text, callLabel, waText } = Astro.props;
---
<section class="zcta">
  <div class="wrap">
    <h2 set:html={title} />
    <p>{text}</p>
    <div class="zcta-btns">
      <a href={whatsappLink(waText)} target="_blank" rel="noopener" class="btn btn-primary">WhatsApp</a>
      <a href={`tel:${SITE.phone}`} class="btn btn-light">{callLabel}</a>
    </div>
  </div>
</section>
