---
import { twoTone } from '../../lib/two-tone';
import Base from '../../layouts/Base.astro';
import Faq from '../Faq.astro';
import Zcta from '../Zcta.astro';
import '../../styles/animals.css';
import { SITE, type Locale } from '../../config/site';
import { localizePath, translationsFor } from '../../i18n/routes';
import { ANIMALS_TEXT, ANIMAL_GROUPS as ALL_GROUPS, ANIMALS_FAQ, SNAKES_TEXT, SNAKES_FAQ } from '../../i18n/pages/animals';

interface Props {
  lang: Locale;
  /** samo jedna grupa, sa svojim tekstom i URL-om (/zmije.html) */
  group?: 'zmije';
}
const { lang, group } = Astro.props;
const t = { ...ANIMALS_TEXT[lang], ...(group ? SNAKES_TEXT[lang] : {}) };
const ANIMAL_GROUPS = group ? ALL_GROUPS.filter((g) => g.id === group) : ALL_GROUPS;
const FAQ = group ? SNAKES_FAQ : ANIMALS_FAQ;
const href = (srPath: string) => localizePath(srPath, lang);
const path = href(group ? '/zmije.html' : '/zivotinje.html');

// cena "od" sa strane vrste (content/species/sr), da kartica i strana ne mogu da se razidju
const SPECIES = import.meta.glob<{ price?: { low?: number } }>('../../content/species/sr/*.json', { eager: true, import: 'default' });
const LOW_PRICE = Object.fromEntries(
  Object.entries(SPECIES).map(([file, sp]) => [file.split('/').pop()!.replace('.json', '').replaceAll('-', ''), sp.price?.low]),
);
const priceFrom = (srHref?: string) => {
  const low = srHref && LOW_PRICE[srHref.split('/').pop()!.replace('.html', '')];
  if (!low) return null;
  const n = low.toLocaleString(lang === 'sr' ? 'sr-RS' : lang);
  return { sr: `od ${n} din`, en: `from ${n} RSD`, ru: `от ${n} RSD` }[lang];
};

const HERO = { lg: '/style/img/hero/gekon-zivotinje-lg.webp', sm: '/style/img/hero/gekon-zivotinje-sm.webp' };
const linked = ANIMAL_GROUPS.flatMap((g) => g.animals).filter((a) => a.href);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.h1,
    description: t.meta.description,
    url: SITE.url + path,
    inLanguage: lang,
    isPartOf: { '@id': SITE.url + '/#website' },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: linked.length,
      itemListElement: linked.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE.url + href(a.href!), name: a.name[lang] })),
    },
  },
];

const plural = new Intl.PluralRules(lang);
const speciesCount = (n: number) =>
  `${n} ${t.species[plural.select(n) as keyof typeof t.species] ?? t.species.other}`;
---
<Base
  lang={lang}
  {...t.meta}
  path={path}
  image="/style/img/gallery/2.jpg"
  active="animals"
  translations={translationsFor(path)}
  schema={schema}
>
<link slot="head" rel="preload" as="image" href={HERO.sm} media="(max-width: 768px)" fetchpriority="high" />
<link slot="head" rel="preload" as="image" href={HERO.lg} media="(min-width: 769px)" fetchpriority="high" />
<section class="page-head" style={`--ph-img: url(${HERO.lg}); --ph-img-sm: url(${HERO.sm})`}>
  <div class="wrap">
    <h1 set:html={twoTone(t.h1)} />
    <p>{t.lead}</p>
  </div>
</section>
<section class="intro">
  <div class="wrap">
    <div class="intro-box"><p set:html={t.intro} /></div>
  </div>
</section>
<section class="zoo">
  <div class="wrap">
    {!group && (
    <div class="pills">
      {ANIMAL_GROUPS.map((g) => <button class="pill" data-target={g.id}>{g.title[lang]}</button>)}
    </div>
    )}

    {ANIMAL_GROUPS.map((g) => (
      <div class="cat-block" id={`cat-${g.id}`}>
        <div class="cat-title">
          <h2>{!group && g.id === 'zmije' ? <a href={href('/zmije.html')}>{g.title[lang]}</a> : g.title[lang]}</h2>
          <span class="count">{speciesCount(g.animals.length)}</span><span class="line"></span>
        </div>
        <div class="zgrid">
          {g.animals.map((a) => {
            const Card = a.href ? 'a' : 'div';
            return (
              <Card class="zcard" href={a.href && href(a.href)}>
                <div class="zcard-img">
                  {a.beginner && <span class="zbadge">{t.beginner}</span>}
                  <img loading="lazy" decoding="async" src={a.img} alt={a.name[lang]} />
                </div>
                <div class="zcard-body">
                  <div class="lat">{a.latin}</div>
                  <h3>{a.name[lang]}</h3>
                  {priceFrom(a.href) && <span class="zprice">{priceFrom(a.href)}</span>}
                  <p>{a.text[lang]}</p>
                  {a.href && (
                    <span class="zlink">{a.href.includes('/kompleti/') ? t.starter.cta : t.view}
                      <span class="arr"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span></span>
                  )}
                </div>
              </Card>
            );
          })}
        </div>
      </div>
    ))}

    <div class="starter">
      <div class="starter-txt">
        <h3>{t.starter.title}</h3>
        <p>{t.starter.text}</p>
      </div>
      <a href={href('/kompleti.html')} class="btn">{t.starter.cta}</a>
    </div>
  </div>
</section>

<Faq lang={lang} title={t.faqTitle} items={FAQ} />

<Zcta title={t.cta.title} text={t.cta.text} callLabel={t.cta.call} />

<script is:inline slot="after">
  // pills skroluju do kategorije
  document.querySelectorAll('.zoo .pill').forEach((p) =>
    p.addEventListener('click', () => {
      const el = document.getElementById('cat-' + p.dataset.target);
      if (!el) return;
      const y = el.getBoundingClientRect().top + window.pageYOffset - 150;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }),
  );
</script>
</Base>
