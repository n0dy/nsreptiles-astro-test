---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import '../../styles/contact.css';
import { SITE, whatsappLink, type Locale } from '../../config/site';
import { localizePath, translationsFor } from '../../i18n/routes';
import { CONTACT } from '../../i18n/pages/contact';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = CONTACT[lang];
const path = localizePath('/kontakt.html', lang);
const [consentBefore, consentAfter] = t.consent.split('{privacy}');
---
<Base lang={lang} {...t.meta} path={path} translations={translationsFor(path)}>
<section class="page-head" style="--ph-img: url(/style/img/hero/kameleoni-lg.webp); --ph-img-sm: url(/style/img/hero/kameleoni-sm.webp)">
  <div class="wrap">
    <h1 set:html={t.h1} />
    <p>{t.lead}</p>
  </div>
</section>
<section class="kontakt">
  <div class="wrap k-grid">
    <div class="k-info">
      <h2 class="sec-title" set:html={t.infoTitle} />
      <p class="lead">{t.infoText}</p>

      <a class="k-card" href={`tel:${SITE.phone}`}>
        <div class="ic">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.5-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"></path>
          </svg>
        </div>
        <div class="k-card-txt">
          <small>{t.phone}</small><span>{SITE.phoneDisplay}</span>
        </div>
        <span class="k-go" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
      <a class="k-card" href={`mailto:${SITE.email}`}>
        <div class="ic">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M2 7l10 6 10-6"></path>
          </svg>
        </div>
        <div class="k-card-txt">
          <small>E-mail</small><span>{SITE.email}</span>
        </div>
        <span class="k-go" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
      <a class="k-card" href="https://maps.app.goo.gl/TqdvEyPwP1t5ZC117" target="_blank" rel="noopener">
        <div class="ic">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a7 7 0 00-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 00-7-7z"></path>
            <circle cx="12" cy="9" r="2.5"></circle>
          </svg>
        </div>
        <div class="k-card-txt">
          <small>{t.location}</small><span>{t.locationValue}</span>
        </div>
        <span class="k-go" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>

      <div class="k-quick">
        <a href={whatsappLink()} target="_blank" rel="noopener" class="k-wa"><Icon name="whatsapp" size={18} />
          WhatsApp</a>
        <a href={`viber://chat?number=${encodeURIComponent(SITE.phone)}`} target="_blank" rel="noopener" class="k-vb"><Icon name="viber" size={18} />
          Viber</a>
      </div>

      <div class="k-social">
        <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
        <a href={SITE.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" size={16} /></a>
      </div>
    </div>

    <div class="k-form" id="kForm">
      <div class="k-form-inner">
        <h3>{t.formTitle}</h3>
        <p class="sub">{t.formText}</p>
        <div class="k-row">
          <div class="k-field">
            <label for="kName">{t.name}</label><input type="text" id="kName" autocomplete="name" placeholder={t.namePh}>
          </div>
          <div class="k-field">
            <label for="kEmail">E-mail</label><input type="email" id="kEmail" autocomplete="email" placeholder={t.emailPh}>
          </div>
        </div>
        <div class="k-field">
          <label for="kPhone">{t.phoneLabel}</label><input type="tel" id="kPhone" autocomplete="tel" placeholder="+381 6x xxx xxxx">
        </div>
        <div class="k-field">
          <label for="kMsg">{t.message}</label><textarea id="kMsg" placeholder={t.messagePh}></textarea>
        </div>
        <label class="k-consent"><input type="checkbox" id="kConsent"> {consentBefore}
          <a href={localizePath('/politika-privatnosti.html', lang)}>{t.privacy}</a>{consentAfter}</label>
        <button class="btn btn-primary k-submit" id="kSubmit">{t.submit}</button>
      </div>
      <div class="k-success" id="kSuccess">
        <div class="chk">
          <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
        </div>
        <h3>{t.successTitle}</h3>
        <p>{t.successText}</p>
      </div>
    </div>
  </div>
</section>
{t.mapTitle && (
  <section class="kmap">
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d179701.48173165406!2d19.677280566657767!3d45.27133289079664!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x475b1176262afab3%3A0x7026cc24dbf679b7!2sNS%20REPTILES%20-%20izrada%20terarijuma%20i%20akvarijuma%20po%20meri!5e0!3m2!1sen!2srs!4v1783322633785!5m2!1sen!2srs" width="100%" height="440" style="border: 0" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={t.mapTitle}></iframe>
  </section>
)}

<script is:inline slot="after" define:vars={{ m: t.js }}>
  // Prefill poruke sa strane kompleta (?komplet=) ili proizvoda (?proizvod=)
  (function () {
    const q = new URLSearchParams(location.search);
    const komplet = q.get('komplet'), proizvod = q.get('proizvod');
    if (!komplet && !proizvod) return;
    const msg = document.getElementById('kMsg');
    if (!msg.value.trim()) {
      msg.value = komplet
        ? m.prefillKit.replace('{x}', () => komplet)
        : m.prefillProduct.replace('{x}', () => proizvod);
    }
    document.getElementById('kForm').scrollIntoView({ block: 'center' });
  })();

  document.getElementById('kSubmit').addEventListener('click', async () => {
    const name = document.getElementById('kName').value.trim();
    const email = document.getElementById('kEmail').value.trim();
    const phone = document.getElementById('kPhone').value.trim();
    const msg = document.getElementById('kMsg').value.trim();
    const consent = document.getElementById('kConsent').checked;
    if (!name || !email || !msg) {
      alert(m.required);
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      alert(m.badEmail);
      return;
    }
    if (!consent) {
      alert(m.consent);
      return;
    }
    const btn = document.getElementById('kSubmit');
    btn.disabled = true;
    const origText = btn.textContent;
    btn.textContent = m.sending;
    const parts = name.split(' ');
    let ok = false;
    try {
      ok = await window.hsSubmit('6ec8a905-316d-43b5-bc28-40dd6de3feff', [
        { name: 'firstname', value: parts[0] },
        { name: 'lastname', value: parts.slice(1).join(' ') },
        { name: 'email', value: email },
        {
          name: 'message',
          value: phone ? msg + '\n\n' + m.phone + ': ' + phone : msg,
        },
      ]);
    } catch (e) {}
    if (ok) {
      document.getElementById('kForm').classList.add('sent');
      document.getElementById('kSuccess').classList.add('show');
    } else {
      alert(m.error);
      btn.disabled = false;
      btn.textContent = origText;
    }
  });
</script>
</Base>
