---
import Base from '../../layouts/Base.astro';
import '../../styles/privacy.css';
import { SITE, type Locale } from '../../config/site';
import { localizePath, translationsFor } from '../../i18n/routes';
import { PRIVACY } from '../../i18n/pages/privacy';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = PRIVACY[lang];
const path = localizePath('/politika-privatnosti.html', lang);
const last = t.sections.length - 1;
---
<Base lang={lang} {...t.meta} path={path} translations={translationsFor(path)}>
<section class="page-head">
  <div class="wrap">
    <h1>{t.h1}</h1>
    <p>{t.lead}</p>
  </div>
</section>
<section class="doc">
  <div class="wrap">
    <div class="doc-updated">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      {t.updated}
    </div>

    {t.sections.map((s, i) => (
      <div class="doc-sec">
        <h2>{s.title}</h2>
        <p set:html={s.text} />
        {s.items && <ul>{s.items.map((li) => <li set:html={li} />)}</ul>}
        {s.after && <p set:html={s.after} />}
        {i === last && (
          <div class="doc-contact">
            <div class="row">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="M2 7l10 6 10-6"></path>
              </svg>
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </div>
            <div class="row">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.5-1.1a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"></path>
              </svg>
              <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</section>
</Base>
