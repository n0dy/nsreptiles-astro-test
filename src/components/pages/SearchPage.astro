---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../config/site';
import { localizePath, translationsFor } from '../../i18n/routes';
import { UI } from '../../i18n/ui';
import { SEARCH_PAGE } from '../../i18n/pages/search';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = SEARCH_PAGE[lang];
const ui = UI[lang];
const path = localizePath('/pretraga.html', lang);
const strings = { types: t.types, count: t.count, all: t.all, empty: ui.searchEmpty, error: ui.searchError, prompt: t.prompt };
---
<Base lang={lang} {...t.meta} path={path} noindex translations={translationsFor(path)}>
<section class="section srp" data-strings={JSON.stringify(strings)} data-lang={lang}>
  <div class="wrap">
    <h1 class="sec-title">{t.h1}</h1>
    <form class="srp-form" role="search" action={path} method="get">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg>
      <input type="search" name="q" class="srp-input" placeholder={ui.searchPlaceholder} aria-label={ui.search} autocomplete="off" spellcheck="false" required />
      <button type="submit" class="btn btn-primary">{ui.search}</button>
    </form>
    <div class="srp-filters" role="group" aria-label={t.h1}></div>
    <p class="srp-status" role="status" aria-live="polite">{t.prompt}</p>
    <ul class="srp-results search-results"></ul>
    <button type="button" class="btn btn-light srp-more" hidden>{t.more}</button>
  </div>
</section>
<script src="../../scripts/search-page.js"></script>
</Base>
