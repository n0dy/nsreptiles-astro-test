---
import { twoTone } from '../../lib/two-tone';
import Base from '../../layouts/Base.astro';
import Zcta from '../Zcta.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { SITE, type Locale } from '../../config/site';
import { localizePath, translationsFor } from '../../i18n/routes';
import { SERVICES, SERVICE_UI, type ServiceKey } from '../../i18n/pages/services';

interface Props {
  service: ServiceKey;
  lang: Locale;
}
const { service, lang } = Astro.props;
const s = SERVICES[service];
const ui = SERVICE_UI[lang];
const href = (srPath: string) => localizePath(srPath, lang);
const path = href(s.path);
const cta = s.cta[lang];
const heroImg = service === 'akvarijumi' ? '/style/img/izrada/akvarijum.webp' : '/style/img/izrada/terarijum.webp';
const animals = s.animals?.[lang];

const sc = s.schema[lang];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: sc.name,
    serviceType: sc.serviceType,
    provider: {
      '@type': 'LocalBusiness',
      name: SITE.name,
      telephone: SITE.phone,
      address: { '@type': 'PostalAddress', addressLocality: 'Novi Sad', addressCountry: 'RS' },
    },
    areaServed: ui.areaServed,
    description: sc.description,
    url: SITE.url + path,
  },
];
---
<Base
  lang={lang}
  {...s.meta[lang]}
  path={path}
  translations={translationsFor(path)}
  schema={schema}
>
<section class="page-head" style={`--ph-img: url(${heroImg}); --ph-img-sm: url(${heroImg})`}>
  <div class="wrap">
    <h1 set:html={twoTone(s.h1[lang])} />
    <p>{s.lead[lang]}</p>
  </div>
</section>
<section class="intro">
  <div class="wrap">
    <div class="intro-box">
      <p set:html={s.intro[lang]} />
    </div>
  </div>
</section>
<section class="usl">
  <div class="wrap">
    {s.layout === 'proc' ? (
      <div class="proc">
        {s.items.map((it) => (
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>{it.title[lang]}</h3>
              <p>{it.text[lang]}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="feat-grid">
        {s.items.map((it, i) => (
          <article class="feat-card">
            <span class="feat-idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{it.title[lang]}</h3>
            <p>{it.text[lang]}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
<Zcta title={cta.title} text={cta.text} callLabel={cta.call} />
{animals && (
  <section class="usl-more" style="background: var(--bg)">
    <div class="wrap">
      <div class="usl-more-head">
        <h2 set:html={animals.title} />
      </div>
      <div class="usl-more-grid">
        {animals.links.map((l) => (
          <a class="usl-link" href={href(l.href)}>{l.label}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        ))}
      </div>
    </div>
  </section>
)}
<section class="usl-more">
  <div class="wrap">
    <div class="usl-more-head">
      <h2 set:html={ui.moreTitle} />
    </div>
    <div class="usl-more-grid">
      {s.more.map((l) => (
        <a class="usl-link" href={href(l.href)}>{l.label[lang]}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      ))}
    </div>
  </div>
</section>
</Base>
