---
import Base from '../../layouts/Base.astro';
import { SITE, whatsappLink, type Locale } from '../../config/site';
import { localizePath, translationsFor } from '../../i18n/routes';
import { SHIPPING } from '../../i18n/pages/shipping';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = SHIPPING[lang];
const path = localizePath('/dostava.html', lang);
const { full, short } = t;

const LINK_ICONS = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><path d="M22 6l-10 7L2 6"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M12 3v6"></path><circle cx="12" cy="16" r="2"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c2-3 5-5 10-5s8 2 10 5"></path><path d="M2 17c2-3 5-5 10-5s8 2 10 5"></path><path d="M12 22V7"></path><circle cx="12" cy="4" r="2"></circle></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"></path><rect x="4" y="4" width="16" height="16" rx="1"></rect><path d="M4 10h16"></path><path d="M10 4v16"></path></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 15c3-3 6-4 10-4s7 1 10 4"></path><path d="M2 20c3-3 6-4 10-4s7 1 10 4"></path><rect x="4" y="2" width="16" height="13" rx="1"></rect></svg>',
];
const WHEN_ICONS = [
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.7l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.7l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"></path><path d="M3.3 7L12 12l8.7-5M12 22V12"></path></svg>',
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>',
  '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 00-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 00-7-7z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>',
];
const METHOD_ICONS = [
  '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>',
  '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V6a2 2 0 012-2h12a2 2 0 012 2v11"></path><path d="M2 17h20v2a1 1 0 01-1 1H3a1 1 0 01-1-1z"></path><circle cx="7" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle><path d="M4 8h16"></path></svg>',
  '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M6 17l1-6h10l1 6M8 11l1-4h6l1 4"></path><circle cx="7.5" cy="17.5" r="1.5"></circle><circle cx="16.5" cy="17.5" r="1.5"></circle><path d="M10 7V5h4v2"></path></svg>',
  '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><path d="M9 22V12h6v10"></path></svg>',
];
const NOTE_ICON = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16h.01"></path></svg>';
const CARD_ICONS = [
  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>',
  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 3v5h-7V8z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>',
  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 010 7H6"></path></svg>',
];
---
<Base lang={lang} {...t.meta} path={path} translations={translationsFor(path)}>
<section class="page-head">
  <div class="wrap">
    <h1>{t.h1}</h1>
    <p>{t.lead}</p>
  </div>
</section>
{full && (
  <section class="del">
    <div class="wrap">
      <div class="dsec-title">
        <h2 set:html={full.when.title} />
      </div>
      <p class="sec-lead">{full.when.lead}</p>
      <div class="dcard-grid">
        <div class="dcard">
          <div class="ic" set:html={WHEN_ICONS[0]} />
          <h3>{full.when.byType.title}</h3>
          {full.when.byType.rows.map(([label, value]) => <div class="drow"><span>{label}</span><b>{value}</b></div>)}
        </div>
        {full.when.cards.map((c, i) => (
          <div class="dcard">
            <div class="ic" set:html={WHEN_ICONS[i + 1]} />
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="del">
    <div class="wrap">
      <div class="dsec-title">
        <h2 set:html={full.how.title} />
      </div>
      <p class="sec-lead">{full.how.lead}</p>
      <div class="methods">
        {full.how.methods.map((m, i) => (
          <div class="method">
            <div class="ic" set:html={METHOD_ICONS[i]} />
            <div><h4>{m.title}</h4><p>{m.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="del">
    <div class="wrap">
      <div class="dsec-title">
        <h2 set:html={full.cost.title} />
      </div>
      <p class="sec-lead">{full.cost.lead}</p>
      <div class="dbanner">
        <div class="price-card">
          <h3>{full.cost.price.title}</h3>
          <p>{full.cost.price.text}</p>
          <div class="price-tag"><b>{full.cost.price.amount}</b><span>{full.cost.price.unit}</span></div>
        </div>
        <div class="del-note-card">
          <div class="ic" set:html={NOTE_ICON} />
          <h3>{full.cost.note.title}</h3>
          <p>{full.cost.note.text}</p>
        </div>
      </div>
      <div class="dcta">
        <h3>{full.cost.cta.title}</h3>
        <p>{full.cost.cta.text}</p>
        <div class="dcta-btns">
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-primary">{full.cost.cta.wa}</a>
          <a href={`tel:${SITE.phone}`} class="btn btn-outline">{full.cost.cta.call}</a>
        </div>
      </div>

      <div class="useful-links">
        {t.links.map((l, i) => <a href={localizePath(l.href, lang)}><Fragment set:html={LINK_ICONS[i]} />{l.label}</a>)}
      </div>
    </div>
  </section>
)}
{short && (
  <section class="section" style="background: var(--bg)">
    <div class="wrap">
      <div class="del-grid">
        {short.cards.map((c, i) => (
          <div class="del-card">
            <div class="del-icon" set:html={CARD_ICONS[i]} />
            <h3>{c.title}</h3>
            <ul>{c.items.map((li) => <li set:html={li} />)}</ul>
            {c.note && <p style="margin-top: 14px; font-size: 0.88rem" set:html={c.note} />}
          </div>
        ))}
      </div>
      <div class="del-note" set:html={short.contact} />
      <div class="useful-links">
        {t.links.map((l, i) => <a href={localizePath(l.href, lang)}><Fragment set:html={LINK_ICONS[i]} />{l.label}</a>)}
      </div>
    </div>
  </section>
)}
<style is:global>
  .del{padding:64px 0 100px;background:var(--bg);transition:background .4s}
  .del+.del{padding-top:0}
  .dsec-title{text-align:center;margin-bottom:14px}
  .dsec-title h2{font-size:clamp(1.6rem,3.4vw,2.3rem);text-transform:uppercase}
  .dsec-title h2 b{color:var(--green-ink)}
  .sec-lead{text-align:center;max-width:600px;margin:0 auto 44px;color:var(--ink-soft)}

  .dcard-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:20px}
  .dcard{position:relative;background:var(--white);border:1px solid var(--silver);padding:30px 28px;transition:background .4s,border-color .4s}
  .dcard .ic{position:absolute;top:22px;right:22px;color:var(--green-ink);display:flex;align-items:center;justify-content:center}
  .dcard h3{font-size:1.12rem;text-transform:uppercase;margin-bottom:14px}
  .drow{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-bottom:1px solid var(--bg);font-size:.94rem}
  .drow:last-child{border-bottom:none}
  .drow span:first-child{color:var(--ink-soft)}
  .drow b{font-family:'Oswald Variable',sans-serif;font-weight:600;color:var(--green-ink);white-space:nowrap;text-align:right}
  .dcard p{color:var(--ink-soft);font-size:.95rem}

  .methods{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:20px}
  .method{position:relative;display:flex;gap:16px;background:var(--white);border:1px solid var(--silver);padding:24px 60px 24px 26px;transition:background .4s,border-color .4s}
  .method .ic{position:absolute;top:20px;right:20px;color:var(--green-ink);display:flex;align-items:center;justify-content:center}
  .method h4{font-size:1rem;text-transform:uppercase;margin-bottom:5px}
  .method p{color:var(--ink-soft);font-size:.92rem}

  .dbanner{display:grid;grid-template-columns:1.3fr 1fr;gap:20px;margin-bottom:20px}
  .price-card{background:var(--white);border:1px solid var(--silver);padding:30px 28px;transition:background .4s,border-color .4s}
  .price-card h3{font-size:1.12rem;text-transform:uppercase;margin-bottom:12px}
  .price-card p{color:var(--ink-soft);font-size:.95rem;margin-bottom:10px}
  .price-tag{display:inline-flex;align-items:baseline;gap:8px;margin-top:6px}
  .price-tag b{font-family:'Oswald Variable',sans-serif;font-weight:700;font-size:2rem;color:var(--green-ink);line-height:1}
  .price-tag span{color:var(--ink-soft);font-size:.85rem}
  .del-note-card{position:relative;background:linear-gradient(150deg,var(--green),var(--green-dark));color:#fff;padding:30px 28px;display:flex;flex-direction:column;justify-content:center}
  .del-note-card .ic{position:absolute;top:22px;right:22px;color:rgba(255,255,255,.7);display:flex;align-items:center;justify-content:center}
  .del-note-card h3{color:#fff;text-transform:uppercase;font-size:1.1rem;margin-bottom:8px}
  .del-note-card p{color:rgba(255,255,255,.92);font-size:.95rem}

  .dcta{background:var(--white);border:1px solid var(--silver);padding:36px 32px;text-align:center;transition:background .4s,border-color .4s}
  .dcta h3{font-size:1.4rem;text-transform:uppercase;margin-bottom:8px}
  .dcta p{color:var(--ink-soft);margin-bottom:22px;max-width:520px;margin-left:auto;margin-right:auto}
  .dcta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}

  @media(max-width:880px){.dcard-grid{grid-template-columns:1fr}.dbanner{grid-template-columns:1fr}}
  @media(max-width:680px){.methods{grid-template-columns:1fr}}
</style>
</Base>
