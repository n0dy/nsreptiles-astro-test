---
import { twoTone } from '../../lib/two-tone';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../ProductCard.astro';
import Zcta from '../Zcta.astro';
import Faq from '../Faq.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import '../../styles/oprema.css';
import { SITE, AUTHOR, whatsappLink, type Locale } from '../../config/site';
import { HOME } from '../../i18n/ui';
import { localizePath, translationsFor } from '../../i18n/routes';
import { getProducts } from '../../lib/products';
import { gitDates } from '../../lib/git-dates';
import { TERRARIUM_GUIDES } from '../../i18n/guides';
import { ANIMAL_GROUPS, ANIMALS_TEXT } from '../../i18n/pages/animals';
import { KITS } from '../../i18n/kits';

interface Props {
  lang: Locale;
  /** srpski slug vrste, npr. "leopard-gekon" */
  slug: string;
}
const { lang, slug } = Astro.props;

const UI = {
  sr: { home: 'Početna', animals: 'Životinje', crumbs: 'Putanja', related: 'Preporučeni proizvodi', cat: 'Terarijum', cta: 'Kontaktirajte <b>NS Reptiles</b>', kit: 'Komplet za početnike' },
  en: { home: 'Home', animals: 'Animals', crumbs: 'Breadcrumb', related: 'Recommended products', cat: 'Terrarium', cta: 'Contact <b>NS Reptiles</b>', kit: 'Starter kit' },
  ru: { home: 'Главная', animals: 'Животные', crumbs: 'Навигационная цепочка', related: 'Рекомендуемые товары', cat: 'Террариум', cta: 'Свяжитесь с <b>NS Reptiles</b>', kit: 'Стартовый набор' },
}[lang];

const entry = await getEntry('species', `${lang}/${slug}`);
const sr = await getEntry('species', `sr/${slug}`);
if (!entry || !sr) throw new Error(`Nema species/${lang}/${slug}.json`);
const d = entry.data;
// slike, proizvodi i cena se vode samo u sr fajlu
const { image, related = [] } = sr.data;
if (!image || !sr.data.photo) throw new Error(`species/sr/${slug}.json: fale image/photo`);
const low = sr.data.price?.low;
const guide = TERRARIUM_GUIDES[slug];

const href = (srPath: string) => localizePath(srPath, lang);
// sr URL-ovi su bez crtica (stari sajt, a sitemap ih tako i pravi) - ne menjati zbog SEO
const srPath = `/zivotinje/${slug.replaceAll('-', '')}.html`;
const path = href(srPath);
// strana vrste prikazuje istu sliku kao njena kartica na zivotinje.html; sve slike kartica su 800x1000
const kit = KITS.find((k) => k.species.includes(srPath));
const card = ANIMAL_GROUPS.flatMap((g) => g.animals).find((a) => a.href === srPath);
const photo = card?.img ?? sr.data.photo;
const photoSize = card ? [800, 1000] : (sr.data.photoSize ?? [1248, 832]);
const url = SITE.url + path;
const imageUrl = SITE.url + image;

const all = await getProducts();
const relatedProducts = related.map((id) => {
  const p = all.find((x) => x.id === id);
  if (!p) throw new Error(`species/sr/${slug}.json: nepostojeci proizvod ${id}`);
  return p;
});

const modified = gitDates().get(`src/content/species/${lang}/${slug}.json`);
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.article.headline,
    description: d.article.description,
    author: AUTHOR,
    ...(modified ? { dateModified: modified } : {}),
    inLanguage: lang,
    publisher: { '@id': SITE.url + '/#business' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: imageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: UI.home, item: SITE.url + HOME[lang] },
      { '@type': 'ListItem', position: 2, name: UI.animals, item: SITE.url + href('/zivotinje.html') },
      { '@type': 'ListItem', position: 3, name: d.schemaName ?? d.name, item: url },
    ],
  },
];
// cena se vodi samo u sr fajlu; Product samo gde je kartica sa cenom vidljiva (Google trazi cenu na strani); cena je "od", zato Offer sa minPrice
if (low && d.price) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: d.product?.name ?? d.schemaName ?? d.name,
    description: d.product?.description ?? d.article.description,
    image: imageUrl,
    brand: { '@type': 'Brand', name: SITE.name },
    offers: { '@type': 'Offer', url, priceCurrency: 'RSD', price: low, priceSpecification: { '@type': 'PriceSpecification', minPrice: low, priceCurrency: 'RSD' }, seller: { '@id': SITE.url + '/#business' } },
  });
}
// FAQPage schema pravi Faq komponenta iz istih pitanja
const faqItems = (d.faq?.items ?? []).map((f) => ({ q: { [lang]: f.q }, a: { [lang]: f.a } }));

---
<Base
  lang={lang}
  {...d.seo}
  path={path}
  image={image}
  ogType="article"
  active="animals"
  translations={translationsFor(path)}
  schema={schema}
>
<section class="page-head sp-head" style="--ph-img: none; --ph-img-sm: none">
  <div class="wrap">
    <div class="sp-head-text">
      {card?.latin && <div class="sp-latin">{card.latin}</div>}
      <h1 set:html={twoTone(d.name)} />
      <p>{d.lead}</p>
      {card?.beginner && <span class="sp-badge">{ANIMALS_TEXT[lang].beginner}</span>}
    </div>
  </div>
  <figure class="sp-photo">
    <img data-pagefind-meta="image[src]" src={photo} alt={d.photoAlt} width={photoSize[0]} height={photoSize[1]} fetchpriority="high" />
  </figure>
</section>
<section class="pd-crumbs">
  <div class="wrap">
    <nav class="pd-breadcrumb" aria-label={UI.crumbs}>
      <a href={HOME[lang]}>{UI.home}</a>
      <span class="sep" aria-hidden="true">›</span>
      <a href={href('/zivotinje.html')}>{UI.animals}</a>
      <span class="sep" aria-hidden="true">›</span>
      <span class="cur" aria-current="page">{d.name}</span>
    </nav>
  </div>
</section>
<section class="intro sp-intro-sec">
  <div class:list={['wrap sp-intro', { 'has-price': d.price }]}>
    <div>
      <div class="intro-box reveal"><p set:html={d.intro} /></div>
    </div>
    {d.price && (
      <div class="aprice-card sp-price reveal">
        <div class="aprice-main">
          <div class="aprice-label">{d.price.label}</div>
          <div class="aprice-value">{d.price.value}</div>
          <p class="aprice-note" set:html={d.price.note} />
        </div>
        <div class="aprice-cta" data-proizvod={slug}>
          <a href={`tel:${SITE.phone}`} class="btn btn-primary">{d.price.call}</a>
          <a href={whatsappLink(d.price.waText)} target="_blank" rel="noopener" class="btn btn-outline">WhatsApp</a>
        </div>
      </div>
    )}
  </div>
</section>
<section class="sp-care">
  <div class="wrap">
    {d.sections.map((s, i) => (
      <div class="sp-topic reveal">
        <div class="sp-topic-head">
          <span class="sp-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h2 set:html={s.title} />
        </div>
        <div class="sp-boxes">
          {s.boxes.map((b) => (
            <div class="sp-box">
              {b.title && <h3>{b.title}</h3>}
              {b.p.map((p) => <p set:html={p} />)}
            </div>
          ))}
        </div>
      </div>
    ))}
    {(guide || kit) && (
      <div class="sp-guide">
        {guide && <a class="btn btn-outline" href={href(guide.href)}>{guide.label[lang]}</a>}
        {kit && <a class="btn btn-outline" href={href(kit.href)}>{UI.kit}: {kit.name[lang]}</a>}
      </div>
    )}
  </div>
</section>
{d.faq && <Faq lang={lang} title={d.faq.title} items={faqItems} />}
{relatedProducts.length > 0 && (
  <section class="pd-related section sp-related">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="sec-title" set:html={twoTone(UI.related)} />
      </div>
      <div class="op-grid">
        {relatedProducts.map((p) => <ProductCard product={p} lang={lang} catLabel={UI.cat} />)}
      </div>
    </div>
  </section>
)}
<Zcta title={d.cta.title ?? UI.cta} text={d.cta.text} callLabel={SITE.phoneDisplay} waText={d.cta.waText} />
</Base>
