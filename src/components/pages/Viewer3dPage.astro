            w.colorMap.userData.mimeType = 'image/jpeg'; // AR izvoz kao jpeg, ne png
            w.colorMap.colorSpace = THREE.SRGBColorSpace;
            w.colorMap.wrapS = w.colorMap.wrapT = THREE.RepeatWrapping;
            w.colorMap.repeat.set(3, 3);
        }

        const colorOptions = woodTextures;
        var activeWood = DEFAULT_WOOD;

        const panelMaterials = []; // samo foilMaterial, puni se kod generatora

        let doorLeft = null, doorRight = null;
        let doorLeftStart = new THREE.Vector3(), doorRightStart = new THREE.Vector3();
        let slideDir = new THREE.Vector3(), doorSlideDistance = 0;

        let lid = null;
        let lidStartPos = new THREE.Vector3();

        function applyOption(opt) {
            ensureWoodLoaded(opt);
            panelMaterials.forEach(function (mat) {
                mat.color.setHex(0xffffff);
                mat.map = opt.colorMap;
                mat.roughness = 0.8;
                mat.metalness = 0.0;
                mat.needsUpdate = true;
            });
        }

        // Tabovi panela
        document.querySelectorAll('.panel-tabs button').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.panel-tabs button').forEach(function (b) { b.setAttribute('aria-selected', String(b === btn)); });
                document.querySelectorAll('.panel-tab').forEach(function (t) { t.hidden = t.dataset.tab !== btn.dataset.tab; });
            });
        });

        // Tekstura dugmad
        const colorContainer = document.getElementById('color-options');
        const colorCode = document.getElementById('color-code');
        colorCode.textContent = DEFAULT_WOOD.name;
        colorOptions.forEach(function (opt) {
            const btn = document.createElement('button');
            btn.className = 'color-swatch' + (opt === DEFAULT_WOOD ? ' active' : '');
            btn.title = opt.name;
            btn.setAttribute('aria-label', opt.name);
            btn.innerHTML = '<span class="dot" style="background:url(' + opt.preview + ') center/cover;"></span>';
            btn.addEventListener('click', function () {
                colorContainer.querySelectorAll('.color-swatch').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                applyOption(opt);
                activeWood = opt;
                colorCode.textContent = opt.name;
                scheduleArExport();
            });
            colorContainer.appendChild(btn);
        });

        // Pozadine: bez, crna ili 3D reljef generisan iz fotografije pozadine (3d-pozadine.html)
        let GLASS_M = 0.004; // debljina stakla u metrima; kod akvarijuma zavisi od mera (setupTerrarium)
        const BG_RELIEF_DEPTH = 0.05;
        const BG_SEG_X = 240, BG_SEG_Y = 120;
        const RELIEF_GAMMA = 1.4; // >1 naglasava ispupcenja, pukotine ostaju duboke
        const NORMAL_STRENGTH = 2.5;
        const WHITE_THRESHOLD = 235;
        const bgFiles = ['001', '002', '003', '004', '005', '006', '007', '008', '009', '0010', '0011', '0012'];
        const bgOptions = [
            { name: T.bgNone, type: 'none' },
            { name: T.bgBlack, type: 'black' }
        ].concat(bgFiles.map(function (f, i) {
            return { name: T.bgRelief + ' M0' + String(i + 1).padStart(2, '0'), type: 'relief', src: '/style/img/backgrounds/poz' + f + '.webp' };
        }));
        let modelSize = null, activeBg = bgOptions[0], bgMesh = null, bgRequest = 0;
        let sideGapY = null; // [dno, vrh] razmaka izmedju bocnih traka folije, u svetskim koordinatama

        function loadImage(src) {
            return new Promise(function (resolve, reject) {
                const img = new Image();
                img.onload = function () { resolve(img); };
                img.onerror = reject;
                img.src = src;
            });
        }

        // Granice panela na fotografiji (sve sto nije providno ni belo), uvuceno 3% da ne uhvati ivicu
        function panelBounds(img) {
            const c = document.createElement('canvas');
            c.width = img.naturalWidth; c.height = img.naturalHeight;
            const ctx = c.getContext('2d');
            ctx.drawImage(img, 0, 0);
            const d = ctx.getImageData(0, 0, c.width, c.height).data;
            let x0 = c.width, y0 = c.height, x1 = 0, y1 = 0;
            for (let y = 0; y < c.height; y++) {
                for (let x = 0; x < c.width; x++) {
                    const i = (y * c.width + x) * 4;
                    const opaque = d[i + 3] > 128;
                    if (opaque && (d[i] < WHITE_THRESHOLD || d[i + 1] < WHITE_THRESHOLD || d[i + 2] < WHITE_THRESHOLD)) {
                        if (x < x0) x0 = x; if (x > x1) x1 = x;
                        if (y < y0) y0 = y; if (y > y1) y1 = y;
                    }
                }
            }
            if (x1 <= x0 || y1 <= y0) return { x: 0, y: 0, w: c.width, h: c.height };
            const ix = (x1 - x0) * 0.03, iy = (y1 - y0) * 0.03;
            return { x: x0 + ix, y: y0 + iy, w: x1 - x0 - 2 * ix, h: y1 - y0 - 2 * iy };
        }

        // Luminansa canvasa kao niz 0..1; providni/beli pikseli (van panela) su NaN
        function luminance(canvas) {
            const d = canvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height).data;
            const out = new Float32Array(canvas.width * canvas.height);
            for (let i = 0; i < out.length; i++) {
                const r = d[i * 4], g = d[i * 4 + 1], b = d[i * 4 + 2];
                const outside = d[i * 4 + 3] < 128 || (r > WHITE_THRESHOLD && g > WHITE_THRESHOLD && b > WHITE_THRESHOLD);
                out[i] = outside ? NaN : (0.299 * r + 0.587 * g + 0.114 * b) / 255;
            }
            return out;
        }

        function fillMissing(a) {
            let sum = 0, n = 0;
            for (let i = 0; i < a.length; i++) if (!isNaN(a[i])) { sum += a[i]; n++; }
            const mean = n ? sum / n : 0.5;
            for (let i = 0; i < a.length; i++) if (isNaN(a[i])) a[i] = mean;
            return a;
        }

        // Box blur (separabilni), passes puta - aproksimira gausovo zagladjivanje
        function blur(a, w, h, radius, passes) {
            let src = a, tmp = new Float32Array(a.length);
            for (let p = 0; p < passes; p++) {
                for (let y = 0; y < h; y++) {
                    for (let x = 0; x < w; x++) {
                        let s = 0, n = 0;
                        for (let k = -radius; k <= radius; k++) {
                            const xx = Math.min(w - 1, Math.max(0, x + k));
                            s += src[y * w + xx]; n++;
                        }
                        tmp[y * w + x] = s / n;
                    }
                }
                const out = new Float32Array(a.length);
                for (let y = 0; y < h; y++) {
                    for (let x = 0; x < w; x++) {
                        let s = 0, n = 0;
                        for (let k = -radius; k <= radius; k++) {
                            const yy = Math.min(h - 1, Math.max(0, y + k));
                            s += tmp[yy * w + x]; n++;
                        }
                        out[y * w + x] = s / n;
                    }
                }
                src = out;
            }
            return src;
        }

        function normalize(a) {
            let min = Infinity, max = -Infinity;
            for (let i = 0; i < a.length; i++) { min = Math.min(min, a[i]); max = Math.max(max, a[i]); }
            const range = Math.max(max - min, 0.001);
            for (let i = 0; i < a.length; i++) a[i] = (a[i] - min) / range;
            return a;
        }

        // Normal mapa iz sitnih detalja fotografije (sobel), za strukturu kamena koju geometrija ne hvata
        function normalMapFrom(canvas) {
            const w = canvas.width, h = canvas.height;
            const hgt = blur(fillMissing(luminance(canvas)), w, h, 1, 1);
            const out = document.createElement('canvas');
            out.width = w; out.height = h;
            const octx = out.getContext('2d');
            const img = octx.createImageData(w, h);
            const at = function (x, y) { return hgt[Math.min(h - 1, Math.max(0, y)) * w + Math.min(w - 1, Math.max(0, x))]; };
            for (let y = 0; y < h; y++) {
                for (let x = 0; x < w; x++) {
                    const dx = (at(x + 1, y - 1) + 2 * at(x + 1, y) + at(x + 1, y + 1)) - (at(x - 1, y - 1) + 2 * at(x - 1, y) + at(x - 1, y + 1));
                    const dy = (at(x - 1, y + 1) + 2 * at(x, y + 1) + at(x + 1, y + 1)) - (at(x - 1, y - 1) + 2 * at(x, y - 1) + at(x + 1, y - 1));
                    const nx = -dx * NORMAL_STRENGTH, ny = dy * NORMAL_STRENGTH, nz = 1;
                    const len = Math.hypot(nx, ny, nz);
                    const i = (y * w + x) * 4;
                    img.data[i] = (nx / len * 0.5 + 0.5) * 255;
                    img.data[i + 1] = (ny / len * 0.5 + 0.5) * 255;
                    img.data[i + 2] = (nz / len * 0.5 + 0.5) * 255;
                    img.data[i + 3] = 255;
                }
            }
            octx.putImageData(img, 0, 0);
            return out;
        }

        // u0..u1: deo sirine slike (0-1) koji ide na ovaj komad, da se slika nastavlja preko vise komada
        function buildRelief(img, w, h, u0, u1) {
            const b = panelBounds(img), sx = b.x + b.w * u0, sw = b.w * (u1 - u0);
            const colorCanvas = document.createElement('canvas');
            colorCanvas.width = Math.max(1, Math.round(sw)); colorCanvas.height = Math.round(b.h);
            colorCanvas.getContext('2d').drawImage(img, sx, b.y, sw, b.h, 0, 0, colorCanvas.width, colorCanvas.height);

            // Krupni oblici reljefa: mreza verteksa, zagladjena da nema siljaka od suma
            const gw = BG_SEG_X + 1, gh = BG_SEG_Y + 1;
            const hc = document.createElement('canvas');
            hc.width = gw; hc.height = gh;
            hc.getContext('2d').drawImage(colorCanvas, 0, 0, gw, gh);
            const height = normalize(blur(fillMissing(luminance(hc)), gw, gh, 2, 2));

            const geo = new THREE.PlaneGeometry(w, h, BG_SEG_X, BG_SEG_Y);
            const pos = geo.attributes.position;
            for (let i = 0; i < pos.count; i++) pos.setZ(i, Math.pow(height[i], RELIEF_GAMMA) * BG_RELIEF_DEPTH);
            geo.computeVertexNormals();

            const map = new THREE.CanvasTexture(colorCanvas);
            map.colorSpace = THREE.SRGBColorSpace;
            map.anisotropy = renderer.capabilities.getMaxAnisotropy();
            const normalMap = new THREE.CanvasTexture(normalMapFrom(colorCanvas));
            const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({
                map: map, normalMap: normalMap, normalScale: new THREE.Vector2(0.8, 0.8), roughness: 0.92, metalness: 0
            }));
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            return mesh;
        }

        function clearBackground() {
            if (!bgMesh) return;
            scene.remove(bgMesh);
            bgMesh.traverse(function (o) {
                if (!o.isMesh || o.userData.sharedMaterial) {
                    if (o.isMesh) o.geometry.dispose();
                    return;
                }
                o.geometry.dispose();
                if (o.material.map) o.material.map.dispose();
                o.material.dispose();
            });
            bgMesh = null;
        }

        // crna folija spolja na zadnjem staklu
        function blackFoil() {
            const m = new THREE.Mesh(new THREE.PlaneGeometry(modelSize.x, modelSize.y),
                new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.9, side: THREE.DoubleSide }));
            m.position.set(0, 0, -modelSize.z / 2 - 0.0005);
            return m;
        }

        // vertikalne trake folije na bocnim staklima uz zadnju ivicu (sakrivaju ivicu pozadine)
        const SIDE_STRIP = 0.09;
        function sideStrips() {
            const group = new THREE.Group();
            [-1, 1].forEach(function (side) {
                const y0 = sideGapY ? sideGapY[0] : -modelSize.y / 2, y1 = sideGapY ? sideGapY[1] : modelSize.y / 2;
                const geo = new THREE.PlaneGeometry(SIDE_STRIP, y1 - y0);
                const uv = geo.attributes.uv;
                for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) * SIDE_STRIP, uv.getY(i) * (y1 - y0));
                const m = new THREE.Mesh(geo, panelMaterials[0]);
                m.userData.sharedMaterial = true;
                m.rotation.y = side * Math.PI / 2;
                m.position.set(side * (modelSize.x / 2 + 0.0005), (y0 + y1) / 2, -modelSize.z / 2 + SIDE_STRIP / 2);
                group.add(m);
            });
            return group;
        }

        async function applyBackground() {
            if (!modelSize) return;
            const opt = activeBg, request = ++bgRequest;
            let mesh = null;
            if (opt.type === 'black') {
                mesh = blackFoil();
            } else if (opt.type === 'relief') {
                let img;
                try {
                    img = await loadImage(opt.src);
                } catch (e) {
                    console.error('Pozadina nije ucitana:', opt.src, e);
                    return;
                }
                if (request !== bgRequest) return;
                const innerH = modelSize.y - 2 * GLASS_M - 0.002;
                const L = modelSize.x * 1000, W = modelSize.z * 1000, innerL = L - 2 * T_GLASS;
                mesh = new THREE.Group();
                const spans = backgroundSpans(L, W, build), wrap = BG_RELIEF_DEPTH * 600; // mm
                const yMid = -modelSize.y / 2 + GLASS_M + 0.001 + innerH / 2, frac = function (mm) { return (mm - T_GLASS) / innerL; };
                spans.forEach(function (sp, i) {
                    const prev = spans[i - 1], next = spans[i + 1];
                    // komad ispred pregrade filtera prelazi malo preko ugla komore, da se spoji sa komadom na njenom boku
                    const x0 = sp[0] - (prev && prev[2] > sp[2] ? wrap : 0), x1 = sp[1] + (next && next[2] > sp[2] ? wrap : 0);
                    const relief = buildRelief(img, (x1 - x0) / 1000 - 0.002, innerH, frac(sp[0]), frac(sp[1]));
                    relief.position.set(((x0 + x1) / 2 - L / 2) / 1000, yMid, (W / 2 - sp[2]) / 1000 + 0.001);
                    mesh.add(relief);
                    if (!next || next[2] === sp[2]) return;
                    // bok komore (kod filtera na polovini zadnje strane): komad pozadine okrenut ka slobodnoj polovini
                    const dir = next[2] > sp[2] ? 1 : -1, y0 = Math.min(sp[2], next[2]) - wrap, y1 = Math.max(sp[2], next[2]);
                    const u = Math.min(frac(sp[1]), 1 - (y1 - y0) / innerL);
                    const side = buildRelief(img, (y1 - y0) / 1000, innerH, u, u + (y1 - y0) / innerL);
                    side.rotation.y = dir * Math.PI / 2;
                    side.position.set((sp[1] - L / 2) / 1000 + dir * 0.001, yMid, (W / 2 - (y0 + y1) / 2) / 1000);
                    mesh.add(side);
                });
                mesh.add(blackFoil());
                if (panelMaterials.length) mesh.add(sideStrips());
            }
            if (request !== bgRequest) return;
            clearBackground();
            if (mesh) {
                bgMesh = mesh;
                scene.add(mesh);
            }
        }

        const bgContainer = document.getElementById('bg-options');
        bgOptions.forEach(function (opt, i) {
            const btn = document.createElement('button');
            btn.className = 'color-swatch' + (i === 0 ? ' active' : '');
            btn.title = opt.name;
            btn.setAttribute('aria-label', opt.name);
            const dotStyle = opt.type === 'none' ? 'background:#fff;outline:1px dashed #bbb;outline-offset:-4px;'
                : opt.type === 'black' ? 'background:#111;'
                : 'background:url(' + opt.src + ') center/170% no-repeat;';
            btn.innerHTML = '<span class="dot" style="' + dotStyle + '"></span>';
            btn.addEventListener('click', function () {
                bgContainer.querySelectorAll('.color-swatch').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                activeBg = opt;
                syncBackFoil();
                applyBackground();
                decorGroup.children.forEach(clampDecor);
                updateRing();
            });
            bgContainer.appendChild(btn);
        });

        // Staklo materijal
        const glassMaterial = new THREE.MeshPhysicalMaterial({
            color: new THREE.Color(0.78, 0.92, 0.85),
            transparent: true,
            opacity: 0.15,
            roughness: 0.05,
            metalness: 0.0,
            side: THREE.DoubleSide,
            depthWrite: false
        });

        function isGlassMaterial(mat) {
            if (!mat) return false;
            const name = (mat.name || '').toLowerCase();
            return name.includes('glass') || name.includes('staklo');
        }

        // Terarijum se generise u browseru iz mera (mm). Lokalno: x = duzina, y = dubina (0 = napred), z = visina;
        // root skalira na metre i rotira u Y-up, pa su offseti poklopca u mm.
        let T_GLASS = 4; // terarijum je uvek 4 mm; kod akvarijuma debljinu odredjuje glassFor
        const T_FOIL = 0.3, TRACK = 10, TRACK_DEPTH = 14, DOOR_OVERLAP = 10, LID_FRAME = 112.5, LID_FRAME_RATIO = 0.225; // lajsne oko mrezice (sirina i udeo kod malih mera)
        const TOP_BAND_RATIO = 0.18, BOTTOM_BAND_RATIO = 0.135; // lajsne srazmerne visini: na 50cm su 9 i 6.75cm
        const TOP_BAND_MIN = 30, BOTTOM_BAND_MIN = 20;
        const LOGO_W = 50, LOGO_H = 20, LOGO_MARGIN = 15, LOGO_DEPTH = 2, LOGO_BEVEL = 2.5, LOGO_INNER_RADIUS = 0.1; // radijus ugla = bevel + unutrasnji
        const UV_SCALE = 1 / 1000, MESH_UV_SCALE = 1 / 20;
        const DIM_FIELDS = AQUA ? [
            { key: 'L', label: T.dims[0], min: 20, max: 200 },
            { key: 'W', label: T.dims[1], min: 15, max: 100 },
            { key: 'H', label: T.dims[2], min: 15, max: 120 }
        ] : [
            { key: 'L', label: T.dims[0], min: 30, max: 200 },
            { key: 'W', label: T.dims[1], min: 25, max: 100 },
            { key: 'H', label: T.dims[2], min: 25, max: 150 }
        ];
        const DEFAULT_DIMS = AQUA ? { L: 100, W: 40, H: 50 } : { L: 100, W: 50, H: 50 };
        let dims = Object.assign({}, DEFAULT_DIMS);
        const FILTER_SPOTS = ['none', 'left', 'right', 'back', 'backLeft', 'backRight'];
        const AQUA_FIELDS = AQUA ? [
            { tab: 'water', key: 'water', label: T.build.water[0], options: [['yes', T.build.water[1]], ['no', T.build.water[2]]] },
            { tab: 'water', key: 'waterGap', label: T.build.waterGap, number: [0, 500], when: function (b) { return b.water === 'yes'; } },
            { tab: 'water', key: 'filter', label: T.build.filter[0], options: FILTER_SPOTS.map(function (k, i) { return [k, T.build.filter[i + 1]]; }) },
            { tab: 'water', key: 'filterMm', label: T.build.filterMm, number: [50, 400], when: function (b) { return b.filter !== 'none'; } },
            { tab: 'water', key: 'filterFoil', label: T.build.filterFoil[0], options: [['no', T.build.filterFoil[1]], ['yes', T.build.filterFoil[2]]], when: function (b) { return b.filter !== 'none'; } },
            { tab: 'options', key: 'bottomFoil', label: T.build.bottomFoil[0], options: [['yes', T.build.bottomFoil[1]], ['no', T.build.bottomFoil[2]]] },
            { tab: 'lid', key: 'cover', label: T.build.cover[0], options: [['none', T.build.cover[1]], ['yes', T.build.cover[2]], ['double', T.build.cover[3]]] },
            { tab: 'lid', key: 'coverFoil', label: T.build.coverFoil[0], options: [['no', T.build.coverFoil[1]], ['yes', T.build.coverFoil[2]]], when: function (b) { return b.cover !== 'none'; } }
        ] : null;
        const BUILD_FIELDS = AQUA_FIELDS || [
            { tab: 'options', key: 'open', label: T.build.open[0], options: [['sliding', T.build.open[1]], ['top', T.build.open[2]]] },
            // lajsne napred po meri: gornja i donja iste, vrata se skracuju, a bocna folija prati
            { tab: 'options', key: 'band', label: T.build.band[0], options: [['std', T.build.band[1]], ['custom', T.build.band[2]]], when: function (b) { return b.open === 'sliding'; } },
            { tab: 'options', key: 'bandMm', label: T.build.bandMm, number: [30, 400], when: function (b) { return b.open === 'sliding' && b.band === 'custom'; } },
            // gornja folija uvek ostaje: pokriva silikon na nosacima poklopca
            { tab: 'options', key: 'bottomFoil', label: T.build.bottomFoil[0], options: [['yes', T.build.bottomFoil[1]], ['no', T.build.bottomFoil[2]]], when: function (b) { return b.open === 'top'; } },
            { tab: 'lid', key: 'lid', label: T.build.lid[0], options: [['one', T.build.lid[1]], ['two', T.build.lid[2]]] },
            // poklopac iz dva dela: zadnji deo je zicani, prednji stakleni; ostala pitanja o plafonu tada ne vaze
            { tab: 'lid', key: 'lidFront', label: T.build.lidFront[0], options: [['foil', T.build.lidFront[1]], ['glass', T.build.lidFront[2]]], when: function (b) { return b.lid === 'two'; } },
            { tab: 'lid', key: 'lidFrontMm', label: T.build.lidFrontMm, number: [50, 1000], when: function (b) { return b.lid === 'two'; } },
            // kad se terarijum otvara odozgo drska je uvek tu, pa se pita samo kod kliznih vrata
            { tab: 'lid', key: 'lidHandle', label: T.build.lidHandle[0], options: [['no', T.build.lidHandle[1]], ['yes', T.build.lidHandle[2]]], when: function (b) { return b.lid === 'two' && b.open === 'sliding'; } },
            { tab: 'vent', key: 'topVent', label: T.build.topVent[0], options: [['mesh', T.build.topVent[1]], ['plastic', T.build.topVent[2]]] },
            // broj cepova bira kupac; koliko staje odredjuju lidVentFit/sideVentFit, visak se odbacuje
            { tab: 'vent', key: 'lidCols', label: T.build.lidCols, number: [1, 8], step: 1, unit: '', when: function (b) { return b.topVent === 'plastic'; } },
            { tab: 'vent', key: 'lidRows', label: T.build.lidRows, number: [1, 4], step: 1, unit: '', when: function (b) { return b.topVent === 'plastic'; } },
            { tab: 'vent', key: 'sideVent', label: T.build.sideVent[0], options: [['none', T.build.sideVent[1]], ['plastic', T.build.sideVent[2]]] },
            { tab: 'vent', key: 'sideVentN', label: T.build.sideVentN, number: [1, 6], step: 1, unit: '', when: function (b) { return b.sideVent === 'plastic'; } },
            { tab: 'vent', key: 'ventColor', label: T.build.ventColor[0], options: [['black', T.build.ventColor[1]], ['white', T.build.ventColor[2]]], when: function (b) { return b.topVent === 'plastic' || b.sideVent === 'plastic'; } }
        ];
        const DEFAULT_BUILD = { open: 'sliding', band: 'std', bandMm: 80, bottomFoil: 'yes', lid: 'one', lidFront: 'foil', lidFrontMm: 150, lidHandle: 'no', topVent: 'mesh', lidCols: 4, lidRows: 2, sideVent: 'none', sideVentN: 2, ventColor: 'black' };
        // akvarijum nema klizna vrata: 'top' da zajednicke funkcije (unutrasnje mere, dekoracija) racunaju sa fiksnim prednjim staklom
        if (AQUA) Object.assign(DEFAULT_BUILD, { open: 'top', water: 'yes', waterGap: 30, filter: 'none', filterMm: 100, cover: 'yes', coverFoil: 'no', filterFoil: 'no' });
        const LID_GAP = 1; // razmak izmedju dva dela poklopca; 0.1 mm se na ekranu ne bi video
        let build = Object.assign({}, DEFAULT_BUILD);

        const foilMaterial = new THREE.MeshStandardMaterial({ name: 'Folija', roughness: 0.8, side: THREE.DoubleSide });
        panelMaterials.push(foilMaterial);
        const edgeMaterial = new THREE.MeshStandardMaterial({
            name: 'Ivica', color: new THREE.Color(0.18, 0.38, 0.30), transparent: true, opacity: 0.85, roughness: 0.1, side: THREE.DoubleSide
        });
        const trackMaterial = new THREE.MeshStandardMaterial({
            name: 'Profil', color: new THREE.Color(0.03, 0.03, 0.03), metalness: 0.2, roughness: 0.5, side: THREE.DoubleSide
        });
        const meshMaterial = new THREE.MeshStandardMaterial({
            name: 'Mrezica', map: meshTexture(), transparent: true, metalness: 0.6, roughness: 0.5, side: THREE.DoubleSide
        });
        const logoTexture = texLoader.load('/3d/logo-plocica.png');
        logoTexture.colorSpace = THREE.SRGBColorSpace;
        const logoMaterial = new THREE.MeshStandardMaterial({ name: 'Logo', map: logoTexture, roughness: 0.25 });
        const siliconeMaterial = new THREE.MeshStandardMaterial({ name: 'Silikon', roughness: 0.4, side: THREE.DoubleSide });
        const SILICONE_LOOKS = { black: { color: 0x080808, opacity: 1 }, clear: { color: 0xffffff, opacity: 0.6 } };
        let siliconeColor = 'black';
        function setSilicone(key) {
            siliconeColor = key;
            siliconeMaterial.color.setHex(SILICONE_LOOKS[key].color);
            siliconeMaterial.opacity = SILICONE_LOOKS[key].opacity;
            siliconeMaterial.transparent = SILICONE_LOOKS[key].opacity < 1;
            siliconeMaterial.needsUpdate = true;
            document.querySelectorAll('#silicone-options button').forEach(function (b) {
                const on = b.dataset.value === key;
                b.classList.toggle('active', on);
                b.setAttribute('aria-pressed', on);
            });
        }
        setSilicone('black');
        document.getElementById('silicone-options').addEventListener('click', function (e) {
            const b = e.target.closest('button');
            if (!b || b.dataset.value === siliconeColor) return;
            setSilicone(b.dataset.value);
            scheduleArExport();
            checkDirty();
        });
        const waterMaterial = new THREE.MeshPhysicalMaterial({
            name: 'Voda', color: 0x4fa9cf, transparent: true, opacity: 0.3, roughness: 0.05, metalness: 0, depthWrite: false
        });
        const partMaterials = { foil: foilMaterial, track: trackMaterial, mesh: meshMaterial, silicone: siliconeMaterial, water: waterMaterial };
        // cepovi postoje u crnoj i beloj plastici; rupe su uvek tamne
        const VENT_LOOKS = { black: { rim: 0x161616, face: '#2e2e2e', ring: '#4a4a4a' }, white: { rim: 0xe9e9e6, face: '#f1f1ee', ring: '#cfcfca' } };
        const ventMaterials = {};
        Object.keys(VENT_LOOKS).forEach(function (key) {
            const rim = new THREE.MeshStandardMaterial({ name: 'Ventilator obod', color: VENT_LOOKS[key].rim, roughness: 0.55 });
            const face = new THREE.MeshStandardMaterial({ name: 'Ventilator', map: ventTexture(VENT_LOOKS[key]), roughness: 0.6 });
            ventMaterials[key] = [rim, face, rim];
        });

        // sive zice, providna okca; jedan tile = 20mm (4 okca)
        function meshTexture() {
            const c = document.createElement('canvas');
            c.width = c.height = 64;
            const ctx = c.getContext('2d');
            ctx.fillStyle = '#aaaaaa';
            for (let i = 0; i < 4; i++) {
                ctx.fillRect(i * 16, 0, 3, 64);
                ctx.fillRect(0, i * 16, 64, 3);
            }
            const tex = new THREE.CanvasTexture(c);
            tex.colorSpace = THREE.SRGBColorSpace;
            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }

        function thinAxis(b) {
            const sizes = [b[1] - b[0], b[3] - b[2], b[5] - b[4]];
            return sizes.indexOf(Math.min.apply(null, sizes));
        }

        // lica kocke normalna na `axes`, ravne normale, planarni UV; b = [x0, x1, y0, y1, z0, z1]
        function boxFaces(out, b, offset, uvScale, axes) {
            const lo = [b[0] - offset[0], b[2] - offset[1], b[4] - offset[2]];
            const hi = [b[1] - offset[0], b[3] - offset[1], b[5] - offset[2]];
            axes.forEach(function (axis) {
                const a1 = (axis + 1) % 3, a2 = (axis + 2) % 3;
                [[-1, lo[axis]], [1, hi[axis]]].forEach(function (face) {
                    const sign = face[0], base = out.pos.length / 3;
                    const pts = [[lo[a1], lo[a2]], [hi[a1], lo[a2]], [hi[a1], hi[a2]], [lo[a1], hi[a2]]].map(function (c) {
                        const p = [0, 0, 0], n = [0, 0, 0];
                        p[axis] = face[1]; p[a1] = c[0]; p[a2] = c[1]; n[axis] = sign;
                        out.pos.push(p[0], p[1], p[2]);
                        out.nor.push(n[0], n[1], n[2]);
                        // u je uvek vodoravna osa (x, a na bocnim stranama y), da godovi folije idu isto na svim stranama
                        const u = axis === 1 ? c[1] + offset[a2] : c[0] + offset[a1], v = axis === 1 ? c[0] + offset[a1] : c[1] + offset[a2];
                        out.uv.push(u * uvScale, v * uvScale);
                        return p;
                    });
                    // (a1, a2, axis) je ciklicno => cross(e1, e2) ima samo komponentu po `axis`
                    const e1 = [0, 1, 2].map(function (k) { return pts[1][k] - pts[0][k]; });
                    const e2 = [0, 1, 2].map(function (k) { return pts[2][k] - pts[0][k]; });
                    const cross = e1[a1] * e2[a2] - e1[a2] * e2[a1];
                    (cross * sign > 0 ? [0, 1, 2, 0, 2, 3] : [0, 2, 1, 0, 3, 2]).forEach(function (t) { out.idx.push(base + t); });
                });
            });
        }

        function geometryOf(boxes, offset, uvScale, axesFor) {
            const out = { pos: [], nor: [], uv: [], idx: [] };
            boxes.forEach(function (b) { boxFaces(out, b, offset, uvScale, axesFor(b)); });
            const geo = new THREE.BufferGeometry();
            geo.setAttribute('position', new THREE.Float32BufferAttribute(out.pos, 3));
            geo.setAttribute('normal', new THREE.Float32BufferAttribute(out.nor, 3));
            geo.setAttribute('uv', new THREE.Float32BufferAttribute(out.uv, 2));
            geo.setIndex(out.idx);
            return geo;
        }

        // bez kliznih vrata nema sina, pa su trake folije duplo tanje (uz minimum da logo stane)
        function bands(H, c) {
            if (c.open === 'sliding' && c.band === 'custom') {
                // vratima ostaje bar 100 mm izmedju sina
                const v = Math.min(c.bandMm, (H - 2 * TRACK - 100) / 2);
                return { top: v, bottom: v };
            }
            if (c.open === 'sliding') return { top: H * TOP_BAND_RATIO, bottom: H * BOTTOM_BAND_RATIO };
            const top = Math.max(H * TOP_BAND_RATIO / 2, TOP_BAND_MIN);
            // kod duplog poklopca gornja folija ide do ispod donjeg stakla i njegovih nosaca, da ih sakrije
            return { top: c.cover === 'double' ? Math.max(top, H - lowCoverZ(H) + COVER_GLASS) : top, bottom: Math.max(H * BOTTOM_BAND_RATIO / 2, BOTTOM_BAND_MIN) };
        }

        // donja ivica prednjeg stakla: kod kliznih stoji na podu, bez njih ide do dna kao bocna
        function frontBottom(c) {
            return c.open === 'sliding' ? T_GLASS : 0;
        }

        // kod kliznih vrata bocne trake folije su za visinu sine sire od prednjih, da se crna sina ne vidi sa strane
        function sideBandGap(H, c) {
            const b = bands(H, c), extra = c.open === 'sliding' ? TRACK : 0;
            return [frontBottom(c) + b.bottom + extra, H - b.top - extra];
        }

        // crne vodilice: osnova + zidovi, izmedju zidova dva kanala (y 2-6 i 8-12) u koje upadaju vrata
        function trackBoxes(L, botTop, topBot) {
            const g = T_GLASS, half = TRACK / 2;
            const walls = [[0, 2], [2 + g, 8], [8 + g, TRACK_DEPTH]];
            const out = [[g, L - g, 0, TRACK_DEPTH, botTop, botTop + half], [g, L - g, 0, TRACK_DEPTH, topBot - half, topBot]];
            walls.forEach(function (w) {
                out.push([g, L - g, w[0], w[1], botTop + half, botTop + TRACK]);
                out.push([g, L - g, w[0], w[1], topBot - TRACK, topBot - half]);
            });
            return out;
        }

        // okrugli plasticni ventilator (crni obod + resetka), osa ide duz `dir` ('z' gore, '-x'/'+x' bocno)
        // mere po specifikaciji cepa: precnik 50 mm; od ukupno 4 mm debljine iznad povrsine viri samo lice, kopce ulaze u otvor
        const VENT_R = 25, VENT_H = 1.5;
        function vent(x, y, z, dir, color) {
            const geo = new THREE.CylinderGeometry(VENT_R, VENT_R, VENT_H, 40);
            const m = new THREE.Mesh(geo, ventMaterials[color]);
            if (dir === 'z') m.rotation.x = Math.PI / 2; // +Y cilindra -> +Z
            else m.rotation.z = dir === '-x' ? Math.PI / 2 : -Math.PI / 2;
            m.position.set(x, y, z);
            m.userData.noBounds = true;
            return m;
        }

        // izgled pravog cepa: mat crni disk, tanak uzdignut obod, rupe u sacastom (smaknutom) rasporedu na srednjih ~60% precnika
        function ventTexture(look) {
            const S = 256, R = S / 2, c = document.createElement('canvas');
            c.width = c.height = S;
            const ctx = c.getContext('2d');
            ctx.fillStyle = look.face;
            ctx.fillRect(0, 0, S, S);
            ctx.fillStyle = '#000';
            // po specifikaciji: rupe precnika 3 mm, razmak centara 5.5 mm, redovi 5-6-7-8-7-6-5 (R = 25 mm)
            const pitch = R * 5.5 / 25, hole = R * 1.5 / 25;
            for (let k = -3; k <= 3; k++) {
                const n = 8 - Math.abs(k);
                for (let i = 0; i < n; i++) {
                    ctx.beginPath(); ctx.arc(R + (i - (n - 1) / 2) * pitch, R + k * pitch * 0.866, hole, 0, Math.PI * 2); ctx.fill();
                }
            }
            ctx.strokeStyle = look.ring;
            ctx.lineWidth = 4;
            ctx.beginPath(); ctx.arc(R, R, R * 0.94, 0, Math.PI * 2); ctx.stroke();
            const tex = new THREE.CanvasTexture(c);
            tex.colorSpace = THREE.SRGBColorSpace;
            return tex;
        }

        // ventilatori u mrezi na punom poklopcu (40x40cm -> 3x3); napred ostaje mesta za dršku
        // najmanji razmak centara cepova; odatle koliko ih najvise staje
        const VENT_PITCH = 70;
        function ventFit(span) { return Math.max(1, Math.floor(span / VENT_PITCH)); }
        // mreza cepova na punom poklopcu, ravnomerno i centrirano; napred ostaje mesta za drsku
        // `from` = prednja ivica dela poklopca na kom su cepovi (kod poklopca iz dva dela to je zadnji deo)
        function lidVents(L, W, H, c, from) {
            const g = T_GLASS, front = from, back = W - g - 20;
            const cols = Math.min(c.lidCols, ventFit(L - 2 * g)), rows = Math.min(c.lidRows, ventFit(back - front));
            const out = [];
            for (let i = 0; i < cols; i++) {
                for (let j = 0; j < rows; j++) {
                    out.push(vent(g + (L - 2 * g) * (i + 0.5) / cols, front + (back - front) * (j + 0.5) / rows, H + T_FOIL + VENT_H / 2, 'z', c.ventColor));
                }
            }
            return out;
        }
        function sideVents(L, W, H, c) {
            const n = Math.min(c.sideVentN, ventFit(W - 40));
            const z = (sideBandGap(H, c)[1] + H) / 2, out = [];
            for (let i = 0; i < n; i++) {
                const y = 20 + (W - 40) * (i + 0.5) / n;
                out.push(vent(-T_FOIL - VENT_H / 2, y, z, '-x', c.ventColor), vent(L + T_FOIL + VENT_H / 2, y, z, '+x', c.ventColor));
            }
            return out;
        }

        // crni silikon na spojevima stakala; napred samo u visinama frontSpans (donja i gornja maska kod kliznih vrata, cela visina kod fiksnog stakla): unutrasnji ugaoni zavar (vidi se kroz staklo) + crne ivice stakla spolja
        const SILICONE = 6, JOINT = 1; // JOINT = debljina silikona u spoju stakla na staklo (mm)
        function siliconeBoxes(L, W, H, frontSpans, frontJoint) {
            const g = T_GLASS, f = T_FOIL, s = SILICONE, e = 0.2;
            const front = [], sideJointY0 = frontJoint ? g : e;
            frontSpans.forEach(function (z) { front.push([g, g + s, g, g + s, z[0], z[1]], [L - g - s, L - g, g, g + s, z[0], z[1]]); });
            // fiksno prednje staklo naleze preko ivica bocnih i poda isto kao ledja
            if (frontJoint) front.push([e, g - e, g - e, g + JOINT + e, e, H - e], [L - g + e, L - e, g - e, g + JOINT + e, e, H - e], [g - e, L - g + e, g - e, g + JOINT + e, e, g - e]);
            return front.concat([
                // ledja uz bocna stakla, celom visinom
                [g, g + s, W - g - s, W - g, g, H - g], [L - g - s, L - g, W - g - s, W - g, g, H - g],
                // pod uz bocna stakla i uz ledja
                [g, g + s, g, W - g, g, g + s], [L - g - s, L - g, g, W - g, g, g + s],
                [g, L - g, W - g - s, W - g, g, g + s],
                // pod uz prednje staklo/masku
                [g, L - g, g, g + s, g, g + s],
                // gornje ivice bocnih stakala i ledja oko poklopca
                [0, g, 0, W, H, H + f], [L - g, L, 0, W, H, H + f], [g, L - g, W - g, W, H, H + f],
                // zadnji uglovi spolja
                [-f, 0, W, W + f, 0, H], [L, L + f, W, W + f, 0, H],
                // ledja nalezu preko ivica bocnih stakala i poda: silikon ispunjava taj spoj.
                // Za `e` zalazi u staklo i uvucen je od spoljnih ivica, da nijedna strana ne bude u ravni sa staklom (z-fighting)
                [e, g - e, W - g - JOINT - e, W - g + e, e, H - e], [L - g + e, L - e, W - g - JOINT - e, W - g + e, e, H - e],
                [g - e, L - g + e, W - g - JOINT - e, W - g + e, e, g - e],
                // pod stoji izmedju bocnih stakala: i taj spoj je uvek ispunjen silikonom
                [g - e, g + JOINT + e, sideJointY0, W - g, e, g - e], [L - g - JOINT - e, L - g + e, sideJointY0, W - g, e, g - e]
            ]);
        }

        // poklopac lezi unutra na staklenim nosacima: traka stakla zalepljena pljostimice uz zid (uspravno), duga 75% stranice,
        // na sve cetiri strane; poklopac stoji na njenoj gornjoj ivici od 4 mm
        const LEDGE_H = 20, LEDGE_RATIO = 0.75, LEDGE_GLUE = 1;
        // vraca [x0, x1, y0, y1] trake debljine `w`, odmaknute `off` od svakog zida
        function ledgeRects(L, W, w, off) {
            const g = T_GLASS + off, lx = (L - 2 * T_GLASS) * LEDGE_RATIO, ly = (W - 2 * T_GLASS) * LEDGE_RATIO;
            const x0 = (L - lx) / 2, y0 = (W - ly) / 2;
            return [[x0, x0 + lx, g, g + w], [x0, x0 + lx, W - g - w, W - g], [g, g + w, y0, y0 + ly], [L - g - w, L - g, y0, y0 + ly]];
        }

        // Debljina stakla akvarijuma: zid kao ploca oslonjena na tri ivice pod pritiskom vode, faktor sigurnosti 3.8
        // (ista formula kao u javnim kalkulatorima; koeficijent zavisi od odnosa duzina/visina). Zaokruzuje se na staklo koje radionica ima.
        // shortcut: dno je iste debljine kao zidovi (racuna se da lezi celom povrsinom na podlozi), zameniti kad stignu stvarne debljine iz radionice
        const GLASS_STOCK = [4, 6, 8, 10, 12], GLASS_SAFETY = 3.8, GLASS_STRENGTH = 19.2;
        const GLASS_K = [[0.5, 0.085], [0.666, 0.1156], [1, 0.16], [1.5, 0.26], [2, 0.32], [2.5, 0.35], [3, 0.37]];
        function glassFor(d) {
            const H = d.H * 10, ratio = Math.max(d.L, d.W) * 10 / H;
            let k = GLASS_K[GLASS_K.length - 1][1];
            if (ratio <= GLASS_K[0][0]) k = GLASS_K[0][1];
            for (let i = 1; i < GLASS_K.length; i++) {
                const a = GLASS_K[i - 1], b = GLASS_K[i];
                if (ratio >= a[0] && ratio <= b[0]) k = a[1] + (b[1] - a[1]) * (ratio - a[0]) / (b[0] - a[0]);
            }
            const need = Math.sqrt(k * H * H * H * 1e-5 / (GLASS_STRENGTH / GLASS_SAFETY));
            const mm = GLASS_STOCK.find(function (t) { return t >= need - 0.05; });
            return { need: need, mm: mm || GLASS_STOCK[GLASS_STOCK.length - 1], over: !mm };
