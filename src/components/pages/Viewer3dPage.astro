        scene.add(new THREE.DirectionalLight(0xffffff, 0.3).translateY(-2000));

        // Dezeni folije: 34 folije koje radionica ima, redom kao u njihovom spisku (broj + naziv); kvadratne teksture koje se ponavljaju
        const texLoader = new THREE.TextureLoader();
        const basePath = '/3d/folije/';
        const FOILS = ['bela', 'crna-drvo', 'belo-drvo', 'grafit', 'sivo-drvo', 'svetlosivo-drvo', 'vintage-natpis', 'svetli-bor', 'med-hrast', 'rustic-hrast', 'tamni-grafit', 'zlatno-drvo', 'tamni-mahagoni', 'smedje-sivo', 'rustic-orah', 'bordo-drvo', 'tamni-orah', 'chevron', 'belo-patinirano', 'krem', 'beli-hrast', 'bez-drvo', 'plavo-beli-vintage', 'bele-daske', 'platno', 'sivi-hrast', 'taupe-drvo', 'prirodni-hrast', 'patchwork', 'zlatni-hrast', 'crvenkasto-drvo', 'srednji-orah', 'prugasti-orah', 'topli-orah'];
        const woodTextures = FOILS.map(function (slug, i) {
            const num = String(i + 1).padStart(2, '0'), label = slug.replace(/-/g, ' ');
            return { id: slug, name: num + ' ' + label.charAt(0).toUpperCase() + label.slice(1), preview: basePath + num + '-' + slug + '-t.jpg', file: basePath + num + '-' + slug + '.jpg' };
        });
        const DEFAULT_WOOD = woodTextures.find(function (w) { return w.id === 'rustic-hrast'; });

        // Mapa se ucitava tek kad se dezen prvi put izabere
        function ensureWoodLoaded(w) {
