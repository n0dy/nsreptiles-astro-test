---
import { twoTone } from '../../lib/two-tone';
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../config/site';
import { localizePath, translationsFor } from '../../i18n/routes';
import { VIEWER_3D } from '../../i18n/pages/viewer-3d';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = VIEWER_3D[lang];
const path = localizePath('/3d.html', lang);
---
<Base
  lang={lang}
  {...t.meta}
  path={path}
  image="/style/img/terrariums/90x45x45.webp"
  bodyClass="viewer-3d-page"
  floatContact={false}
  translations={translationsFor(path)}
>
<section class="page-head" style="--ph-img: url(/style/img/izrada/terarijum.webp); --ph-img-sm: url(/style/img/izrada/terarijum.webp)">
      <div class="wrap">
        <h1 set:html={twoTone(t.h1)} />
        <p>{t.lead}</p>
      </div>
    </section>
<div id="viewer-page">
        <div id="viewer-wrap">
            <div id="loading">{t.loading}</div>
            <div id="hint"></div>
            <script is:inline define:vars={{ hintTouch: t.hintTouch, hintDesktop: t.hintDesktop }}>
                document.getElementById('hint').textContent = window.innerWidth <= 1000
                    ? hintTouch
                    : hintDesktop;
            </script>

            <button id="lid-button" title={t.lid}>
                <svg class="lid-closed" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="6" width="20" height="2.5" rx="0.5" />
                    <rect x="3" y="8.5" width="18" height="12" rx="1" />
                    <line x1="9" y1="8.5" x2="9" y2="20.5" opacity="0.3" />
                    <line x1="15" y1="8.5" x2="15" y2="20.5" opacity="0.3" />
                </svg>
                <svg class="lid-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="2.5" rx="0.5" />
                    <rect x="3" y="10" width="18" height="12" rx="1" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                    <line x1="9" y1="10" x2="9" y2="22" opacity="0.3" />
                    <line x1="15" y1="10" x2="15" y2="22" opacity="0.3" />
                </svg>
            </button>

            <button id="help-button" title={t.help}>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </button>

            <div id="help-overlay">
                <div id="help-popup">
                    <h2>{t.helpTitle}</h2>
                    <div class="help-item">
                        <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                                <path
                                    d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                                <circle cx="12" cy="13" r="4" />
                            </svg></div>
                        <div class="help-text">
                            <h4>{t.helpShot.title}</h4>
                            <p>{t.helpShot.text}</p>
                        </div>
                    </div>
                    <div class="help-item">
                        <div class="help-icon green"><svg viewBox="0 0 24 24" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M12 3l9 4.5v9L12 21l-9-4.5v-9L12 3z" />
                                <path d="M12 12l9-4.5" />
                                <path d="M12 12v9" />
                                <path d="M12 12L3 7.5" />
                            </svg></div>
                        <div class="help-text">
                            <h4>{t.helpAr.title}</h4>
                            <p>{t.helpAr.text}</p>
                        </div>
                    </div>
                    <div class="help-item">
                        <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" />
                                <path d="M9 3v18" />
                                <path d="M15 3v18" />
                            </svg></div>
                        <div class="help-text">
                            <h4>{t.helpDoors.title}</h4>
                            <p>{t.helpDoors.text}</p>
                        </div>
                    </div>
                    <div class="help-item">
                        <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2" fill="none">
                                <rect x="2" y="6" width="20" height="2.5" rx="0.5" />
                                <rect x="3" y="8.5" width="18" height="12" rx="1" />
                                <line x1="9" y1="8.5" x2="9" y2="20.5" opacity="0.3" />
                                <line x1="15" y1="8.5" x2="15" y2="20.5" opacity="0.3" />
                            </svg></div>
                        <div class="help-text">
                            <h4>{t.helpLid.title}</h4>
                            <p>{t.helpLid.text}</p>
                        </div>
                    </div>
                    <div class="help-item">
                        <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10" />
                            </svg></div>
                        <div class="help-text">
                            <h4>{t.helpTexture.title}</h4>
                            <p>{t.helpTexture.text}</p>
                        </div>
                    </div>
                    <button id="help-close">{t.close}</button>
                </div>
            </div>

            <div id="screenshot-flash"></div>

            <!-- Skriveni model-viewer za AR -->
            <model-viewer id="ar-model" ar ar-modes="webxr scene-viewer quick-look"
                ar-scale="auto" camera-controls alt={t.modelAlt}></model-viewer>

            <div id="viewer-actions">
                <button id="screenshot-button" title={t.shot}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                        <circle cx="12" cy="13" r="4" />
                    </svg>
                </button>
                <button id="ar-button" class="hidden" title={t.ar}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l9 4.5v9L12 21l-9-4.5v-9L12 3z" />
                        <path d="M12 12l9-4.5" />
                        <path d="M12 12v9" />
                        <path d="M12 12L3 7.5" />
                    </svg>
                </button>
            </div>
        </div>

        <div id="panel">
            <button id="reset-button" title={t.reset}>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 4 1 10 7 10" />
                    <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" />
                </svg>
            </button>
            <div class="panel-header">
                <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <path d="M9 3v18" />
                        <path d="M15 3v18" />
                    </svg></div>
                <h3>{t.doors}</h3>
            </div>
            <div class="door-controls">
                <div class="door-control">
                    <div class="door-header">
                        <span>{t.leftGlass}</span>
                        <span class="door-value" id="door-left-value">0%</span>
                    </div>
                    <input type="range" id="door-left-slider" min="0" max="100" value="0">
                </div>
                <div class="door-control">
                    <div class="door-header">
                        <span>{t.rightGlass}</span>
                        <span class="door-value" id="door-right-value">0%</span>
                    </div>
                    <input type="range" id="door-right-slider" min="0" max="100" value="0" style="direction:rtl">
                </div>
            </div>

            <hr class="panel-divider">

            <div class="panel-header">
                <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="7" cy="8" r="2.5" />
                        <circle cx="17" cy="8" r="2.5" />
                        <circle cx="12" cy="16" r="2.5" />
                    </svg></div>
                <h3>{t.build}</h3>
            </div>
            <div id="build-options"></div>

            <hr class="panel-divider">

            <div class="panel-header">
                <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10" />
                    </svg></div>
                <h3>{t.texture}</h3>
            </div>
            <div class="color-grid" id="color-options"></div>

            <hr class="panel-divider">

            <div class="panel-header">
                <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <path d="M3 16l5-5 4 4 3-3 6 6" />
                    </svg></div>
                <h3>{t.background}</h3>
            </div>
            <div class="color-grid" id="bg-options"></div>

            <hr class="panel-divider">

            <div class="panel-header">
                <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 20h18" />
                        <path d="M6 20c0-4 2-7 5-7s5 3 5 7" />
                        <path d="M12 13V5" />
                        <path d="M12 9c2-3 5-3 6-2" />
                    </svg></div>
                <h3>{t.decor}</h3>
            </div>
            <span class="opt-row-label">{t.substrate}</span>
            <div class="color-grid" id="substrate-options"></div>
            <div class="door-control substrate-depth" id="substrate-depth-row" hidden>
                <div class="door-header">
                    <span>{t.substrateDepth}</span>
                    <span class="door-value" id="substrate-depth-value">4 cm</span>
                </div>
                <input type="range" id="substrate-depth" min="2" max="10" step="1" value="4" aria-label={t.substrateDepthAria}>
            </div>
            <span class="opt-row-label decor-label">{t.fromOffer}</span>
            <div class="decor-grid" id="decor-options"></div>
            <div class="decor-selected" id="decor-selected" hidden>
                <div class="decor-selected-head">
                    <span id="decor-selected-name"></span>
                    <button type="button" id="decor-remove" title={t.removeTitle}>{t.remove}</button>
                </div>
                <div class="door-header">
                    <span>{t.angle}</span>
                    <span class="door-value" id="decor-angle-value">0°</span>
                </div>
                <input type="range" id="decor-angle" min="0" max="359" step="1" value="0" aria-label={t.angleAria}>
            </div>
            <p class="dim-hint decor-hint">{t.decorHint}</p>

            <hr class="panel-divider">

            <div class="panel-header">
                <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10H3M21 6H3M21 14H3M21 18H3" />
                    </svg></div>
                <h3>{t.dimensions}</h3>
            </div>
            <div class="dimensions-info" id="dimensions-info"></div>
        </div>
    </div>
<style is:global>
#viewer-page {
display: flex;
width: 100%;
height: calc(100vh - 80px);
background-color: #fff;
}

#viewer-wrap {
position: relative;
flex: 7;
background: #e8e8e8;
overflow: hidden;
}

#viewer-wrap canvas {
display: block;
width: 100%;
height: 100%;
}

#loading {
position: absolute;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
font-size: 16px;
z-index: 20;
background: rgba(0, 0, 0, 0.8);
color: #fff;
padding: 16px 32px;
border-radius: 10px;
width: max-content;
font-family: 'Poppins', 'Jost Variable', sans-serif;
}

/* Panel */
#panel {
flex: 3;
background: #fff;
border-left: 1px solid #e5e5e5;
padding: 28px 22px;
overflow-y: auto;
display: none;
position: relative;
}

#panel h3 {
font-size: 12px;
margin: 0;
color: #666;
text-transform: uppercase;
letter-spacing: 1.5px;
font-weight: 700;
font-family: "Oswald", sans-serif;
}

#panel label {
font-size: 13px;
color: #555;
display: block;
margin-bottom: 4px;
}

#panel input[type="range"] {
width: 100%;
accent-color: #4aa584;
margin-bottom: 8px;
}

.panel-divider {
border: none;
border-top: 1px solid #e0e0e0;
margin: 16px 0;
}

/* Door controls */
.door-controls {
display: flex;
flex-direction: row;
gap: 10px;
}

.door-control {
flex: 1;
background: #f8f8f8;
border-radius: 12px;
padding: 10px 12px 8px;
border: 1px solid #eee;
}

.door-header {
display: flex;
align-items: center;
gap: 6px;
margin-bottom: 6px;
}

.door-header span {
font-size: 13px;
color: #555;
}

.door-value {
margin-left: auto;
font-weight: 600;
color: #4aa584;
font-size: 12px;
}

.door-control input[type="range"] {
-webkit-appearance: none;
appearance: none;
width: 100%;
height: 24px;
margin: 0;
background: transparent;
cursor: pointer;
touch-action: none;
}

.door-control input[type="range"]::-webkit-slider-runnable-track {
height: 6px;
border-radius: 3px;
background: #4aa584;
}

.door-control input[type="range"]::-webkit-slider-thumb {
-webkit-appearance: none;
width: 18px;
height: 18px;
border-radius: 50%;
background: #fff;
border: 2px solid #4aa584;
box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
margin-top: -6px;
transition: transform 0.15s, box-shadow 0.15s;
}

.door-control input[type="range"]::-webkit-slider-thumb:active {
transform: scale(1.15);
box-shadow: 0 2px 8px rgba(15, 143, 99, 0.3);
}

.door-control input[type="range"]::-moz-range-track {
height: 6px;
border-radius: 3px;
background: #4aa584;
border: none;
}

.door-control input[type="range"]::-moz-range-thumb {
width: 18px;
height: 18px;
border-radius: 50%;
background: #fff;
border: 2px solid #4aa584;
box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
}

/* Poklopac toggle */
.lid-control {
display: flex;
align-items: center;
justify-content: space-between;
padding: 12px;
}

.lid-control span {
font-size: 13px;
color: #555;
}

.lid-toggle {
position: relative;
width: 48px;
height: 26px;
display: block;
cursor: pointer;
}

.lid-toggle input {
opacity: 0;
width: 0;
height: 0;
position: absolute;
}

.lid-track {
position: absolute;
top: 0;
left: 0;
right: 0;
bottom: 0;
background: #ddd;
border-radius: 13px;
transition: background 0.25s;
}

.lid-track:before {
content: "";
position: absolute;
width: 20px;
height: 20px;
left: 3px;
top: 3px;
background: #fff;
border-radius: 50%;
box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
transition: transform 0.25s;
}

.lid-toggle input:checked + .lid-track {
background: #4aa584;
}

.lid-toggle input:checked + .lid-track:before {
transform: translateX(22px);
}

/* Boje */
.color-grid {
display: flex;
flex-wrap: wrap;
gap: 6px;
}

.color-swatch {
width: 44px;
height: 44px;
border-radius: 10px;
border: 2px solid transparent;
cursor: pointer;
transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
padding: 0;
background: none;
position: relative;
}

.color-swatch:hover {
transform: scale(1.08);
border-color: #4aa584;
}

.color-swatch.active {
border-color: #4aa584;
}

.color-swatch .dot {
width: 100%;
height: 100%;
border-radius: 8px;
display: block;
}

.color-name {
font-size: 12px;
color: #888;
text-align: center;
margin-top: 4px;
display: block;
}

/* Reset dugme */
#reset-button {
position: absolute;
top: 10px;
right: 10px;
width: 20px;
height: 20px;
border-radius: 50%;
border: none;
background: #f0f0f0;
color: #999;
cursor: pointer;
display: none;
align-items: center;
justify-content: center;
transition: background 0.2s, color 0.2s, transform 0.15s;
}

#reset-button:hover {
background: #e0e0e0;
color: #555;
transform: scale(1.1);
}

#reset-button.visible {
display: flex;
}

/* Dimenzije */
.dimensions-info {
margin-top: 6px;
display: flex;
flex-wrap: wrap;
gap: 8px;
}

.dim-item {
flex: 1;
background: #f8f8f8;
border-radius: 10px;
border: 1px solid #eee;
padding: 8px;
text-align: center;
}

.dim-label {
display: block;
font-size: 12px;
color: #999;
text-transform: uppercase;
letter-spacing: 0.5px;
}

.dim-value {
display: block;
font-size: 15px;
font-weight: 700;
color: #333;
margin-top: 2px;
}

.opt-row {
margin-top: 10px;
}

.opt-row-label {
display: block;
font-size: 12px;
color: #666;
margin-bottom: 6px;
}

.opt-seg {
display: flex;
gap: 6px;
}

.opt-seg button {
flex: 1;
padding: 9px 6px;
font: inherit;
font-size: 12px;
color: #555;
background: #f8f8f8;
border: 1px solid #eee;
border-radius: 10px;
cursor: pointer;
transition: border-color 0.2s, background 0.2s, color 0.2s;
}

.opt-seg button:hover {
border-color: #cfe6dc;
}

.opt-seg button.active {
border-color: #4aa584;
background: #eef7f3;
color: #2f7d62;
font-weight: 600;
}

.opt-seg button:focus-visible {
outline: 2px solid #3a9d7a;
outline-offset: 2px;
}

.substrate-depth {
margin-top: 10px;
}

.decor-label {
margin-top: 14px;
}

.decor-grid {
display: flex;
flex-wrap: wrap;
gap: 6px;
}

.decor-grid button,
.decor-selected button {
padding: 7px 10px;
font: inherit;
font-size: 12px;
color: #555;
background: #f8f8f8;
border: 1px solid #eee;
border-radius: 10px;
cursor: pointer;
transition: border-color 0.2s, background 0.2s;
}

.decor-grid button:hover,
.decor-selected button:hover {
border-color: #4aa584;
background: #eef7f3;
}

.decor-grid button:disabled {
opacity: 0.5;
cursor: progress;
}

.decor-grid button:focus-visible,
.decor-selected button:focus-visible {
outline: 2px solid #3a9d7a;
outline-offset: 2px;
}

.decor-selected-head {
display: flex;
align-items: center;
gap: 6px;
margin-bottom: 8px;
}

.decor-selected {
margin-top: 10px;
padding: 8px 10px;
background: #eef7f3;
border: 1px solid #cfe6dc;
border-radius: 10px;
font-size: 12px;
color: #2f7d62;
font-weight: 600;
}

.decor-selected-head span {
margin-right: auto;
}

.decor-hint {
margin-top: 8px;
text-align: left;
}

[hidden] {
display: none !important;
}

.dim-input {
width: 3.2em;
font: inherit;
color: inherit;
text-align: center;
background: transparent;
border: none;
border-bottom: 1px dashed #bbb;
padding: 0;
-moz-appearance: textfield;
}

.dim-input::-webkit-inner-spin-button,
.dim-input::-webkit-outer-spin-button {
-webkit-appearance: none;
margin: 0;
}

.dim-input:focus {
outline: 2px solid #3a9d7a;
outline-offset: 2px;
border-bottom-color: transparent;
}

.dim-hint {
flex-basis: 100%;
margin: 2px 0 0;
font-size: 12px;
color: #666;
text-align: center;
}

.dim-unit {
font-size: 12px;
color: #999;
font-weight: 400;
}

/* Info hint */
#hint {
position: absolute;
top: 16px;
left: 50%;
transform: translateX(-50%);
background: rgba(0, 0, 0, 0.6);
color: #fff;
padding: 8px 18px;
border-radius: 20px;
font-size: 12px;
z-index: 10;
pointer-events: none;
transition: opacity 0.5s;
width: fit-content;
height: fit-content;
text-align: center;
}

/* Viewer action dugmad - dole desno */
#viewer-actions {
position: absolute;
bottom: 16px;
right: 16px;
z-index: 15;
display: flex;
gap: 8px;
}

#viewer-actions button {
width: 36px;
height: 36px;
border-radius: 50%;
cursor: pointer;
display: flex;
align-items: center;
justify-content: center;
transition: transform 0.15s, color 0.2s, box-shadow 0.2s;
}

#viewer-actions button:active {
transform: scale(0.95);
}

#screenshot-button {
background: rgba(255, 255, 255, 0.95);
color: #555;
border: none;
box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

#screenshot-button:hover {
transform: scale(1.1);
color: #4aa584;
}

#ar-button {
background: var(--green-btn);
color: #fff;
border: none;
