                return [0, 1, 2].filter(function (a) { return a !== thinAxis(b); });
            }), edgeMaterial);
            faces.userData.noBounds = edges.userData.noBounds = !!noBounds;
            return [faces, edges];
        }

        // gabarit tela terarijuma, bez dodataka (drska, ventilatori, logo) - po njemu idu centriranje i pozadina
        function bodyBox(object) {
            object.updateMatrixWorld(true);
            const box = new THREE.Box3();
            object.traverse(function (o) {
                if (!o.isMesh || o.userData.noBounds) return;
                if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
                box.union(o.geometry.boundingBox.clone().applyMatrix4(o.matrixWorld));
            });
            return box;
        }

        function buildTerrarium(d, c) {
            const L = d.L * 10, W = d.W * 10, H = d.H * 10;
            const root = new THREE.Group();
            root.name = (AQUA ? 'Akvarijum ' : 'Terarijum ') + d.L + 'x' + d.W + 'x' + d.H + ' staklo';
            root.rotation.x = -Math.PI / 2;
            root.scale.setScalar(0.001);
            root.userData.sideBandGap = sideBandGap(H, c);
            (AQUA ? aquariumParts : parts)(L, W, H, c).forEach(function (part) {
                const node = new THREE.Group();
                const t = part.t || [0, 0, 0];
                node.name = part.name;
                node.position.fromArray(t);
                if (part.glass) glassMeshes(part.glass, t).forEach(function (m) { node.add(m); });
                ['foil', 'track', 'mesh', 'silicone', 'water'].forEach(function (key) {
                    if (!part[key]) return;
                    const geo = geometryOf(part[key], t, key === 'mesh' ? MESH_UV_SCALE : UV_SCALE, function () { return [0, 1, 2]; });
                    node.add(new THREE.Mesh(geo, partMaterials[key]));
                });
                (part.extra || []).forEach(function (o) {
                    o.position.x -= t[0]; o.position.y -= t[1]; o.position.z -= t[2];
                    node.add(o);
                });
                root.add(node);
            });
            root.add(logoMesh(H, bands(H, c).top, c.open === 'sliding' ? T_GLASS : -T_FOIL));
            const object = new THREE.Group();
            object.add(root);
            return object;
        }

        let terrarium = null, lidClosed = true;
        // naslov, slajderi i razdelnik sekcije Vrata; skriveni kad nema kliznih vrata
        const doorControls = document.querySelector('.door-controls');
        const doorHeader = doorControls.previousElementSibling;
        const doorSection = [doorHeader.previousElementSibling, doorHeader, doorControls]; // razdelnik je iznad naslova (vrata su poslednja u tabu)
        const leftSlider = document.getElementById('door-left-slider');
        const rightSlider = document.getElementById('door-right-slider');
        const lidButton = document.getElementById('lid-button');

        function updateDoors() {
            const lv = parseInt(leftSlider.value) / 100;
            const rv = parseInt(rightSlider.value) / 100;
            if (doorLeft) doorLeft.position.copy(doorLeftStart).addScaledVector(slideDir, doorSlideDistance * lv);
            if (doorRight) doorRight.position.copy(doorRightStart).addScaledVector(slideDir, -doorSlideDistance * rv);
            document.getElementById('door-left-value').textContent = leftSlider.value + '%';
            document.getElementById('door-right-value').textContent = rightSlider.value + '%';
        }
        leftSlider.addEventListener('input', updateDoors);
        rightSlider.addEventListener('input', updateDoors);

        function updateLid() {
            if (!lid) return;
            if (lidClosed) lid.position.copy(lidStartPos);
            else lid.position.set(lidStartPos.x, lidStartPos.y + 150, lidStartPos.z + 250);
            lidButton.classList.toggle('open', !lidClosed);
        }
        lidButton.addEventListener('click', function () {
            lidClosed = !lidClosed;
            updateLid();
        });

        function updateAquaStats() {
            const glass = glassFor(dims), l = aquariumLiters(dims, build), round = function (v) { return Math.round(v); };
            const cell = function (value, label) { return '<div><strong>' + value + '</strong>' + label + '</div>'; };
            document.getElementById('aqua-stats').innerHTML =
                cell(glass.mm + ' mm', T.stats.glass) + cell(round(l.total) + ' L', T.stats.total) +
                cell(build.water === 'yes' ? round(l.water) + ' L' : '–', T.stats.water) +
                (build.water === 'yes' && l.filter ? '<p>' + T.stats.filter.replace('{n}', round(l.filter)) + '</p>' : '') +
                (glass.over ? '<p class="warn">' + T.stats.over.replace('{n}', glass.need.toFixed(1)) + '</p>' : '');
        }

        function syncBackFoil() {
            if (!terrarium) return;
            terrarium.traverse(function (o) { if (o.name === BACK_FOIL_NAME) o.visible = activeBg.type === 'none'; });
        }

        function cameraHome(maxDim) {
            // pocetni pogled: spreda-levo i malo odozgo (oko 35 stepeni ulevo, 20 stepeni iznad);
            // uzak/uspravan pogled (telefon) vidi manje u sirinu, pa se kamera odmice da model stane
            const aspect = camera.aspect > 0 ? camera.aspect : 1.5; // 0/0 dok je wrap jos skriven
            const k = maxDim * Math.max(1, 1 / aspect);
            camera.position.set(-0.94 * k, 0.6 * k, 1.35 * k);
            controls.target.set(0, 0, 0);
            controls.update();
        }

        function setupTerrarium() {
            if (terrarium) {
                scene.remove(terrarium);
                terrarium.traverse(function (o) { if (o.isMesh) o.geometry.dispose(); });
            }
            if (AQUA) {
                T_GLASS = glassFor(dims).mm;
                GLASS_M = T_GLASS / 1000;
            }
            const object = buildTerrarium(dims, build);
            doorLeft = doorRight = lid = null;
            object.traverse(function (child) {
                if (child.isMesh) {
                    // staklo i silikon ne bacaju senku: providni su, a slojevi na 0.3 mm jedan od drugog bi sencili jedan drugi
                    child.castShadow = [glassMaterial, edgeMaterial, siliconeMaterial, waterMaterial].indexOf(child.material) === -1;
                    child.receiveShadow = true;
                }
                const name = child.name.toLowerCase();
                if (name.includes('prednje staklo (l)')) doorLeft = child;
                if (name.includes('prednje staklo (d)')) doorRight = child;
                if (name.includes('poklopac')) lid = child;
            });

            const box = bodyBox(object);
            const size = box.getSize(new THREE.Vector3());
            object.position.sub(box.getCenter(new THREE.Vector3()));
            scene.add(object);
            terrarium = object;
            const resized = !modelSize || !modelSize.equals(size);
            modelSize = size.clone();
            object.updateMatrixWorld(true);
            const modelRoot = object.children[0];
            sideGapY = modelRoot.userData.sideBandGap.map(function (z) { return modelRoot.localToWorld(new THREE.Vector3(0, 0, z)).y; });

            const maxDim = Math.max(size.x, size.y, size.z);
            const sc = dirLight1.shadow.camera;
            sc.left = sc.bottom = -maxDim; sc.right = sc.top = maxDim;
            sc.updateProjectionMatrix();
            controls.minDistance = maxDim * 0.3;
            controls.maxDistance = maxDim * 5;
            // promena izvedbe ne dira pogled; kamera se vraca na pocetni samo kad se promeni velicina terarijuma
            if (resized) cameraHome(maxDim);

            const sliding = !!(doorLeft && doorRight);
            doorSection.forEach(function (el) { el.hidden = !sliding; });
            if (sliding) {
                doorLeftStart.copy(doorLeft.position);
                doorRightStart.copy(doorRight.position);
                slideDir.copy(doorRightStart).sub(doorLeftStart).normalize();
                doorSlideDistance = doorRightStart.distanceTo(doorLeftStart);
            }
            updateDoors();
            lidButton.style.display = lid ? '' : 'none'; // akvarijum bez pokrivnog stakla nema sta da se otvara
            if (lid) lidStartPos.copy(lid.position);
            updateLid();
            if (AQUA) updateAquaStats();

            syncBackFoil();
            applyBackground();
            // supstrat ostaje najmanje 2 cm ispod gornje ivice donje lajsne, da se ne vidi kroz vrata i ne ispada
            // shortcut: kad je lajsna preniska (fiksno prednje staklo), ostaje 1 cm supstrata iako to krsi razmak
            const maxCm = AQUA ? Math.max(2, Math.min(15, Math.floor(dims.H / 4)))
                : Math.max(1, Math.floor((frontBottom(build) + bands(dims.H * 10, build).bottom - T_GLASS - SUBSTRATE_CLEARANCE) / 10));
            substrateDepth.max = maxCm;
            substrateDepth.min = Math.min(2, maxCm);
            if (substrate.cm > maxCm) {
                substrate.cm = maxCm;
                substrateDepth.value = maxCm;
                document.getElementById('substrate-depth-value').textContent = maxCm + ' ' + T.unit;
            }
            updateSubstrate();
            updateRing();
            scheduleArExport();
        }

        // Dimenzije: unos u cm, model se pravi ponovo
        const dimContainer = document.getElementById('dimensions-info');
        dimContainer.innerHTML = DIM_FIELDS.map(function (f) {
            return '<label class="dim-item"><span class="dim-label">' + f.label + '</span><span class="dim-value">' +
                '<input type="number" class="dim-input" data-dim="' + f.key + '" min="' + f.min + '" max="' + f.max +
                '" step="1" inputmode="numeric" value="' + dims[f.key] + '" aria-label="' + f.label + T.inUnit + ' (' + f.min + '-' + f.max + ')">' +
                ' <span class="dim-unit">' + T.unit + '</span></span></label>';
        }).join('') + '<p class="dim-hint">' + DIM_FIELDS.map(function (f) { return f.label + ' ' + f.min + '-' + f.max; }).join(' · ') + ' ' + T.unit + '</p>';

        // polja izvedbe su rasporedjena po tabovima (build-options, build-lid, build-vent), a osluskuju se na celom panelu
        const buildContainer = document.getElementById('panel');
        BUILD_FIELDS.forEach(function (f) {
            const row = document.createElement('div');
            row.className = 'opt-row';
            row.dataset.key = f.key;
            if (f.number) {
                row.innerHTML = '<label class="opt-row-label opt-num"><span>' + f.label + '</span><span class="opt-num-box"><input type="number" class="dim-input" data-key="' + f.key +
                    '" min="' + f.number[0] + '" max="' + f.number[1] + '" step="' + (f.step || 10) + '" inputmode="numeric" value="' + build[f.key] + '"> ' + (f.unit === undefined ? 'mm' : f.unit) + '</span></label>';
                document.getElementById('build-' + f.tab).appendChild(row);
                return;
            }
            row.innerHTML = '<span class="opt-row-label" id="opt-' + f.key + '">' + f.label + '</span>' +
                '<div class="opt-seg" role="group" aria-labelledby="opt-' + f.key + '">' + f.options.map(function (o) {
                    return '<button type="button" data-key="' + f.key + '" data-value="' + o[0] + '" aria-pressed="' + (build[f.key] === o[0]) + '"' +
                        (build[f.key] === o[0] ? ' class="active"' : '') + '>' + o[1] + '</button>';
                }).join('') + '</div>';
            document.getElementById('build-' + f.tab).appendChild(row);
        });
        function syncBuildButtons() {
            buildContainer.querySelectorAll('button[data-key]').forEach(function (b) {
                const on = build[b.dataset.key] === b.dataset.value;
                b.classList.toggle('active', on);
                b.setAttribute('aria-pressed', on);
            });
            buildContainer.querySelectorAll('input[data-key]').forEach(function (i) { i.value = build[i.dataset.key]; });
            BUILD_FIELDS.forEach(function (f) {
                if (f.when) buildContainer.querySelector('.opt-row[data-key="' + f.key + '"]').hidden = !f.when(build);
            });
        }
        syncBuildButtons();
        buildContainer.addEventListener('change', function (e) {
            const i = e.target.closest('input[data-key]');
            if (!i) return;
            const v = Math.min(Number(i.max), Math.max(Number(i.min), (i.value.trim() === "" || isNaN(i.value) ? DEFAULT_BUILD[i.dataset.key] : Math.round(Number(i.value)))));
            build = Object.assign({}, build, { [i.dataset.key]: v });
            syncBuildButtons();
            setupTerrarium();
            checkDirty();
        });
        buildContainer.addEventListener('click', function (e) {
            const b = e.target.closest('button[data-key]');
            if (!b || build[b.dataset.key] === b.dataset.value) return;
            build = Object.assign({}, build, { [b.dataset.key]: b.dataset.value });
            syncBuildButtons();
            setupTerrarium();
            checkDirty();
        });

        let dimTimer = null;
        function applyDim(input, clamp) {
            const f = DIM_FIELDS.find(function (x) { return x.key === input.dataset.dim; });
            let v = Math.round(parseFloat(input.value));
            if (isNaN(v)) v = dims[f.key];
            if (!clamp && (v < f.min || v > f.max)) return;
            v = Math.min(f.max, Math.max(f.min, v));
            if (clamp) input.value = v;
            if (v === dims[f.key]) return;
            dims = Object.assign({}, dims, { [f.key]: v });
            setupTerrarium();
            checkDirty();
        }
        dimContainer.querySelectorAll('.dim-input').forEach(function (input) {
            input.addEventListener('input', function () {
                clearTimeout(dimTimer);
                dimTimer = setTimeout(function () { applyDim(input, false); }, 400);
            });
            input.addEventListener('change', function () {
                clearTimeout(dimTimer);
                applyDim(input, true);
            });
        });

        function setDims(d) {
            dims = Object.assign({}, d);
            dimContainer.querySelectorAll('.dim-input').forEach(function (input) { input.value = dims[input.dataset.dim]; });
            setupTerrarium();
        }



        // Resize
        window.addEventListener('resize', function () {
            camera.aspect = wrap.clientWidth / wrap.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(wrap.clientWidth, wrap.clientHeight);
        });

        // Screenshot dugme
        const screenshotBtn = document.getElementById('screenshot-button');
        const flash = document.getElementById('screenshot-flash');

        screenshotBtn.addEventListener('click', function () {
            // Renderuj frame pre screenshot-a
            renderer.render(scene, camera);

            // Flash efekat
            flash.classList.add('flash');
            setTimeout(function () { flash.classList.remove('flash'); }, 150);

            // Uzmi sliku sa canvas-a
            const dataUrl = renderer.domElement.toDataURL('image/png');

            // Kreiraj download link
            const link = document.createElement('a');
            link.download = T.download;
            link.href = dataUrl;
            link.click();
        });

// Dekoracija: supstrat na dnu + 3D modeli (CC0, Poly Haven) koji se prevlace po dnu
        const SUBSTRATES = [
            { key: 'none', name: T.substrates[0] },
            { key: 'pesak', name: T.substrates[1] },
            { key: 'treset', name: T.substrates[2] }
        ];
        const SUBSTRATE_TILE = 0.3; // jedan tile teksture = 30cm
        const DEFAULT_SUBSTRATE_CM = 4;
        const SUBSTRATE_CLEARANCE = 20; // mm
        const DECOR_ITEMS = [
            // nasi proizvodi; id = slug iz nsreptiles-astro oprema, size = najveca mera u m.
            // Model: scripts/photo_lathe_model.py (okrugle, od fotografije) ili scripts/object-capture/make-model.sh (fotogrametrija)
            // shortcut: precnik 15 cm je pretpostavka sa fotografije, zameniti stvarnom merom
            { id: 'posuda-godovi-drveta', name: T.decor[0], size: 0.15 },
            { id: 'skrivalica-pecina', name: T.decor[1], size: 0.2 }
        ];
        const decorLoader = new GLTFLoader();
        const decorCache = {}; // id -> Promise<Object3D> normalizovan model (dno na y=0, centriran)
        const decorGroup = new THREE.Group();
        scene.add(decorGroup);
        let substrate = { type: 'none', cm: DEFAULT_SUBSTRATE_CM }, substrateMesh = null, selectedDecor = null;

        // unutrasnjost terarijuma u svetskim koordinatama (m); front je +z
        function innerBounds() {
            const frontInset = build.open === 'sliding' ? TRACK_DEPTH / 1000 + 0.002 : GLASS_M;
            const backInset = GLASS_M + (activeBg.type === 'relief' ? BG_RELIEF_DEPTH * 0.6 : 0);
            return {
                x0: -modelSize.x / 2 + GLASS_M, x1: modelSize.x / 2 - GLASS_M,
                z0: -modelSize.z / 2 + backInset, z1: modelSize.z / 2 - frontInset,
                floor: -modelSize.y / 2 + GLASS_M
            };
        }

        function surfaceY() {
            return innerBounds().floor + (substrate.type === 'none' ? 0 : substrate.cm / 100);
        }

        function substrateMaps(key) {
            const p = '/3d/supstrat/' + key + '/';
            const maps = { map: texLoader.load(p + 'color.jpg'), normalMap: texLoader.load(p + 'normal.jpg'), roughnessMap: texLoader.load(p + 'roughness.jpg') };
            maps.map.colorSpace = THREE.SRGBColorSpace;
            maps.map.userData.mimeType = 'image/jpeg';
            Object.values(maps).forEach(function (t) { t.wrapS = t.wrapT = THREE.RepeatWrapping; });
            return maps;
        }
        const substrateTex = {};

        function updateSubstrate() {
            if (substrateMesh) {
                scene.remove(substrateMesh);
                substrateMesh.children.forEach(function (m) { m.geometry.dispose(); });
                substrateMesh.children[0].material.dispose();
                substrateMesh = null;
            }
            if (substrate.type !== 'none' && modelSize) {
                const b = innerBounds(), h = substrate.cm / 100;
                if (!substrateTex[substrate.type]) substrateTex[substrate.type] = substrateMaps(substrate.type);
                const material = new THREE.MeshStandardMaterial(Object.assign({ roughness: 1 }, substrateTex[substrate.type]));
                // dno supstrata je 0.5 mm iznad stakla poda: u istoj ravni dve povrsine trepere (z-fighting) kad se gleda odozdo
                const LIFT = 0.0005;
                substrateMesh = new THREE.Group();
                // ide do zadnjeg stakla i ispod pozadine, spreda do prednjeg stakla; u akvarijumu zaobilazi komoru filtera
                substrateRects(dims.L * 10, dims.W * 10, build).forEach(function (r) {
                    const w = (r[1] - r[0]) / 1000 - 0.001, d = (r[3] - r[2]) / 1000 - 0.001;
                    const geo = new THREE.BoxGeometry(w, h - LIFT, d), uv = geo.attributes.uv;
                    for (let i = 0; i < uv.count; i++) uv.setXY(i, uv.getX(i) * w / SUBSTRATE_TILE, uv.getY(i) * d / SUBSTRATE_TILE);
                    const m = new THREE.Mesh(geo, material);
                    m.position.set((r[0] + r[1]) / 2000 - modelSize.x / 2, b.floor + LIFT + (h - LIFT) / 2, modelSize.z / 2 - (r[2] + r[3]) / 2000);
                    m.receiveShadow = true;
                    substrateMesh.add(m);
                });
                scene.add(substrateMesh);
            }
            decorGroup.children.forEach(clampDecor);
        }

        function loadDecor(item) {
            if (!decorCache[item.id]) {
                const raw = decorLoader.loadAsync('/3d/dekor/' + item.id + '/' + item.id + '.glb').then(function (g) { return g.scene; });
                decorCache[item.id] = raw.then(function (obj) {
                    // normalizacija: najveca dimenzija = item.size, dno na y=0, centar u xz
                    const box = new THREE.Box3().setFromObject(obj);
                    const sz = box.getSize(new THREE.Vector3());
                    const k = item.size / Math.max(sz.x, sz.y, sz.z);
                    obj.scale.setScalar(k);
                    const c = box.getCenter(new THREE.Vector3());
                    obj.position.set(-c.x * k, -box.min.y * k, -c.z * k);
                    obj.traverse(function (o) { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });
                    const pivot = new THREE.Group();
                    pivot.add(obj);
                    return pivot;
                });
            }
            return decorCache[item.id];
        }

        // drzi dekoraciju unutar terarijuma; ako je veca od unutrasnjosti, smanji je
        function clampDecor(o) {
            if (!modelSize) return;
            const b = innerBounds();
            o.scale.setScalar(1);
            o.updateMatrixWorld(true);
            const sz = new THREE.Box3().setFromObject(o).getSize(new THREE.Vector3());
            const fit = Math.min(1, (b.x1 - b.x0) * 0.9 / sz.x, (b.z1 - b.z0) * 0.9 / sz.z, (modelSize.y - 2 * GLASS_M) * 0.8 / sz.y);
            o.scale.setScalar(fit);
            const rx = sz.x * fit / 2, rz = sz.z * fit / 2;
            o.position.x = THREE.MathUtils.clamp(o.position.x, b.x0 + rx, b.x1 - rx);
            o.position.z = THREE.MathUtils.clamp(o.position.z, b.z0 + rz, b.z1 - rz);
            o.position.y = surfaceY();
        }

        async function addDecor(item) {
            let proto;
            try {
                proto = await loadDecor(item);
            } catch (e) {
                delete decorCache[item.id];
                console.error('Dekoracija nije ucitana:', item.id, e);
                return;
            }
            const o = proto.clone();
            o.userData.decor = item;
            const b = innerBounds();
            // svaka nova malo pomerena da ne upadnu jedna u drugu
            const n = decorGroup.children.length;
            o.position.set((b.x0 + b.x1) / 2 + ((n % 5) - 2) * 0.08, 0, (b.z0 + b.z1) / 2);
            o.rotation.y = Math.random() * Math.PI * 2;
            decorGroup.add(o);
            clampDecor(o);
            selectDecor(o);
            scheduleArExport();
            checkDirty();
        }

        const decorTools = document.getElementById('decor-selected');
        const selectionRing = new THREE.Mesh(new THREE.RingGeometry(0.86, 1, 64), new THREE.MeshBasicMaterial({ color: 0x4aa584, side: THREE.DoubleSide }));
        selectionRing.rotation.x = -Math.PI / 2;
        selectionRing.visible = false;
        scene.add(selectionRing);

        // spisak dodate dekoracije u panelu: klik oznacava komad, isto kao klik na njega u terarijumu
        const decorList = document.getElementById('decor-list');
        function renderDecorList() {
            decorList.textContent = '';
            decorGroup.children.forEach(function (o, i) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = (i + 1) + '. ' + o.userData.decor.name;
                btn.setAttribute('aria-pressed', o === selectedDecor);
                btn.addEventListener('click', function () { selectDecor(o === selectedDecor ? null : o); });
                decorList.appendChild(btn);
            });
            document.getElementById('decor-added').hidden = decorGroup.children.length === 0;
        }

        function selectDecor(o) {
            selectedDecor = o;
            renderDecorList();
            decorTools.hidden = !o;
            selectionRing.visible = !!o;
            if (o) {
                document.getElementById('decor-selected-name').textContent = o.userData.decor.name;
                updateRing();
                syncAngle();
            }
        }

        function updateRing() {
            if (!selectedDecor) return;
            const sz = new THREE.Box3().setFromObject(selectedDecor).getSize(new THREE.Vector3());
            const r = Math.max(sz.x, sz.z) / 2 + 0.01;
            selectionRing.scale.set(r, r, 1);
            selectionRing.position.set(selectedDecor.position.x, selectedDecor.position.y + 0.002, selectedDecor.position.z);
        }

        function removeDecor(o) {
            decorGroup.remove(o);
            selectDecor(selectedDecor === o ? null : selectedDecor);
            scheduleArExport();
            checkDirty();
        }

        const angleInput = document.getElementById('decor-angle');
        const TAU = Math.PI * 2;

        function syncAngle() {
            if (!selectedDecor) return;
            const deg = Math.round(THREE.MathUtils.radToDeg(((selectedDecor.rotation.y % TAU) + TAU) % TAU)) % 360;
            angleInput.value = deg;
            document.getElementById('decor-angle-value').textContent = deg + '°';
        }

        function setDecorAngle(o, rad) {
            o.rotation.y = rad;
            clampDecor(o);
            updateRing();
            syncAngle();
        }

        function rotateDecor(o) {
            setDecorAngle(o, o.rotation.y + Math.PI / 4);
            scheduleArExport();
        }

        function clearDecor() {
            decorGroup.clear();
            selectDecor(null);
        }

        // prevlacenje: capture na omotacu da OrbitControls ne krene da rotira kameru
        const raycaster = new THREE.Raycaster(), pointer = new THREE.Vector2();
        const dragPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0), dragHit = new THREE.Vector3(), dragOffset = new THREE.Vector3();
        let dragging = null, rotating = false, rotStart = 0, rotPointer = 0;

        function pointerAngle(o) {
            return Math.atan2(dragHit.x - o.position.x, dragHit.z - o.position.z);
        }

        function setPointer(e) {
            const r = renderer.domElement.getBoundingClientRect();
            pointer.set((e.clientX - r.left) / r.width * 2 - 1, -(e.clientY - r.top) / r.height * 2 + 1);
            raycaster.setFromCamera(pointer, camera);
        }

        function decorRoot(obj) {
            while (obj && obj.parent !== decorGroup) obj = obj.parent;
            return obj;
        }

        renderer.domElement.parentElement.addEventListener('pointerdown', function (e) {
            if (e.target !== renderer.domElement || e.button !== 0 || !decorGroup.children.length) return;
            setPointer(e);
            // zeleni prsten oko izabrane dekoracije je rucka za okretanje
            const onRing = selectedDecor && selectionRing.visible && raycaster.intersectObject(selectionRing).length > 0;
            const hit = onRing ? null : raycaster.intersectObjects(decorGroup.children, true)[0];
            if (!onRing && !hit) { selectDecor(null); return; }
            const o = onRing ? selectedDecor : decorRoot(hit.object);
            selectDecor(o);
            dragPlane.constant = -o.position.y;
            if (!raycaster.ray.intersectPlane(dragPlane, dragHit)) return;
            dragOffset.copy(o.position).sub(dragHit);
            rotating = onRing;
            rotStart = o.rotation.y;
            rotPointer = pointerAngle(o);
            dragging = o;
            controls.enabled = false;
            try { renderer.domElement.setPointerCapture(e.pointerId); } catch (err) { /* pointer vec otpusten */ }
            e.stopPropagation();
        }, true);

        renderer.domElement.addEventListener('pointermove', function (e) {
            if (!dragging) return;
            setPointer(e);
            if (!raycaster.ray.intersectPlane(dragPlane, dragHit)) return;
            if (rotating) {
                setDecorAngle(dragging, rotStart + pointerAngle(dragging) - rotPointer);
                return;
            }
            dragging.position.x = dragHit.x + dragOffset.x;
            dragging.position.z = dragHit.z + dragOffset.z;
            clampDecor(dragging);
            updateRing();
        });

        function endDrag() {
            if (!dragging) return;
            dragging = null;
            controls.enabled = true;
            scheduleArExport();
        }
        renderer.domElement.addEventListener('pointerup', endDrag);
        renderer.domElement.addEventListener('pointercancel', endDrag);

        window.addEventListener('keydown', function (e) {
            if (!selectedDecor || /input|textarea/i.test(document.activeElement.tagName)) return;
            if (e.key === 'Delete' || e.key === 'Backspace') { removeDecor(selectedDecor); e.preventDefault(); }
            else if (e.key === 'r' || e.key === 'R') rotateDecor(selectedDecor);
            else if (e.key === 'Escape') selectDecor(null);
        });
        angleInput.addEventListener('input', function () { if (selectedDecor) setDecorAngle(selectedDecor, THREE.MathUtils.degToRad(parseInt(angleInput.value))); });
        angleInput.addEventListener('change', scheduleArExport);
        document.getElementById('decor-remove').addEventListener('click', function () { if (selectedDecor) removeDecor(selectedDecor); });

        // UI: supstrat
        const substrateContainer = document.getElementById('substrate-options');
        const substrateDepth = document.getElementById('substrate-depth');
        const substrateDepthRow = document.getElementById('substrate-depth-row');
        SUBSTRATES.forEach(function (opt, i) {
            const btn = document.createElement('button');
            btn.className = 'color-swatch' + (i === 0 ? ' active' : '');
            btn.title = opt.name;
            btn.setAttribute('aria-label', opt.name);
            btn.dataset.substrate = opt.key;
            const dotStyle = opt.key === 'none' ? 'background:#fff;outline:1px dashed #bbb;outline-offset:-4px;'
                : 'background:url(/3d/supstrat/' + opt.key + '/thumb.jpg) center/cover;';
            btn.innerHTML = '<span class="dot" style="' + dotStyle + '"></span>';
            btn.addEventListener('click', function () { setSubstrate(opt.key, substrate.cm); });
            substrateContainer.appendChild(btn);
        });

        function setSubstrate(type, cm) {
            substrate = { type: type, cm: cm };
            substrateContainer.querySelectorAll('.color-swatch').forEach(function (b) { b.classList.toggle('active', b.dataset.substrate === type); });
            substrateDepth.value = cm;
            document.getElementById('substrate-depth-value').textContent = cm + ' ' + T.unit;
            substrateDepthRow.hidden = type === 'none';
            updateSubstrate();
            updateRing();
            scheduleArExport();
            checkDirty();
        }
        substrateDepth.addEventListener('input', function () { setSubstrate(substrate.type, parseInt(substrateDepth.value)); });

        // UI: dekoracije
        const decorContainer = document.getElementById('decor-options');
        DECOR_ITEMS.forEach(function (item) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = '+ ' + item.name;
            btn.addEventListener('click', function () {
                btn.disabled = true;
                addDecor(item).finally(function () { btn.disabled = false; });
            });
            decorContainer.appendChild(btn);
        });

        // AR: model-viewer dobija GLB izvezen iz trenutnog terarijuma (mere + izabrana folija)
        const arButton = document.getElementById('ar-button');
        const arModel = document.getElementById('ar-model');
        // model-viewer i GLTFExporter (oko 4 s rada procesora) stizu tek na prvi dodir, i samo na uredjajima sa ekranom na dodir - AR ionako radi samo tamo
        let exporter = null;
        let arExportTimer = null, arUrl = null, arExportId = 0;

        async function initAR() {
            try {
                const mods = await Promise.all([
                    import('three/addons/exporters/GLTFExporter.js'),
                    import('https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js'),
                ]);
                exporter = new mods[0].GLTFExporter();
                exportForAR();
            } catch (e) {
                console.error('AR nije ucitan:', e);
            }
        }
        if (navigator.maxTouchPoints > 0) {
            ['pointerdown', 'keydown', 'scroll'].forEach(function (ev) {
                window.addEventListener(ev, function once() {
                    if (!initAR.started) { initAR.started = true; initAR(); }
                }, { once: true, passive: true });
            });
        }

        function scheduleArExport() {
            syncUrl();
            if (!exporter) return;
            clearTimeout(arExportTimer);
            arExportTimer = setTimeout(exportForAR, 600);
        }

        async function exportForAR() {
            const id = ++arExportId;
            await activeWood.ready;
            if (id !== arExportId || !terrarium || !exporter) return;
            // AR dobija samo color mapu drveta, kao i ranije (manji fajl)
            const arFoil = new THREE.MeshStandardMaterial({ name: 'Folija', map: activeWood.colorMap, roughness: 1, metalness: 0 });
            const copy = new THREE.Group();
            copy.add(terrarium.clone(), decorGroup.clone());
            if (substrateMesh) copy.add(substrateMesh.clone());
            copy.traverse(function (o) { if (o.isMesh && o.material === foilMaterial) o.material = arFoil; });
            try {
                const glb = await exporter.parseAsync(copy, { binary: true, maxTextureSize: 1024 });
                if (id !== arExportId) return;
                if (arUrl) URL.revokeObjectURL(arUrl);
                arUrl = URL.createObjectURL(new Blob([glb], { type: 'model/gltf-binary' }));
                arModel.src = arUrl;
            } catch (e) {
                console.error('AR izvoz nije uspeo:', e);
            } finally {
                arFoil.dispose();
            }
        }

        // Proveri da li uredjaj podrzava AR
        arModel.addEventListener('load', function () {
            if (arModel.canActivateAR) {
                arButton.classList.remove('hidden');
            }
        });

        // prva stvarna izmena u panelu (ne ucitavanje iz linka): koliko posetilaca zaista koristi konfigurator
        ['input', 'click'].forEach(function (type) {
            document.getElementById('panel').addEventListener(type, function once(e) {
                if (window.__cfgUsed || !e.target.closest('input, button, .color-swatch, [data-value]')) return;
                window.__cfgUsed = true;
                window.gtag('event', 'konfigurator_3d', { tip: AQUA ? 'akvarijum' : 'terarijum' });
            });
        });
        // GA4: pocetak koriscenja, promena po vrsti opcije i prva rotacija - svaki najvise jednom po strani
        const TIP_3D = AQUA ? 'akvarijum' : 'terarijum';
        let cfgStarted = false;
        function cfgStart() {
            if (cfgStarted) return;
            cfgStarted = true;
            window.gtag('event', 'konfigurator_start', { tip: TIP_3D });
        }
        ['pointerdown', 'wheel', 'keydown'].forEach(function (type) {
            renderer.domElement.addEventListener(type, function (e) { if (e.isTrusted) cfgStart(); }, { passive: true });
        });
        let cfgRotated = false;
        controls.addEventListener('start', function () {
            cfgStart();
            if (cfgRotated) return;
            cfgRotated = true;
            window.gtag('event', 'konfigurator_rotacija', { tip: TIP_3D });
        });
        const FIELD_TAB_OPTION = { water: 'voda', lid: 'poklopac', vent: 'ventilacija', options: 'izvedba' };
        const PANEL_OPTIONS = [
            ['#dimensions-info', 'dimenzije'], ['#color-options', 'folija'], ['#bg-options', 'pozadina'],
            ['#silicone-options', 'silikon'], ['.door-controls', 'vrata'],
            ['#substrate-options, #substrate-depth-row', 'supstrat'], ['.panel-tab[data-tab="decor"]', 'dekoracija']
        ];
        function panelOption(el) {
            const row = el.closest('.opt-row[data-key]');
            if (row) {
                const field = BUILD_FIELDS.find(function (f) { return f.key === row.dataset.key; });
                if (field) return FIELD_TAB_OPTION[field.tab] || field.tab;
            }
            const hit = PANEL_OPTIONS.find(function (o) { return el.closest(o[0]); });
            return hit ? hit[1] : null;
        }
        const cfgSent = {};
        ['input', 'click'].forEach(function (type) {
            document.getElementById('panel').addEventListener(type, function (e) {
                if (!e.isTrusted) return;
                cfgStart();
                const el = e.target.closest('input, button, select, .color-swatch, [data-value]');
                const opcija = el && panelOption(el);
                if (!opcija || cfgSent[opcija]) return;
                cfgSent[opcija] = true;
                window.gtag('event', 'konfigurator_promena', { tip: TIP_3D, opcija: opcija });
            });
        });

        screenshotBtn.addEventListener('click', function () {
            window.gtag('event', 'slika_3d', { tip: TIP_3D });
            window.gtag('event', 'konfigurator_deljenje', { tip: TIP_3D });
        });

        arButton.addEventListener('click', function () {
            window.gtag('event', 'ar_3d', { tip: AQUA ? 'akvarijum' : 'terarijum' });
            if (arModel.canActivateAR) arModel.activateAR();
        });

        // Prati izmene - prikaži reset kad je nešto promenjeno
        var resetBtn = document.getElementById('reset-button');
        function checkDirty() {
            var ls = document.getElementById('door-left-slider');
            var rs = document.getElementById('door-right-slider');
            var lidBtn = document.getElementById('lid-button');
            var firstSwatch = colorContainer.children[colorOptions.indexOf(DEFAULT_WOOD)];
            var dirty = parseInt(ls.value) !== 0 ||
                parseInt(rs.value) !== 0 ||
                lidBtn.classList.contains('open') ||
                (firstSwatch && !firstSwatch.classList.contains('active')) ||
                activeBg !== bgOptions[0] || siliconeColor !== 'black' ||
                DIM_FIELDS.some(function (f) { return dims[f.key] !== DEFAULT_DIMS[f.key]; }) ||
                BUILD_FIELDS.some(function (f) { return build[f.key] !== DEFAULT_BUILD[f.key]; }) ||
                substrate.type !== 'none' || decorGroup.children.length > 0;
            resetBtn.classList.toggle('visible', dirty);
            syncUrl();
        }

        document.getElementById('door-left-slider').addEventListener('input', function () { checkDirty(); });
        document.getElementById('door-right-slider').addEventListener('input', function () { checkDirty(); });
        document.getElementById('lid-button').addEventListener('click', function () { setTimeout(checkDirty, 50); });
        document.querySelectorAll('.color-swatch').forEach(function (s) {
            s.addEventListener('click', function () { setTimeout(checkDirty, 50); });
        });

        // Reset
        resetBtn.addEventListener('click', function () {
            var ls = document.getElementById('door-left-slider');
            var rs = document.getElementById('door-right-slider');
            ls.value = 0; rs.value = 0;
            ls.dispatchEvent(new Event('input'));
            var lidBtn = document.getElementById('lid-button');
            if (lidBtn.classList.contains('open')) lidBtn.click();
            var firstSwatch = colorContainer.children[colorOptions.indexOf(DEFAULT_WOOD)];
            if (firstSwatch && !firstSwatch.classList.contains('active')) firstSwatch.click();
            if (activeBg !== bgOptions[0]) bgContainer.firstChild.click();
            setSilicone('black');
            clearDecor();
            if (substrate.type !== 'none' || substrate.cm !== DEFAULT_SUBSTRATE_CM) setSubstrate('none', DEFAULT_SUBSTRATE_CM);
            const buildChanged = BUILD_FIELDS.some(function (f) { return build[f.key] !== DEFAULT_BUILD[f.key]; });
            build = Object.assign({}, DEFAULT_BUILD);
            syncBuildButtons();
            if (buildChanged || DIM_FIELDS.some(function (f) { return dims[f.key] !== DEFAULT_DIMS[f.key]; })) setDims(DEFAULT_DIMS);
            cameraHome(Math.max(modelSize.x, modelSize.y, modelSize.z));
            resetBtn.classList.remove('visible');
        });

        // Help popup
        var helpOverlay = document.getElementById('help-overlay');
        document.getElementById('help-button').addEventListener('click', function () {
            helpOverlay.classList.add('open');
        });
        document.getElementById('help-close').addEventListener('click', function () {
            helpOverlay.classList.remove('open');
        });
        helpOverlay.addEventListener('click', function (e) {
            if (e.target === helpOverlay) helpOverlay.classList.remove('open');
        });

        // Stanje konfiguratora zivi u URL-u (samo ono sto odstupa od podrazumevanog), da se konfiguracija moze poslati linkom.
        // Sve sto dodje iz URL-a prolazi kroz iste granice i spiskove dozvoljenih vrednosti kao i unos u panelu.
        let urlReady = false;
        const URL_DECOR_MAX = 20;
        // Poruci: parametri modela i link ka njemu idu u poruku na kontakt formi
        function orderMessage() {
            const O = T.order, lines = [O.dims + ': ' + DIM_FIELDS.map(function (f) { return dims[f.key]; }).join(' x ') + ' ' + T.unit];
            BUILD_FIELDS.forEach(function (f) {
                if (f.when && !f.when(build)) return;
                const opt = f.options && f.options.find(function (o) { return o[0] === build[f.key]; });
                lines.push(f.label + ': ' + (opt ? opt[1] : build[f.key] + (f.unit === undefined ? ' mm' : f.unit)));
            });
            lines.push(O.foil + ': ' + activeWood.name, O.silicone[0] + ': ' + O.silicone[siliconeColor === 'black' ? 1 : 2], O.bg + ': ' + activeBg.name);
            const sub = SUBSTRATES.find(function (o) { return o.key === substrate.type; });
            lines.push(O.substrate + ': ' + sub.name + (substrate.type === 'none' ? '' : ' ' + substrate.cm + ' ' + T.unit));
            if (decorGroup.children.length) lines.push(O.decor + ': ' + decorGroup.children.map(function (o) { return o.userData.decor.name; }).join(', '));
            return O.intro + '\n' + lines.map(function (l) { return '- ' + l; }).join('\n') + '\n\n' + O.link + ': ' + location.href;
        }
        document.getElementById('order-button').addEventListener('click', function () {
            syncUrl();
            window.gtag('event', 'poruci_3d', {
                tip: AQUA ? 'akvarijum' : 'terarijum',
                dimenzije: DIM_FIELDS.map(function (f) { return dims[f.key]; }).join('x'),
                folija: activeWood.name
            });
            location.href = T.order.contact + '?poruka=' + encodeURIComponent(orderMessage());
        });

        function syncUrl() {
            if (!urlReady) return;
            const q = new URLSearchParams();
            // u adresi su uvek svi parametri, i pocetni: link tako opisuje ceo model i ne zavisi od toga sta su nam podrazumevane vrednosti
            DIM_FIELDS.forEach(function (f) { q.set(f.key.toLowerCase(), dims[f.key]); });
            BUILD_FIELDS.forEach(function (f) {
                if (!f.when || f.when(build)) q.set(f.key, build[f.key]);
            });
            q.set('foil', activeWood.id);
            q.set('sil', siliconeColor);
            q.set('bg', bgOptions.indexOf(activeBg));
            q.set('sub', substrate.type);
            if (substrate.type !== 'none') q.set('subcm', substrate.cm);
            if (decorGroup.children.length) {
                q.set('decor', decorGroup.children.map(function (o) {
                    const deg = Math.round(THREE.MathUtils.radToDeg(((o.rotation.y % TAU) + TAU) % TAU)) % 360;
                    return [o.userData.decor.id, Math.round(o.position.x * 1000), Math.round(o.position.z * 1000), deg].join('.');
                }).join('_'));
            }
            const qs = q.toString();
            history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
        }

        const urlState = new URLSearchParams(location.search);
        function clampInt(text, min, max, fallback) {
            const v = parseInt(text, 10);
            return isNaN(v) ? fallback : Math.min(max, Math.max(min, v));
        }
        // dimenzije i izvedba pre prve izgradnje modela, da se ne gradi dvaput
        (function readUrlBuild() {
            const d = {}, b = {};
            DIM_FIELDS.forEach(function (f) { d[f.key] = clampInt(urlState.get(f.key.toLowerCase()), f.min, f.max, dims[f.key]); });
            BUILD_FIELDS.forEach(function (f) {
                const v = urlState.get(f.key);
                if (f.number) b[f.key] = clampInt(v, f.number[0], f.number[1], build[f.key]);
                else b[f.key] = f.options.some(function (o) { return o[0] === v; }) ? v : build[f.key];
            });
            dims = Object.assign({}, dims, d);
            build = Object.assign({}, build, b);
            syncBuildButtons();
            dimContainer.querySelectorAll('.dim-input').forEach(function (input) { input.value = dims[input.dataset.dim]; });
        })();

        async function readUrlLook() {
            const foil = colorOptions.findIndex(function (o) { return o.id === urlState.get('foil'); });
            if (foil >= 0) colorContainer.children[foil].click();
            if (urlState.get('sil') === 'clear') setSilicone('clear');
            const bg = parseInt(urlState.get('bg'), 10);
            if (bg > 0 && bg < bgOptions.length) bgContainer.children[bg].click();
            const sub = urlState.get('sub');
            if (sub !== 'none' && SUBSTRATES.some(function (x) { return x.key === sub; })) {
                setSubstrate(sub, clampInt(urlState.get('subcm'), Number(substrateDepth.min), Number(substrateDepth.max), Math.min(DEFAULT_SUBSTRATE_CM, Number(substrateDepth.max))));
            }
            const tokens = (urlState.get('decor') || '').split('_').filter(Boolean).slice(0, URL_DECOR_MAX);
            for (const token of tokens) {
                const part = token.split('.');
                const item = DECOR_ITEMS.find(function (x) { return x.id === part[0]; });
                if (!item) continue;
                const before = decorGroup.children.length;
                await addDecor(item);
                const o = decorGroup.children[before];
                if (!o) continue;
                // clampDecor u setDecorAngle vraca komad u terarijum ako je pozicija iz URL-a van njega
                o.position.x = clampInt(part[1], -5000, 5000, Math.round(o.position.x * 1000)) / 1000;
                o.position.z = clampInt(part[2], -5000, 5000, Math.round(o.position.z * 1000)) / 1000;
                setDecorAngle(o, THREE.MathUtils.degToRad(clampInt(part[3], 0, 359, 0)));
            }
            if (tokens.length) selectDecor(null);
        }

        setupTerrarium();
        applyOption(DEFAULT_WOOD);
        readUrlLook().catch(function (e) { console.error('Stanje iz URL-a nije ucitano:', e); }).then(function () {
            urlReady = true;
            syncUrl();
            checkDirty();
        });
        document.getElementById('loading').style.display = 'none';

        // Resize nakon sto panel postane vidljiv
        setTimeout(function () {
            camera.aspect = wrap.clientWidth / wrap.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(wrap.clientWidth, wrap.clientHeight);
        }, 0);

        // Sakrij hint posle 5s
        setTimeout(function () {
            const hint = document.getElementById('hint');
            if (hint) hint.style.opacity = '0';
            setTimeout(function () { if (hint) hint.remove(); }, 500);
        }, 5000);

        // Animacija
        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }
        animate();
    </script>
</Base>
