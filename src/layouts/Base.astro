---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
// Poppins nema cirilicu - ru tekst pada na Jost (ucitava se samo kad zatreba)
import '@fontsource-variable/jost';
import '@fontsource-variable/oswald';
import poppinsLatin from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import oswaldLatin from '@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url';
import '../styles/style.css';
import { SITE, IS_INDEXABLE, type Locale } from '../config/site';
import type { NavKey } from '../i18n/nav';
import SeoHead, { type SeoProps } from '../components/SeoHead.astro';
import Topbar from '../components/Topbar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatContact from '../components/FloatContact.astro';

type Props = SeoProps & {
  lang: Locale;
  active?: NavKey;
  /** kuda vodi jezicki meni; podrazumevano prevodi, inace pocetna tog jezika */
  langLinks?: Partial<Record<Locale, string>>;
  bodyClass?: string;
  floatContact?: boolean;
};

const { lang, active, langLinks, bodyClass, floatContact = true, ...seo } = Astro.props;
// analitika samo na produkcijskom domenu, da test deploy ne kvari statistiku
const analytics = IS_INDEXABLE;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <!-- fontovi stizu pre prvog crtanja, da se hero tekst ne prelama posle (CLS) -->
    <link rel="preload" href={poppinsLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={oswaldLatin} as="font" type="font/woff2" crossorigin />
    <SeoHead lang={lang} {...seo} />
    {analytics && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.gaId, gtmId: SITE.gtmId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId);
          (function (w, d, s, l, i) { w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' }); var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f); })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      </>
    )}
    {!analytics && <script is:inline>window.dataLayer = window.dataLayer || []; window.gtag = function () {};</script>}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <!-- shortcut: dark tema iskljucena dok je .theme-toggle sakriven; vratiti skriptu ispod kad se dugme vrati -->
    <!-- <script is:inline>try { if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark'); } catch (e) {}</script> -->
    {analytics && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <Topbar lang={lang} alternates={langLinks ?? seo.translations ?? {}} />
    <Header lang={lang} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {floatContact && <FloatContact />}
    <script src="../scripts/main.js"></script>
    <slot name="after" />
  </body>
</html>
