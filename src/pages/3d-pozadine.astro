---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/usluge.css';
import '../styles/oprema.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "3D Pozadine za Akvarijume i Terarijume",
    "description": "Unikatne 3D pozadine po meri izradjene od prirodnih materijala - siga kamen, imitacija stene, treset i kora drveta.",
    "brand": {
      "@type": "Brand",
      "name": "NS Reptiles"
    },
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "RSD",
      "price": "0",
      "seller": {
        "@type": "Organization",
        "name": "NS Reptiles"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Pocetna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "3D pozadine",
        "item": "https://nsreptiles.net/3d-pozadine.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="3D pozadine za akvarijume i terarijume po meri | NS Reptiles"
  description="3D pozadine po meri za akvarijume i terarijume - prirodni siga kamen, imitacija stene, treset i kora drveta. Unikatni dizajni, izrada u Novom Sadu."
  keywords="3D pozadina za akvarijum, 3D pozadina za terarijum, 3D pozadine po meri, siga kamen pozadina, stena pozadina, dekoracija akvarijuma, NS Reptiles"
  path="/3d-pozadine.html"
  image="/style/img/backgrounds/poz001.webp"
  ogTitle="3D Pozadine za Akvarijume i Terarijume - NS Reptiles"
  ogDescription="Unikatne 3D pozadine po meri za akvarijume i terarijume. Izrada od prirodnih materijala - siga kamen, stena, treset."
  translations={translationsFor("/3d-pozadine.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Izrada po meri</div>
        <h1>3D pozadine za akvarijume i terarijume</h1>
        <p>
          Unikatne 3D pozadine po meri od prirodnih materijala - siga kamen,
          imitacija stene, treset i kora drveta. Svaka pozadina se izradjuje
          rucno, prema dimenzijama vaseg akvarijuma ili terarijuma.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Nasa ponuda</div>
          <p>
            3D pozadine izradjujemo od najkvalitetnijih materijala. U ponudi su
            pozadine sa <strong>prirodnim siga kamenom</strong>, imitacijom
            stene, kombinacijom <strong>treseta i kore od drveta</strong>, kao i
            3D logo vaseg brenda ili firme. Sve pozadine se prave po meri, tako
            da savrseno naleze na zadnji zid vaseg akvarijuma ili terarijuma.
          </p>
        </div>
      </div>
    </section>
<section class="op-shop">
      <div class="wrap">
        <div class="op-toolbar">
          <div class="op-search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M21 21l-4.3-4.3"></path>
            </svg>
            <input type="text" id="opSearch" placeholder="Pretrazi pozadine...">
          </div>
        </div>
        <div class="op-count" id="opCount">12 modela</div>
        <div class="op-grid" id="opGrid">
          <article class="op-card" data-search="pozadina 100x40cm m001">
            <div class="op-img"><img src="/style/img/backgrounds/poz001.webp" alt="3D pozadina za akvarijum i terarijum 100x40cm M001" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
              <div class="op-cat">3D pozadina</div>
              <h3>Pozadina 100x40cm M001</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="pozadina 100x40cm m002">
            <div class="op-img"><img src="/style/img/backgrounds/poz002.webp" alt="3D pozadina za akvarijum i terarijum 100x40cm M002" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
              <div class="op-cat">3D pozadina</div>
              <h3>Pozadina 100x40cm M002</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="pozadina 100x40cm m003">
            <div class="op-img"><img src="/style/img/backgrounds/poz003.webp" alt="3D pozadina za akvarijum i terarijum 100x40cm M003" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
              <div class="op-cat">3D pozadina</div>
              <h3>Pozadina 100x40cm M003</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="pozadina 100x40cm m004">
            <div class="op-img"><img src="/style/img/backgrounds/poz004.webp" alt="3D pozadina za akvarijum i terarijum 100x40cm M004" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
              <div class="op-cat">3D pozadina</div>
              <h3>Pozadina 100x40cm M004</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="pozadina 100x40cm m005">
            <div class="op-img"><img src="/style/img/backgrounds/poz005.webp" alt="3D pozadina za akvarijum i terarijum 100x40cm M005" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
              <div class="op-cat">3D pozadina</div>
              <h3>Pozadina 100x40cm M005</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="pozadina 100x40cm m006">
            <div class="op-img"><img src="/style/img/backgrounds/poz006.webp" alt="3D pozadina za akvarijum i terarijum 100x40cm M006" loading="lazy" width="600" height="600"></div>
