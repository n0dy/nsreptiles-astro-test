              <h3>Pozadina 100x40cm M006</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="pozadina 90x45cm m007">
            <div class="op-img"><img src="/style/img/backgrounds/poz007.webp" alt="3D pozadina za akvarijum i terarijum 90x45cm M007" loading="lazy" width="600" height="600"></div>
