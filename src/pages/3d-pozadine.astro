        </div>
        <div class="op-empty" id="opEmpty">
          Nema rezultata za vasu pretragu. <a href="/3d-pozadine.html">Prikazi sve pozadine</a>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Zainteresovani ste?</div>
        <h2>3D pozadina <b>po meri</b></h2>
        <p>
          Posaljite nam dimenzije vaseg akvarijuma ili terarijuma i zeljeni
          materijal - izradicemo unikatnu 3D pozadinu tacno po vasim potrebama.
        </p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Pozovi nas</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Ostale usluge</div>
          <h2>Sve na <b>jednom mestu</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/izrada-terarijuma.html">Izrada terarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-akvarijuma.html">Izrada akvarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-led-rasvete.html">Izrada LED rasvete<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/oprema.html">Oprema za terarijume<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>

<script is:inline slot="after">
      // pretraga po nazivu pozadine
      const bgCards = [...document.querySelectorAll('.op-card')];
      const bgCount = document.getElementById('opCount');
      const bgEmpty = document.getElementById('opEmpty');
      const bgSearch = document.getElementById('opSearch');

      function bgApply() {
        const q = bgSearch.value.trim().toLowerCase();
        let n = 0;
        bgCards.forEach((c) => {
          const show = !q || c.dataset.search.includes(q);
          c.style.display = show ? '' : 'none';
          if (show) n++;
        });
        bgCount.textContent =
          n + (n % 10 === 1 && n % 100 !== 11 ? ' model' : ' modela');
        bgEmpty.classList.toggle('show', n === 0);
      }

      bgSearch.addEventListener('input', bgApply);
    </script>
</Base>
