---
import Base from '../layouts/Base.astro';

import { translationsFor } from '../i18n/routes';
---
<Base
  lang="sr"
  title="3D Pregled Terarijuma - NS Reptiles | Novi Sad"
  description="3D pregled terarijuma - rotirajte, zumirajte i prilagodite boje. Pogledajte terarijum u svom prostoru kroz AR. NS Reptiles Novi Sad."
  path="/3d.html"
  image="/style/img/terrariums/90x45x45.webp"
  bodyClass="viewer-3d-page"
  floatContact={false}
  translations={translationsFor("/3d.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Interaktivni prikaz</div>
        <h1>3D Pregled Terarijuma</h1>
        <p>
          Rotirajte, zumirajte i prilagodite boje terarijuma. Otvorite vrata i
          poklopac, izaberite teksturu drveta, a na telefonu ga pogledajte u
          svom prostoru kroz AR.
        </p>
      </div>
    </section>
<div id="viewer-page">
      <div id="viewer-wrap">
        <div id="loading">Ucitavanje 3D modela...</div>
        <div id="hint"></div>
        <script is:inline>
          document.getElementById('hint').textContent = window.innerWidth <= 1000
            ? 'Vuci za rotaciju • Pinch za zoom'
            : 'Vuci za rotaciju • Scroll za zoom • Desni klik za pomeranje';
        </script>

        <button id="lid-button" title="Poklopac">
          <svg class="lid-closed" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="6" width="20" height="2.5" rx="0.5"></rect>
            <rect x="3" y="8.5" width="18" height="12" rx="1"></rect>
            <line x1="9" y1="8.5" x2="9" y2="20.5" opacity="0.3"></line>
            <line x1="15" y1="8.5" x2="15" y2="20.5" opacity="0.3"></line>
          </svg>
          <svg class="lid-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="2.5" rx="0.5"></rect>
            <rect x="3" y="10" width="18" height="12" rx="1"></rect>
            <line x1="3" y1="10" x2="21" y2="10"></line>
            <line x1="9" y1="10" x2="9" y2="22" opacity="0.3"></line>
            <line x1="15" y1="10" x2="15" y2="22" opacity="0.3"></line>
          </svg>
        </button>

        <button id="help-button" title="Pomoć">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </button>

        <div id="help-overlay">
          <div id="help-popup">
            <h2>Kako koristiti 3D pregled</h2>
            <div class="help-item">
              <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg></div>
              <div class="help-text">
                <h4>Slikaj</h4>
                <p>Napravi screenshot trenutnog prikaza i preuzmi kao sliku.</p>
              </div>
            </div>
            <div class="help-item">
              <div class="help-icon green"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3l9 4.5v9L12 21l-9-4.5v-9L12 3z"></path>
                  <path d="M12 12l9-4.5"></path>
                  <path d="M12 12v9"></path>
                  <path d="M12 12L3 7.5"></path>
                </svg></div>
              <div class="help-text">
                <h4>Pogledaj u prostoru (AR)</h4>
                <p>Postavi terarijum u svoj prostor kroz kameru telefona. Dostupno samo na mobilnom.</p>
              </div>
            </div>
            <div class="help-item">
              <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                  <path d="M9 3v18"></path>
                  <path d="M15 3v18"></path>
                </svg></div>
              <div class="help-text">
                <h4>Vrata</h4>
                <p>Pomeri slidere da otvoris levo i desno klizno staklo terarijuma.</p>
              </div>
            </div>
            <div class="help-item">
              <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" fill="none">
                  <rect x="2" y="6" width="20" height="2.5" rx="0.5"></rect>
                  <rect x="3" y="8.5" width="18" height="12" rx="1"></rect>
                  <line x1="9" y1="8.5" x2="9" y2="20.5" opacity="0.3"></line>
                  <line x1="15" y1="8.5" x2="15" y2="20.5" opacity="0.3"></line>
                </svg></div>
              <div class="help-text">
                <h4>Poklopac</h4>
                <p>Klikni dugme gore levo da otvoris ili zatvoris poklopac terarijuma.</p>
              </div>
            </div>
            <div class="help-item">
              <div class="help-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10"></path>
                </svg></div>
              <div class="help-text">
                <h4>Tekstura</h4>
                <p>Biraj izmedju 5 boja drveta: tresnja, mahagonij, belo drvo, tamni hrast i bambus.</p>
              </div>
            </div>
            <button id="help-close">Zatvori</button>
          </div>
        </div>

        <div id="screenshot-flash"></div>

        <!-- Skriveni model-viewer za AR -->
        <model-viewer id="ar-model" src="/3d/ter100x50x50.glb" ar="" ar-modes="webxr scene-viewer quick-look" ar-scale="auto" camera-controls="" alt="3D model terarijuma"></model-viewer>

        <div id="viewer-actions">
          <button id="screenshot-button" title="Slikaj i preuzmi">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </button>
          <button id="ar-button" class="hidden" title="Pogledaj u prostoru">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l9 4.5v9L12 21l-9-4.5v-9L12 3z"></path>
              <path d="M12 12l9-4.5"></path>
              <path d="M12 12v9"></path>
              <path d="M12 12L3 7.5"></path>
            </svg>
          </button>
        </div>
      </div>

      <div id="panel">
        <button id="reset-button" title="Resetuj">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
        </button>
        <div class="panel-header">
          <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <path d="M9 3v18"></path>
              <path d="M15 3v18"></path>
            </svg></div>
          <h3>Vrata</h3>
        </div>
        <div class="door-controls">
          <div class="door-control">
            <div class="door-header">
              <span>Levo staklo</span>
              <span class="door-value" id="door-left-value">0%</span>
            </div>
            <input type="range" id="door-left-slider" min="0" max="100" value="0">
          </div>
          <div class="door-control">
            <div class="door-header">
              <span>Desno staklo</span>
              <span class="door-value" id="door-right-value">0%</span>
            </div>
            <input type="range" id="door-right-slider" min="0" max="100" value="0" style="direction:rtl">
          </div>
        </div>

        <hr class="panel-divider">

        <div class="panel-header">
          <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10"></path>
            </svg></div>
          <h3>Tekstura</h3>
        </div>
        <div class="color-grid" id="color-options"></div>

        <hr class="panel-divider">

        <div class="panel-header">
          <div class="panel-header-icon"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10H3M21 6H3M21 14H3M21 18H3"></path>
            </svg></div>
          <h3>Dimenzije</h3>
        </div>
        <div class="dimensions-info" id="dimensions-info"></div>
      </div>
    </div>
<div class="cart-overlay" id="cartOverlay"></div>
<aside class="cart-panel" id="cartPanel" aria-label="Korpa">
      <div class="cart-head">
        <h3>Korpa <span class="cart-count" id="cartCount">0</span></h3>
        <button class="cart-close" id="cartClose" aria-label="Zatvori">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M18 6L6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="cart-items" id="cartItems"></div>
      <div class="cart-foot" id="cartFoot">
        <div class="cart-total">
          <span>Ukupno</span><b id="cartTotal">0 din</b>
        </div>
        <a href="/korpa.html" class="btn btn-primary">Idi u korpu</a>
        <button class="btn btn-outline" id="cartContinue">
          Nastavi kupovinu
        </button>
      </div>
    </aside>
<style is:global>
      #viewer-page {
        display: flex;
        width: 100%;
        height: calc(100vh - 80px);
        background-color: #fff;
      }

      #viewer-wrap {
        position: relative;
        flex: 7;
        background: #e8e8e8;
        overflow: hidden;
      }

      #viewer-wrap canvas {
        display: block;
        width: 100%;
        height: 100%;
      }

      #loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 16px;
        z-index: 20;
        background: rgba(0, 0, 0, 0.8);
        color: #fff;
        padding: 16px 32px;
        border-radius: 10px;
        width: max-content;
        font-family: "Jost", sans-serif;
      }

      /* Panel */
      #panel {
        flex: 3;
        background: #fff;
        border-left: 1px solid #e5e5e5;
        padding: 28px 22px;
        overflow-y: auto;
        display: none;
        position: relative;
      }

      #panel h3 {
        font-size: 11px;
        margin: 0;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
        font-family: "Oswald", sans-serif;
      }

      #panel label {
        font-size: 13px;
        color: #555;
        display: block;
        margin-bottom: 4px;
      }

      #panel input[type="range"] {
        width: 100%;
        accent-color: #4aa584;
        margin-bottom: 8px;
      }

      .panel-divider {
        border: none;
        border-top: 1px solid #e0e0e0;
        margin: 16px 0;
      }

      /* Door controls */
      .door-controls {
        display: flex;
        flex-direction: row;
        gap: 10px;
      }

      .door-control {
        flex: 1;
        background: #f8f8f8;
        border-radius: 12px;
        padding: 10px 12px 8px;
        border: 1px solid #eee;
      }

      .door-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
      }

      .door-header span {
        font-size: 13px;
        color: #555;
      }

      .door-value {
        margin-left: auto;
        font-weight: 600;
        color: #4aa584;
        font-size: 12px;
      }

      .door-control input[type="range"] {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 24px;
        margin: 0;
        background: transparent;
        cursor: pointer;
        touch-action: none;
      }

      .door-control input[type="range"]::-webkit-slider-runnable-track {
        height: 6px;
        border-radius: 3px;
        background: #4aa584;
      }

      .door-control input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #4aa584;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
        margin-top: -6px;
        transition: transform 0.15s, box-shadow 0.15s;
      }

      .door-control input[type="range"]::-webkit-slider-thumb:active {
        transform: scale(1.15);
        box-shadow: 0 2px 8px rgba(74, 165, 132, 0.3);
      }

      .door-control input[type="range"]::-moz-range-track {
        height: 6px;
        border-radius: 3px;
        background: #4aa584;
        border: none;
      }

      .door-control input[type="range"]::-moz-range-thumb {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #4aa584;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
      }

      /* Poklopac toggle */
      .lid-control {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px;
      }

      .lid-control span {
        font-size: 13px;
        color: #555;
      }

      .lid-toggle {
        position: relative;
        width: 48px;
        height: 26px;
        display: block;
        cursor: pointer;
      }

      .lid-toggle input {
        opacity: 0;
        width: 0;
        height: 0;
        position: absolute;
      }

      .lid-track {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #ddd;
        border-radius: 13px;
        transition: background 0.25s;
      }

      .lid-track:before {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        left: 3px;
        top: 3px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
        transition: transform 0.25s;
      }

      .lid-toggle input:checked + .lid-track {
        background: #4aa584;
      }

      .lid-toggle input:checked + .lid-track:before {
        transform: translateX(22px);
      }

      /* Boje */
      .color-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .color-swatch {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        border: 2px solid transparent;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
        padding: 0;
        background: none;
        position: relative;
      }

      .color-swatch:hover {
        transform: scale(1.08);
        border-color: #4aa584;
      }

      .color-swatch.active {
        border-color: #4aa584;
      }

      .color-swatch .dot {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        display: block;
      }

      .color-name {
        font-size: 10px;
        color: #888;
        text-align: center;
        margin-top: 4px;
        display: block;
      }

      /* Reset dugme */
      #reset-button {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: none;
        background: #f0f0f0;
        color: #999;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, color 0.2s, transform 0.15s;
      }

      #reset-button:hover {
        background: #e0e0e0;
        color: #555;
        transform: scale(1.1);
      }

      #reset-button.visible {
        display: flex;
      }

      /* Dimenzije */
      .dimensions-info {
        margin-top: 6px;
        display: flex;
        gap: 8px;
      }

      .dim-item {
        flex: 1;
        background: #f8f8f8;
        border-radius: 10px;
        border: 1px solid #eee;
        padding: 8px;
        text-align: center;
      }

      .dim-label {
        font-size: 10px;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .dim-value {
        font-size: 15px;
        font-weight: 700;
        color: #333;
        margin-top: 2px;
      }

      .dim-unit {
        font-size: 10px;
        color: #999;
        font-weight: 400;
      }

      /* Info hint */
      #hint {
        position: absolute;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 12px;
        z-index: 10;
        pointer-events: none;
        transition: opacity 0.5s;
        width: fit-content;
        height: fit-content;
        text-align: center;
      }

      /* Viewer action dugmad - dole desno */
      #viewer-actions {
        position: absolute;
        bottom: 16px;
        right: 16px;
        z-index: 15;
        display: flex;
        gap: 8px;
      }

      #viewer-actions button {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s, color 0.2s, box-shadow 0.2s;
      }

      #viewer-actions button:active {
        transform: scale(0.95);
      }

      #screenshot-button {
        background: rgba(255, 255, 255, 0.95);
        color: #555;
        border: none;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      }

      #screenshot-button:hover {
        transform: scale(1.1);
        color: #4aa584;
      }

      #ar-button {
        background: #4aa584;
        color: #fff;
        border: none;
        box-shadow: 0 2px 8px rgba(74, 165, 132, 0.35);
      }

      #ar-button:hover {
        transform: scale(1.1);
        box-shadow: 0 3px 12px rgba(74, 165, 132, 0.5);
      }

      #ar-button.hidden {
        display: none;
      }

      /* Screenshot flash efekat */
      #screenshot-flash {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #fff;
        opacity: 0;
        pointer-events: none;
        z-index: 50;
        transition: opacity 0.15s;
      }

      #screenshot-flash.flash {
        opacity: 0.7;
        transition: none;
      }

      /* Poklopac dugme */
      #lid-button {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 15;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        border: none;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        transition: transform 0.15s, color 0.2s, background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
      }

      #lid-button:hover {
        transform: scale(1.1);
      }

      #lid-button.open {
        background: #4aa584;
        color: #fff;
        box-shadow: 0 2px 8px rgba(74, 165, 132, 0.35);
      }

      #lid-button svg {
        stroke: currentColor;
      }

      #lid-button .lid-open {
        display: none;
      }

      #lid-button.open .lid-closed {
        display: none;
      }

      #lid-button.open .lid-open {
        display: block;
      }

      /* Help dugme */
      #help-button {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 15;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        border: none;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        transition: transform 0.15s, color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
      }

      #help-button:hover {
        transform: scale(1.1);
        color: #4aa584;
      }

      #help-button svg {
        stroke: currentColor;
      }

      /* Help popup */
      #help-overlay {
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 30;
        align-items: center;
        justify-content: center;
      }

      #help-overlay.open {
        display: flex;
      }

      #help-popup {
        background: #fff;
        border-radius: 16px;
        padding: 28px 24px;
        max-width: 380px;
        width: 90%;
        max-height: 80%;
        overflow-y: auto;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      }

      #help-popup h2 {
        font-size: 16px;
        margin: 0 0 16px;
        color: #333;
        font-family: "Oswald", sans-serif;
      }

      .help-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
      }

      .help-icon {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
      }

      .help-icon svg {
        width: 18px;
        height: 18px;
        stroke: #555;
        fill: none;
        stroke-width: 2;
      }

      .help-icon.green {
        background: #4aa584;
      }

      .help-icon.green svg {
        stroke: #fff;
      }

      /* Panel section headers */
      .panel-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
      }

      .panel-header-icon {
        width: auto;
        height: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .panel-header-icon svg {
        width: 14px;
        height: 14px;
        stroke: #888;
        fill: none;
        stroke-width: 2;
      }

      .help-text h4 {
        font-size: 13px;
        margin: 0 0 2px;
        color: #333;
      }

      .help-text p {
        font-size: 12px;
        margin: 0;
        color: #888;
        line-height: 1.4;
      }

      #help-close {
        display: block;
        width: 100%;
        margin-top: 16px;
        padding: 10px;
        border: none;
        border-radius: 10px;
        background: #f0f0f0;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      #help-close:hover {
        background: #e0e0e0;
      }

      /* Skriveni model-viewer za AR */
      #ar-model {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
        overflow: hidden;
      }

      /* Mobile */
      @media (max-width: 1000px) {
        #viewer-page {
          flex-direction: column;
          height: auto;
        }

        #viewer-wrap {
          flex: none;
          height: 55vh;
          height: 55dvh;
        }

        #panel {
          flex: 1;
          border-left: none;
          border-top: 1px solid #ddd;
          padding: 20px 16px;
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
          background-color: #fff;
        }

        #help-popup {
          width: 95%;
          max-width: 100%;
          max-height: 95%;
        }

        #hint {
          bottom: 12px;
          font-size: 11px;
          padding: 6px 14px;
        }

        #viewer-actions {
          right: auto;
          left: 16px;
        }
      }
    </style>
<script is:inline slot="after" type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>
<script is:inline slot="after" type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.module.js",
            "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.164.1/examples/jsm/"
        }
    }
    </script>
<script is:inline slot="after" type="module">
      import * as THREE from 'three';
      import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
      import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

      const wrap = document.getElementById('viewer-wrap');

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0xf5f5f5);

      const camera = new THREE.PerspectiveCamera(45, wrap.clientWidth / wrap.clientHeight, 0.1, 100000);
      camera.position.set(3000, 2000, 3000);

      const renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
      renderer.setSize(wrap.clientWidth, wrap.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.2;
      wrap.appendChild(renderer.domElement);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.08;
      controls.rotateSpeed = 0.8;
      controls.touches = { ONE: THREE.TOUCH.ROTATE, TWO: THREE.TOUCH.DOLLY_PAN };

      // Svetla
      scene.add(new THREE.AmbientLight(0xffffff, 0.6));

      const dirLight1 = new THREE.DirectionalLight(0xffffff, 1.0);
      dirLight1.position.set(5000, 5000, 5000);
      dirLight1.castShadow = true;
      scene.add(dirLight1);

      const dirLight2 = new THREE.DirectionalLight(0xffffff, 0.5);
      dirLight2.position.set(-3000, 3000, -3000);
      scene.add(dirLight2);

      scene.add(new THREE.DirectionalLight(0xffffff, 0.3).translateY(-2000));

      // PBR teksture drveta
      const texLoader = new THREE.TextureLoader();
      const basePath = '/3d/textures/';

      const woodTextures = [
        { name: 'Trešnja', folder: 'tresnja' },
        { name: 'Mahagonij', folder: 'mahagonij' },
        { name: 'Belo drvo', folder: 'belo-drvo' },
        { name: 'Tamni hrast', folder: 'tamni-hrast' },
        { name: 'Bambus', folder: 'bambus' },
      ];

      // Učitaj sve teksture
      woodTextures.forEach(function (w) {
        const p = basePath + w.folder + '/';
        w.colorMap = texLoader.load(p + 'color.png');
        w.normalMap = texLoader.load(p + 'normal.png');
        w.roughnessMap = texLoader.load(p + 'roughness.png');
        w.preview = p + 'color.png';
        [w.colorMap, w.normalMap, w.roughnessMap].forEach(function (tex) {
          tex.wrapS = THREE.RepeatWrapping;
          tex.wrapT = THREE.RepeatWrapping;
          tex.repeat.set(2, 2);
        });
      });

      const colorOptions = woodTextures;
      var activeWood = woodTextures[0];

      const panelMaterials = [];

      let doorLeft = null, doorRight = null;
      let doorLeftStart = new THREE.Vector3(), doorRightStart = new THREE.Vector3();
      let slideDir = new THREE.Vector3(), doorSlideDistance = 0;

      let lid = null;
      let lidStartPos = new THREE.Vector3();

      function applyOption(opt) {
        panelMaterials.forEach(function (mat) {
          mat.color.setHex(0xffffff);
          mat.map = opt.colorMap;
          mat.normalMap = opt.normalMap;
          mat.roughnessMap = opt.roughnessMap;
          mat.roughness = 1.0;
          mat.metalness = 0.0;
          mat.needsUpdate = true;
        });
      }

      // Tekstura dugmad
      const colorContainer = document.getElementById('color-options');
      colorOptions.forEach(function (opt, i) {
        const btn = document.createElement('button');
        btn.className = 'color-swatch' + (i === 0 ? ' active' : '');
        btn.title = opt.name;
        btn.innerHTML = '<span class="dot" style="background:url(' + opt.preview + ') center/cover;"></span>';
        btn.addEventListener('click', function () {
          document.querySelectorAll('.color-swatch').forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          applyOption(opt);
          activeWood = opt;
        });
        colorContainer.appendChild(btn);
      });

      // Staklo materijal
      const glassMaterial = new THREE.MeshPhysicalMaterial({
        color: new THREE.Color(0.5451, 0.7608, 1.0),
        transparent: true,
        opacity: 0.15,
        roughness: 0.05,
        metalness: 0.0,
        side: THREE.DoubleSide,
        depthWrite: false
      });

      function isGlassMaterial(mat) {
        if (!mat) return false;
        const name = (mat.name || '').toLowerCase();
        return name.includes('glass') || name.includes('staklo');
      }

      // Ucitaj GLB
      const loader = new GLTFLoader();
      loader.load(
        '/3d/ter100x50x50.glb',
        function (gltf) {
          const object = gltf.scene;

          object.traverse(function (child) {
            if (child.isMesh) {
              child.castShadow = true;
              child.receiveShadow = true;
              const mats = Array.isArray(child.material) ? child.material : [child.material];
              const newMats = mats.map(function (mat) {
                if (isGlassMaterial(mat)) return glassMaterial;
                mat.side = THREE.DoubleSide;
                if (panelMaterials.indexOf(mat) === -1) panelMaterials.push(mat);
                return mat;
              });
              child.material = newMats.length === 1 ? newMats[0] : newMats;
            }

            const name = (child.name || '').toLowerCase();
            if (name.includes('prednje') && name.includes('staklo') && !name.includes('geom3d')) {
              if (name.includes('(l)')) doorLeft = child;
              if (name.includes('(d)')) doorRight = child;
            }
            if ((name.includes('plafon') || name.includes('poklopac')) && !name.includes('geom3d')) {
              lid = child;
            }
          });

          // Centriraj
          const box = new THREE.Box3().setFromObject(object);
          const center = box.getCenter(new THREE.Vector3());
          const size = box.getSize(new THREE.Vector3());
          object.position.sub(center);
          scene.add(object);

          // Kamera
          const maxDim = Math.max(size.x, size.y, size.z);
          var zoom = window.innerWidth <= 1000 ? 1.4 : 1.5;
          camera.position.set(maxDim * zoom, maxDim * 0.5, maxDim * 0.7);
          controls.target.set(0, 0, 0);
          controls.minDistance = maxDim * 0.3;
          controls.maxDistance = maxDim * 5;
          controls.update();

          // Vrata
          if (doorLeft && doorRight) {
            doorLeftStart.copy(doorLeft.position);
            doorRightStart.copy(doorRight.position);
            slideDir.copy(doorRightStart).sub(doorLeftStart).normalize();
            doorSlideDistance = doorRightStart.distanceTo(doorLeftStart);
          } else {
            document.getElementById('door-left-slider').disabled = true;
            document.getElementById('door-right-slider').disabled = true;
          }

          var leftSlider = document.getElementById('door-left-slider');
          var rightSlider = document.getElementById('door-right-slider');
          var leftValue = document.getElementById('door-left-value');
          var rightValue = document.getElementById('door-right-value');

          function updateDoors() {
            var lv = parseInt(leftSlider.value) / 100;
            var rv = parseInt(rightSlider.value) / 100;
            if (doorLeft) doorLeft.position.copy(doorLeftStart).addScaledVector(slideDir, doorSlideDistance * lv);
            if (doorRight) doorRight.position.copy(doorRightStart).addScaledVector(slideDir, -doorSlideDistance * rv);
            leftValue.textContent = leftSlider.value + '%';
            rightValue.textContent = rightSlider.value + '%';
          }

          leftSlider.addEventListener('input', updateDoors);
          rightSlider.addEventListener('input', updateDoors);


          // Poklopac
          var lidButton = document.getElementById('lid-button');
          var lidClosed = true;
          if (lid) {
            lidStartPos.copy(lid.position);
          } else {
            lidButton.style.display = 'none';
          }
          lidButton.addEventListener('click', function () {
            if (!lid) return;
            lidClosed = !lidClosed;
            if (lidClosed) {
              lid.position.copy(lidStartPos);
              lidButton.classList.remove('open');
            } else {
              lid.position.set(lidStartPos.x - 200, lidStartPos.y + 400, lidStartPos.z + 100);
              lidButton.classList.add('open');
            }
          });

          // Primeni drvo teksturu kao default
          applyOption(colorOptions[0]);

          // Dimenzije (zakucane za trenutni model)
          var dimContainer = document.getElementById('dimensions-info');
          var dims = [
            { label: 'Dužina', val: 100 },
            { label: 'Širina', val: 50 },
            { label: 'Visina', val: 50 }
          ];
          dimContainer.innerHTML = dims.map(function (d) {
            return '<div class="dim-item"><div class="dim-label">' + d.label + '</div><div class="dim-value">' + d.val + ' <span class="dim-unit">cm</span></div></div>';
          }).join('');

          // Gotovo
          document.getElementById('loading').style.display = 'none';
          document.getElementById('panel').style.display = 'block';

          // Resize nakon sto panel postane vidljiv
          setTimeout(function () {
            camera.aspect = wrap.clientWidth / wrap.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(wrap.clientWidth, wrap.clientHeight);
          }, 0);

          // Sakrij hint posle 4s
          setTimeout(function () {
            const hint = document.getElementById('hint');
            if (hint) hint.style.opacity = '0';
            setTimeout(function () { if (hint) hint.remove(); }, 500);
          }, 5000);
        },
        function (xhr) {
          if (xhr.lengthComputable) {
            const pct = Math.round(xhr.loaded / xhr.total * 100);
            document.getElementById('loading').textContent = 'Ucitavanje: ' + pct + '%';
          }
        },
        function (error) {
          document.getElementById('loading').textContent = 'Greska pri ucitavanju modela.';
          console.error('GLB greska:', error);
        }
      );


      // Resize
      window.addEventListener('resize', function () {
        camera.aspect = wrap.clientWidth / wrap.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(wrap.clientWidth, wrap.clientHeight);
      });

      // Screenshot dugme
      const screenshotBtn = document.getElementById('screenshot-button');
      const flash = document.getElementById('screenshot-flash');

      screenshotBtn.addEventListener('click', function () {
        // Renderuj frame pre screenshot-a
        renderer.render(scene, camera);

        // Flash efekat
        flash.classList.add('flash');
        setTimeout(function () { flash.classList.remove('flash'); }, 150);

        // Uzmi sliku sa canvas-a
        const dataUrl = renderer.domElement.toDataURL('image/png');

        // Kreiraj download link
        const link = document.createElement('a');
        link.download = 'terarijum-3d-pregled.png';
        link.href = dataUrl;
        link.click();
      });

      // AR dugme
      const arButton = document.getElementById('ar-button');
      const arModel = document.getElementById('ar-model');

      async function applyTextureToAR() {
        if (!arModel.model) return;
        try {
          var p = basePath + activeWood.folder + '/';
          var colorTex = await arModel.createTexture(p + 'color.png');
          arModel.model.materials.forEach(function (mat) {
            var name = (mat.name || '').toLowerCase();
            if (name.includes('glass') || name.includes('staklo')) return;
            mat.pbrMetallicRoughness.baseColorTexture.setTexture(colorTex);
            mat.pbrMetallicRoughness.setMetallicFactor(0);
            mat.pbrMetallicRoughness.setRoughnessFactor(1);
          });
        } catch (e) {
          console.warn('AR tekstura error:', e);
        }
      }

      // Proveri da li uredjaj podrzava AR
      arModel.addEventListener('load', function () {
        if (arModel.canActivateAR) {
          arButton.classList.remove('hidden');
        }
      });

      arButton.addEventListener('click', async function () {
        if (arModel.canActivateAR) {
          await applyTextureToAR();
          arModel.activateAR();
        }
      });

      // Prati izmene - prikaži reset kad je nešto promenjeno
      var resetBtn = document.getElementById('reset-button');
      function checkDirty() {
        var ls = document.getElementById('door-left-slider');
        var rs = document.getElementById('door-right-slider');
        var lidBtn = document.getElementById('lid-button');
        var firstSwatch = document.querySelector('.color-swatch');
        var dirty = parseInt(ls.value) !== 0 ||
          parseInt(rs.value) !== 0 ||
          lidBtn.classList.contains('open') ||
          (firstSwatch && !firstSwatch.classList.contains('active'));
        resetBtn.classList.toggle('visible', dirty);
      }

      document.getElementById('door-left-slider').addEventListener('input', function () { checkDirty(); });
      document.getElementById('door-right-slider').addEventListener('input', function () { checkDirty(); });
      document.getElementById('lid-button').addEventListener('click', function () { setTimeout(checkDirty, 50); });
      document.querySelectorAll('.color-swatch').forEach(function (s) {
        s.addEventListener('click', function () { setTimeout(checkDirty, 50); });
      });

      // Reset
      resetBtn.addEventListener('click', function () {
        var ls = document.getElementById('door-left-slider');
        var rs = document.getElementById('door-right-slider');
        ls.value = 0; rs.value = 0;
        ls.dispatchEvent(new Event('input'));
        var lidBtn = document.getElementById('lid-button');
        if (lidBtn.classList.contains('open')) lidBtn.click();
        var firstSwatch = document.querySelector('.color-swatch');
        if (firstSwatch && !firstSwatch.classList.contains('active')) firstSwatch.click();
        var box = new THREE.Box3().setFromObject(scene);
        var sz = box.getSize(new THREE.Vector3());
        var maxDim = Math.max(sz.x, sz.y, sz.z);
        var zoom = window.innerWidth <= 1000 ? 1.4 : 1.5;
        camera.position.set(maxDim * zoom, maxDim * 0.5, maxDim * 0.7);
        controls.target.set(0, 0, 0);
        controls.update();
        resetBtn.classList.remove('visible');
      });

      // Help popup
      var helpOverlay = document.getElementById('help-overlay');
      document.getElementById('help-button').addEventListener('click', function () {
        helpOverlay.classList.add('open');
      });
      document.getElementById('help-close').addEventListener('click', function () {
        helpOverlay.classList.remove('open');
      });
      helpOverlay.addEventListener('click', function (e) {
        if (e.target === helpOverlay) helpOverlay.classList.remove('open');
      });

      // Animacija
      function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
      }
      animate();
    </script>
</Base>
