            <button class="pill" data-filter="ter-akvarijumi">Ter-akvarijumi</button>
            <button class="pill" data-filter="kompleti">Kompleti</button>
          </div>
          <div class="op-search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M21 21l-4.3-4.3"></path>
            </svg>
            <input type="text" id="opSearch" placeholder="Pretraži akvarijume...">
          </div>
        </div>
        <div class="op-count" id="opCount">30 proizvoda</div>
        <div class="op-grid" id="opGrid">
