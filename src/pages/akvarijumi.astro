---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/oprema.css';
import '../styles/usluge.css';
import { translationsFor } from '../i18n/routes';
---
<Base
  lang="sr"
  title="Akvarijumi i ter-akvarijumi — izrada i prodaja | NS Reptiles"
  description="Ručno lepljeni stakleni akvarijumi, kompleti sa opremom i ter-akvarijumi za kornjače. Izrada po meri. NS Reptiles, Novi Sad."
  path="/akvarijumi.html"
  image="/style/img/aquariums/a100x40x50.webp"
  ogTitle="Akvarijumi i ter-akvarijumi | NS Reptiles"
  ogDescription="Stakleni akvarijumi, kompleti i ter-akvarijumi za vodene kornjače. Izrada po meri. Novi Sad."
  active="aquariums"
  translations={translationsFor("/akvarijumi.html")}
>
<section class="page-head">
      <div class="wrap">
        <h1>Stakleni akvarijumi i ter-akvarijumi</h1>
        <p>
          Ručno lepljeni stakleni akvarijumi, kompleti sa opremom i
          ter-akvarijumi za vodene kornjače — plus izrada po meri.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>
            Sve akvarijume <strong>ručno lepimo od stakla</strong> — od malih
            za sitne ribice do velikih od preko 190 litara.
            <strong>Ter-akvarijumi</strong> sa suvim i vodenim delom idealni su
            za vodene kornjače. Za bilo koju dimenziju van ponude radimo
            <strong>izradu po meri</strong>.
          </p>
        </div>
      </div>
    </section>
<section class="op-shop">
