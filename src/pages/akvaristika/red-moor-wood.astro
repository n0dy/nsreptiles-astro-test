---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "Red Moor Wood za akvarijum — priprema, upotreba i aquascaping",
        "description": "Vodic za Red Moor Wood panjeve u akvarijumu. Sta je red moor wood, kako ga pripremiti namakanjem i kuvanjem, uticaj tanina na pH vode i upotreba u aquascape-u.",
        "url": "https://nsreptiles.net/akvaristika/red-moor-wood.html",
        "image": "https://nsreptiles.net/style/img/red-moor/IMG_1439.webp",
        "author": {
          "@type": "Organization",
          "name": "NS Reptiles"
        },
        "publisher": {
          "@type": "Organization",
          "name": "NS Reptiles",
          "url": "https://nsreptiles.net"
        },
        "inLanguage": "sr"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Pocetna",
            "item": "https://nsreptiles.net/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Akvaristika",
            "item": "https://nsreptiles.net/akvarijumi.html"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Red Moor Wood",
            "item": "https://nsreptiles.net/akvaristika/red-moor-wood.html"
          }
        ]
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Red Moor Wood za akvarijum — priprema | NS Reptiles"
  description="Vodič za Red Moor Wood panjeve u akvarijumu: šta je, kako se priprema namakanjem i kuvanjem, uticaj tanina na vodu i upotreba u aquascape-u."
  path="/akvaristika/red-moor-wood.html"
  image="/style/img/red-moor/IMG_1439.webp"
  ogType="article"
  ogTitle="Red Moor Wood vodič za akvarijum | NS Reptiles"
  ogDescription="Red Moor Wood — prirodna koreninasta dekoracija za akvarijum. Priprema, namakanje, uticaj na pH i saveti za aquascaping."
  translations={translationsFor("/akvaristika/red-moor-wood.html")}
  langLinks={{ ...{"en":"/en/aquariums.html","ru":"/ru/aquariums.html"}, ...translationsFor("/akvaristika/red-moor-wood.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Red Moor Wood</h1>
        <p>
          Prirodna koreninasta dekoracija za aquascape i biotop akvarijume —
          razgranata struktura, dugotrajnost i korisni tanini koji obogacuju
          vodeni ekosistem.
        </p>
      </div>
    </section>
<div class="wrap breadcrumb reveal">
      <nav aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Pocetna</a></li>
          <li><a href="/akvarijumi.html">Vodici</a></li>
          <li>Red Moor Wood</li>
        </ol>
      </nav>
    </div>
<section class="guide-body">
      <div class="wrap">

        <!-- Sta je Red Moor Wood -->
        <div class="guide-section reveal">
          <h2>Sta je Red Moor Wood?</h2>
          <p>
            Red Moor Wood je vrsta korenovog drveta koje potice iz mocvarnih
            podrucja severne i centralne Evrope. Prepoznatljivo je po izrazito
            razgranatoj, koreninastoj strukturi i crvenkasto-smedjoj boji koja
            vremenom potamni u vodi. Svaki komad je jedinstven po obliku i
            velicini, sto ga cini omiljenim materijalom medu aquascaperima koji
            teze prirodnom, organskom izgledu akvarijuma.
          </p>
          <p>
            Za razliku od nekih drugih vrsta drveta koja se koriste u
            akvaristici, Red Moor Wood je veoma dugotrajan i ne truli u vodi.
            Zahvaljujuci gustoj strukturi, odrzava oblik godinama i postaje sve
            efektniji kako razvija prirodnu patinu. Idealan je za kreiranje
            prirodnog izgleda u akvarijumima i paludarijumima.
          </p>
        </div>

        <!-- Prednosti -->
        <div class="guide-section reveal">
          <h2>Prednosti u akvarijumu</h2>
          <div class="guide-card">
            <h3>Aquascaping i biotop dizajn</h3>
            <p>
              Razgranata struktura Red Moor Wood-a savrsena je za kreiranje
              prirodnih biotop uredenja — mocvarnih sumi, korijenastih reka i
              tamnih voda Amazona ili jugoistocne Azije. Koristi se kao
              centralni element kompozicije ili kao vizuelni okvir za mahovina i
              biljke.
            </p>
          </div>
          <div class="guide-card">
            <h3>Staniste za ribe i beskicmenjake</h3>
            <p>
              Razgranati krakovi i skrovita mesta privlace mnoge vrste riba —
              posebno manje karakoide, koridorasi i rakove. Corydoras i
              otocinkli aktivno pretrazuju drvo u potrazi za algama i biofilmom
              koji se prirodno razvija na povrsini.
            </p>
          </div>
          <div class="guide-card">
            <h3>Podloga za mahovina i biljke</h3>
            <p>
              Red Moor Wood je odlicna podloga za priucivanje mahovina i biljaka
              poput Anubias-a, Java Fern-a (Microsorum pteropus) i
              Bucephalandra-e. Koreni se lako prihvataju za hrapavu povrsinu
              drveta bez potrebe za lepilom — dovoljno ih je pricvrstiti koncem
              i sacekati nekoliko nedelja.
            </p>
          </div>
          <div class="guide-card">
            <h3>Dugotrajnost</h3>
            <p>
              Za razliku od mekih vrsta drveta koje se brzo razlazu, Red Moor
              Wood je izuzetno dugotrajan. Voda ne utice na njegovu strukturu —
              drvo ostaje cvrsto i estetski atraktivno godinama.
            </p>
          </div>
        </div>

        <!-- Priprema -->
        <div class="guide-section reveal">
          <h2>Kako pripremiti Red Moor Wood za akvarijum</h2>
          <p>
            Pre nego sto postavite drvo u akvarijum, preporucujemo sledece
            korake kako biste izbegli zamucivanje vode i osigurali da drvo
            potone.
          </p>

          <h3>1. Ispiranje</h3>
          <p>
            Temeljno isperite drvo mlazom hladne vode kako biste uklonili
            prasinu, pesak i sitne cestice. Za vece komade koristite cetku.
          </p>

          <h3>2. Potapanje (1–2 nedelje)</h3>
          <p>
            Potopite drvo u kofu ili posudu sa vodom i ostavite ga 1 do 2
            nedelje. Tokom tog perioda drvo ce ispustati tanine koji obojavaju
            vodu u zutu ili smedu nijansu. Menjajte vodu svaka 2–3 dana dok ne
            postane dovoljno bistra. Ovo je ujedno i jedini nacin da se drvo
            natopi i potone bez oslonca.
          </p>

          <h3>3. Kuvanje (opciono)</h3>
          <p>
            Kratko kuvanje u kipucoj vodi (20–30 minuta) ubrzava ispustanje
            tanina i sterilizuje drvo. Preporucuje se za manje komade ili kada
            zelite brze rezultate. Posle kuvanja ostavite drvo da se ohladi pre
            postavljanja u akvarijum.
          </p>

          <h3>4. Fiksiranje u akvarijumu</h3>
          <p>
            Ako drvo i dalje pliva posle namakanja, privremeno ga pritisnite
            kamenom ili upotrebite akvarijumsko lajsno kao oslonac. Drvo ce
            potpuno potonuti kad se dovoljno natopi — obicno posle 2 do 4
            nedelje u vodi.
          </p>

          <div class="tip-box">
            <p>
              <strong>Savet:</strong> Tanini koje drvo ispusta nisu stetni —
              naprotiv, korisni su za mnoge tropske ribe porekla tamnih voda
              (diskuse, tetraice, koridorasi). Ako zelite bistriju vodu bez
              tamnjenja, dodajte aktivni ugalj u filter.
            </p>
          </div>
        </div>

        <!-- Uticaj na vodu -->
        <div class="guide-section reveal">
          <h2>Uticaj na hemiju vode</h2>
          <p>
            Red Moor Wood prirodno ispusta tanine — organske kiseline koje
            blago snizavaju pH i smanjuju tvrdocu vode. Ovo moze biti korisno
            ili neutralno, zavisno od vrsta riba koje drzite:
          </p>
          <ul>
            <li>
              <strong>Povoljno za:</strong> ribe tropskih tamnih voda — diskusi,
              skalarne, neonske tetraice, apistogramme i vecina koridorasa. Ove
              ribe prirodno zive u vodi bogatoj taninima.
            </li>
            <li>
              <strong>Neutralno za:</strong> vecinu ukrasnih riba koje tolerisu
              siri opseg pH (6,5–7,5).
            </li>
            <li>
              <strong>Pratite parametre:</strong> ako drzite ribe koje zahtevaju
              visok pH (cichlidi africkih jezera, goldfish), redovno merite
              vrednosti vode i po potrebi koristite pufer.
            </li>
          </ul>
          <p>
            Jacina uticaja zavisi od velicine komada drveta, zapremine
            akvarijuma i kolicine vode koja prolazi kroz filter. U vecini
            slucajeva efekat je minimalan posle inicijalnog perioda namakanja.
          </p>
        </div>

        <!-- Odrzavanje -->
        <div class="guide-section reveal">
          <h2>Odrzavanje</h2>
          <p>
            Red Moor Wood zahteva minimalno odrzavanje. Tokom redovnog ciscenja
            akvarijuma, cetkom lagano predjite po povrsini drveta kako biste
            uklonili visestruke naslage algi ili sediment. Nemojte koristiti
            hemijska sredstva za ciscenje.
          </p>
          <p>
            Vremenom ce se na drvetu razviti tanki sloj biofilma — bela ili
            sivkasta prevlaka koja je potpuno normalna i korisna. Predstavlja
            izvor hrane za stozere i mlade ribe. Ako vam estetski smeta, lagano
            je uklonite cetkom tokom redovnog procene vode.
          </p>
        </div>

        <!-- Velicine i dostupnost -->
        <div class="guide-section reveal">
          <h2>Velicine i dostupnost</h2>
          <p>
            U ponudi imamo Red Moor Wood panjeve razlicitih velicina — od
            manjih komada pogodnih za nano akvarijume (ispod 30 litara) do
            velikih, raskosnih komada za setup-e od 100 litara i vise. Svaki
            komad je jedinstven po obliku, grananju i teksturi.
          </p>
          <p>
            Za informacije o trenutnoj dostupnosti i cenama, kontaktirajte nas:
          </p>
          <div class="guide-cta-links">
            <a href="tel:+381693301474" class="btn btn-primary" onclick="gtag('event','telefon_click',{'metod':'poziv'})">Pozovite nas</a>
            <a href="https://wa.me/381693301474?text=Zanima%20me%20Red%20Moor%20Wood%20panj%20za%20akvarijum" target="_blank" rel="noopener" class="btn btn-outline" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp upit</a>
          </div>
        </div>

        <!-- Interni linkovi -->
        <div class="guide-section reveal">
          <h2>Vise o akvaristici i opremi</h2>
          <p>
            Pogledajte nas kompletan asortiman akvarijuma, dekoracija i opreme:
          </p>
          <div class="usl-more-grid" style="margin-top: 20px">
            <a class="usl-link" href="/akvarijumi.html">Akvarijumi i dekoracija<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
            <a class="usl-link" href="/oprema.html">Oprema za terarijume i akvarijume<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          </div>
        </div>

      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Kontaktirajte nas</h2>
        <p>
          Javite nam se telefonom ili putem WhatsApp-a i rado cemo vam pomoci
          oko izbora odgovarajuceg komada Red Moor Wood-a za vas akvarijum.
        </p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Zanima%20me%20Red%20Moor%20Wood%20za%20akvarijum" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','telefon_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>
<style is:global>
      .guide-body {
        padding: 60px 0 100px;
        background: var(--bg);
        transition: background 0.4s;
      }
      .guide-section {
        margin-bottom: 56px;
      }
      .guide-section:last-child {
        margin-bottom: 0;
      }
      .guide-section h2 {
        font-family: 'Oswald Variable', sans-serif;
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink);
        margin-bottom: 18px;
      }
      .guide-section h3 {
        font-family: 'Oswald Variable', sans-serif;
        font-size: clamp(1.05rem, 1.5vw, 1.25rem);
        font-weight: 600;
        color: var(--green-dark);
        margin: 28px 0 10px;
      }
      .guide-section p,
      .guide-section li {
        font-family: 'Jost Variable', sans-serif;
        font-weight: 300;
        line-height: 1.8;
        color: var(--ink);
        font-size: 1rem;
      }
      .guide-section ul {
        padding-left: 22px;
        margin: 14px 0;
      }
      .guide-section ul li {
        margin-bottom: 8px;
      }
      .guide-card {
        background: var(--white);
        border-radius: 4px;
        box-shadow: 0 10px 30px -18px rgba(40, 47, 52, 0.25);
        padding: 28px 32px;
        margin-bottom: 20px;
        transition: transform 0.25s;
      }
      .guide-card:hover {
        transform: translateY(-4px);
      }
      .guide-card h3 {
        margin-top: 0;
      }
      .tip-box {
        background: var(--white);
        border-left: 3px solid var(--green);
        padding: 18px 22px;
        margin-top: 20px;
        border-radius: 0 4px 4px 0;
      }
      .tip-box p {
        margin: 0;
        font-family: 'Jost Variable', sans-serif;
        font-weight: 300;
        line-height: 1.75;
        color: var(--ink);
        font-size: 1rem;
      }
      .breadcrumb {
        padding: 16px 0 0;
      }
      .breadcrumb ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        align-items: center;
        font-family: 'Jost Variable', sans-serif;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }
      .breadcrumb li + li::before {
        content: '›';
        margin-right: 4px;
        color: var(--ink-soft);
      }
      .breadcrumb a {
        color: var(--ink-soft);
        text-decoration: none;
        transition: color 0.2s;
      }
      .breadcrumb a:hover {
        color: var(--green-ink);
      }
      .breadcrumb li:last-child {
        color: var(--ink);
      }
      .guide-cta-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 28px;
      }
    </style>

</Base>
