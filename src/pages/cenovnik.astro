---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/usluge.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Pocetna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Cenovnik",
        "item": "https://nsreptiles.net/cenovnik.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Cenovnik terarijuma i akvarijuma | NS Reptiles"
  description="Kompletna lista proizvoda sa cenama — terarijumi, akvarijumi i oprema za reptile. NS Reptiles, Novi Sad. Za tačnu ponudu pozovite ili pišite."
  path="/cenovnik.html"
  image="/style/img/logo.jpg"
  ogTitle="Cenovnik | NS Reptiles, Novi Sad"
  ogDescription="Terarijumi, akvarijumi i oprema za reptile — pogledajte kompletnu ponudu NS Reptiles iz Novog Sada."
  translations={translationsFor("/cenovnik.html")}
  langLinks={{ ...{"en":"/en/","ru":"/ru/"}, ...translationsFor("/cenovnik.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">NS Reptiles, Novi Sad</div>
        <h1>Cenovnik</h1>
        <p>Terarijumi, akvarijumi i oprema izradjeni po vašim merama. Vecina cena se formira individualno — za tačnu ponudu javite nam se pre porudžbine.</p>
      </div>
    </section>
<section class="cn-section reveal">
      <div class="wrap">

        <div class="cn-note">
          <p>Cene su <strong>informativnog karaktera</strong>. Za tačnu ponudu po vašim merama i željama, slobodno nas kontaktirajte telefonom ili putem WhatsApp-a — odgovaramo brzo.</p>
