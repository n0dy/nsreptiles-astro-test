---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Koji reptil je najbolji za početnike?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Leopard gekon i bradata agama su najčešći izbor za prve vlasnike reptila. Leopard gekon je miran, jede insekte i ne zahteva prevelik terarijum. Bradata agama je društvenija i jede i biljnu i životinjsku hranu. Crested gekon je takođe odličan - hrani se gotovom mešavinom i ne treba mu grejna lampa na sobnoj temperaturi."
        }
      },
      {
        "@type": "Question",
        "name": "Koliko je komplikovano držanje reptila?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Manje nego što većina misli. Kada se jednom postavi terarijum sa odgovarajućom temperaturom, UVB osvetljenjem i vlažnošću, svakodnevna briga svodi se na hranjenje, svežu vodu i proveru uslova. Nema šetanja, nema buke, nema dlaka po stanu."
        }
      },
      {
        "@type": "Question",
        "name": "Da li se reptili naviknu na vlasnika?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Reptili ne pokazuju naklonost kao psi ili mačke, ali se naviknu na prisustvo i rukovanje. Bradate agame su poznate po tome što tolerišu i uživaju u kontaktu. Gekoni postaju mirni kad ih redovno uzimate u ruke. Ključ je strpljenje i nežan pristup od mladog uzrasta."
        }
      },
      {
        "@type": "Question",
        "name": "Koliko često treba hraniti reptile?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Zavisi od vrste i uzrasta. Mladunci većine vrsta jedu svakodnevno jer brzo rastu. Odrasli leopard gekoni jedu svaki drugi dan, bradate agame svakodnevno (kombinacija salate i insekata), a loptasti pitoni jednom u 7-14 dana. Pravilo je ponuditi onoliko hrane koliko životinja može da pojede za 10-15 minuta."
        }
      },
      {
        "@type": "Question",
        "name": "Šta jedu reptili - da li svi jedu insekte?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ne. Postoje tri tipa ishrane: insektivori (leopard gekoni - jedu samo insekte), omnivori (bradate agame - jedu insekte i povrće) i herbivori (kopnene kornjače - jedu samo biljke). Bitno je znati potrebe konkretne vrste pre kupovine."
        }
      },
      {
        "@type": "Question",
        "name": "Kako odrediti pravu veličinu hrane?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Osnovno pravilo: insekt ne sme biti veći od razmaka između očiju reptila. Prevelika hrana može izazvati probleme sa varenjem ili u retkim slučajevima gušenje. Kod nas dubia i fobasi dolaze u tri veličine (S, M, L) - birate prema uzrastu vaše životinje."
        }
      },
      {
        "@type": "Question",
        "name": "Živa ili sušena hrana - šta je bolje?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Živa hrana je uvek prvi izbor. Pokret insekta stimuliše lovački instinkt reptila i podstiče prirodno ponašanje. Živi insekti imaju i više vlage i hranljivih materija. Sušeni insekti mogu poslužiti kao dodatak ili rezerva, ali ne bi trebalo da budu osnova ishrane."
        }
      },
      {
        "@type": "Question",
        "name": "Da li reptili mogu da jedu samo jednu vrstu insekta?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mogu, ali ne bi trebalo. Raznovrsna ishrana - kombinacija dubia, cvrčaka, lateralisa i fobasa - obezbeđuje bolji balans proteina, masti, kalcijuma i vlage. Monotona ishrana može dovesti do nutritivnih deficita."
        }
      },
      {
        "@type": "Question",
        "name": "Koji insekti su najbolji za hranjenje reptila?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dubia bubašvabe su najpopularnije - imaju visok procenat proteina, malo masti i mekši oklop koji je lak za varenje. Cvrčci, lateralisi (red runner), fobasi i brašnari su takođe česta hrana. Najbolji rezultati su kada se kombinuje više vrsta insekata za nutritivni balans."
        }
      },
      {
        "@type": "Question",
        "name": "Da li su dubia bubašvabe bezbedne za reptile?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Potpuno bezbedne. Dubia bubašvabe ne grizu i ne napadaju životinje, zbog čega su jedan od najpopularnijih feeder insekata u teraristici. Mogu se ostaviti u terarijumu bez rizika da oštete reptila."
        }
      },
      {
        "@type": "Question",
        "name": "Da li su fobasi dobra hrana za reptile?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fobasi su bogati proteinima ali imaju i više masti u odnosu na dubia bubašvabe. Zato se koriste kao dopunska hrana ili povremena poslastica, ne kao jedini izvor ishrane."
        }
      },
      {
        "@type": "Question",
        "name": "Šta je gut loading i da li je potreban?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Gut loading znači hranjenje insekata kvalitetnom hranom 24-48 sati pre nego što ih date reptilu. Insekti koji su se hranili povrćem, voćem ili specijalnom hranom prenose više hranljivih materija vašem ljubimcu. Jeste potreban - razlika u kvalitetu ishrane je značajna."
        }
      },
      {
        "@type": "Question",
        "name": "Kako čuvati feeder insekte kod kuće?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Insekti se drže u dobro provetrenim plastičnim kutijama na sobnoj temperaturi (za dubia 25-30°C). Treba im hrana (povrće, voće ili specijalna hrana za insekte), skrovišta od kartonskih uložaka za jaja i pristup vlazi. Pravilno čuvanje produžava životni vek i nutritivni kvalitet insekata."
        }
      },
      {
        "@type": "Question",
        "name": "Zašto je UVB osvetljenje neophodno?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "UVB svetlo omogućava reptilima da u koži sintetišu vitamin D3, koji je neophodan za apsorpciju kalcijuma iz hrane. Bez UVB osvetljenja reptili razvijaju metaboličku bolest kostiju - deformitete, slabost i ozbiljne zdravstvene probleme. Pustinjskim vrstama treba 10-12% UVB, šumskim 5-7%."
        }
      },
      {
        "@type": "Question",
        "name": "Da li insekte treba posipati kalcijumom i vitaminima?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Da, to je obavezno za većinu vrsta reptila. Kalcijum bez D3 koristi se svakodnevno - pospe se po insektima pre hranjenja. Vitaminski preparat ili kalcijum sa D3 daje se 2-3 puta nedeljno. Bez suplementacije reptili razvijaju metaboličku bolest kostiju."
        }
      },
      {
        "@type": "Question",
        "name": "Da li reptilima treba voda?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Da. Većina reptila treba posudu sa svežom vodom u terarijumu koja se menja svakodnevno. Neke vrste poput crested gekona i kameleona uzimaju vlagu lizanjem kapljica sa lišća i zidova - njima je potrebno i orošavanje terarijuma. Vodene kornjače žive u vodi."
        }
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Česta pitanja - reptili, ishrana i oprema | NS Reptiles"
  description="Odgovori na najčešća pitanja o reptilima, terarijumima i opremi. Ishrana, UVB osvetljenje, kalcijum, feeder insekti i nega gekona, agama i zmija."
  path="/cesta-pitanja.html"
  image="/style/img/logo.jpg"
  ogTitle="Česta pitanja o reptilima i opremi | NS Reptiles"
  ogDescription="Sve što treba da znate o držanju reptila - ishrana, oprema, terarijumi, UVB osvetljenje i suplementi."
  translations={translationsFor("/cesta-pitanja.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Podrška</div>
        <h1>Česta pitanja</h1>
        <p>
          Odgovori na pitanja koja najčešće dobijamo od kupaca i budućih
          vlasnika reptila - od izbora prvog ljubimca do ishrane i opreme.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Kako da pomognemo?</div>
          <p>
            Sakupili smo odgovore na pitanja koja nam stižu svakodnevno. Ako ne
            pronađete odgovor na vaše pitanje,
            <strong><a href="/kontakt.html" style="color: var(--green-ink)">kontaktirajte nas</a></strong>
            - rado ćemo pomoći oko izbora životinje, terarijuma ili opreme.
          </p>
        </div>
      </div>
    </section>
<section class="faq-page">
      <div class="wrap">
        <div class="pills">
          <button class="pill" data-target="ljubimci">Reptili kao ljubimci</button>
          <button class="pill" data-target="ishrana">Ishrana</button>
          <button class="pill" data-target="insekti">Feeder insekti</button>
          <button class="pill" data-target="oprema">Oprema i uslovi</button>
        </div>

        <!-- REPTILI KAO LJUBIMCI -->
        <div class="faq-cat" id="cat-ljubimci">
          <div class="cat-title">
            <h2>Reptili kao <b>kućni ljubimci</b></h2>
            <span class="count">3 pitanja</span><span class="line"></span>
          </div>
          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-q">
                Koji reptil je najbolji za početnike?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Leopard gekon i bradata agama su najčešći izbor za prve
                  vlasnike reptila. Leopard gekon je miran, jede insekte i ne
                  zahteva prevelik terarijum. Bradata agama je društvenija i
                  jede i biljnu i životinjsku hranu. Crested gekon je takođe
                  odličan - hrani se gotovom mešavinom i ne treba mu grejna
                  lampa na sobnoj temperaturi. Pre kupovine uvek se raspitajte o
                  konkretnim zahtevima vrste - veličina terarijuma, temperatura,
                  vlažnost i ishrana razlikuju se od životinje do životinje.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Koliko je komplikovano držanje reptila?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Manje nego što većina misli. Kada se jednom postavi terarijum
                  sa odgovarajućom temperaturom, UVB osvetljenjem i vlažnošću,
                  svakodnevna briga svodi se na hranjenje, svežu vodu i proveru
                  uslova. Nema šetanja, nema buke, nema dlaka po stanu. Potrebno
                  je održavati čistoću terarijuma i periodično proveravati da
                  oprema radi ispravno.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Da li se reptili naviknu na kontakt sa vlasnikom?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Reptili ne pokazuju naklonost kao psi ili mačke, ali se
                  naviknu na prisustvo i rukovanje. Bradate agame su poznate po
                  tome što tolerišu i uživaju u kontaktu sa čovekom. Gekoni
                  postaju mirni kad ih redovno uzimate u ruke. Ključ je
                  strpljenje i nežan pristup od mladog uzrasta - nikad ih ne
                  hvatajte naglo odozgo jer to imitira grabljivicu.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- ISHRANA -->
        <div class="faq-cat" id="cat-ishrana">
          <div class="cat-title">
            <h2>Ishrana <b>reptila</b></h2>
            <span class="count">5 pitanja</span><span class="line"></span>
          </div>
          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-q">
                Koliko često treba hraniti reptile?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Zavisi od vrste i uzrasta. Mladunci većine vrsta jedu
                  svakodnevno jer brzo rastu. Odrasli leopard gekoni jedu svaki
                  drugi dan, bradate agame svakodnevno (kombinacija salate i
                  insekata), a loptasti pitoni jednom u 7–14 dana. Praktično
                  pravilo: ponudite onoliko hrane koliko životinja može da
                  pojede za 10–15 minuta, pa uklonite ostatak.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Da li svi reptili jedu insekte?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Ne. Postoje tri tipa ishrane kod reptila: insektivori jedu
                  samo insekte (leopard gekoni, dnevni gekoni), omnivori jedu
                  insekte i biljnu hranu (bradate agame, plavi jezičasti
                  skinkovi), a herbivori jedu samo biljke (kopnene kornjače,
                  iguane). Bitno je znati potrebe konkretne vrste pre kupovine
                  kako biste obezbedili pravilnu ishranu od prvog dana.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Kako odrediti pravu veličinu hrane za reptila?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Osnovno pravilo - insekt ne sme biti veći od razmaka između
                  očiju vašeg reptila. Prevelika hrana može izazvati probleme sa
                  varenjem. Kod nas u ponudi dubia i fobasi dolaze u tri
                  veličine (S, M, L) tako da lako birate prema uzrastu vaše
                  životinje.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Živa ili sušena hrana - šta je bolje za reptile?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Živa hrana je uvek prvi izbor. Pokret insekta stimuliše
                  lovački instinkt reptila, podstiče aktivnost i prirodno
                  ponašanje. Živi insekti imaju i više vlage i hranljivih
                  materija od sušenih. Sušeni insekti služe kao dopuna ili
                  rezerva kada živa hrana nije dostupna, ali ne bi trebalo da
                  budu osnova ishrane.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Da li je dovoljno davati samo jednu vrstu insekta?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Tehnički može, ali ne bi trebalo. Raznovrsna ishrana -
                  kombinacija dubia bubašvaba, cvrčaka, lateralisa i fobasa -
                  obezbeđuje bolji balans proteina, masti, kalcijuma i vlage.
                  Monotona ishrana jednom vrstom insekta može dovesti do
                  nutritivnih deficita tokom vremena.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- INSEKTI -->
        <div class="faq-cat" id="cat-insekti">
          <div class="cat-title">
            <h2>Insekti - <b>hrana za reptile</b></h2>
            <span class="count">5 pitanja</span><span class="line"></span>
          </div>
          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-q">
                Koje insekte koristiti za hranjenje reptila?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Najpopularniji feeder insekti su dubia bubašvabe, cvrčci,
                  lateralisi (red runner), fobasi i brašnari. Dubia bubašvabe su
                  prvi izbor za većinu vlasnika jer imaju visok procenat
                  proteina, malo masti i mekši oklop koji je lak za varenje.
                  Najbolji rezultati se postižu kombinovanjem više vrsta za
                  potpun nutritivni profil.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Da li dubia bubašvabe mogu da povrede reptila?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Ne, potpuno su bezbedne. Dubia bubašvabe ne grizu i ne
                  napadaju životinje, što ih čini jednim od najsigurnijih feeder
                  insekata. Za razliku od cvrčaka koji mogu grickati reptila
                  tokom noći, dubia se mirno kriju i čekaju da budu pojedene.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Jesu li fobasi dobra hrana za reptile?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Fobasi su bogati proteinima i većina reptila ih obožava, ali
                  imaju više masti u poređenju sa dubia bubašvabama. Zato se
                  preporučuju kao dopunska hrana ili povremena poslastica, ne
                  kao jedini izvor ishrane. Kombinujte ih sa dubia i cvrčcima za
                  uravnotežen obrok.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Šta je gut loading i zašto je bitan?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Gut loading je hranjenje insekata kvalitetnom hranom 24–48
                  sati pre nego što ih date reptilu. Insekti koji su jeli
                  povrće, voće ili specijalnu hranu prenose znatno više
                  hranljivih materija vašem ljubimcu. Razlika u kvalitetu
                  ishrane je značajna - insekt koji je gladovao nema šta da
                  ponudi osim praznih kalorija.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Kako pravilno čuvati feeder insekte?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Insekti se drže u dobro provetrenim plastičnim kutijama. Za
                  dubia bubašvabe optimalna temperatura je 25–30°C. Obezbedite
                  im hranu (povrće, voće ili specijalna hrana za insekte),
                  skrovišta od kartonskih uložaka za jaja i izvor vlage.
                  Pravilnim čuvanjem insekti ostaju zdravi i nutritivno
                  kvalitetni nedeljama.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- OPREMA -->
        <div class="faq-cat" id="cat-oprema">
          <div class="cat-title">
            <h2>Oprema i <b>uslovi u terarijumu</b></h2>
            <span class="count">3 pitanja</span><span class="line"></span>
          </div>
          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-q">
                Zašto je UVB osvetljenje neophodno za reptile?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  UVB svetlo omogućava reptilima da u koži sintetišu vitamin D3,
                  neophodan za apsorpciju kalcijuma iz hrane. Bez UVB
                  osvetljenja reptili razvijaju metaboličku bolest kostiju -
                  deformitete, slabost i ozbiljne zdravstvene probleme koji mogu
                  biti fatalni. Pustinjskim vrstama (bradate agame) treba 10–12%
                  UVB lampa, šumskim (crested gekoni) 5–7%. Lampe se menjaju na
                  svakih 6–12 meseci jer UVB emitovanje slabi.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Da li insekte treba posipati kalcijumom pre hranjenja?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Da, suplementacija je obavezna. Kalcijum bez D3 koristi se
                  svakodnevno - pospe se po insektima neposredno pre hranjenja
                  (tzv. dusting). Vitaminski preparat ili kalcijum sa D3 daje se
                  2–3 puta nedeljno. Bez suplementacije reptili ne dobijaju
                  dovoljno kalcijuma čak ni uz pravilnu ishranu.
                </p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Da li reptilima treba voda u terarijumu?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>
                  Da. Većina reptila treba posudu sa svežom vodom koja se menja
                  svakodnevno. Neke arborealne vrste poput crested gekona i
                  kameleona uzimaju vlagu lizanjem kapljica sa lišća i zidova
                  terarijuma - njima je pored posude potrebno i redovno
                  orošavanje. Vodene kornjače žive u vodi, pa im treba
                  ter-akvarijum sa vodenim delom.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">
          Niste našli odgovor?
        </div>
        <h2>Pitajte nas <b>direktno</b></h2>
        <p>
          Javite nam se - rado ćemo odgovoriti na svako pitanje o životinjama,
          terarijumima i opremi.
        </p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
