        <div class="op-empty" id="opEmpty">
          No results for your search. <a href="/en/3d-backgrounds.html">Show all backgrounds</a>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Interested?</div>
        <h2>Custom <b>3D background</b></h2>
        <p>
          Send us the dimensions of your aquarium or terrarium and the material
          you want - we will make a unique 3D background tailored exactly to your needs.
        </p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Call us</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Other services</div>
          <h2>Everything in <b>one place</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/en/custom-terrariums.html">Custom terrariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-aquariums.html">Custom aquariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/led-lighting.html">Custom LED lighting<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/equipment.html">Terrarium equipment<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>

<script is:inline slot="after">
      // pretraga po nazivu pozadine
      const bgCards = [...document.querySelectorAll('.op-card')];
      const bgCount = document.getElementById('opCount');
      const bgEmpty = document.getElementById('opEmpty');
      const bgSearch = document.getElementById('opSearch');

      function bgApply() {
        const q = bgSearch.value.trim().toLowerCase();
        let n = 0;
        bgCards.forEach((c) => {
          const show = !q || c.dataset.search.includes(q);
          c.style.display = show ? '' : 'none';
          if (show) n++;
        });
        bgCount.textContent =
          n + (n === 1 ? ' model' : ' models');
        bgEmpty.classList.toggle('show', n === 0);
      }

      bgSearch.addEventListener('input', bgApply);
    </script>
</Base>
