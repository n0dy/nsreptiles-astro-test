---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "3D Backgrounds for Aquariums and Terrariums",
    "description": "Unique custom 3D backgrounds made from natural materials - tufa stone, rock imitation, peat and tree bark.",
    "brand": {
      "@type": "Brand",
      "name": "NS Reptiles"
    },
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "RSD",
      "price": "0",
      "seller": {
        "@type": "Organization",
        "name": "NS Reptiles"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://nsreptiles.net/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "3D backgrounds",
        "item": "https://nsreptiles.net/en/3d-backgrounds.html"
      }
    ]
  }
];
---
<Base
  lang="en"
  title="Custom 3D Aquarium & Terrarium Backgrounds | NS Reptiles"
  description="Custom 3D backgrounds for aquariums and terrariums - natural tufa stone, rock imitation, peat and tree bark. Unique designs, made in Novi Sad."
  keywords="3D aquarium background, 3D terrarium background, custom 3D background, tufa stone background, rock background, aquarium decoration, NS Reptiles"
  path="/en/3d-backgrounds.html"
  image="/style/img/backgrounds/poz001.webp"
  ogTitle="3D Backgrounds for Aquariums and Terrariums - NS Reptiles"
  ogDescription="Unique custom 3D backgrounds for aquariums and terrariums. Made from natural materials - tufa stone, rock, peat."
  translations={translationsFor("/en/3d-backgrounds.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Custom builds</div>
        <h1>3D backgrounds for aquariums and terrariums</h1>
        <p>
          Unique custom 3D backgrounds made from natural materials - tufa stone,
          rock imitation, peat and tree bark. Every background is handmade
          to the dimensions of your aquarium or terrarium.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">What we offer</div>
          <p>
            We make 3D backgrounds from top-quality materials. We offer
            backgrounds with <strong>natural tufa stone</strong>, rock
            imitation, a combination of <strong>peat and tree bark</strong>, as well as
            a 3D logo of your brand or company. All backgrounds are made to measure, so
            they fit the back wall of your aquarium or terrarium perfectly.
          </p>
        </div>
      </div>
    </section>
<section class="op-shop">
      <div class="wrap">
        <div class="op-toolbar">
          <div class="op-search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M21 21l-4.3-4.3"></path>
            </svg>
            <input type="text" id="opSearch" placeholder="Search backgrounds...">
          </div>
        </div>
        <div class="op-count" id="opCount">12 models</div>
        <div class="op-grid" id="opGrid">
          <article class="op-card" data-search="background 100x40cm m001">
            <div class="op-img"><img src="/style/img/backgrounds/poz001.webp" alt="3D background for aquarium and terrarium 100x40cm M001" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
              <div class="op-cat">3D background</div>
              <h3>Background 100x40cm M001</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Price on request</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="background 100x40cm m002">
            <div class="op-img"><img src="/style/img/backgrounds/poz002.webp" alt="3D background for aquarium and terrarium 100x40cm M002" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
              <div class="op-cat">3D background</div>
              <h3>Background 100x40cm M002</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Price on request</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="background 100x40cm m003">
            <div class="op-img"><img src="/style/img/backgrounds/poz003.webp" alt="3D background for aquarium and terrarium 100x40cm M003" loading="lazy" width="600" height="600"></div>
            <div class="op-body">
