        </div>
        <div class="op-grid">
          <article class="op-card reveal">
            <a class="op-img" href="/en/products/terrariums/terrarium-50x35x35.html">
              <img src="/style/img/terrariums/50x35x35-2.webp" alt="Terrarium 50x35x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terrarium</div>
              <h3><a href="/en/products/terrariums/terrarium-50x35x35.html">Terrarium 50x35x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Price on request</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/en/products/terrariums/terrarium-45x35x35.html">
              <img src="/style/img/terrariums/45x35x35.webp" alt="Terrarium 45x35x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terrarium</div>
              <h3><a href="/en/products/terrariums/terrarium-45x35x35.html">Terrarium 45x35x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Price on request</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/en/products/terrariums/terrarium-65x35x35.html">
              <img src="/style/img/terrariums/t-65x35x35-bele-plocice-web.webp" alt="Terrarium 65x35x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terrarium</div>
              <h3><a href="/en/products/terrariums/terrarium-65x35x35.html">Terrarium 65x35x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Price on request</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/en/products/terrariums/terrarium-70x40x35.html">
              <img src="/style/img/terrariums/70x40x35.webp" alt="Terrarium 70x40x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terrarium</div>
              <h3><a href="/en/products/terrariums/terrarium-70x40x35.html">Terrarium 70x40x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Price on request</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content:center">Interested?</div>
        <h2>Contact <b>NS Reptiles</b></h2>
        <p>For questions about getting a leopard gecko, its care or equipment — we are here. Give us a call or send a message.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=I%27m%20interested%20in%20a%20leopard%20gecko" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
