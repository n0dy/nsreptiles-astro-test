    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/en/animals/leopard-gecko.html"
