    "@type": "CollectionPage",
    "name": "Glass Aquariums & Ter-Aquariums | NS Reptiles",
    "description": "Hand-glued glass aquariums, starter kits and ter-aquariums for water turtles. Custom sizes available.",
    "url": "https://nsreptiles.net/en/aquariums.html",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      },
      "telephone": "+381693301474",
      "email": "bata.dino00@gmail.com"
    }
  }
];
