---
import Base from '../../layouts/Base.astro';

import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="en"
  title="Checkout - NS Reptiles"
  description="Complete your NS Reptiles order: courier delivery in 2–4 business days across Serbia or personal pickup in Novi Sad, cash on delivery or bank transfer."
  path="/en/cart.html"
  active="home"
  bodyClass="checkout-page"
  cart={false}
  floatContact={false}
  translations={translationsFor("/en/cart.html")}
>
<div class="co-top">
      <div class="wrap">
        <div class="crumb">Home · Cart · Checkout</div>
        <div class="co-top-row">
          <h1>Checkout</h1>
          <a href="/en/" class="back-link">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            Continue Shopping
          </a>
        </div>
      </div>
    </div>
<div class="co-wrap">
      <div id="coContent">
        <div class="co-grid">
          <!-- LEFT: form -->
          <div>
            <div class="card">
              <h2><span class="step-no">1</span> Contact Information</h2>
              <p class="sub">So we can update you on order status.</p>
              <div class="f-row">
                <div class="field">
                  <label>First Name</label><input type="text" id="fName" placeholder="John">
                </div>
                <div class="field">
                  <label>Last Name</label><input type="text" id="fLast" placeholder="Smith">
                </div>
              </div>
              <div class="f-row">
                <div class="field">
                  <label>E-mail</label><input type="email" id="fEmail" placeholder="john@email.com">
                </div>
                <div class="field">
                  <label>Phone</label><input type="tel" id="fPhone" placeholder="+381 6x xxx xxxx">
                </div>
              </div>
            </div>

            <div class="card">
              <h2><span class="step-no">2</span> Shipping Address</h2>
              <p class="sub">Where should we send your order.</p>
              <div class="field full">
                <label>Street Address</label><input type="text" id="fStreet" placeholder="123 Main Street">
              </div>
              <div class="f-row">
                <div class="field">
                  <label>City</label><input type="text" id="fCity" placeholder="Novi Sad">
                </div>
                <div class="field">
                  <label>ZIP Code</label><input type="text" id="fZip" placeholder="21000">
                </div>
              </div>
              <div class="field full">
                <label>Note (optional)</label><textarea id="fNote" placeholder="E.g. leave with neighbor, call before delivery..."></textarea>
              </div>
            </div>

            <div class="card">
              <h2><span class="step-no">3</span> Shipping Method</h2>
              <p class="sub">Choose how you want to receive your order.</p>
              <label class="opt sel" data-ship="290">
                <input type="radio" name="ship" value="290" checked=""><span class="dot"></span>
                <div class="opt-main">
                  <b>Courier Delivery</b><small>2–4 business days, all of Serbia</small>
                </div>
                <span class="opt-price">290 RSD</span>
              </label>
              <label class="opt" data-ship="0">
                <input type="radio" name="ship" value="0"><span class="dot"></span>
                <div class="opt-main">
                  <b>Personal Pickup</b><small>Novi Sad, by arrangement</small>
                </div>
                <span class="opt-price">Free</span>
              </label>
            </div>

            <div class="card">
              <h2><span class="step-no">4</span> Payment Method</h2>
              <p class="sub">Safe and simple.</p>
              <label class="opt sel">
                <input type="radio" name="pay" value="cod" checked=""><span class="dot"></span>
                <div class="opt-main">
                  <b>Cash on Delivery</b><small>Pay the courier upon delivery</small>
                </div>
              </label>
              <label class="opt">
                <input type="radio" name="pay" value="transfer"><span class="dot"></span>
                <div class="opt-main">
                  <b>Bank Transfer</b><small>Invoice sent to your e-mail</small>
                </div>
              </label>
            </div>
          </div>

          <!-- RIGHT: order summary -->
          <div class="summary-col">
            <div class="card summary">
              <h2>Your Order</h2>
              <div id="sumItems"></div>
              <div class="promo">
                <input type="text" id="promo" placeholder="Promo Code">
                <button id="promoBtn">Apply</button>
              </div>
              <div class="sum-line">
                <span>Subtotal</span><span id="sumSub">0 RSD</span>
              </div>
              <div class="sum-line">
                <span>Shipping</span><span id="sumShip">290 RSD</span>
              </div>
              <div class="sum-line" id="sumDiscRow" style="display: none">
                <span>Discount</span><span id="sumDisc">0 RSD</span>
              </div>
              <div class="sum-line total">
                <span>Total</span><b id="sumTotal">0 RSD</b>
              </div>
              <button class="btn btn-primary place-btn" id="placeBtn">
                Place Order
              </button>
              <div class="co-secure">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0110 0v4"></path>
                </svg>
                Secure Checkout
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>


</Base>
