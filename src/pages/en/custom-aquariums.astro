---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Custom Aquarium Building",
    "serviceType": "Custom Aquarium Building",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Serbia",
    "description": "Custom-built glass aquariums in Novi Sad. Handcrafted tanks for fish and turtles, 40+ vinyl wrap designs, LED lighting, filters, and 3D backgrounds. Ready in 7 business days.",
    "url": "https://nsreptiles.net/en/custom-aquariums.html"
  }
];
---
<Base
  lang="en"
  title="Custom Aquariums — Made-to-Order Glass Tanks | NS Reptiles"
  description="Custom-built glass aquariums in Novi Sad for fish and turtles: 40+ vinyl wrap designs, LED lighting, filters and 3D backgrounds. Ready in 7 business days."
  path="/en/custom-aquariums.html"
  ogTitle="Custom Aquariums | NS Reptiles"
  ogDescription="Hand-sealed glass aquariums built to your exact dimensions — vinyl wraps, LED lighting, filters, and full equipment. Novi Sad."
  translations={translationsFor("/en/custom-aquariums.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Custom Aquariums</h1>
        <p>Every aquarium we build is handcrafted from glass, made to your exact measurements and preferences — with your choice of vinyl wrap, LED lighting, and full equipment.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>From the first contact to pick-up, we walk you through a few simple steps. Not sure what size is best for your fish or turtles? <strong>We're happy to help</strong> you make the right choice.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="proc">
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Get in touch</h3>
              <p>Reach out by phone, email, or social media and let us know the dimensions you have in mind. If you're not sure what size works best for your fish or turtles, we'll be happy to guide you to the right choice.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Choose your wrap</h3>
              <p>We offer over 40 different vinyl wrap designs, so you can easily match the aquarium to your interior. We can also apply a black lacquer finish instead of vinyl if you prefer a cleaner look.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Pick a 3D background</h3>
              <p>Classic photo print, factory-style backdrop, 3D polystyrene background, natural stone 3D background, or no background at all — the choice is entirely yours.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Lighting &amp; equipment</h3>
              <p>We offer energy-efficient, long-lasting LED lighting. You can add two lighting modes — day and night — with switches on the tank itself and optional remote control. We also help you choose the right filter, pump, heater, substrate, and decorations.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>30% deposit</h3>
              <p>A minimum deposit of 30% of the total price is required to start the build. The remaining balance is due upon completion, when you collect the aquarium.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Build time — 7 business days</h3>
              <p>The standard lead time for an aquarium is 7 business days. For larger or more complex builds, the timeline may be longer.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Pick up your aquarium</h3>
              <p>You can collect your aquarium in person in Novi Sad, or we can ship it by bus to your city — shipping costs are covered by the buyer. For larger tanks we can also arrange delivery by van.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Your aquarium, <b>built to order</b></h2>
        <p>Send us your dimensions and intended use — we'll build an aquarium that fits your space perfectly, with LED lighting of your choice.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Call us</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Everything in <b>one place</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/en/custom-terrariums.html">Custom terrariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-vivariums.html">Custom vivariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/led-lighting.html">Custom LED lighting<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/maintenance.html">Maintenance &amp; setup<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/repair.html">Repair &amp; servicing<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
