---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Custom Terrarium Builds",
    "serviceType": "Custom Terrarium Manufacturing",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Serbia",
    "description": "Custom-built glass terrariums in Novi Sad. Handcrafted terrariums for bearded dragons, geckos and pythons — 40+ film finishes, 3D backgrounds and UVB lighting. Ready in 7 working days.",
    "url": "https://nsreptiles.net/en/custom-terrariums.html"
  }
];
---
<Base
  lang="en"
  title="Custom Glass Terrarium Builds in Novi Sad | NS Reptiles"
  description="Custom glass terrariums in Novi Sad for bearded dragons, geckos and pythons — 40+ film finishes, 3D backgrounds and UVB lighting. Ready in 7 working days."
  path="/en/custom-terrariums.html"
  ogTitle="Custom Terrarium Builds | NS Reptiles"
  ogDescription="Handcrafted glass terrariums built to your exact dimensions — decorative films, 3D backgrounds, lighting and full equipment. Novi Sad."
  translations={translationsFor("/en/custom-terrariums.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Custom Builds</div>
        <h1>Custom Terrarium Builds</h1>
        <p>Every terrarium is handcrafted from glass, built to your exact dimensions and preferences — with the decorative film of your choice, a 3D background, and full equipment included.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">How do you get your terrarium?</div>
          <p>From your first inquiry to pick-up, we walk you through a few straightforward steps. Not sure what size is right for your animal? <strong>We're happy to help</strong> you make the right call.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="proc">
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Get in touch</h3>
              <p>Reach us by phone, email or social media and tell us what dimensions you have in mind. If you're not sure what size suits your pet best, we'll gladly help you figure it out.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Choose your finish</h3>
              <p>With over 40 decorative film options available, you can easily match the terrarium to the rest of your interior. There's also the option of finishing the terrarium in black lacquer board instead of film.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Pick a 3D background</h3>
              <p>A printed picture film, a factory panel, a 3D polystyrene background, a 3D natural rock stone background, or no background at all — the choice is entirely yours. Climbing branches, hides and other décor elements can be added as well.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Lighting and equipment</h3>
              <p>Proper lighting and temperature are essential for your pet's wellbeing. We'll help you choose the right UVB/UVA lighting, heaters, thermostats, substrate and decorations — all included in one price.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>30% deposit</h3>
              <p>A minimum deposit of 30% of the total price is required to start production. The remainder is due upon completion, when you collect the terrarium.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Build time — 7 working days</h3>
              <p>Standard production time is 7 working days. For more complex or larger builds, such as terrariums for a large water dragon or iguana, the lead time may be longer.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Collection</h3>
              <p>You can collect the terrarium in person in Novi Sad, or we can ship it by bus to your city — shipping costs are covered by the buyer. For larger terrariums, delivery by van can also be arranged.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Ready to start?</div>
        <h2>Your terrarium, <b>built to order</b></h2>
        <p>Send us your dimensions and the type of animal — we'll build a terrarium tailored to your exact needs, with the 3D background of your choice.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Call us</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Other services</div>
          <h2>Everything in <b>one place</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/en/custom-aquariums.html">Custom aquariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-vivariums.html">Custom vivariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/led-lighting.html">Custom LED lighting<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/maintenance.html">Maintenance &amp; setup<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/repair.html">Repairs &amp; servicing<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
