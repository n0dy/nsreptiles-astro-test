---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Custom Vivarium Building",
    "serviceType": "Custom Vivarium Building",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Serbia",
    "description": "Custom glass vivariums built to your specifications in Novi Sad. Full-spectrum lighting, 40+ decorative foil options, humidity systems, and a 7-business-day turnaround.",
    "url": "https://nsreptiles.net/en/custom-vivariums.html"
  }
];
---
<Base
  lang="en"
  title="Custom Glass Vivarium Building in Novi Sad | NS Reptiles"
  description="Custom glass vivariums in Novi Sad: full-spectrum lighting, 40+ decorative foil options, humidity systems and a 7-business-day turnaround."
  path="/en/custom-vivariums.html"
  ogTitle="Custom Vivarium Building | NS Reptiles"
  ogDescription="Handcrafted glass vivariums built to your exact dimensions — full-spectrum lighting, humidity control, and complete equipment. Novi Sad."
  translations={translationsFor("/en/custom-vivariums.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Custom vivarium building</h1>
        <p>Every vivarium is handcrafted from glass, built to your exact dimensions and preferences — with full-spectrum lighting for healthy plant growth and everything you need included.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>From the first contact to pick-up, we guide you through a few simple steps. Not sure what size works best for your plants? <strong>We're happy to help</strong> you make the right choice.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="proc">
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Get in touch</h3>
              <p>Reach out by phone, email, or social media and let us know what dimensions you have in mind. If you're not sure what size suits your plants best, we'll gladly help you figure it out.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Choose your vivarium colour</h3>
              <p>We offer over 40 different decorative foil designs, so you can easily match the vivarium to the rest of your interior. There's also the option to have it finished in black lacobel glass instead of foil.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Pick a 3D background</h3>
              <p>A printed foil, a factory model, a 3D styrofoam background, a 3D natural stone background, or no background at all — the choice is entirely yours.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Lighting and equipment</h3>
              <p>We offer ideal lighting for your vivarium, covering all the spectral needs for healthy plant growth — available in various colours and shades (red, blue, green, and white). We also help you choose heaters, thermostats, water filters, substrate, thermometers, and hygrometers.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>30% deposit</h3>
              <p>A minimum deposit of 30% of the total price is required to begin production. The remaining balance is paid upon completion, when you collect your vivarium.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Production — 7 business days</h3>
              <p>Standard build time is 7 business days. For more complex or larger projects, the timeline may be longer.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Collecting your vivarium</h3>
              <p>You can pick up your vivarium in person in Novi Sad, or we can ship it by bus to your city — shipping costs are covered by the buyer. For larger builds, we can arrange delivery by van.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Your vivarium, <b>built to order</b></h2>
        <p>Send us your dimensions and intended use — we'll build a vivarium exactly to your needs, complete with full-spectrum lighting.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Call us</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Everything in <b>one place</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/en/custom-terrariums.html">Custom terrariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-aquariums.html">Custom aquariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/led-lighting.html">Custom LED lighting<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/maintenance.html">Maintenance &amp; setup<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/repair.html">Repairs &amp; servicing<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
