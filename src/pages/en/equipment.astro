---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Terrarium & Aquarium Equipment",
    "description": "UVB lighting, heating, food and supplements, live feeders, substrates and decoration for terrariums and aquariums.",
    "url": "https://nsreptiles.net/en/equipment.html",
    "inLanguage": "en",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      },
      "telephone": "+381693301474",
      "url": "https://nsreptiles.net"
    }
  }
];
---
<Base
  lang="en"
  title="Terrarium & Aquarium Equipment | NS Reptiles, Novi Sad"
  description="Reptile equipment - UVB lighting, heating, food and supplements, live feeders (dubia, feeder roaches), substrates and decoration. NS Reptiles, Novi Sad."
  path="/en/equipment.html"
  ogTitle="Terrarium & Aquarium Equipment | NS Reptiles"
  ogDescription="UVB lighting, heating, food and supplements, live feeders, substrates and decoration for terrariums and aquariums."
