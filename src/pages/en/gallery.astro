            <div class="cap"><small>Lizard</small><b>Water Dragon</b></div>
          </div>
        </div>
      </div>
    </section>
<div class="lightbox" id="lightbox">
      <button class="lb-close" id="lbClose" aria-label="Close">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
      <button class="lb-arrow lb-prev" id="lbPrev" aria-label="Previous">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <div class="lb-img-wrap">
        <img id="lbImg" src="/" alt="">
        <div class="lb-cap" id="lbCap"></div>
      </div>
      <button class="lb-arrow lb-next" id="lbNext" aria-label="Next">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>


</Base>
