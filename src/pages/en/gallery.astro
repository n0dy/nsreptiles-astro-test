---
import Base from '../../layouts/Base.astro';

import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="en"
  title="Gallery — Terrarium and Reptile Photos | NS Reptiles"
  description="Browse the NS Reptiles gallery - photos of terrariums, aquariums, reptiles and exotic animals. Inspiration for your future terrarium."
  path="/en/gallery.html"
  active="gallery"
  bodyClass="gallery-page"
  cart={false}
  translations={translationsFor("/en/gallery.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Gallery</div>
        <h1>Our World of Exotics</h1>
        <p>
          Photos of our reptiles, terrariums and aquariums. Browse our work and
          find inspiration for your future pet home.
        </p>
      </div>
    </section>
<section class="section gallery">
      <div class="wrap">
        <div class="gal-grid" id="galGrid">
          <div class="gal-item gal-tall" data-cat="guster">
            <img src="/style/img/gallery/2.jpg" alt="Bearded Dragon">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Lizard</small><b>Bearded Dragon</b></div>
          </div>
          <div class="gal-item gal-big" data-cat="guster">
            <img src="/style/img/gallery/13.jpg" alt="Water Dragon">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Lizard</small><b>Water Dragon</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img src="/style/img/gallery/3.jpg" alt="Leopard Gecko">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Lizard</small><b>Leopard Gecko</b></div>
          </div>
          <div class="gal-item" data-cat="zmija">
            <img src="/style/img/gallery/1.jpg" alt="Ball Python">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Snake</small><b>Ball Python</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img src="/style/img/gallery/14.jpg" alt="Leopard Gecko">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Lizard</small><b>Leopard Gecko</b></div>
