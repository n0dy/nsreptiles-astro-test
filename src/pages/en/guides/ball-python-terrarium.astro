---
import Base from '../../../layouts/Base.astro';
import '../../../styles/animals.css';
import '../../../styles/usluge.css';
import { translationsFor } from '../../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Ball Python Terrarium — a Setup Guide",
    "description": "The recommended terrarium size for a ball python is about 80x40x40cm. Learn all about substrate, heating, hides and equipment.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/en/guides/ball-python-terrarium.html"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://nsreptiles.net/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terrariums",
        "item": "https://nsreptiles.net/en/terrariums.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Ball Python Terrarium",
        "item": "https://nsreptiles.net/en/guides/ball-python-terrarium.html"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What size terrarium does a ball python need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The recommended terrarium size for a ball python is about 80x40x40cm, which gives it enough room to move around and hide."
        }
      },
      {
        "@type": "Question",
        "name": "How do I maintain the temperature in a ball python terrarium?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Place a heat mat under one side of the terrarium to maintain the optimal temperature. The substrate should be coco peat."
        }
      },
      {
        "@type": "Question",
        "name": "What does a ball python terrarium need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The terrarium needs a hide and a water dish. The substrate should be coco peat, and the temperature is regulated with a heat mat."
        }
      }
    ]
  }
];
---
<Base
  lang="en"
  title="Ball Python Terrarium: Size and Setup Guide | NS Reptiles"
  description="Ball python terrarium guide: recommended size 80x40x40cm, coco peat, heat mat and a hide. Custom glass terrariums handmade in Novi Sad, Serbia."
  keywords="ball python terrarium, ball python enclosure size, ball python setup, snake terrarium, custom glass terrarium Serbia"
  path="/en/guides/ball-python-terrarium.html"
  image="/style/img/terrariums/90x45x45.webp"
  ogType="article"
  ogDescription="The recommended terrarium size for a ball python is about 80x40x40cm with a heat mat. Custom glass terrariums, Novi Sad."
  translations={translationsFor("/en/guides/ball-python-terrarium.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Ball Python Terrarium</h1>
        <p>The recommended size is about 80×40×40 cm with a heat mat under the terrarium. We build custom glass snake terrariums in Novi Sad.</p>
      </div>
    </section>
<nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="wrap">
        <a href="/en/">Home</a>
        <span>›</span>
        <a href="/en/terrariums.html">Guides</a>
        <span>›</span>
        Ball Python Terrarium
      </div>
    </nav>
<section class="animal-facts reveal">
      <div class="wrap">
        <h2>What you <b>need</b></h2>
        <div class="feat-grid">
          <div class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Terrarium size</h3>
            <p>The recommended minimum size is about 80×40×40 cm — enough room to move around and hide.</p>
          </div>
          <div class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Heating</h3>
            <p>A heat mat is placed under one side of the terrarium to create a temperature gradient.</p>
          </div>
          <div class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Substrate and equipment</h3>
            <p>Coco peat as substrate, a hide and a water dish are essential in every well-equipped terrarium.</p>
          </div>
        </div>
      </div>
    </section>
<section class="care-sections reveal">
      <div class="wrap">

        <div class="care-section">
          <div class="care-label">Dimensions</div>
          <div class="care-text">
            <p>The recommended terrarium size for a ball python is about 80×40×40 cm. These dimensions provide enough room to move around and hide, which is important for this snake's well-being. A smaller terrarium doesn't allow for a resting zone separate from the activity zone.</p>
            <p>Since we build terrariums to order, you choose the dimensions, color and equipment yourself. If you are not sure what the optimal size is for your pet, feel free to contact us before ordering.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Heating</div>
          <div class="care-text">
            <p>The temperature inside the terrarium is regulated with a heat mat placed under one side of the terrarium. This creates a temperature gradient — a warmer zone on one side and a cooler one on the other — which lets the snake regulate its own body temperature by moving around the terrarium.</p>
            <p>The heat mat must not cover the entire floor, because the animal has to be able to move to the cooler side when it needs to.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Substrate</div>
          <div class="care-text">
            <p>The recommended substrate in a ball python terrarium is coco peat. This substrate is a good fit because it holds moisture well, looks natural and is easy to clean and replace.</p>
            <p>Check the substrate regularly and replace it as needed to keep the terrarium clean and prevent bacteria and mold from growing.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Interior setup</div>
          <div class="care-text">
            <p>The terrarium needs a hide and a water dish. A hide is essential because ball pythons are known for liking to hide — without a proper shelter the snake can be constantly stressed.</p>
            <p>The water dish must be big enough for the snake to get into, because this species regularly uses water both for drinking and bathing, especially during shedding.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Custom builds</div>
          <div class="care-text">
            <p>We build all of these terrariums to order from glass. You can choose the terrarium color, size, equipment and everything else yourself. A 3D background made of styrofoam or natural tufa stone, climbing branches and hides can also be added.</p>
            <p>If you want a terrarium fully equipped for a ball python — with a heat mat, substrate, hide and water dish — we can arrange that when you order.</p>
          </div>
        </div>

      </div>
    </section>
<section class="rec-tera reveal">
      <div class="wrap">
        <div class="rec-tera-box">
          <div class="rec-tera-info">
            <h2>Recommended <b>terrarium</b></h2>
            <p>For a ball python we recommend a terrarium measuring <strong>80×40×45 cm</strong> or <strong>90×45×45 cm</strong>. We handcraft every terrarium from glass, with a decorative film or 3D background of your choice and full equipment for this species.</p>
            <a href="/en/terrariums.html" class="btn btn-primary" onclick="gtag('event', 'terarijum_click', {'vrsta': 'loptasti_piton'})">View terrariums</a>
          </div>
          <div class="rec-tera-visual">
            <img src="/style/img/terrariums/90x45x45.webp" alt="90x45x45cm glass terrarium for a ball python" loading="lazy" width="1080" height="1080">
          </div>
        </div>
      </div>
    </section>
<section class="faq-sec reveal">
      <div class="wrap">
        <h2>Frequently asked <b>questions</b></h2>
        <div class="faq-list">

          <div class="faq-item">
            <button class="faq-q">
              What size terrarium does a ball python need?<span class="ic">+</span>
            </button>
            <div class="faq-a">
              <p>The recommended terrarium size for a ball python is about 80×40×40 cm, which gives it enough room to move around and hide.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-q">
              How do I maintain the temperature in a ball python terrarium?<span class="ic">+</span>
            </button>
            <div class="faq-a">
              <p>Place a heat mat under one side of the terrarium to maintain the optimal temperature. The substrate should be coco peat.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-q">
              What does a ball python terrarium need?<span class="ic">+</span>
            </button>
            <div class="faq-a">
              <p>The terrarium needs a hide and a water dish. The substrate should be coco peat, and the temperature is regulated with a heat mat placed under one side of the terrarium.</p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="related-links reveal">
      <div class="wrap">
        <h2>Useful <b>links</b></h2>
        <div class="rel-grid">
          <a href="/en/animals/ball-python.html" class="rel-card">
            Ball python care guide
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/en/terrariums.html" class="rel-card">
            All terrariums
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/en/custom-terrariums.html" class="rel-card">
            Custom terrarium builds
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>
<section class="zcta reveal">
      <div class="wrap">
        <h2>Contact <b>us</b></h2>
        <p>Get in touch for terrarium advice or to place an order. We build terrariums to order — you choose the color, size and equipment.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Hi%2C%20I%27m%20interested%20in%20a%20ball%20python%20terrarium" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event', 'kontakt_click', {'metod': 'whatsapp', 'stranica': 'vodic_loptasti_piton'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event', 'kontakt_click', {'metod': 'poziv', 'stranica': 'vodic_loptasti_piton'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>
<style is:global>
      /* Breadcrumb */
      .breadcrumb {
        padding: 14px 0;
        background: var(--bg);
        font-size: 0.88rem;
        color: var(--ink-soft);
        border-bottom: 1px solid var(--silver);
        transition: background 0.4s, border-color 0.4s;
      }
      .breadcrumb a { color: var(--green-ink); }
      .breadcrumb span { margin: 0 7px; opacity: 0.5; }

      /* Quick info cards */
      .animal-facts {
        padding: 60px 0 30px;
        background: var(--bg);
        transition: background 0.4s;
      }
      .animal-facts h2 {
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        text-transform: uppercase;
        margin-bottom: 28px;
      }
      .animal-facts h2 b { color: var(--green-ink); }

      /* Care sections */
      .care-sections {
        padding: 40px 0 90px;
        background: var(--white);
        transition: background 0.4s;
      }
      .care-section {
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 26px;
        padding: 28px 0;
        border-bottom: 1px solid var(--silver);
        transition: border-color 0.4s;
      }
      .care-section:first-child { padding-top: 4px; }
      .care-section:last-child { border-bottom: 0; }
      .care-label {
        font-family: 'Oswald Variable', sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--green-ink);
        padding-top: 3px;
      }
      .care-text p {
        color: var(--ink-soft);
        line-height: 1.78;
        margin: 0 0 12px;
      }
      .care-text p:last-child { margin-bottom: 0; }

      /* Recommended terrarium block */
      .rec-tera {
        padding: 80px 0;
        background: var(--bg);
        transition: background 0.4s;
      }
      .rec-tera-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: center;
      }
      .rec-tera-info h2 {
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        text-transform: uppercase;
        margin-bottom: 16px;
      }
      .rec-tera-info h2 b { color: var(--green-ink); }
      .rec-tera-info p {
        color: var(--ink-soft);
        line-height: 1.75;
        margin-bottom: 26px;
      }
      .rec-tera-visual {
        background: var(--pattern);
        aspect-ratio: 4/3;
        overflow: hidden;
        transition: background 0.4s;
      }
      .rec-tera-visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
      }
      .rec-tera-visual:hover img { transform: scale(1.04); }

      /* FAQ section */
      .faq-sec {
        padding: 80px 0;
        background: var(--white);
        transition: background 0.4s;
      }
      .faq-sec h2 {
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        text-transform: uppercase;
        margin-bottom: 36px;
      }
      .faq-sec h2 b { color: var(--green-ink); }
      .faq-list { display: flex; flex-direction: column; gap: 2px; }
      .faq-item { border-bottom: 1px solid var(--silver); transition: border-color 0.4s; }
      .faq-item:first-child { border-top: 1px solid var(--silver); }
      .faq-q {
        width: 100%;
        background: none;
        border: none;
        text-align: left;
        padding: 20px 4px;
        font-family: 'Oswald Variable', sans-serif;
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--ink);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        transition: color 0.2s;
      }
      .faq-q:hover { color: var(--green-ink); }
      .faq-q .ic {
        font-size: 1.4rem;
        font-weight: 300;
        line-height: 1;
        flex-shrink: 0;
        transition: transform 0.25s;
        color: var(--green-ink);
      }
      .faq-item.open .faq-q .ic { transform: rotate(45deg); }
      .faq-a {
        display: none;
        padding: 0 4px 20px;
        color: var(--ink-soft);
        line-height: 1.78;
      }
      .faq-item.open .faq-a { display: block; }

      /* Internal links block */
      .related-links {
        padding: 60px 0;
        background: var(--bg);
        transition: background 0.4s;
      }
      .related-links h2 {
        font-size: clamp(1.3rem, 2.5vw, 1.8rem);
        text-transform: uppercase;
        margin-bottom: 24px;
      }
      .related-links h2 b { color: var(--green-ink); }
      .rel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }
      .rel-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 22px;
        background: var(--white);
        border: 1px solid var(--silver);
        color: var(--ink);
        text-decoration: none;
        font-family: 'Oswald Variable', sans-serif;
        font-weight: 500;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: border-color 0.2s, color 0.2s, background 0.4s;
        gap: 12px;
      }
      .rel-card:hover { border-color: var(--green); color: var(--green-ink); }
      .rel-card svg { flex-shrink: 0; }

      @media (max-width: 860px) {
        .care-section { grid-template-columns: 1fr; gap: 8px; }
        .rec-tera-box { grid-template-columns: 1fr; }
        .rec-tera-visual { aspect-ratio: 16/9; }
      }
    </style>
<script is:inline slot="after">
      // FAQ accordion
      document.querySelectorAll('.faq-q').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var item = this.closest('.faq-item');
          var isOpen = item.classList.contains('open');
          document.querySelectorAll('.faq-item').forEach(function(el) { el.classList.remove('open'); });
          if (!isOpen) item.classList.add('open');
        });
      });
    </script>
</Base>
