            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="usl-link" href="/en/equipment.html">
            Terrarium and aquarium equipment
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="usl-link" href="/en/faq.html">
            FAQ
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>
<section class="zcta reveal">
      <div class="wrap">
        <h2>Call us or <b>message us on WhatsApp</b></h2>
        <p>Our team at NS Reptiles will help you choose the right aquarium and equipment for you. We are available every working day from 09:00 to 17:00.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=I%27m%20interested%20in%20a%20beginner%20aquarium" target="_blank" rel="noopener" class="btn btn-primary" onclick="gtag('event', 'kontakt_click', {'metod': 'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event', 'kontakt_click', {'metod': 'telefon'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
