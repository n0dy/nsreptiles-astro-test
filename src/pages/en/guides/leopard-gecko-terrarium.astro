    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Leopard Gecko Terrarium — Size, Equipment and Setup",
    "description": "Recommended leopard gecko terrarium dimensions, heat mat heating, coco peat, humidity and common mistakes. An NS Reptiles guide.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/en/guides/leopard-gecko-terrarium.html"
    },
    "image": "https://nsreptiles.net/style/img/terrariums/50x35x35-7.webp"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://nsreptiles.net/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terrariums",
        "item": "https://nsreptiles.net/en/terrariums.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
