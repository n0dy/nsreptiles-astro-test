        </p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=I%27m%20interested%20in%20Red%20Moor%20Wood%20for%20my%20aquarium" target="_blank" rel="noopener" class="btn btn-primary" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','telefon_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>
<style is:global>
