---
import Base from '../../../layouts/Base.astro';
import '../../../styles/animals.css';
import '../../../styles/usluge.css';
import { translationsFor } from '../../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Turtle Aquarium — a Setup Guide",
    "description": "A complete guide to an aquarium for an aquatic turtle: dimensions, filtration, basking area, heating and UVB. Custom aqua-terrariums in Novi Sad.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/en/guides/turtle-aquarium.html"
    },
    "image": "https://nsreptiles.net/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://nsreptiles.net/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Aquariums",
        "item": "https://nsreptiles.net/en/aquariums.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Turtle Aquarium",
        "item": "https://nsreptiles.net/en/guides/turtle-aquarium.html"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What kind of aquarium does an aquatic turtle need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An aquatic turtle needs an aqua-terrarium with both a water section and a land section, so the turtle can swim and also rest on dry ground. A water-only aquarium without a land section is not suitable."
        }
      },
      {
        "@type": "Question",
        "name": "What aquarium dimensions does a turtle need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The dimensions depend on the size of the turtle. We offer aqua-terrariums from 50x35x45cm to 100x45x45cm, and we also build them to order to fit your needs."
        }
      },
      {
        "@type": "Question",
        "name": "Does a turtle aquarium need filtration?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, filtration is a must. Turtles foul the water faster than fish, so you need a filter with enough capacity to keep the water clear and healthy."
        }
      }
    ]
  }
];
---
<Base
  lang="en"
  title="Turtle Aquarium Setup: Size, Filter and UVB | NS Reptiles"
  description="Complete guide to an aquatic turtle aquarium: dimensions, filtration, basking area, heating and UVB. Custom aqua-terrariums made in Novi Sad, Serbia."
  keywords="turtle aquarium, aquatic turtle tank, turtle aqua-terrarium, turtle tank setup, turtle basking area, custom turtle tank Serbia"
  path="/en/guides/turtle-aquarium.html"
  image="/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
  ogType="article"
  ogDescription="Everything you need to know about setting up an aquarium for an aquatic turtle: dimensions, filtration, land section, heating and common mistakes."
  translations={translationsFor("/en/guides/turtle-aquarium.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Turtle Aquarium</h1>
        <p>An aqua-terrarium with a land and a water section — everything you need to know before setting up an enclosure for an aquatic turtle.</p>
      </div>
    </section>
<nav class="breadcrumb-bar" aria-label="Breadcrumb">
      <div class="wrap">
        <ol class="breadcrumb">
          <li><a href="/en/">Home</a></li>
          <li><a href="/en/aquariums.html">Guides</a></li>
          <li aria-current="page">Turtle Aquarium</li>
        </ol>
      </div>
    </nav>
<section class="intro">
      <div class="wrap">
        <div class="intro-box reveal">
          <p>A regular aquarium is not enough for an aquatic turtle — it needs an <strong>aqua-terrarium</strong> with both a water section and a land section. The turtle must be able to swim and to rest on dry ground, on a raised platform or a natural island. Without a land section the turtle cannot warm up, dry off or rest, which harms its health in the long run. This guide walks through all the key elements of a properly set up aqua-terrarium for an aquatic turtle.</p>
        </div>
      </div>
    </section>
<div class="wrap reveal" style="padding-top: 0; padding-bottom: 0;">
      <img src="/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp" alt="Aqua-terrarium for an aquatic turtle with a land and a water section" class="guide-img" width="1080" height="1080" loading="eager" fetchpriority="high">
    </div>
<section class="zoo" style="padding-top: 40px;">
      <div class="wrap">

        <!-- Dimenzije -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Aqua-terrarium <b>dimensions</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Minimum dimensions</h3>
            <p>The minimum floor area of an aqua-terrarium for one adult turtle is about 50x35cm. The bigger the turtle, the bigger the aquarium should be. Our turtle aqua-terrariums are available from 50x35x45cm up to 100x45x45cm — and everything can also be built to order.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">What the 4 dimensions mean</h3>
            <p>Turtle aqua-terrariums are often listed with four numbers — for example 60x35x45x30. The first two numbers are the width and depth of the aquarium, the third is the total height of the glass, and the fourth is the height of the water column (water depth). The rest of the height is the land section — the raised platform where the turtle rests.</p>
          </div>
        </div>

        <!-- Filtracija -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Filtration</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Why a filter is a must</h3>
            <p>Aquatic turtles foul the water much more than fish — they eat faster, produce more waste and are more biologically active. A filter is an essential piece of equipment and has to match the aquarium's volume. A filter rated for a larger volume than the actual one is recommended, because turtles load the filtration faster than fish of a similar size. Regular partial water changes are also important, regardless of filtration.</p>
          </div>
        </div>

        <!-- Kopneni deo / ostrvo -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Land section and <b>platform</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Why a land section is essential</h3>
            <p>The turtle must have access to a dry surface where it can climb out of the water, warm up under a lamp and rest. Without a land section the turtle cannot regulate its body temperature — and that is one of the most common causes of health problems in captive aquatic turtles.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">How it is built into the aqua-terrarium</h3>
            <p>In our aqua-terrariums the land section is built into the structure — a raised glass or plexiglass shelf separated from the water section. The land area should be large enough for the turtle to lie and move around freely, without the risk of slipping back into the water by accident.</p>
          </div>
        </div>

        <!-- Grejanje i UVB -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Heating and <b>UVB lighting</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Heat lamp over the land section</h3>
            <p>A heat lamp that creates a basking spot must be placed over the land section. The turtle uses this spot for thermoregulation — warming its body after swimming. The basking spot temperature above the platform should be roughly 30-32°C, while the water temperature stays lower.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">UVB light</h3>
            <p>A UVB lamp is essential — it lets the turtle synthesize vitamin D3, which is key to healthy bones and shell. Without UVB, turtles develop shell and skeletal problems over time. The UVB lamp goes over the land section and is replaced according to the manufacturer's instructions (usually every 6-12 months, even if it still lights up).</p>
          </div>
        </div>

        <!-- Ceste greske -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Common <b>mistakes</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">What to watch out for</h3>
            <ul style="color:var(--ink-soft);line-height:1.9;padding-left:18px;margin:0;">
              <li>An aquarium without a land section — the turtle needs a dry surface for resting and warming up.</li>
              <li>An aquarium that is too small — the turtle needs room to swim and move freely.</li>
              <li>Insufficient filtration — turtles foul the water faster than fish, so the filter must have enough capacity.</li>
              <li>Skipping the UVB lamp — without UVB, serious health problems develop over time.</li>
              <li>No basking spot — the land section must be heated with a lamp so the turtle can warm up after swimming.</li>
            </ul>
          </div>
        </div>

      </div>
    </section>
<section class="zoo" style="padding-top: 0;">
      <div class="wrap">
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Frequently asked <b>questions</b></h2>
            <div class="line"></div>
          </div>
          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-q">
                What kind of aquarium does an aquatic turtle need?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>An aquatic turtle needs an aqua-terrarium with both a water section and a land section, so the turtle can swim and also rest on dry ground. A water-only aquarium without a land section is not suitable — the turtle needs a dry surface for warming up and resting.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                What aquarium dimensions does a turtle need?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>The dimensions depend on the size of the turtle. We offer aqua-terrariums from 50x35x45cm to 100x45x45cm, and we also build them to order to fit your needs and the size of the animal.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">
                Does a turtle aquarium need filtration?<span class="ic">+</span>
              </button>
              <div class="faq-a">
                <p>Yes, filtration is a must. Turtles foul the water faster than fish, so you need a filter with enough capacity to keep the water clear and healthy. Regular partial water changes are also recommended, regardless of the filter.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head reveal">
          <h2>Related <b>content</b></h2>
        </div>
        <div class="usl-more-grid reveal">
          <a class="usl-link" href="/en/aquariums.html">
            Aquariums — our range
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="usl-link" href="/en/custom-aquariums.html">
            Custom aquarium builds
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="usl-link" href="/en/guides/turtle-terrarium.html">
            Turtle terrarium — guide
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2><b>Custom</b> builds</h2>
        <p>We build turtle aqua-terrariums to order — you choose the dimensions, color and equipment. Get in touch and we will send you a quote.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=I%27m%20interested%20in%20a%20turtle%20aqua-terrarium" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>
<style is:global>
      .guide-img {
        width: 100%;
        border-radius: 8px;
        display: block;
        margin: 0 auto 40px;
        max-width: 640px;
      }
      .faq-list { margin-top: 24px; }
      .faq-item {
        border-bottom: 1px solid var(--silver);
        padding: 0;
      }
      .faq-q {
        width: 100%;
        background: none;
        border: none;
        text-align: left;
        font-family: 'Oswald Variable', sans-serif;
        font-size: 1rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--ink);
        padding: 18px 0;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        transition: color .2s;
      }
      .faq-q:hover { color: var(--green-ink); }
      .faq-q .ic {
        font-size: 1.4rem;
        font-weight: 300;
        line-height: 1;
        flex-shrink: 0;
        transition: transform .25s;
      }
      .faq-item.open .faq-q .ic { transform: rotate(45deg); }
      .faq-a {
        display: none;
        padding-bottom: 18px;
      }
      .faq-item.open .faq-a { display: block; }
      .faq-a p {
        color: var(--ink-soft);
        line-height: 1.7;
        margin: 0;
      }
    </style>
<script is:inline slot="after">
      // FAQ accordion
      document.querySelectorAll('.faq-q').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var item = this.closest('.faq-item');
          var isOpen = item.classList.contains('open');
          document.querySelectorAll('.faq-item').forEach(function(el) { el.classList.remove('open'); });
          if (!isOpen) item.classList.add('open');
        });
      });
    </script>
<style is:global>
      .breadcrumb-bar {
        background: var(--bg);
        border-bottom: 1px solid var(--silver);
        padding: 12px 0;
        transition: background 0.4s;
      }
      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }
      .breadcrumb li + li::before {
        content: '›';
        margin-right: 6px;
        color: var(--ink-soft);
      }
      .breadcrumb a {
        color: var(--green-ink);
        text-decoration: none;
      }
      .breadcrumb a:hover {
        text-decoration: underline;
      }
    </style>
</Base>
