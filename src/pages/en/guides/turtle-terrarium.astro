      {
        "@type": "Question",
        "name": "What is a turtle aqua-terrarium?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An aqua-terrarium is a combination of a terrarium and an aquarium with both a land and a water section, ideal for aquatic and semi-aquatic turtles. The land section is for basking, resting and warming up under a lamp, and the water section is for swimming and hydration."
        }
      },
      {
        "@type": "Question",
        "name": "How big should a turtle aqua-terrarium be?",
