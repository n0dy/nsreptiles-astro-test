---
import Base from '../../layouts/Base.astro';

import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="en"
  title="NS Reptiles Novi Sad — Exotic Animals & Custom Terrariums"
  description="Exotic pet breeding facility and custom terrarium and aquarium workshop in Novi Sad. Healthy and tame animals, quality equipment and expert advice."
  path="/en/"
  ogDescription="Exotic pet breeding facility and custom terrarium workshop in Novi Sad. Healthy animals, quality equipment, expert advice."
  active="home"
  translations={translationsFor("/en/")}
>
<link slot="head" rel="preload" as="image" href="/style/img/cover-sm.webp" media="(max-width: 768px)" fetchpriority="high" />
<link slot="head" rel="preload" as="image" href="/style/img/cover-lg.webp" media="(min-width: 769px)" fetchpriority="high" />
<section class="hero" id="hero">
      <div class="hero-bg" id="heroBg">
        <div class="slide active" style="--bg: url('/style/img/cover-lg.webp'); --bg-sm: url('/style/img/cover-sm.webp')"></div>
        <div class="slide" style="--bg: url('/style/img/cover1-lg.webp'); --bg-sm: url('/style/img/cover1-sm.webp')"></div>
        <div class="slide" style="--bg: url('/style/img/cover2-lg.webp'); --bg-sm: url('/style/img/cover2-sm.webp')"></div>
        <div class="slide" style="--bg: url('/style/img/cover3-lg.webp'); --bg-sm: url('/style/img/cover3-sm.webp')"></div>
      </div>
      <div class="wrap">
        <div class="hero-content">
          <div class="pre">Breeding Facility · Novi Sad</div>
          <h1>Exotic Animals</h1>
          <p>
            NS Reptiles is an <strong>exotic pet breeding facility</strong> and
            workshop for
            <strong>custom terrarium and aquarium construction</strong> -
            healthy and tame animals, quality equipment and expert advice, all
            in one place.
          </p>
          <div style="display: flex; gap: 14px; flex-wrap: wrap">
            <a href="#kompleti" class="btn btn-primary">View Kits</a>
            <a href="https://wa.me/381693301474" class="btn btn-light">WhatsApp</a>
          </div>
        </div>
      </div>
      <div class="hero-dots">
        <span class="active"></span><span></span><span></span><span></span>
      </div>
    </section>
<section class="section about">
      <div class="wrap about-grid">
        <div class="about-illu reveal">
          <img loading="lazy" decoding="async" src="/style/img/gallery/4.jpg" alt="Bearded dragon">
        </div>
        <div class="about-text reveal">
          <h2 class="sec-title">About the <b>Breeding Facility</b></h2>
          <p class="lead">
            For over 10 years, we have been selectively breeding healthy exotic
            pets and handcrafting custom terrariums and aquariums. Bearded
            dragons, leopard geckos, ball pythons, corn snakes - and all the
            equipment they need.
          </p>
          <div class="stats-row">
            <div class="stat">
              <b data-count="1000">0</b><span>Happy Customers</span>
            </div>
            <div class="stat">
              <b data-count="300">0</b><span>Animals Bred</span>
            </div>
            <div class="stat">
              <b data-count="1000">0</b><span>Terrariums/Aquariums Built</span>
            </div>
          </div>
          <a href="/en/about.html" class="btn btn-outline">More About Us</a>
        </div>
      </div>
    </section>
<section class="section reptiles">
      <div class="wrap">
