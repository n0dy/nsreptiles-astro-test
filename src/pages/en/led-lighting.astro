---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Custom LED Lighting",
    "serviceType": "Custom LED Lighting for Aquariums and Terrariums",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Serbia",
    "description": "Custom-built LED lighting for aquariums and terrariums. Various sizes and colors, day/night modes, remote control. Energy efficient. Novi Sad.",
    "url": "https://nsreptiles.net/en/led-lighting.html"
  }
];
---
<Base
  lang="en"
  title="Custom LED Lighting for Aquariums & Terrariums | NS Reptiles"
  description="Custom-built LED lighting for aquariums and terrariums. Various sizes and colors, day/night modes, remote control. Energy efficient. Novi Sad, Serbia."
  path="/en/led-lighting.html"
  ogDescription="Custom LED lighting for aquariums and terrariums — choose your color, mode, and control method. Made to your exact measurements. Novi Sad."
  translations={translationsFor("/en/led-lighting.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Service</div>
        <h1>Custom LED Lighting</h1>
        <p>We build LED lighting tailored to the exact dimensions of your aquarium or terrarium. Choose your color, operating mode, and control method.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Made to your measurements</div>
          <p>LED lighting uses significantly less power, delivers stronger and more even light, and doesn't heat the water. We build it <strong>to your exact dimensions</strong> — from small 30 cm aquariums all the way to large builds over 2 metres.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="feat-grid">
          <article class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Any size</h3>
            <p>We build LED lighting to the precise measurements of your aquarium or terrarium. Whether it's a compact 30 cm tank or a large display over 2 metres — we adjust the length and number of LED strips to achieve optimal coverage.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Choice of colours</h3>
            <p>White (cool and warm), blue, red, green, or RGB that cycles through colours — the choice is yours. We can combine multiple colours for a natural effect, or use a single colour to create a specific atmosphere. Blue lighting is ideal for night mode and makes fluorescent fish really pop.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Day and night mode</h3>
            <p>Every LED unit can have two operating modes — a daytime mode with brighter white light to support your animals' activity, and a night mode with softer blue light that simulates moonlight. Switching between them is simple, just one flip of a switch.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">04</span>
            <h3>Remote control</h3>
            <p>We can optionally add a remote control for full command over your lighting. Change the colour, brightness, and mode without opening the lid — a practical solution for aquariums in hard-to-reach spots.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">05</span>
            <h3>Energy efficiency</h3>
            <p>LED lighting draws significantly less power than traditional bulbs and fluorescent tubes, while delivering stronger, more even light. It lasts longer and doesn't heat the water — which is especially important for tropical fish and reptiles.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">06</span>
            <h3>Retrofit installation</h3>
            <p>We can install LED lighting into any existing aquarium or terrarium. We adapt the mounting to your lid, add switches wherever you need them, and connect everything into a single clean setup. We also replace old, worn-out lighting.</p>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Interested?</div>
        <h2>LED lighting <b>built for you</b></h2>
        <p>Send us your dimensions and preferred colour — we'll put together LED lighting made exactly to your specifications.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Call us</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Other services</div>
          <h2>Everything in <b>one place</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/en/custom-terrariums.html">Custom Terrariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-aquariums.html">Custom Aquariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-vivariums.html">Custom Vivariums<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/maintenance.html">Maintenance &amp; Setup<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/repair.html">Repairs &amp; Service<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
