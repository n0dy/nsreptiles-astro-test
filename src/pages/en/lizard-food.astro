---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/oprema.css';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../config/site';
import { getProducts, productViewOrSr } from '../../lib/products';
import { translationsFor } from '../../i18n/routes';

const FIRST = ['oprema/dubia-zohari', 'oprema/fobasi', 'oprema/lateralis', 'oprema/brasnari-tenebrio'];
// "Ziva hrana" dok se postojeci fajlovi ne prebace na dijakritike
const food = (await getProducts())
  .filter((p) => ['Živa hrana', 'Ziva hrana'].includes(p.data.label))
  .sort((a, b) => (FIRST.indexOf(a.id) + 1 || 99) - (FIRST.indexOf(b.id) + 1 || 99));
const views = await Promise.all(food.map((p) => productViewOrSr(p, 'en')));

const faq = [
  ['What should I feed my lizard?', 'Most lizards eat live insects. Dubia roaches are the staple of the diet because they are high in protein, low in chitin and easy to digest. Superworms, lateralis (Turkestan roach) and mealworms are used alongside them for variety. Live food should be dusted with calcium before every feeding.'],
  ['What is the best food for a bearded dragon?', 'Young bearded dragons eat large amounts of insects every day - dubia roaches and lateralis are ideal because they are soft and rich in protein. Adult dragons eat fewer insects and more vegetables. Mealworms are given in moderation because they have a harder chitin.'],
  ['What insect sizes does a baby lizard need?', 'The rule is that the insect should not be wider than the space between the lizard\'s eyes. For babies, use small dubia nymphs or small lateralis. As the lizard grows, move on to medium and large insects. Prey that is too large can cause digestive problems.'],
  ['Why are dubia roaches better than crickets?', 'Dubia roaches don\'t chirp, don\'t jump, can\'t climb smooth surfaces and don\'t give off an unpleasant smell. They live longer in the terrarium and have a better protein-to-chitin ratio than crickets, so they are more nutritious and more practical to keep.'],
  ['How do I store live food for lizards?', 'Dubia roaches and superworms are kept at room temperature in a ventilated box with egg-crate cardboard and a little food (carrot, apple, grains). Mealworms can be kept in the fridge to slow their development. Lateralis need warmer housing because they are more active.'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/en/' },
      { '@type': 'ListItem', position: 2, name: 'Equipment', item: SITE.url + '/en/equipment.html' },
      { '@type': 'ListItem', position: 3, name: 'Lizard food', item: SITE.url + '/en/lizard-food.html' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Lizard food',
    itemListElement: views.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.name, url: SITE.url + v.path,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base
  lang="en"
  title="Lizard Food | Dubia, Lateralis, Mealworms - NS Reptiles"
  description="Live food for lizards and reptiles: dubia roaches, superworms, lateralis (Turkestan roach) and mealworms (tenebrio) in several sizes. NS Reptiles Novi Sad."
  keywords="lizard food, live food for reptiles, dubia roaches, superworms, lateralis, Turkestan roach, mealworms, tenebrio, feeder insects for lizards, bearded dragon food, leopard gecko food"
  path="/en/lizard-food.html"
  image="/style/img/oprema/dubie.webp"
  ogTitle="Lizard Food | Dubia Roaches, Lateralis, Mealworms - NS Reptiles"
  ogDescription="Live food for lizards and reptiles - dubia roaches, superworms, lateralis and mealworms in several sizes. Fresh and always in stock."
  active="equipment"
  translations={translationsFor("/en/lizard-food.html")}
  schema={schema}
>
  <section class="page-head">
    <div class="wrap">
      <h1>Lizard food</h1>
    </div>
  </section>
  <section class="intro">
    <div class="wrap">
      <div class="intro-box">
        <p>
          Live food is the foundation of most lizards' diet. We stock fresh feeder insects bred for feeding
          reptiles - <strong>dubia roaches</strong>, <strong>superworms</strong>, <strong>lateralis (Turkestan
          roach)</strong> and <strong>mealworms (tenebrio)</strong> in several sizes. All species are available from
          the tiniest nymphs for babies to adults for larger lizards, so you can feed
          <a style="color: var(--green-ink)" href="/en/animals/bearded-dragon.html">bearded dragons</a>,
          <a style="color: var(--green-ink)" href="/en/animals/leopard-gecko.html">leopard geckos</a>, chameleons, tegus and other insectivores.
          Live food prices start at <strong>400 din per 100 pieces</strong>.
        </p>
        <h2 style="margin-top: 28px">Types of live food we offer</h2>
        <p>
          <strong>Dubia roaches</strong> are the most popular feeder insect - they are high in protein, low in
          chitin and easy to digest. They don't chirp, don't jump, can't climb smooth surfaces and don't smell,
          so they are practical to keep. <strong>Superworms</strong> are a soft and nutritious feeder, a great addition
          to dubias for a varied diet.
        </p>
        <p style="margin-top: 14px">
          <strong>Lateralis</strong>, or the Turkestan roach, is a fast, smaller insect whose movement
          triggers the hunting instinct - ideal for chameleons, young geckos and lizards that respond to motion.
          <strong>Mealworms (tenebrio)</strong> are larvae with a harder chitin and a higher fat content, so they are given as
          a treat and to build up condition, in moderation.
        </p>
        <h3 style="margin-top: 28px">How to feed a lizard</h3>
        <p>
          Always dust live food with calcium (and occasionally a multivitamin) before feeding. The size rule: the insect
          must not be wider than the space between the lizard's eyes. Babies eat more often and smaller prey, while adults
          eat less often and larger insects. For an exact recommendation of the species and size for your animal - call us.
        </p>
      </div>
    </div>
  </section>
  <section class="op-shop">
    <div class="wrap">
      <div class="op-grid">
        {food.map((p) => <ProductCard lang="en" product={p} catLabel="Live food" />)}
      </div>
    </div>
  </section>
  <section class="faq section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="sec-title">Frequently asked questions about feeding lizards</h2>
      </div>
      <div class="faq-list">
        {faq.map(([q, a]) => (
          <div class="faq-item">
            <button class="faq-q">{q}<span class="ic">+</span></button>
            <div class="faq-a"><p>{a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
