---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aquarium and Terrarium Maintenance",
    "serviceType": "Aquarium and Terrarium Maintenance",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Serbia",
    "description": "Professional aquarium and terrarium maintenance in Novi Sad. Cleaning, water changes, equipment setup, and interior decoration. One-time or regular service.",
    "url": "https://nsreptiles.net/en/maintenance.html"
  }
];
---
<Base
  lang="en"
  title="Aquarium & Terrarium Maintenance | NS Reptiles, Novi Sad"
  description="Professional aquarium and terrarium maintenance in Novi Sad: cleaning, water changes, equipment setup and interior decoration. One-time or regular service."
  path="/en/maintenance.html"
  ogTitle="Aquarium & Terrarium Maintenance | NS Reptiles"
  ogDescription="Professional cleaning, decoration, and equipment setup for aquariums and terrariums. One-time or regular. Novi Sad."
  translations={translationsFor("/en/maintenance.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Aquarium &amp; Terrarium Maintenance</h1>
        <p>Professional maintenance and decoration so your aquarium or terrarium always looks its best — and your animals stay healthy and happy.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>We offer <strong>one-time services</strong> for cleaning and decoration, as well as arrangements for <strong>regular maintenance</strong>. Get in touch and we'll work out a schedule and scope that suits you.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="feat-grid">
          <article class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Aquarium Cleaning</h3>
            <p>Regular cleaning is essential for the health of your fish and turtles. We perform partial water changes, algae removal from the glass, substrate vacuuming, filter cleaning, and water parameter checks. We recommend monthly maintenance.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Terrarium Cleaning</h3>
            <p>A terrarium needs regular cleaning to keep your reptile healthy. We replace the substrate, disinfect surfaces, and inspect all equipment. We pay close attention to temperature, humidity, and UVB lighting conditions.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Aquarium Decoration</h3>
            <p>Looking for a completely new look? We install substrate, rocks, driftwood (Red Moor Wood), live and artificial plants, 3D backgrounds, and decorations. We create a natural, visually appealing setup tailored to your fish or turtles.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">04</span>
            <h3>Terrarium Decoration</h3>
            <p>We build a functional and visually attractive space for your reptile. We install the right substrate, 3D backgrounds made from polystyrene or tufa rock, climbing branches, hides, water and food dishes — all chosen according to the species' needs.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">05</span>
            <h3>Equipment Setup</h3>
            <p>We inspect and configure all equipment — filters, pumps, heaters, thermostats, LED and UVB/UVA lighting. If anything is worn out or not working correctly, we'll recommend a replacement and help you choose the right gear.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">06</span>
            <h3>Regular Maintenance</h3>
            <p>We offer both one-time maintenance and decoration services, as well as ongoing maintenance agreements. Contact us and we'll work out a schedule and level of service that fits your needs.</p>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Book <b>maintenance</b></h2>
        <p>Get in touch and we'll arrange maintenance or decoration that works for you — one-time or on a regular basis.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Call us</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Everything in <b>one place</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/en/custom-terrariums.html">Terrarium Building<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-aquariums.html">Aquarium Building<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/custom-vivariums.html">Vivarium Building<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/led-lighting.html">Custom LED Lighting<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/en/repair.html">Repair &amp; Servicing<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
