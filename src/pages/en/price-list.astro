---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://nsreptiles.net/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Price list",
        "item": "https://nsreptiles.net/en/price-list.html"
      }
    ]
  }
];
---
<Base
  lang="en"
  title="Terrarium & Aquarium Price List | NS Reptiles"
  description="Full product list with prices — terrariums, aquariums and reptile equipment. NS Reptiles, Novi Sad. Call or message us for an exact quote."
  keywords="terrarium price list, aquarium prices, custom glass terrarium price, reptile equipment prices, NS Reptiles"
  path="/en/price-list.html"
  image="/style/img/logo.jpg"
  ogTitle="Price List | NS Reptiles, Novi Sad"
  ogDescription="Terrariums, aquariums and reptile equipment — see the full NS Reptiles range from Novi Sad."
  translations={translationsFor("/en/price-list.html")}
  schema={schema}
>
