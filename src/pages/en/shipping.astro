---
import Base from '../../layouts/Base.astro';

import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="en"
  title="Shipping — Terrarium and Aquarium Delivery | NS Reptiles"
  description="Shipping information for NS Reptiles - delivery times, methods and costs for terrariums, aquariums and equipment across Serbia."
  path="/en/shipping.html"
  cart={false}
  translations={translationsFor("/en/shipping.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Information</div>
        <h1>Shipping</h1>
        <p>
          Everything you need to know about delivery of our products -
          timeframes, shipping methods and costs across Serbia.
        </p>
      </div>
    </section>
<section class="section" style="background: var(--bg)">
      <div class="wrap">
        <div class="del-grid">
          <div class="del-card">
            <div class="del-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 6v6l4 2"></path>
              </svg>
            </div>
            <h3>Delivery Timeframes</h3>
            <ul>
              <li><b>Equipment, food &amp; decorations:</b> 1–3 business days</li>
              <li><b>Terrariums &amp; aquariums in stock:</b> 2–5 business days</li>
              <li>
                <b>Custom orders:</b> timeframe agreed individually (typically
                7–14 days)
              </li>
              <li>
                <b>Animals:</b> delivery only via personal pickup or arrangement
              </li>
            </ul>
          </div>
          <div class="del-card">
            <div class="del-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <path d="M16 8h4l3 3v5h-7V8z"></path>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </div>
            <h3>Shipping Methods</h3>
            <ul>
              <li><b>Courier service:</b> across all of Serbia</li>
              <li><b>Personal delivery:</b> Novi Sad and surrounding area</li>
              <li><b>Bus transport:</b> to most cities in Serbia</li>
              <li><b>Taxi delivery:</b> to Belgrade addresses</li>
            </ul>
          </div>
          <div class="del-card">
            <div class="del-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 1v22M17 5H9.5a3.5 3.5 0 100 7h5a3.5 3.5 0 010 7H6"></path>
              </svg>
            </div>
            <h3>Shipping Costs</h3>
            <ul>
              <li><b>Standard equipment:</b> 350–700 RSD</li>
              <li>
                <b>Terrariums &amp; aquariums:</b> calculated individually based on
                dimensions
              </li>
              <li><b>Personal pickup:</b> free (Novi Sad)</li>
            </ul>
            <p style="margin-top: 14px; font-size: 0.88rem">
              <b>Note:</b> Shipping costs are covered by the buyer.
            </p>
          </div>
        </div>
        <div class="del-note">
          For any shipping questions, contact us at <b>+381 69 330 1474</b> or
          via
          <a href="https://wa.me/381693301474" style="color: var(--green-ink); font-weight: 500">WhatsApp</a>.
        </div>
        <div class="useful-links">
          <div class="eyebrow">Useful Links</div>
          <a href="/en/contact.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><path d="M22 6l-10 7L2 6"></path></svg>Contact</a>
          <a href="/en/terrariums.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M12 3v6"></path><circle cx="12" cy="16" r="2"></circle></svg>Terrariums</a>
          <a href="/en/aquariums.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c2-3 5-5 10-5s8 2 10 5"></path><path d="M2 17c2-3 5-5 10-5s8 2 10 5"></path><path d="M12 22V7"></path><circle cx="12" cy="4" r="2"></circle></svg>Aquatics</a>
          <a href="/en/equipment.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>Equipment</a>
          <a href="/en/custom-terrariums.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"></path><rect x="4" y="4" width="16" height="16" rx="1"></rect><path d="M4 10h16"></path><path d="M10 4v16"></path></svg>Custom Terrariums</a>
          <a href="/en/custom-aquariums.html"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 15c3-3 6-4 10-4s7 1 10 4"></path><path d="M2 20c3-3 6-4 10-4s7 1 10 4"></path><rect x="4" y="2" width="16" height="13" rx="1"></rect></svg>Custom Aquariums</a>
        </div>
      </div>
    </section>


</Base>
