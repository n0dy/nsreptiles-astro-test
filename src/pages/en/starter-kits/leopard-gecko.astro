---
import Base from '../../../layouts/Base.astro';
import '../../../styles/animals.css';
import '../../../styles/kompleti.css';
import { translationsFor } from '../../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Leopard Gecko Starter Kit",
    "description": "Starter kit: leopard gecko + 50×35×35 terrarium, heat mat, hide, peat, bowl, food and vitamins. All in one place - NS Reptiles Novi Sad.",
    "image": "../assets/img/leopard-gekon.jpg",
    "brand": {
      "@type": "Brand",
      "name": "NS Reptiles"
    },
    "offers": {
      "@type": "Offer",
      "url": "https://nsreptiles.net/en/starter-kits/leopard-gecko.html",
      "priceCurrency": "RSD",
      "price": "12500",
      "availability": "https://schema.org/InStock"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://nsreptiles.net/en/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Starter kits",
        "item": "https://nsreptiles.net/en/starter-kits.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Leopard gecko",
        "item": "https://nsreptiles.net/en/starter-kits/leopard-gecko.html"
      }
    ]
  }
];
---
<Base
  lang="en"
  title="Leopard Gecko Starter Kit with Terrarium | NS Reptiles"
  description="Leopard gecko starter kit: 50×35×35 terrarium, heat mat, hide, coconut peat, water bowl, food and vitamins. NS Reptiles, Novi Sad."
  keywords="leopard gecko starter kit, leopard gecko for sale, leopard gecko terrarium, reptiles Novi Sad"
  path="/en/starter-kits/leopard-gecko.html"
  image="/assets/img/leopard-gekon.jpg"
  ogType="product"
  translations={translationsFor("/en/starter-kits/leopard-gecko.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Leopard Gecko Starter Kit</h1>
        <p>The animal, a terrarium and basic equipment — everything you need for a confident start, in one place.</p>
      </div>
    </section>
<nav class="breadcrumb-bar" aria-label="Breadcrumb">
      <div class="wrap">
        <ol class="breadcrumb">
          <li><a href="/en/">Home</a></li>
          <li><a href="/en/starter-kits.html">Starter kits</a></li>
          <li aria-current="page">Leopard gecko</li>
        </ol>
      </div>
    </nav>
<section class="ks-main">
      <div class="wrap">
        <div class="ks-grid">
          <div class="ks-media reveal">
            <div class="ks-img">
              <span class="kit-badge">Sale</span>
              <img src="/assets/img/leopard-gekon.jpg" alt="Leopard gecko - starter kit" width="800" height="800">
            </div>
          </div>
          <div class="ks-info reveal">
            <h2 class="ks-title">Leopard gecko</h2>
            <div class="ks-price">12,500 <span>din</span></div>
            <p class="ks-desc">The leopard gecko is one of the most commonly kept gecko species in the world — calm-natured, easy to tame and easy to care for. An ideal first reptile, and the kit brings the terrarium, heating and all the basic equipment at once.</p>
            <div class="ks-incl-title">What's included</div>
            <ul class="ks-incl">
              <li>50×35×35 terrarium</li>
              <li>Heat mat and hide</li>
              <li>Coconut peat and water bowl</li>
              <li>Food and vitamins</li>
            </ul>
            <div class="ks-cta">
              <a href="/en/contact.html?komplet=Leopard%20gecko" class="btn btn-primary">
                Send an inquiry
              </a>
              <a href="https://wa.me/381693301474?text=I'm%20interested%20in%20the%20Leopard%20gecko%20kit" target="_blank" rel="noopener" class="btn btn-outline" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">
                Ask on WhatsApp
              </a>
            </div>
            <div class="ks-note">
              Pickup in person in Novi Sad or shipping by arrangement. Advice on
              choosing and care is free — get in touch before you buy.
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="ks-perks">
      <div class="wrap">
        <div class="reveal" style="text-align: center; max-width: 640px; margin: 0 auto">
          <h2 class="sec-title">Everything for a <b>confident start</b></h2>
        </div>
        <div class="ks-perks-grid">
          <div class="ks-perk reveal">
            <div class="ks-perk-num">01</div>
            <h3>All in one place</h3>
            <p>The animal, a terrarium of the right size and basic equipment — no running from shop to shop or guessing what you need.</p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">02</div>
            <h3>Chosen for beginners</h3>
            <p>The species in our kits are calm-natured and easy to care for, and the equipment is matched to their specific needs.</p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">03</div>
            <h3>Expert support</h3>
            <p>We have 10 years of breeding behind us. With the kit you also get care advice, and we are available for any questions after you buy.</p>
          </div>
        </div>
      </div>
    </section>
<section class="ks-others">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <h2 class="sec-title">Other <b>kits</b></h2>
          </div>
          <a href="/en/starter-kits.html" class="btn btn-outline">All kits</a>
        </div>
        <div class="kit-grid">
          <article class="kit-card reveal">
            <a href="/en/starter-kits/bearded-dragon.html" class="kit-img">
              <img src="/assets/img/bradata-agama.jpg" alt="Bearded dragon" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Bearded dragon</h3>
              <div class="kit-price">25,800 <span>din</span></div>
              <a href="/en/starter-kits/bearded-dragon.html" class="btn btn-outline">View more</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/en/starter-kits/corn-snake.html" class="kit-img">
              <img src="/assets/img/kukuruzni-smuk.jpg" alt="Corn snake" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Corn snake</h3>
              <div class="kit-price">12,500 <span>din</span></div>
              <a href="/en/starter-kits/corn-snake.html" class="btn btn-outline">View more</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/en/starter-kits/scorpion.html" class="kit-img">
              <img src="/assets/img/skorpija.jpg" alt="Scorpion" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Scorpion</h3>
              <div class="kit-price">8,500 <span>din</span></div>
              <a href="/en/starter-kits/scorpion.html" class="btn btn-outline">View more</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/en/starter-kits/tarantula.html" class="kit-img">
              <img src="/assets/img/tarantula.jpg" alt="Tarantula" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Tarantula</h3>
              <div class="kit-price">3,000 <span>din</span></div>
              <a href="/en/starter-kits/tarantula.html" class="btn btn-outline">View more</a>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Contact <b>NS Reptiles</b></h2>
        <p>Not sure if this kit is the right choice? Get in touch — we are happy to help you decide.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=I'm%20interested%20in%20the%20Leopard%20gecko%20kit" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
