---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Glass Terrariums with 3D Background | NS Reptiles",
    "description": "Hand-made glass terrariums with 3D backgrounds in over 80 sizes. Ventilation and custom builds.",
    "url": "https://nsreptiles.net/en/terrariums.html",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      },
      "telephone": "+381693301474",
      "email": "bata.dino00@gmail.com"
    }
  }
];
---
<Base
  lang="en"
  title="Glass Terrariums with 3D Background | NS Reptiles"
  description="Hand-made glass terrariums with 3D backgrounds in over 80 sizes, with mesh or plastic ventilation. Custom builds available. NS Reptiles, Novi Sad."
  path="/en/terrariums.html"
  image="/style/img/terrariums/90x45x45.webp"
  ogDescription="Glass terrariums in over 80 sizes, with 3D backgrounds. Custom builds. NS Reptiles, Novi Sad."
  active="terrariums"
  translations={translationsFor("/en/terrariums.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Glass terrariums with 3D background</h1>
        <p>
          Hand-made glass terrariums in over 80 sizes — from small ones for
          hatchlings to large enclosures, with 3D backgrounds and ventilation.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>
            Every terrarium is <strong>hand-made from glass</strong>, with mesh
            or plastic ventilation and an optional 3D background that mimics a
            natural habitat. Don't see the size you need? We offer
            <strong>custom builds</strong> — get in touch with your measurements.
          </p>
        </div>
      </div>
    </section>
