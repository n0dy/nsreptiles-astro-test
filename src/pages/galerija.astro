---
import Base from '../layouts/Base.astro';

import { translationsFor } from '../i18n/routes';
---
<Base
  lang="sr"
  title="Galerija terarijuma i reptila, Novi Sad | NS Reptiles"
  description="Pogledajte galeriju NS Reptiles - slike terarijuma, akvarijuma, reptila i egzotičnih životinja. Inspiracija za vaš budući terarijum."
  path="/galerija.html"
  image="/style/img/gallery/1.jpg"
  active="gallery"
  bodyClass="gallery-page"
  translations={translationsFor("/galerija.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Galerija</div>
        <h1>Naš svet egzotike</h1>
        <p>
          Slike naših reptila, terarijuma i akvarijuma. Pregledajte radove i
          pronađite inspiraciju za svoj budući dom za ljubimca.
        </p>
      </div>
    </section>
<section class="section gallery">
      <div class="wrap">
        <div class="gal-grid" id="galGrid">
          <div class="gal-item gal-big" data-cat="guster">
            <img src="/style/img/gallery/2.jpg" alt="Bradata agama">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Gušter</small><b>Bradata agama</b></div>
          </div>
          <div class="gal-item" data-cat="zmija">
            <img src="/style/img/gallery/1.jpg" alt="Loptasti piton">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Zmija</small><b>Loptasti piton</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img src="/style/img/gallery/14.jpg" alt="Leopard gekon">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Gušter</small><b>Leopard gekon</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img src="/style/img/gallery/3.jpg" alt="Leopard gekon">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Gušter</small><b>Leopard gekon</b></div>
          </div>
          <div class="gal-item gal-tall" data-cat="zmija">
            <img src="/style/img/gallery/7.jpg" alt="Loptasti piton">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Zmija</small><b>Loptasti piton</b></div>
