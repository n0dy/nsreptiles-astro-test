            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Zmija</small><b>Loptasti piton</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img src="/style/img/gallery/10.jpg" alt="Leopard gekon">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Gušter</small><b>Leopard gekon</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img src="/style/img/gallery/8.jpg" alt="Bradata agama">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Gušter</small><b>Bradata agama</b></div>
          </div>
          <div class="gal-item gal-wide" data-cat="zmija">
            <img src="/style/img/gallery/12.jpg" alt="Loptasti piton">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Zmija</small><b>Loptasti piton</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img src="/style/img/gallery/11.jpg" alt="Bradata agama">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Gušter</small><b>Bradata agama</b></div>
          </div>
        </div>
      </div>
    </section>
<div class="lb" id="lb">
      <button class="lb-close" id="lbClose" aria-label="Zatvori">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
      <button class="lb-nav prev" id="lbPrev" aria-label="Prethodna">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button class="lb-nav next" id="lbNext" aria-label="Sledeća">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
      <div class="lb-stage">
        <img class="lb-img" id="lbImg" src="/" alt="">
        <div class="lb-cap"><small id="lbCat"></small><b id="lbName"></b></div>
        <div class="lb-count" id="lbCount"></div>
      </div>
    </div>


</Base>
