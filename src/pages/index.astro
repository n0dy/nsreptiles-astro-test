---
import Base from '../layouts/Base.astro';
import '../styles/oprema.css';
import { translationsFor } from '../i18n/routes';
---
<Base
  lang="sr"
  title="NS Reptiles Novi Sad — egzotične životinje i terarijumi"
  description="Odgajivačnica egzotičnih ljubimaca i izrada terarijuma i akvarijuma po meri u Novom Sadu. Zdrave i pitome jedinke, kvalitetna oprema i stručan savet."
  path="/"
  image="/style/img/logo.jpg"
  ogDescription="Odgajivačnica egzotičnih ljubimaca i izrada terarijuma po meri u Novom Sadu. Zdrave jedinke, kvalitetna oprema, stručan savet."
  active="home"
  translations={translationsFor("/")}
>
<link slot="head" rel="preload" as="image" href="/style/img/cover-sm.webp" media="(max-width: 768px)" fetchpriority="high" />
<link slot="head" rel="preload" as="image" href="/style/img/cover-lg.webp" media="(min-width: 769px)" fetchpriority="high" />
<section class="hero" id="hero">
      <div class="hero-bg" id="heroBg">
        <div class="slide active" style="--bg: url('/style/img/cover-lg.webp'); --bg-sm: url('/style/img/cover-sm.webp')"></div>
        <div class="slide" style="--bg: url('/style/img/cover1-lg.webp'); --bg-sm: url('/style/img/cover1-sm.webp')"></div>
        <div class="slide" style="--bg: url('/style/img/cover2-lg.webp'); --bg-sm: url('/style/img/cover2-sm.webp')"></div>
        <div class="slide" style="--bg: url('/style/img/cover3-lg.webp'); --bg-sm: url('/style/img/cover3-sm.webp')"></div>
      </div>
      <div class="wrap">
        <div class="hero-content">
          <div class="pre">Odgajivačnica · Novi Sad</div>
          <h1>Egzotične životinje</h1>
          <p>
            NS Reptiles je
            <strong>odgajivačnica egzotičnih kućnih ljubimaca</strong> i
            radionica za
            <strong>izradu terarijuma i akvarijuma po meri</strong> - zdrave i
            pitome jedinke, kvalitetna oprema i stručan savet, sve na jednom
            mestu.
          </p>
          <div style="display: flex; gap: 14px; flex-wrap: wrap">
            <a href="#kompleti" class="btn btn-primary">Pogledaj komplete</a>
            <a href="https://wa.me/381693301474" class="btn btn-light">WhatsApp</a>
          </div>
        </div>
      </div>
      <div class="hero-dots">
        <span class="active"></span><span></span><span></span><span></span>
      </div>
    </section>
<section class="section about">
      <div class="wrap about-grid">
        <div class="about-illu reveal">
          <img loading="lazy" decoding="async" src="/style/img/gallery/4.jpg" alt="Bradata agama">
        </div>
        <div class="about-text reveal">
          <h2 class="sec-title">O <b>odgajivačnici</b></h2>
          <p class="lead">
            Već 10 godina selektivno uzgajamo zdrave egzotične ljubimce i ručno
            izrađujemo terarijume i akvarijume po meri. Bradate agame, leopard
            gekoni, loptasti pitoni, kukuruzni smukovi - i sva oprema koja im
            treba.
          </p>
          <div class="stats-row">
            <div class="stat">
              <b data-count="1000">0</b><span>Zadovoljnih kupaca</span>
            </div>
            <div class="stat">
              <b data-count="300">0</b><span>Uzgojenih životinja</span>
            </div>
            <div class="stat">
              <b data-count="1000">0</b><span>Izrađenih ter/akv</span>
            </div>
          </div>
          <a href="/onama.html" class="btn btn-outline">Više o nama</a>
        </div>
      </div>
    </section>
<section class="section reptiles">
      <div class="wrap">
        <div class="rep-head reveal">
          <div>
            <h2 class="sec-title">Naši <b>reptili</b></h2>
          </div>
          <div class="car-nav">
            <button class="car-btn" data-car="rep" data-dir="-1">‹</button>
            <button class="car-btn" data-car="rep" data-dir="1">›</button>
          </div>
        </div>
      </div>
      <div class="wrap">
        <div class="car-track" id="repTrack">
          <div class="rep-card">
            <img loading="lazy" decoding="async" src="/style/img/gallery/2.jpg" alt="">
            <div class="rep-label">
              <div class="num">01</div>
              <div class="name">Bradata agama</div>
            </div>
          </div>
          <div class="rep-card">
            <img loading="lazy" decoding="async" src="/style/img/gallery/1.jpg" alt="">
            <div class="rep-label">
              <div class="num">02</div>
              <div class="name">Loptasti piton</div>
            </div>
          </div>
          <div class="rep-card">
            <img loading="lazy" decoding="async" src="/style/img/gallery/3.jpg" alt="">
            <div class="rep-label">
              <div class="num">03</div>
              <div class="name">Leopard gekon</div>
            </div>
          </div>
          <div class="rep-card">
            <img loading="lazy" decoding="async" src="/style/img/gallery/9.jpg" alt="">
            <div class="rep-label">
              <div class="num">04</div>
              <div class="name">Kukuruzni smuk</div>
            </div>
          </div>
          <div class="rep-card">
            <img loading="lazy" decoding="async" src="/style/img/gallery/13.jpg" alt="">
            <div class="rep-label">
              <div class="num">05</div>
              <div class="name">Vodena agama</div>
            </div>
          </div>
          <div class="rep-card">
            <img loading="lazy" decoding="async" src="/style/img/gallery/7.jpg" alt="">
            <div class="rep-label">
              <div class="num">06</div>
              <div class="name">Piton</div>
            </div>
          </div>
          <div class="rep-card">
            <img loading="lazy" decoding="async" src="/style/img/gallery/10.jpg" alt="">
            <div class="rep-label">
              <div class="num">07</div>
              <div class="name">Gekon</div>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="bigtypo reveal">
      <h2>Najbolji <b>terarijum</b></h2>
      <div class="sub">u celom svetu egzotike</div>
    </section>
<section class="section gallery">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <h2 class="sec-title">Galerija <b>životinja</b></h2>
          </div>
          <a href="/galerija.html" class="btn btn-outline">Pogledaj celu galeriju</a>
        </div>
        <div class="gal-grid">
          <div class="gal-item gal-tall" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/2.jpg" alt="">
            <div class="cap"><small>Gušter</small><b>Bradata agama</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/14.jpg" alt="">
            <div class="cap"><small>Gušter</small><b>Leopard gekon</b></div>
          </div>
          <div class="gal-item gal-big" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/13.jpg" alt="">
            <div class="cap"><small>Gušter</small><b>Vodena agama</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/3.jpg" alt="">
            <div class="cap"><small>Gušter</small><b>Leopard gekon</b></div>
          </div>
          <div class="gal-item" data-cat="zmija">
            <img loading="lazy" decoding="async" src="/style/img/gallery/1.jpg" alt="">
            <div class="cap"><small>Zmija</small><b>Loptasti piton</b></div>
          </div>
          <div class="gal-item gal-wide" data-cat="zmija">
            <img loading="lazy" decoding="async" src="/style/img/gallery/9.jpg" alt="">
            <div class="cap"><small>Zmija</small><b>Kukuruzni smuk</b></div>
          </div>
          <div class="gal-item gal-tall" data-cat="zmija">
            <img loading="lazy" decoding="async" src="/style/img/gallery/7.jpg" alt="">
            <div class="cap"><small>Zmija</small><b>Loptasti piton</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/6.jpg" alt="">
            <div class="cap"><small>Gušter</small><b>Bradata agama</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/10.jpg" alt="">
            <div class="cap"><small>Gušter</small><b>Leopard gekon</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/8.jpg" alt="">
            <div class="cap"><small>Gušter</small><b>Bradata agama</b></div>
          </div>
        </div>
      </div>
    </section>
<section class="section kompleti" id="kompleti">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <h2 class="sec-title">Kompleti za <b>početnike</b></h2>
          </div>
          <a href="/kompleti.html" class="btn btn-outline">Svi kompleti</a>
        </div>
        <div class="kit-grid">
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/bradata-agama.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/bradata-agama.jpg" alt="Bradata agama">
            </a>
            <div class="kit-body">
              <h3>Bradata agama</h3>
              <ul class="kit-incl">
                <li>Terarijum 100×45×45 +3D</li>
                <li>UVB/UVA rasveta</li>
                <li>Pesak, vitamini</li>
                <li>Hrana za mesec</li>
              </ul>
              <div class="kit-price">25.800 <span>din</span></div>
              <a href="/kompleti/bradata-agama.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/leopard-gekon.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/leopard-gekon.jpg" alt="Leopard gekon">
            </a>
            <div class="kit-body">
              <h3>Leopard gekon</h3>
              <ul class="kit-incl">
                <li>Terarijum 50×35×35</li>
                <li>Folija grejač, skrovište</li>
                <li>Treset, posuda</li>
                <li>Hrana + vitamini</li>
              </ul>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/leopard-gekon.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/kukuruzni-smuk.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/kukuruzni-smuk.jpg" alt="Kukuruzni smuk">
            </a>
            <div class="kit-body">
              <h3>Kukuruzni smuk</h3>
              <ul class="kit-incl">
                <li>Terarijum 50×35×35</li>
                <li>Kokosov treset</li>
                <li>Posuda za vodu</li>
                <li>Pećina</li>
              </ul>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/kukuruzni-smuk.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/skorpija.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/skorpija.jpg" alt="Škorpija">
            </a>
            <div class="kit-body">
              <h3>Škorpija</h3>
              <ul class="kit-incl">
                <li>Heterometrus petersii</li>
                <li>Terarijum 40×25×30</li>
                <li>Kokosov treset</li>
                <li>3 veličine</li>
              </ul>
              <div class="kit-price">8.500 <span>din</span></div>
              <a href="/kompleti/skorpija.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/tarantula.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/tarantula.jpg" alt="Tarantula">
            </a>
            <div class="kit-body">
              <h3>Tarantula</h3>
              <ul class="kit-incl">
                <li>Terarijum 11×15×20 +3D</li>
                <li>Kokosov treset</li>
                <li>~10 vrsta</li>
                <li>Za prvi pauk</li>
              </ul>
              <div class="kit-price">3.000 <span>din</span></div>
              <a href="/kompleti/tarantula.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="section help">
      <div class="wrap">
        <div class="rep-head reveal">
          <div>
            <h2 class="sec-title">Šta sve <b>radimo</b></h2>
          </div>
          <div class="car-nav">
            <button class="car-btn" data-car="help" data-dir="-1">‹</button>
            <button class="car-btn" data-car="help" data-dir="1">›</button>
          </div>
        </div>
      </div>
      <div class="help-track" id="helpTrack">
        <div class="help-card">
          <img loading="lazy" decoding="async" src="/style/img/gallery/2.jpg" alt="">
          <div class="help-info">
            <small>Usluga</small>
            <h3>Odgajivačnica</h3>
            <p>
              Selektivan uzgoj više vrsta egzotičnih kućnih ljubimaca - bradate
              agame, leopard gekoni, loptasti pitoni i kukuruzni smukovi. Zdrave
              i pitome jedinke.
            </p>
          </div>
        </div>
        <div class="help-card">
          <img loading="lazy" decoding="async" src="/style/img/gallery/11.jpg" alt="">
          <div class="help-info">
            <small>Usluga</small>
            <h3>Terarijumi</h3>
            <p>
              Izrađujemo terarijume od stakla i iverice po meri i želji, sa
              ugrađenom UVB/UVA rasvetom. Pored toga u ponudi imamo preko 70
              različitih modela.
            </p>
          </div>
        </div>
        <div class="help-card">
          <img loading="lazy" decoding="async" src="/style/img/gallery/4.jpg" alt="">
          <div class="help-info">
            <small>Usluga</small>
            <h3>Akvarijumi</h3>
            <p>
              Akvarijumi svih dimenzija po meri - za ribice, kornjače ili biljni
              akvarijum. LED rasveta sa dnevnim/noćnim režimom i kompletnom
              opremom.
            </p>
          </div>
        </div>
        <div class="help-card">
          <img loading="lazy" decoding="async" src="/style/img/gallery/8.jpg" alt="">
          <div class="help-info">
            <small>Usluga</small>
            <h3>3D pozadine</h3>
            <p>
              Izrađujemo od najkvalitetnijih materijala - prirodni siga kamen,
              imitacija stene, kombinacija treseta i kore od drveta, ili 3D logo
              vašeg brenda/firme.
            </p>
          </div>
        </div>
        <div class="help-card">
          <img loading="lazy" decoding="async" src="/style/img/gallery/12.jpg" alt="">
          <div class="help-info">
            <small>Usluga</small>
            <h3>Oprema</h3>
            <p>
              U širokoj ponudi može se naći sve za vaše reptile - UVA i UVB
              rasveta različitih jačina, biljne dekoracije, skrovišta, posudice
              za vodu/hranu i sredstva za održavanje.
            </p>
          </div>
        </div>
      </div>
    </section>
<section class="section events">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <h2 class="sec-title">Naši <b>radovi</b></h2>
            <p style="color: var(--ink-soft); font-weight: 300; margin-top: 8px">
              Pogledajte neke od terarijuma i akvarijuma koje smo izradili.
            </p>
          </div>
          <a href="/galerija.html" class="btn btn-outline">Pogledaj sve</a>
        </div>
        <div class="best-grid">
          <article class="op-card">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-120x40x50-3d.html"><img src="/style/img/terrariums/120x40x50.webp" alt="Stakleni terarijum 120x40x50cm sa 3D pozadinom" loading="lazy" width="600" height="600"></a>
            <div class="op-body">
              <div class="op-cat">Veliki terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-120x40x50-3d.html">Terarijum 120x40x50 +3D</a></h3>
              <div class="op-foot">
                <span class="op-price">0 din</span>
                <button class="btn btn-primary add-cart" data-name="Terarijum 120x40x50 +3D" data-price="0" data-img="/style/img/terrariums/120x40x50.webp">
                  Dodaj u korpu
                </button>
              </div>
            </div>
          </article>
          <article class="op-card">
            <a class="op-img" href="/proizvodi/akvarijumi/akvarijum-120x40x40.html"><img src="/style/img/aquariums/a120x40x40.webp" alt="Stakleni akvarijum 120x40x40cm" loading="lazy" width="600" height="600"></a>
            <div class="op-body">
              <div class="op-cat">Akvarijum</div>
              <h3><a href="/proizvodi/akvarijumi/akvarijum-120x40x40.html">Akvarijum 120x40x40</a></h3>
              <div class="op-foot">
                <span class="op-price">0 din</span>
                <button class="btn btn-primary add-cart" data-name="Akvarijum 120x40x40" data-price="0" data-img="/style/img/aquariums/a120x40x40.webp">
                  Dodaj u korpu
                </button>
              </div>
            </div>
          </article>
          <article class="op-card">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-100x45x45-lakobel.html"><img src="/style/img/terrariums/100x45x45-2.webp" alt="Terarijum 100x45x45 LAKOBEL" loading="lazy" width="600" height="600"></a>
            <div class="op-body">
              <div class="op-cat">Veliki terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-100x45x45-lakobel.html">Terarijum 100x45x45 LAKOBEL</a></h3>
              <div class="op-foot">
                <span class="op-price">0 din</span>
                <button class="btn btn-primary add-cart" data-name="Terarijum 100x45x45 LAKOBEL" data-price="0" data-img="/style/img/terrariums/100x45x45-2.webp">
                  Dodaj u korpu
                </button>
              </div>
            </div>
          </article>
          <article class="op-card">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-80x50x80-akvarijum.html"><img src="/style/img/terrariums/80x50x80-voda.webp" alt="Terarijum 80x50x80 + AKVARIJUM" loading="lazy" width="600" height="600"></a>
            <div class="op-body">
              <div class="op-cat">Veliki terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-80x50x80-akvarijum.html">Terarijum 80x50x80 + AKVARIJUM</a></h3>
              <div class="op-foot">
                <span class="op-price">0 din</span>
                <button class="btn btn-primary add-cart" data-name="Terarijum 80x50x80 + AKVARIJUM" data-price="0" data-img="/style/img/terrariums/80x50x80-voda.webp">
                  Dodaj u korpu
                </button>
              </div>
            </div>
          </article>
          <article class="op-card">
            <a class="op-img" href="/proizvodi/akvarijumi/akvarijum-36x28x35.html"><img src="/style/img/aquariums/a36x28x35.webp" alt="Stakleni akvarijum 36x28x35cm" loading="lazy" width="600" height="600"></a>
            <div class="op-body">
              <div class="op-cat">Akvarijum</div>
              <h3><a href="/proizvodi/akvarijumi/akvarijum-36x28x35.html">Akvarijum 36x28x35</a></h3>
              <div class="op-foot">
                <span class="op-price">0 din</span>
                <button class="btn btn-primary add-cart" data-name="Akvarijum 36x28x35" data-price="0" data-img="/style/img/aquariums/a36x28x35.webp">
                  Dodaj u korpu
                </button>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="section izrada" style="background: var(--white)">
      <div class="wrap">
        <div class="izrada-split">
          <div class="img-wrap reveal">
            <img loading="lazy" decoding="async" src="/style/img/terrariums/120x40x50.webp" alt="Terarijum po meri">
          </div>
          <div class="reveal">
            <h2 class="sec-title">Izrada terarijuma <b>po meri</b></h2>
            <p style="color: var(--ink-soft); font-weight: 300; margin: 14px 0 0">
              Svaki terarijum izrađujemo ručno, po vašim merama i željama.
              Koristimo kvalitetne materijale i nudimo kompletnu uslugu - od
              konsultacija do gotovog proizvoda sa opremom.
            </p>
            <ul class="izrada-feats">
              <li>Preko 100 dezena folija</li>
              <li>Ugrađena UVB i UVA rasveta sa prekidačima</li>
              <li>3D pozadine od siga kamena, stiropora ili treseta</li>
              <li>Dupli poklopac sa ventilacijom</li>
              <li>Klizna vrata sa bravicom</li>
              <li>Izrada od stakla ili iverice</li>
            </ul>
            <div class="izrada-links">
              <a href="/izrada-terarijuma.html" class="btn btn-primary">Saznaj više</a>
              <a href="/terarijumi.html" class="ilink">Gotovi terarijumi</a>
              <a href="/odrzavanje-akvarijuma-terarijuma.html" class="ilink">Održavanje</a>
              <a href="/izrada-led-rasvete.html" class="ilink">LED rasveta</a>
              <a href="/popravka-akvarijuma-terarijuma.html" class="ilink">Popravka</a>
            </div>
          </div>
        </div>
      </div>
