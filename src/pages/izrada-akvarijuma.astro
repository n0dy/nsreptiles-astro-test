---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/usluge.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Izrada akvarijuma po meri",
    "serviceType": "Izrada akvarijuma po meri",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Srbija",
    "description": "Izrada akvarijuma po meri u Novom Sadu. Stakleni akvarijumi za ribice i kornjače, preko 40 dezena folija, LED rasveta, filteri i 3D pozadine. Rok izrade 7 radnih dana.",
    "url": "https://nsreptiles.net/izrada-akvarijuma.html"
  }
];
---
<Base
  lang="sr"
  title="Izrada akvarijuma po meri, Novi Sad | NS Reptiles"
  description="Izrada akvarijuma po meri u Novom Sadu: stakleni akvarijumi za ribice i kornjače, 40+ dezena folija, LED rasveta, filteri i 3D pozadine. Rok 7 radnih dana."
  path="/izrada-akvarijuma.html"
  image="/style/img/logo.jpg"
  ogTitle="Izrada akvarijuma po meri | NS Reptiles"
  ogDescription="Ručno lepljeni stakleni akvarijumi po vašim merama — folije, LED rasveta, filteri i oprema. Novi Sad."
  translations={translationsFor("/izrada-akvarijuma.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Izrada akvarijuma po meri</h1>
        <p>Svaki akvarijum izrađujemo ručno od stakla, po vašim merama i željama — sa folijom po izboru, LED rasvetom i kompletnom opremom.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>Od prvog kontakta do preuzimanja vodimo vas kroz nekoliko jednostavnih koraka. Niste sigurni koja je optimalna veličina za vaše ribice ili kornjače? <strong>Rado ćemo vam pomoći</strong> da napravite pravi izbor.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="proc">
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Kontaktirajte nas</h3>
              <p>Javite nam se telefonom, mejlom ili putem društvenih mreža i recite nam koje dimenzije akvarijuma želite. Ukoliko niste sigurni koja je optimalna veličina za vaše ribice ili kornjače, rado ćemo vam pomoći da napravite pravi izbor.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Odaberite boju akvarijuma</h3>
              <p>U ponudi je preko 40 različitih dezena folija tako da možete lako uklopiti akvarijum sa ostatkom enterijera. Takođe, postoji mogućnost da akvarijum bude obložen crnim lakobelom umesto folije.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Izaberite 3D pozadinu</h3>
              <p>Klasična folija sa slikom, fabrički model, 3D pozadina od stiropora, 3D pozadina od prirodnog siga kamena, ili pak bez pozadine — bira se po ukusu i želji kupca.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Rasveta i oprema</h3>
              <p>Nudimo LED rasvetu koja je energetski efikasna i dugotrajna. Možemo dodati dva režima rada — dnevni i noćni, prekidače na samom akvarijumu i mogućnost daljinskog upravljanja. Pomažemo u odabiru filtera, pumpe, grejača, substrata i dekoracije.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Kapara 30%</h3>
              <p>Minimalni iznos kapare za početak izrade akvarijuma je 30% od ukupne cene. Ostatak iznosa se plaća po završetku izrade, prilikom preuzimanja akvarijuma.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Izrada — 7 radnih dana</h3>
              <p>Uobičajeni rok izrade akvarijuma je 7 radnih dana. Za zahtevnije i veće projekte rok izrade može biti i duži.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Preuzimanje akvarijuma</h3>
              <p>Akvarijum možete preuzeti lično u Novom Sadu, ili ga možemo poslati autobusom do vašeg grada. Troškove slanja snosi kupac. Za veće akvarijume možemo organizovati i dostavu kombijem.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Vaš akvarijum <b>po meri</b></h2>
        <p>Pošaljite nam dimenzije i namenu — izradićemo akvarijum tačno po vašem prostoru, sa LED rasvetom po želji.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Pozovi nas</a>
        </div>
      </div>
    </section>
<section class="usl-more" style="background: var(--bg)">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Akvarijum za <b>vasu zivotinju</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/akvarijumi/akvarijum-za-kornjacu.html">Akvarijum za kornjacu<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Sve na <b>jednom mestu</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/izrada-terarijuma.html">Izrada terarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-vivarijuma.html">Izrada vivarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-led-rasvete.html">Izrada LED rasvete<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/odrzavanje-akvarijuma-terarijuma.html">Održavanje i uređenje<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/popravka-akvarijuma-terarijuma.html">Popravka i servis<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
