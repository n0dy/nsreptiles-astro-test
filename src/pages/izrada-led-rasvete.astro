---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/usluge.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Izrada LED rasvete",
    "serviceType": "Izrada LED rasvete",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Srbija",
    "description": "Izrada LED rasvete po meri za akvarijume i terarijume. Različite dimenzije i boje, dnevni i noćni režim, daljinsko upravljanje. Energetski efikasno. Novi Sad.",
    "url": "https://nsreptiles.net/izrada-led-rasvete.html"
  }
];
---
<Base
  lang="sr"
  title="Izrada LED rasvete za akvarijume i terarijume | NS Reptiles"
  description="LED rasveta po meri za akvarijume i terarijume. Različite dimenzije i boje, dnevni i noćni režim, daljinsko upravljanje, energetski efikasno. Novi Sad."
  path="/izrada-led-rasvete.html"
  image="/style/img/logo.jpg"
  ogTitle="Izrada LED rasvete po meri | NS Reptiles"
  ogDescription="LED rasveta po meri za akvarijume i terarijume — boje, režimi rada, daljinsko upravljanje. Novi Sad."
  translations={translationsFor("/izrada-led-rasvete.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Izrada LED rasvete</h1>
        <p>Izrađujemo LED rasvetu prilagođenu dimenzijama vašeg akvarijuma ili terarijuma. Birajte boju, režim rada i način upravljanja.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>LED rasveta troši znatno manje struje, daje jače i ravnomernije svetlo i ne zagreva vodu. Izrađujemo je <strong>po tačnim merama</strong> — od malih akvarijuma od 30 cm do velikih preko 2 metra.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="feat-grid">
          <article class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Različite dimenzije</h3>
            <p>LED rasvetu izrađujemo po tačnim merama vašeg akvarijuma ili terarijuma. Bez obzira da li je u pitanju mali akvarijum od 30 cm ili veliki od preko 2 metra — prilagođavamo dužinu i broj LED traka za optimalno osvetljenje.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Izbor boja</h3>
            <p>Bela (hladna i topla), plava, crvena, zelena ili RGB koja menja boje — birate vi. Kombinujemo više boja za prirodan efekat ili koristimo jednu boju za specifičan ambijent. Plava rasveta je idealna za noćni režim i ističe fluorescentne ribe.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Dnevni i noćni režim</h3>
            <p>Svaka LED rasveta može imati dva režima rada — dnevni sa jačim belim svetlom za aktivnost vaših životinja, i noćni sa slabijim plavim svetlom za simulaciju mesečine. Prebacivanje je jednostavno, jednim prekidačem.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">04</span>
            <h3>Daljinsko upravljanje</h3>
            <p>Opciono dodajemo daljinski upravljač za potpunu kontrolu rasvete. Menjajte boju, intenzitet i režim rada bez otvaranja poklopca. Praktično rešenje za akvarijume na teže dostupnim mestima.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">05</span>
            <h3>Energetska efikasnost</h3>
            <p>LED rasveta troši znatno manje struje od klasičnih sijalica i fluorescentnih cevi, a daje jače i ravnomernije svetlo. Dugotrajna je i ne zagreva vodu, što je posebno važno za tropske ribe i reptile.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">06</span>
            <h3>Ugradnja u postojeći akvarijum</h3>
            <p>LED rasvetu možemo ugraditi u bilo koji postojeći akvarijum ili terarijum. Prilagođavamo montažu vašem poklopcu, dodajemo prekidače na željeno mesto i povezujemo sve u jednu celinu. Zamenjujemo i staru, dotrajalu rasvetu.</p>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>LED rasveta <b>po vašoj meri</b></h2>
        <p>Javite nam dimenzije i željenu boju — napravićemo LED rasvetu tačno po vašoj meri.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Pozovi nas</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Sve na <b>jednom mestu</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/izrada-terarijuma.html">Izrada terarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-akvarijuma.html">Izrada akvarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-vivarijuma.html">Izrada vivarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/odrzavanje-akvarijuma-terarijuma.html">Održavanje i uređenje<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/popravka-akvarijuma-terarijuma.html">Popravka i servis<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
