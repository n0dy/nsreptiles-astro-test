---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/usluge.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Izrada vivarijuma po meri",
    "serviceType": "Izrada vivarijuma po meri",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Srbija",
    "description": "Izrada vivarijuma po meri u Novom Sadu. Stakleni vivarijumi za tropske biljke, žabe i vodozemce, preko 40 dezena folija, specijalna rasveta. Rok izrade 7 radnih dana.",
    "url": "https://nsreptiles.net/izrada-vivarijuma.html"
  }
];
---
<Base
  lang="sr"
  title="Izrada vivarijuma po meri, Novi Sad | NS Reptiles"
  description="Izrada vivarijuma po meri u Novom Sadu: stakleni vivarijumi za tropske biljke, žabe i vodozemce, 40+ dezena folija i specijalna rasveta. Rok 7 radnih dana."
  path="/izrada-vivarijuma.html"
  image="/style/img/logo.jpg"
  ogTitle="Izrada vivarijuma po meri | NS Reptiles"
  ogDescription="Ručno rađeni stakleni vivarijumi po vašim merama — rasveta punog spektra, sistem za vlažnost i oprema. Novi Sad."
  translations={translationsFor("/izrada-vivarijuma.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Izrada po meri</div>
        <h1>Izrada vivarijuma po meri</h1>
        <p>Svaki vivarijum izrađujemo ručno od stakla, po vašim merama i željama — sa rasvetom punog spektra za zdrav rast biljaka i kompletnom opremom.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Kako do vašeg vivarijuma?</div>
          <p>Od prvog kontakta do preuzimanja vodimo vas kroz nekoliko jednostavnih koraka. Niste sigurni koja je optimalna veličina za vaše biljke? <strong>Rado ćemo vam pomoći</strong> da napravite pravi izbor.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="proc">
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Kontaktirajte nas</h3>
              <p>Javite nam se telefonom, mejlom ili putem društvenih mreža i recite nam koje dimenzije vivarijuma želite. Ukoliko niste sigurni koja je optimalna veličina za vaše biljke, rado ćemo vam pomoći da napravite pravi izbor.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Odaberite boju vivarijuma</h3>
              <p>U ponudi je preko 40 različitih dezena folija tako da možete lako uklopiti vivarijum sa ostatkom enterijera. Takođe, postoji mogućnost da vivarijum bude obložen crnim lakobelom umesto folije.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Izaberite 3D pozadinu</h3>
              <p>Klasična folija sa slikom, fabrički model, 3D pozadina od stiropora, 3D pozadina od prirodnog siga kamena, ili pak bez pozadine — bira se po ukusu i želji kupca.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Rasveta i oprema</h3>
              <p>Nudimo idealnu rasvetu za vaš vivarijum koja pruža sve potrebne spektre svetlosti za rast i zdravlje biljaka — različite boje i nijanse (crvena, plava, zelena i bela). Pomažemo u odabiru grejača, termostata, filtera za vodu, substrata, termometara i higrometara.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Kapara 30%</h3>
              <p>Minimalni iznos kapare za početak izrade vivarijuma je 30% od ukupne cene. Ostatak iznosa se plaća po završetku izrade, prilikom preuzimanja vivarijuma.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Izrada — 7 radnih dana</h3>
              <p>Uobičajeni rok izrade vivarijuma je 7 radnih dana. Za zahtevnije i veće projekte rok izrade može biti i duži.</p>
            </div>
          </div>
          <div class="proc-step">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Preuzimanje vivarijuma</h3>
              <p>Vivarijum možete preuzeti lično u Novom Sadu, ili ga možemo poslati autobusom do vašeg grada. Troškove slanja snosi kupac. Za veće vivarijume možemo organizovati i dostavu kombijem.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Spremni za početak?</div>
        <h2>Vaš vivarijum <b>po meri</b></h2>
        <p>Pošaljite nam dimenzije i namenu — izradićemo vivarijum tačno po vašim potrebama, sa rasvetom punog spektra.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Pozovi nas</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Ostale usluge</div>
          <h2>Sve na <b>jednom mestu</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/izrada-terarijuma.html">Izrada terarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-akvarijuma.html">Izrada akvarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-led-rasvete.html">Izrada LED rasvete<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/odrzavanje-akvarijuma-terarijuma.html">Održavanje i uređenje<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/popravka-akvarijuma-terarijuma.html">Popravka i servis<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
