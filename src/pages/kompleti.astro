---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/kompleti.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Kompleti za početnike - prodaja guštera i egzotičnih ljubimaca",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Komplet Bradata agama",
        "url": "https://nsreptiles.net/kompleti/bradata-agama.html"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Komplet Leopard gekon",
        "url": "https://nsreptiles.net/kompleti/leopard-gekon.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Komplet Kukuruzni smuk",
        "url": "https://nsreptiles.net/kompleti/kukuruzni-smuk.html"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "Komplet Škorpija",
        "url": "https://nsreptiles.net/kompleti/skorpija.html"
      },
      {
        "@type": "ListItem",
        "position": 5,
        "name": "Komplet Tarantula",
        "url": "https://nsreptiles.net/kompleti/tarantula.html"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Početna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Kompleti",
        "item": "https://nsreptiles.net/kompleti.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Prodaja Guštera | Kompleti za Početnike - NS Reptiles"
  description="Prodaja guštera iz sopstvenog uzgoja - bradate agame i leopard gekoni, uz kukuruzne smukove, škorpije i tarantule. Kompleti sa terarijumom i opremom."
  path="/kompleti.html"
  image="/style/img/gallery/2.jpg"
  translations={translationsFor("/kompleti.html")}
  langLinks={{ ...{"en":"/en/","ru":"/ru/"}, ...translationsFor("/kompleti.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Odgajivačnica · Novi Sad</div>
        <h1>Prodaja guštera</h1>
        <p>
          Bradate agame i leopard gekoni iz sopstvenog uzgoja, uz kukuruzne
          smukove, škorpije i tarantule — svaka životinja u kompletu sa
          terarijumom i opremom.
        </p>
      </div>
    </section>
<nav class="breadcrumb-bar" aria-label="Breadcrumb">
      <div class="wrap">
        <ol class="breadcrumb">
          <li><a href="/">Početna</a></li>
          <li aria-current="page">Kompleti</li>
        </ol>
      </div>
    </nav>
<section class="intro">
      <div class="wrap">
        <div class="intro-box reveal">
          <div class="eyebrow">Kompleti za početnike</div>
          <p>
            Već 10 godina se bavimo selektivnim uzgojem egzotičnih kućnih
            ljubimaca. Sve jedinke su zdrave, dobro hranjene i naviknute na
            rukovanje. Da bi start bio što jednostavniji, svaku životinju
            nudimo u kompletu — sa terarijumom odgovarajuće veličine i osnovnom
            opremom, po ceni povoljnijoj od pojedinačne kupovine.
          </p>
        </div>
      </div>
    </section>
<section class="section kompleti" id="kompleti" style="padding-top: 70px">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <div class="eyebrow">Počni ovde</div>
            <h2 class="sec-title">Izaberi svoj <b>komplet</b></h2>
          </div>
          <a href="/zivotinje.html" class="btn btn-outline">Sve životinje</a>
        </div>
        <div class="kit-grid">
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/bradata-agama.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/bradata-agama.jpg" alt="Bradata agama - prodaja guštera Novi Sad">
            </a>
            <div class="kit-body">
              <h3>Bradata agama</h3>
              <ul class="kit-incl">
                <li>Terarijum 100×45×45 +3D</li>
                <li>UVB/UVA rasveta</li>
                <li>Pesak, vitamini</li>
                <li>Hrana za mesec</li>
              </ul>
              <div class="kit-price">25.800 <span>din</span></div>
              <a href="/kompleti/bradata-agama.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/leopard-gekon.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/leopard-gekon.jpg" alt="Leopard gekon - prodaja guštera Novi Sad">
            </a>
            <div class="kit-body">
              <h3>Leopard gekon</h3>
              <ul class="kit-incl">
                <li>Terarijum 50×35×35</li>
                <li>Folija grejač, skrovište</li>
                <li>Treset, posuda</li>
                <li>Hrana + vitamini</li>
              </ul>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/leopard-gekon.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/kukuruzni-smuk.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/kukuruzni-smuk.jpg" alt="Kukuruzni smuk">
            </a>
            <div class="kit-body">
              <h3>Kukuruzni smuk</h3>
              <ul class="kit-incl">
                <li>Terarijum 50×35×35</li>
                <li>Kokosov treset</li>
                <li>Posuda za vodu</li>
                <li>Pećina</li>
              </ul>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/kukuruzni-smuk.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/skorpija.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/skorpija.jpg" alt="Škorpija">
            </a>
            <div class="kit-body">
              <h3>Škorpija</h3>
              <ul class="kit-incl">
                <li>Heterometrus petersii</li>
                <li>Terarijum 40×25×30</li>
                <li>Kokosov treset</li>
                <li>3 veličine</li>
              </ul>
              <div class="kit-price">8.500 <span>din</span></div>
              <a href="/kompleti/skorpija.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Akcija</span>
            <a href="/kompleti/tarantula.html" class="kit-img">
              <img loading="lazy" decoding="async" src="/assets/img/tarantula.jpg" alt="Tarantula">
            </a>
            <div class="kit-body">
              <h3>Tarantula</h3>
              <ul class="kit-incl">
                <li>Terarijum 11×15×20 +3D</li>
                <li>Kokosov treset</li>
                <li>~10 vrsta</li>
                <li>Za prvi pauk</li>
              </ul>
              <div class="kit-price">3.000 <span>din</span></div>
              <a href="/kompleti/tarantula.html" class="btn btn-outline">
                Pogledaj više
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="ks-perks">
      <div class="wrap">
        <div class="reveal" style="text-align: center; max-width: 680px; margin: 0 auto">
          <div class="eyebrow" style="justify-content: center">
            Iz sopstvenog uzgoja
          </div>
          <h2 class="sec-title">Prodaja <b>guštera</b></h2>
          <p style="color: var(--ink-soft); font-weight: 300; margin-top: 14px">
            Gušteri su najtraženiji egzotični ljubimci — pitomi, zanimljivi za
            posmatranje i jednostavni za negu. Bradate agame i leopard gekone
            odgajamo sami, pa uz svaku jedinku znate poreklo, starost i
            navike.
          </p>
        </div>
        <div class="ks-perks-grid">
          <div class="ks-perk reveal">
            <div class="ks-perk-num">01</div>
            <h3>Zdrave i pitome jedinke</h3>
            <p>
              Iza nas je 10 godina selektivnog uzgoja. Sve životinje su dobro
              hranjene, redovno praćene i naviknute na rukovanje od malih
              nogu.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">02</div>
            <h3>Komplet umesto lutanja</h3>
            <p>
              Uz životinju dobijate terarijum odgovarajuće veličine i opremu
              prilagođenu baš toj vrsti — bez pogađanja šta je potrebno i
              kupovine na više mesta.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">03</div>
            <h3>Saveti i posle kupovine</h3>
            <p>
              Objasnimo sve o ishrani, temperaturi i nezi pre nego što
              ljubimac stigne kod vas — a za pitanja smo dostupni i kasnije,
              telefonom ili porukom.
            </p>
          </div>
        </div>
      </div>
    </section>
<section class="section" style="background: var(--white)">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <div class="eyebrow">Jednostavno do ljubimca</div>
            <h2 class="sec-title">Kako <b>funkcioniše</b></h2>
          </div>
        </div>
        <div class="ks-perks-grid" style="margin-top: 10px">
          <div class="ks-perk reveal">
            <div class="ks-perk-num">Korak 1</div>
            <h3>Izaberite komplet</h3>
            <p>
              Pogledajte komplete i otvorite onaj koji vas zanima — na svakoj
              strani je tačan sadržaj i cena.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">Korak 2</div>
            <h3>Pošaljite upit</h3>
            <p>
              Klikom na „Pošalji upit" forma se popunjava automatski. Možete
              nam pisati i na WhatsApp ili Viber — odgovaramo brzo.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">Korak 3</div>
            <h3>Preuzimanje ili slanje</h3>
            <p>
              Lično preuzimanje u Novom Sadu ili slanje po dogovoru. Životinje
              pakujemo bezbedno i sa iskustvom.
            </p>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content:center">Niste sigurni koji komplet?</div>
        <h2>Pitajte <b>NS Reptiles</b></h2>
        <p>Recite nam koliko prostora i vremena imate, a mi ćemo predložiti ljubimca koji vam najviše odgovara. Konsultacije su besplatne.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Zanimaju%20me%20kompleti%20za%20pocetnike" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
