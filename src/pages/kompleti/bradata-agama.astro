---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/kompleti.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Komplet Bradata agama za početnike",
    "description": "Komplet za početnike: bradata agama + terarijum 100×45×45 sa 3D pozadinom, UVB/UVA rasveta, pesak, vitamini i hrana. Sve na jednom mestu - NS Reptiles Novi Sad.",
    "image": "../assets/img/bradata-agama.jpg",
    "brand": {
      "@type": "Brand",
      "name": "NS Reptiles"
    },
    "offers": {
      "@type": "Offer",
      "url": "https://nsreptiles.net/kompleti/bradata-agama.html",
      "priceCurrency": "RSD",
      "price": "25800",
      "availability": "https://schema.org/InStock"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Početna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Kompleti za početnike",
        "item": "https://nsreptiles.net/kompleti.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Bradata agama",
        "item": "https://nsreptiles.net/kompleti/bradata-agama.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Komplet Bradata agama za Početnike | NS Reptiles"
  description="Komplet za početnike: bradata agama + terarijum 100×45×45 sa 3D pozadinom, UVB/UVA rasveta, pesak, vitamini i hrana. NS Reptiles, Novi Sad."
  path="/kompleti/bradata-agama.html"
  image="/assets/img/bradata-agama.jpg"
  ogType="product"
  translations={translationsFor("/kompleti/bradata-agama.html")}
  langLinks={{ ...{"en":"/en/","ru":"/ru/"}, ...translationsFor("/kompleti/bradata-agama.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Kompleti za početnike</div>
        <h1>Komplet Bradata agama</h1>
        <p>Životinja, terarijum i osnovna oprema — sve što je potrebno za siguran start, na jednom mestu.</p>
      </div>
    </section>
<nav class="breadcrumb-bar" aria-label="Breadcrumb">
      <div class="wrap">
        <ol class="breadcrumb">
          <li><a href="/">Početna</a></li>
          <li><a href="/kompleti.html">Kompleti</a></li>
          <li aria-current="page">Bradata agama</li>
        </ol>
      </div>
    </nav>
<section class="ks-main">
      <div class="wrap">
        <div class="ks-grid">
          <div class="ks-media reveal">
            <div class="ks-img">
              <span class="kit-badge">Akcija</span>
              <img src="/assets/img/bradata-agama.jpg" alt="Bradata agama - komplet za početnike" width="800" height="800">
            </div>
          </div>
          <div class="ks-info reveal">
            <div class="eyebrow">Komplet za početnike</div>
            <h2 class="ks-title">Bradata agama</h2>
            <div class="ks-price">25.800 <span>din</span></div>
            <p class="ks-desc">Bradata agama je jedan od najpopularnijih guštera za kućno držanje — dnevna vrsta, radoznala i pitoma, koja se brzo navikne na rukovanje. Komplet sadrži sve što je potrebno za siguran start: terarijum sa 3D pozadinom, UVB/UVA rasvetu i osnovnu opremu.</p>
            <div class="ks-incl-title">Šta je uključeno</div>
            <ul class="ks-incl">
              <li>Terarijum 100×45×45 sa 3D pozadinom</li>
              <li>UVB/UVA rasveta</li>
              <li>Pesak i vitamini</li>
              <li>Hrana za mesec dana</li>
            </ul>
            <div class="ks-cta">
              <a href="/kontakt.html?komplet=Bradata%20agama" class="btn btn-primary">
                Pošalji upit
              </a>
              <a href="https://wa.me/381693301474?text=Zanima%20me%20komplet%20Bradata%20agama" target="_blank" rel="noopener" class="btn btn-outline" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">
                Pitaj na WhatsApp
              </a>
            </div>
            <div class="ks-note">
              Lično preuzimanje u Novom Sadu ili slanje po dogovoru. Konsultacije
              oko izbora i nege su besplatne — javite nam se pre kupovine.
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="ks-perks">
      <div class="wrap">
        <div class="reveal" style="text-align: center; max-width: 640px; margin: 0 auto">
          <div class="eyebrow" style="justify-content: center">Zašto komplet</div>
          <h2 class="sec-title">Sve za <b>siguran start</b></h2>
        </div>
        <div class="ks-perks-grid">
          <div class="ks-perk reveal">
            <div class="ks-perk-num">01</div>
            <h3>Sve na jednom mestu</h3>
            <p>Životinja, terarijum odgovarajuće veličine i osnovna oprema — bez lutanja po prodavnicama i pogađanja šta je potrebno.</p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">02</div>
            <h3>Odabrano za početnike</h3>
            <p>Vrste iz naših kompleta su mirne naravi i jednostavne za negu, a oprema je prilagođena baš njihovim potrebama.</p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">03</div>
            <h3>Stručna podrška</h3>
            <p>Iza nas je 10 godina uzgoja. Uz komplet dobijate i savete za negu, a za sva pitanja smo dostupni i posle kupovine.</p>
          </div>
        </div>
      </div>
    </section>
<section class="ks-others">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <div class="eyebrow">Pogledaj još</div>
            <h2 class="sec-title">Ostali <b>kompleti</b></h2>
          </div>
          <a href="/kompleti.html" class="btn btn-outline">Svi kompleti</a>
        </div>
        <div class="kit-grid">
          <article class="kit-card reveal">
            <a href="/kompleti/leopard-gekon.html" class="kit-img">
              <img src="/assets/img/leopard-gekon.jpg" alt="Leopard gekon" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Leopard gekon</h3>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/leopard-gekon.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/kompleti/kukuruzni-smuk.html" class="kit-img">
              <img src="/assets/img/kukuruzni-smuk.jpg" alt="Kukuruzni smuk" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Kukuruzni smuk</h3>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/kukuruzni-smuk.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/kompleti/skorpija.html" class="kit-img">
              <img src="/assets/img/skorpija.jpg" alt="Škorpija" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Škorpija</h3>
              <div class="kit-price">8.500 <span>din</span></div>
              <a href="/kompleti/skorpija.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/kompleti/tarantula.html" class="kit-img">
              <img src="/assets/img/tarantula.jpg" alt="Tarantula" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Tarantula</h3>
              <div class="kit-price">3.000 <span>din</span></div>
              <a href="/kompleti/tarantula.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content:center">Imate pitanja?</div>
        <h2>Kontaktirajte <b>NS Reptiles</b></h2>
        <p>Niste sigurni da li je ovaj komplet pravi izbor? Javite nam se — rado ćemo pomoći oko odluke.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Zanima%20me%20komplet%20Bradata%20agama" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
