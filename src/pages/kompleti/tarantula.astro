---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/kompleti.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Komplet Tarantula za početnike",
    "description": "Komplet za početnike: tarantula + terarijum 11×15×20 sa 3D pozadinom i kokosov treset. Oko 10 vrsta u ponudi - NS Reptiles Novi Sad.",
    "image": "https://nsreptiles.net/style/img/tarantule/brachypelma-boehmei.png",
    "brand": {
      "@type": "Brand",
      "name": "NS Reptiles"
    },
    "offers": {
      "@type": "Offer",
      "url": "https://nsreptiles.net/kompleti/tarantula.html",
      "priceCurrency": "RSD",
      "price": "3000",
      "availability": "https://schema.org/InStock"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Početna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Kompleti za početnike",
        "item": "https://nsreptiles.net/kompleti.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Tarantula",
        "item": "https://nsreptiles.net/kompleti/tarantula.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Komplet Tarantula za Početnike | NS Reptiles"
  description="Komplet za početnike: tarantula + terarijum 11×15×20 sa 3D pozadinom i kokosov treset. Oko 10 vrsta u ponudi - NS Reptiles Novi Sad."
  path="/kompleti/tarantula.html"
  image="/style/img/tarantule/brachypelma-boehmei.png"
  ogType="product"
  translations={translationsFor("/kompleti/tarantula.html")}
  langLinks={{ ...{"en":"/en/","ru":"/ru/"}, ...translationsFor("/kompleti/tarantula.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Komplet Tarantula</h1>
        <p>Životinja, terarijum i osnovna oprema — sve što je potrebno za siguran start, na jednom mestu.</p>
      </div>
    </section>
<nav class="breadcrumb-bar" aria-label="Breadcrumb">
      <div class="wrap">
        <ol class="breadcrumb">
          <li><a href="/">Početna</a></li>
          <li><a href="/kompleti.html">Kompleti</a></li>
          <li aria-current="page">Tarantula</li>
        </ol>
      </div>
    </nav>
<section class="ks-main">
      <div class="wrap">
        <div class="ks-grid">
          <div class="ks-media reveal">
            <div class="ks-img">
              <span class="kit-badge">Akcija</span>
              <img src="/assets/img/tarantula.jpg" alt="Tarantula - komplet za početnike" width="800" height="800">
            </div>
          </div>
          <div class="ks-info reveal">
            <h2 class="ks-title">Tarantula</h2>
            <div class="ks-price">3.000 <span>din</span></div>
            <p class="ks-desc">Idealan ulazak u svet paukova — u ponudi je oko 10 vrsta tarantula, a komplet uključuje terarijum sa 3D pozadinom i podlogu. Zauzima malo prostora, lako se održava i uvek je zanimljiva za posmatranje.</p>
            <div class="ks-incl-title">Šta je uključeno</div>
            <ul class="ks-incl">
              <li>Terarijum 11×15×20 sa 3D pozadinom</li>
              <li>Kokosov treset</li>
              <li>Oko 10 vrsta u ponudi</li>
              <li>Idealan za prvi pauk</li>
            </ul>
            <div class="ks-cta">
              <a href="/kontakt.html?komplet=Tarantula" class="btn btn-primary">
                Pošalji upit
              </a>
              <a href="https://wa.me/381693301474?text=Zanima%20me%20komplet%20Tarantula" target="_blank" rel="noopener" class="btn btn-outline" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">
                Pitaj na WhatsApp
              </a>
            </div>
            <div class="ks-note">
              Lično preuzimanje u Novom Sadu ili slanje po dogovoru. Konsultacije
              oko izbora i nege su besplatne — javite nam se pre kupovine.
            </div>
          </div>
        </div>
      </div>
    </section>
<section class="ks-perks">
      <div class="wrap">
        <div class="reveal" style="text-align: center; max-width: 640px; margin: 0 auto">
          <h2 class="sec-title">Sve za <b>siguran start</b></h2>
        </div>
        <div class="ks-perks-grid">
          <div class="ks-perk reveal">
            <div class="ks-perk-num">01</div>
            <h3>Sve na jednom mestu</h3>
            <p>Životinja, terarijum odgovarajuće veličine i osnovna oprema — bez lutanja po prodavnicama i pogađanja šta je potrebno.</p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">02</div>
            <h3>Odabrano za početnike</h3>
            <p>Vrste iz naših kompleta su mirne naravi i jednostavne za negu, a oprema je prilagođena baš njihovim potrebama.</p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">03</div>
            <h3>Stručna podrška</h3>
            <p>Iza nas je 10 godina uzgoja. Uz komplet dobijate i savete za negu, a za sva pitanja smo dostupni i posle kupovine.</p>
          </div>
        </div>
      </div>
    </section>
<section class="ks-others">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <h2 class="sec-title">Ostali <b>kompleti</b></h2>
          </div>
          <a href="/kompleti.html" class="btn btn-outline">Svi kompleti</a>
        </div>
        <div class="kit-grid">
          <article class="kit-card reveal">
            <a href="/kompleti/bradata-agama.html" class="kit-img">
              <img src="/assets/img/bradata-agama.jpg" alt="Bradata agama" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Bradata agama</h3>
              <div class="kit-price">25.800 <span>din</span></div>
              <a href="/kompleti/bradata-agama.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/kompleti/leopard-gekon.html" class="kit-img">
              <img src="/assets/img/leopard-gekon.jpg" alt="Leopard gekon" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Leopard gekon</h3>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/leopard-gekon.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/kompleti/kukuruzni-smuk.html" class="kit-img">
              <img src="/assets/img/kukuruzni-smuk.jpg" alt="Kukuruzni smuk" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Kukuruzni smuk</h3>
              <div class="kit-price">12.500 <span>din</span></div>
              <a href="/kompleti/kukuruzni-smuk.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
          <article class="kit-card reveal">
            <a href="/kompleti/skorpija.html" class="kit-img">
              <img src="/assets/img/skorpija.jpg" alt="Škorpija" loading="lazy">
            </a>
            <div class="kit-body">
              <h3>Škorpija</h3>
              <div class="kit-price">8.500 <span>din</span></div>
              <a href="/kompleti/skorpija.html" class="btn btn-outline">Pogledaj više</a>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Kontaktirajte <b>NS Reptiles</b></h2>
        <p>Niste sigurni da li je ovaj komplet pravi izbor? Javite nam se — rado ćemo pomoći oko odluke.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Zanima%20me%20komplet%20Tarantula" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
