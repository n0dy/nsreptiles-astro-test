---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/usluge.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Održavanje i uređenje akvarijuma i terarijuma",
    "serviceType": "Održavanje i uređenje akvarijuma i terarijuma",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Srbija",
    "description": "Održavanje i uređenje akvarijuma i terarijuma u Novom Sadu. Čišćenje, zamena vode, podešavanje opreme i uređenje enterijera. Redovno ili jednokratno.",
    "url": "https://nsreptiles.net/odrzavanje-akvarijuma-terarijuma.html"
  }
];
---
<Base
  lang="sr"
  title="Održavanje akvarijuma i terarijuma, Novi Sad | NS Reptiles"
  description="Održavanje i uređenje akvarijuma i terarijuma u Novom Sadu. Čišćenje, zamena vode, podešavanje opreme i uređenje enterijera. Redovno ili jednokratno."
  path="/odrzavanje-akvarijuma-terarijuma.html"
  image="/style/img/logo.jpg"
  ogTitle="Održavanje i uređenje akvarijuma i terarijuma | NS Reptiles"
  ogDescription="Profesionalno čišćenje, uređenje i podešavanje opreme za akvarijume i terarijume. Redovno ili jednokratno. Novi Sad."
  translations={translationsFor("/odrzavanje-akvarijuma-terarijuma.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Usluga</div>
        <h1>Održavanje i uređenje akvarijuma i terarijuma</h1>
        <p>Profesionalno održavanje i uređenje kako bi vaš akvarijum ili terarijum uvek izgledao savršeno, a životinje bile zdrave i zadovoljne.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Održavanje i uređenje</div>
          <p>Nudimo <strong>jednokratne usluge</strong> čišćenja i uređenja, kao i dogovor za <strong>redovno održavanje</strong>. Kontaktirajte nas i dogovorićemo raspored i obim posla koji vam odgovara.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="feat-grid">
          <article class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Čišćenje akvarijuma</h3>
            <p>Redovno čišćenje je ključno za zdravlje ribica i kornjača. Vršimo delimičnu zamenu vode, čišćenje stakla od algi, usisavanje substrata, čišćenje filtera i proveru parametara vode. Preporučujemo održavanje jednom mesečno.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Čišćenje terarijuma</h3>
            <p>Terarijum zahteva redovno čišćenje kako bi reptil bio zdrav. Menjamo substrat, dezinfikujemo površine i proveravamo stanje opreme. Posebnu pažnju posvećujemo proveri temperature, vlažnosti i UVB rasvete.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Uređenje akvarijuma</h3>
            <p>Želite potpuno nov izgled? Postavljamo substrat, kamenje, drvo (Red Moor Wood), žive i veštačke biljke, 3D pozadine i dekoracije. Kreiramo prirodan, estetski prijatan izgled prilagođen vrsti riba ili kornjača.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">04</span>
            <h3>Uređenje terarijuma</h3>
            <p>Pravimo funkcionalan i vizuelno atraktivan prostor za reptila. Postavljamo odgovarajući substrat, 3D pozadine od stiropora ili siga kamena, penjačke grane, skrovišta, posude za vodu i hranu — sve prema potrebama vrste.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">05</span>
            <h3>Podešavanje opreme</h3>
            <p>Proveravamo i podešavamo kompletnu opremu — filtere, pumpe, grejače, termostate, LED i UVB/UVA rasvetu. Ako je nešto dotrajalo ili ne radi ispravno, predlažemo zamenu i pomažemo u odabiru odgovarajuće opreme.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">06</span>
            <h3>Redovno održavanje</h3>
            <p>Nudimo jednokratne usluge održavanja i uređenja, kao i dogovor za redovno održavanje. Kontaktirajte nas i dogovorićemo se oko rasporeda i obima posla koji vam odgovara.</p>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Treba vam pomoć?</div>
        <h2>Zakažite <b>održavanje</b></h2>
        <p>Javite nam se i dogovorićemo održavanje ili uređenje koje vam odgovara — jednokratno ili redovno.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Pozovi nas</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Ostale usluge</div>
          <h2>Sve na <b>jednom mestu</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/izrada-terarijuma.html">Izrada terarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-akvarijuma.html">Izrada akvarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-vivarijuma.html">Izrada vivarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-led-rasvete.html">Izrada LED rasvete<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/popravka-akvarijuma-terarijuma.html">Popravka i servis<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
