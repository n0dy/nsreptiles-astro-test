---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/oprema.css';
import { translationsFor } from '../i18n/routes';
---
<Base
  lang="sr"
  title="Oprema za terarijume i akvarijume | NS Reptiles, Novi Sad"
  description="Oprema za reptile - UVB rasveta, grejanje, hrana i suplementi, ziva hrana (dubie, fobasi), podloge i dekoracija. NS Reptiles, Novi Sad."
  path="/oprema.html"
  image="/style/img/oprema/dubie.webp"
  ogTitle="Oprema za terarijume i akvarijume | NS Reptiles"
  ogDescription="UVB rasveta, grejanje, hrana i suplementi, ziva hrana, podloge i dekoracija za terarijume i akvarijume."
  active="equipment"
  translations={translationsFor("/oprema.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Oprema</div>
        <h1>Oprema za terarijume i akvarijume</h1>
        <p>
          Sve što je potrebno za pravilno držanje reptila i akvarijumskih
          životinja - rasveta, grejanje, ishrana, podloge i dekoracija.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Naša ponuda</div>
          <p>
            U ponudi držimo <strong>Arcadia</strong> i
            <strong>HabiStat</strong> opremu - UVB i spot rasvetu, grejače,
            suplemente i hranu za gekone i kornjače, kao i živu hranu (dubie i
            fobasi) uvek na stanju. Za uređenje terarijuma tu su prirodne
            podloge, kamen i dekoracija.
          </p>
        </div>
      </div>
    </section>
<section class="op-shop">
      <div class="wrap">
        <div class="op-toolbar">
          <div class="pills">
            <button class="pill active" data-filter="all">Sve</button>
            <button class="pill" data-filter="rasveta">Rasveta i grejanje</button>
            <button class="pill" data-filter="ishrana">Ishrana i suplementi</button>
            <button class="pill" data-filter="dekoracija">Dekoracija i podloge</button>
            <button class="pill" data-filter="dodatna-oprema">Dodatna oprema</button>
            <a class="pill" href="/hrana-za-gustere.html">Hrana za guštere</a>
          </div>
          <div class="op-search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M21 21l-4.3-4.3"></path>
            </svg>
            <input type="text" id="opSearch" placeholder="Pretraži opremu...">
          </div>
        </div>
        <div class="op-count" id="opCount">60 proizvoda</div>
        <div class="op-grid" id="opGrid">
