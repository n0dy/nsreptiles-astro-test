---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/usluge.css';
import { translationsFor } from '../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Popravka akvarijuma i terarijuma",
    "serviceType": "Popravka akvarijuma i terarijuma",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Srbija",
    "description": "Popravka akvarijuma i terarijuma u Novom Sadu. Zamena stakla i silikona, popravka poklopca i okvira, zamena rasvete. Besplatna procena, popravka za 1-3 dana.",
    "url": "https://nsreptiles.net/popravka-akvarijuma-terarijuma.html"
  }
];
---
<Base
  lang="sr"
  title="Popravka akvarijuma i terarijuma, Novi Sad | NS Reptiles"
  description="Popravka akvarijuma i terarijuma u Novom Sadu. Zamena stakla i silikona, popravka poklopca i okvira, zamena rasvete. Besplatna procena, rok 1-3 dana."
  path="/popravka-akvarijuma-terarijuma.html"
  image="/style/img/logo.jpg"
  ogTitle="Popravka akvarijuma i terarijuma | NS Reptiles"
  ogDescription="Servis akvarijuma i terarijuma — zamena stakla i silikona, poklopac, okvir, rasveta. Besplatna procena. Novi Sad."
  translations={translationsFor("/popravka-akvarijuma-terarijuma.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Servis</div>
        <h1>Popravka akvarijuma i terarijuma</h1>
        <p>Vaš akvarijum ili terarijum ima oštećenje? Ne morate kupovati novi — popravljamo ga brzo i pouzdano.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Popravka i servis</div>
          <p>Pošaljite nam slike oštećenja i dimenzije, a mi ćemo vam dati <strong>besplatnu procenu</strong> cene i roka. Većina popravki završava se u roku od <strong>1-3 radna dana</strong>.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="feat-grid">
          <article class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Zamena stakla</h3>
            <p>Puklo ili naprsnulo staklo ne mora da znači kraj. Vršimo kompletnu zamenu oštećenog stakla novim, odgovarajuće debljine i kvaliteta, i vraćamo akvarijum u potpuno funkcionalno stanje.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Zamena silikona</h3>
            <p>Curenje je čest problem, naročito kod starijih modela. Uklanjamo stari, istrošeni silikon i nanosimo novi, kvalitetan akvarijumski silikon koji je potpuno bezbedan za ribe, kornjače i reptile.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Popravka poklopca</h3>
            <p>Poklopac je bitan za bezbednost životinja i rad rasvete. Popravljamo oštećene poklopce, dodajemo otvore za kablove ili izrađujemo nove po meri. Radimo i nadogradnje — ugradnja filtera, dupli poklopac ili nova hauba.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">04</span>
            <h3>Popravka okvira</h3>
            <p>Oštećen okvir, iskrivljen ram ili odlepljena folija — sve to rešavamo. Popravljamo strukturu, zamenjujemo oštećene delove okvira i ponovo oblepljujemo folijom po vašem izboru iz ponude od preko 40 dezena.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">05</span>
            <h3>Zamena rasvete</h3>
            <p>Pregorela LED traka, neispravan prekidač ili dotrajala rasveta? Zamenjujemo staru rasvetu novom LED rasvetom sa dnevnim i noćnim režimom. Za terarijume menjamo i UVB/UVA sijalice neophodne za zdravlje reptila.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">06</span>
            <h3>Besplatna procena</h3>
            <p>Kontaktirajte nas telefonom, mejlom ili preko društvenih mreža. Pošaljite slike oštećenja i dimenzije, a mi dajemo besplatnu procenu cene i roka. Većina popravki završava se u roku od 1-3 radna dana.</p>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Imate oštećenje?</div>
        <h2>Besplatna <b>procena popravke</b></h2>
        <p>Pošaljite nam slike oštećenja i dimenzije — dobićete besplatnu procenu cene i roka popravke.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Pozovi nas</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Ostale usluge</div>
          <h2>Sve na <b>jednom mestu</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/izrada-terarijuma.html">Izrada terarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-akvarijuma.html">Izrada akvarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-vivarijuma.html">Izrada vivarijuma<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/izrada-led-rasvete.html">Izrada LED rasvete<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/odrzavanje-akvarijuma-terarijuma.html">Održavanje i uređenje<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
