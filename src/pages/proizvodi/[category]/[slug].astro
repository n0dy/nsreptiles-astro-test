---
import ProductPage from '../../../components/ProductPage.astro';
import { getProducts, productView, relatedFor } from '../../../lib/products';

export async function getStaticPaths() {
  const all = await getProducts();
  return Promise.all(
    all.map(async (product) => {
      const [category, slug] = product.id.split('/');
      return { params: { category, slug }, props: { view: (await productView(product, 'sr'))!, related: relatedFor(product, all) } };
    })
  );
}
---
<ProductPage {...Astro.props} />
