---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "3D-фоны для аквариумов и террариумов",
    "description": "Уникальные 3D-фоны на заказ из натуральных материалов — туф, имитация скалы, торф и кора дерева.",
    "brand": {
      "@type": "Brand",
      "name": "NS Reptiles"
    },
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "RSD",
      "price": "0",
      "seller": {
        "@type": "Organization",
        "name": "NS Reptiles"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "3D-фоны",
        "item": "https://nsreptiles.net/ru/3d-backgrounds.html"
      }
    ]
  }
];
---
<Base
  lang="ru"
  title="3D-фоны для аквариумов и террариумов | NS Reptiles"
  description="3D-фоны на заказ для аквариумов и террариумов — натуральный туф, имитация скалы, торф и кора. Уникальный дизайн, изготовление в Нови-Саде."
  keywords="3D-фон для аквариума, 3D-фон для террариума, 3D-фон на заказ, фон из туфа, фон скала, декор аквариума, NS Reptiles"
  path="/ru/3d-backgrounds.html"
  image="/style/img/backgrounds/poz001.webp"
  ogTitle="3D-фоны на заказ для аквариумов и террариумов — NS Reptiles"
  ogDescription="Уникальные 3D-фоны на заказ для аквариумов и террариумов. Изготовление из натуральных материалов — туф, скала, торф."
  translations={translationsFor("/ru/3d-backgrounds.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>3D-фоны для аквариумов и террариумов</h1>
        <p>
          Уникальные 3D-фоны на заказ из натуральных материалов — туф,
          имитация скалы, торф и кора дерева. Каждый фон изготавливается
          вручную по размерам вашего аквариума или террариума.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <p>
            Мы изготавливаем 3D-фоны из самых качественных материалов. В ассортименте
            фоны с <strong>натуральным туфом</strong>, имитацией
            скалы, сочетанием <strong>торфа и коры дерева</strong>, а также
            3D-логотип вашего бренда или компании. Все фоны делаются на заказ, поэтому
            идеально прилегают к задней стенке вашего аквариума или террариума.
          </p>
        </div>
      </div>
    </section>
<section class="op-shop">
      <div class="wrap">
        <div class="op-toolbar">
          <div class="op-search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M21 21l-4.3-4.3"></path>
