            <div class="op-body">
              <div class="op-cat">3D-фон</div>
              <h3>Фон 100x40cm M003</h3>
              <div class="op-foot">
                <span class="op-price op-price-call">Цена по запросу</span>
              </div>
            </div>
          </article>
          <article class="op-card" data-search="фон pozadina 100x40cm m004">
