<section class="zcta">
      <div class="wrap">
        <h2>3D-фон <b>на заказ</b></h2>
        <p>
          Пришлите нам размеры вашего аквариума или террариума и желаемый
          материал — мы изготовим уникальный 3D-фон точно под ваши потребности.
        </p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Позвоните нам</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Всё в <b>одном месте</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/ru/custom-terrariums.html">Изготовление террариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/custom-aquariums.html">Изготовление аквариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/led-lighting.html">Изготовление LED-освещения<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/equipment.html">Оборудование для террариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>

<script is:inline slot="after">
      // pretraga po nazivu pozadine
      const bgCards = [...document.querySelectorAll('.op-card')];
      const bgCount = document.getElementById('opCount');
      const bgEmpty = document.getElementById('opEmpty');
      const bgSearch = document.getElementById('opSearch');

      function bgApply() {
        const q = bgSearch.value.trim().toLowerCase();
        let n = 0;
        bgCards.forEach((c) => {
          const show = !q || c.dataset.search.includes(q);
          c.style.display = show ? '' : 'none';
          if (show) n++;
        });
        bgCount.textContent =
          n + (n % 10 === 1 && n % 100 !== 11 ? ' модель' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? ' модели' : ' моделей');
        bgEmpty.classList.toggle('show', n === 0);
      }

      bgSearch.addEventListener('input', bgApply);
    </script>
</Base>
