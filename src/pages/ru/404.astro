---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="ru"
  title="404 — Страница не найдена | NS Reptiles"
  description="Страница, которую вы ищете, перемещена, удалена или никогда не существовала. Перейдите на главную, к животным, террариумам или контактам."
  path="/ru/404.html"
  image="/style/img/logo.jpg"
  noindex
  translations={translationsFor("/ru/404.html")}
>
<main>
      <section class="error-section">
        <div class="wrap">
          <div class="error-code reveal">404</div>
          <div class="error-divider reveal"></div>
          <h1 class="error-title reveal">Страница не найдена</h1>
          <p class="error-desc reveal">
            Страница, которую вы ищете, перемещена, удалена или никогда не
            существовала. Воспользуйтесь ссылками ниже, чтобы найти то, что
            вам нужно.
          </p>
          <div class="error-btns reveal">
            <a href="/ru/" class="btn btn-primary">Главная</a>
            <a href="/ru/animals.html" class="btn btn-primary">Животные</a>
            <a href="/ru/terrariums.html" class="btn btn-primary">Террариумы</a>
            <a href="/ru/contact.html" class="btn btn-primary">Контакты</a>
          </div>
        </div>
      </section>
    </main>
<style is:global>
      .error-section {
        padding: 100px 0 110px;
        text-align: center;
      }
      .error-code {
        font-family: 'Oswald', sans-serif;
        font-size: clamp(7rem, 20vw, 14rem);
        font-weight: 700;
        line-height: 1;
        color: var(--green);
        letter-spacing: -0.02em;
        margin-bottom: 0.1em;
      }
      .error-title {
        font-family: 'Oswald', sans-serif;
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink);
        margin-bottom: 1rem;
      }
      .error-desc {
        font-family: 'Jost', sans-serif;
        font-weight: 300;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--ink-soft);
        max-width: 480px;
        margin: 0 auto 2.5rem;
      }
      .error-btns {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
      }
      .error-divider {
        width: 50px;
        height: 3px;
        background: var(--green);
        margin: 0 auto 2rem;
        border-radius: 2px;
      }
    </style>

</Base>
