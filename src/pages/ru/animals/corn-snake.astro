---
import Base from '../../../layouts/Base.astro';
import '../../../styles/animals.css';
import '../../../styles/usluge.css';
import '../../../styles/oprema.css';
import { translationsFor } from '../../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Маисовый полоз — полное руководство по разведению и уходу",
    "description": "Всё о маисовом полозе — ручной змее, идеальной для начинающих. Террариум, кормление, температура и уход.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/ru/animals/corn-snake.html"
    },
    "image": "https://nsreptiles.net/style/img/gallery/9.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Животные",
        "item": "https://nsreptiles.net/ru/animals.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Маисовый полоз",
        "item": "https://nsreptiles.net/ru/animals/corn-snake.html"
      }
    ]
  }
];
---
<Base
  lang="ru"
  title="Маисовый полоз — уход и содержание | NS Reptiles"
  description="Маисовый полоз — ручная змея, идеальная для начинающих. Узнайте всё о террариуме, кормлении, температуре и уходе. NS Reptiles, Нови-Сад."
  keywords="маисовый полоз, маисовый полоз уход, маисовый полоз содержание, маисовый полоз кормление, террариум для маисового полоза, маисовый полоз купить Нови-Сад, змея для начинающих, NS Reptiles"
  path="/ru/animals/corn-snake.html"
  image="/style/img/gallery/9.jpg"
  ogType="article"
  ogDescription="Ручная змея, идеальная для начинающих. Полное руководство по содержанию маисового полоза — террариум, кормление, температура и уход."
  active="animals"
  translations={translationsFor("/ru/animals/corn-snake.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Змеи</div>
        <h1>Маисовый полоз</h1>
        <p>Ручная и легко приручаемая змея — один из самых частых выборов для начинающих террариумистов. Спокойный нрав, широкий спектр окрасов и долгая жизнь.</p>
      </div>
    </section>
<section class="pd-crumbs">
      <div class="wrap">
        <nav class="pd-breadcrumb" aria-label="Навигационная цепочка">
          <a href="/ru/">Главная</a>
          <span class="sep">›</span>
          <a href="/ru/animals.html">Животные</a>
          <span class="sep">›</span>
          <span class="cur" aria-current="page">Маисовый полоз</span>
        </nav>
      </div>
    </section>
<section class="animal-photo" style="background: var(--bg); padding: 24px 0 0; line-height: 0;">
      <div class="wrap">
        <img src="/style/img/gallery/9.jpg" alt="Маисовый полоз в террариуме — NS Reptiles, Нови-Сад" loading="eager" width="1248" height="832" style="width: 100%; height: auto; display: block; max-height: 520px; object-fit: cover;">
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box reveal">
          <div class="eyebrow">О виде</div>
          <p>Маисовый полоз — одна из самых популярных змей в террариумистике во всём мире. Родом он из юго-восточных районов США — от Нью-Джерси до Флориды и на запад до Луизианы, — где в природе населяет самые разные места обитания: леса, поля, луга и заброшенные постройки. Благодаря селекции он доступен в широком спектре окрасов и узоров; взрослые особи достигают длины от 120 до 160 см, а продолжительность жизни в неволе составляет от 15 до 20 лет.</p>
        </div>
      </div>
    </section>
<section class="zoo" style="padding-top: 40px;">
      <div class="wrap">

        <!-- Содержание и террариум -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Содержание и <b>террариум</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Для взрослой особи нужен террариум минимальных размеров 90×45×45 см. Обязательно обеспечьте укрытия, ветки для лазания и ёмкость с водой для купания. Крышка должна быть надёжно закреплена — маисовые полозы известны своими побегами. Рекомендуемые субстраты — торф, кокосовое волокно или бумага без печатной краски. Мелких частиц следует избегать, так как они могут вызвать закупорку кишечника.</p>
          </div>
        </div>

        <!-- Температура и освещение -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Температура и <b>освещение</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Тёплую часть террариума поддерживайте на уровне 28–30°C, прохладную — 22–24°C, а ночная температура не должна опускаться ниже 20°C. Обогрев обеспечивают термоковрики или термокабели, подключённые к термостату. UVB-освещение не обязательно, но суточный световой цикл помогает нормальному поведению — используйте таймер, чтобы имитировать естественные день и ночь.</p>
          </div>
        </div>

        <!-- Влажность и вода -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Влажность и <b>вода</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Оптимальная влажность — 40–60%. Во время линьки влажность следует повысить; также рекомендуется влажная камера или ёмкость с влажным субстратом. Свежая вода должна быть постоянно доступна в ёмкости, достаточно большой, чтобы змея могла искупаться. Ёмкость регулярно мойте, чтобы предотвратить загрязнение.</p>
          </div>
        </div>

        <!-- Кормление -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Кормление</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Малыши едят новорождённых мышат (пинки) каждые 5 дней. Взрослых кормят взрослыми мышами или крысами каждые 7–10 дней. Корм должен быть подходящего размера — не шире самой узкой части тела змеи. Ради безопасности животного рекомендуется замороженный и затем размороженный корм.</p>
          </div>
        </div>

        <!-- Поведение и обращение -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Поведение и <b>обращение</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Маисовые полозы активны в основном ночью, хотя их часто можно увидеть и днём. Они спокойные и ручные по натуре и легко привыкают к рукам, что делает их отличным выбором для начинающих. Агрессию проявляют редко. Не рекомендуется брать животное в руки в течение 48 часов после кормления, чтобы избежать срыгивания корма.</p>
          </div>
        </div>

        <!-- Размножение и здоровье -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Размножение и <b>здоровье</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Половая зрелость наступает в 2–3 года. Самки откладывают 10–30 яиц в кладке, а инкубация длится 60–65 дней при 27–29°C. Частые проблемы со здоровьем — метаболическая болезнь костей, остатки кожи после линьки, закупорка кишечника и респираторные инфекции. Профилактика — это правильное кормление, подходящие влажность и температура и регулярное соблюдение гигиены. При признаках болезни обратитесь к ветеринару, специализирующемуся на экзотических животных.</p>
          </div>
        </div>

      </div>
    </section>
<section class="pd-related section">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">Рекомендуем для маисового полоза</div>
          <h2 class="sec-title">Рекомендуемые товары</h2>
        </div>
        <div class="op-grid">
          <article class="op-card reveal">
            <a class="op-img" href="/ru/products/terrariums/terrarium-80x50x50.html">
              <img src="/style/img/terrariums/80x50x50.webp" alt="Террариум 80x50x50" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Террариум</div>
              <h3><a href="/ru/products/terrariums/terrarium-80x50x50.html">Террариум 80x50x50</a></h3>
              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/ru/products/terrariums/terrarium-70x40x35.html">
              <img src="/style/img/terrariums/70x40x35.webp" alt="Террариум 70x40x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Террариум</div>
              <h3><a href="/ru/products/terrariums/terrarium-70x40x35.html">Террариум 70x40x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/ru/products/terrariums/terrarium-65x40x40.html">
              <img src="/style/img/terrariums/65x40x40.webp" alt="Террариум 65x40x40" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Террариум</div>
              <h3><a href="/ru/products/terrariums/terrarium-65x40x40.html">Террариум 65x40x40</a></h3>
              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/ru/products/terrariums/terrarium-100x40x40.html">
              <img src="/style/img/terrariums/100x40x40-2.webp" alt="Террариум 100x40x40" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Террариум</div>
              <h3><a href="/ru/products/terrariums/terrarium-100x40x40.html">Террариум 100x40x40</a></h3>
              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content:center">Заинтересовались?</div>
        <h2>Свяжитесь с <b>NS Reptiles</b></h2>
        <p>По вопросам покупки, ухода или оборудования для маисового полоза — мы на связи. Позвоните или напишите нам.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=%D0%9C%D0%B5%D0%BD%D1%8F%20%D0%B8%D0%BD%D1%82%D0%B5%D1%80%D0%B5%D1%81%D1%83%D0%B5%D1%82%20%D0%BC%D0%B0%D0%B8%D1%81%D0%BE%D0%B2%D1%8B%D0%B9%20%D0%BF%D0%BE%D0%BB%D0%BE%D0%B7" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
