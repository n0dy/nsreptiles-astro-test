  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Животные",
        "item": "https://nsreptiles.net/ru/animals.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Толстохвостый геккон",
        "item": "https://nsreptiles.net/ru/animals/fat-tailed-gecko.html"
      }
    ]
  }
