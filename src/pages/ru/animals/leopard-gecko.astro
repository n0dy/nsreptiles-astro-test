              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/ru/products/terrariums/terrarium-45x35x35.html">
              <img src="/style/img/terrariums/45x35x35.webp" alt="Террариум 45x35x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Террариум</div>
              <h3><a href="/ru/products/terrariums/terrarium-45x35x35.html">Террариум 45x35x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/ru/products/terrariums/terrarium-65x35x35.html">
              <img src="/style/img/terrariums/t-65x35x35-bele-plocice-web.webp" alt="Террариум 65x35x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Террариум</div>
              <h3><a href="/ru/products/terrariums/terrarium-65x35x35.html">Террариум 65x35x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/ru/products/terrariums/terrarium-70x40x35.html">
              <img src="/style/img/terrariums/70x40x35.webp" alt="Террариум 70x40x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Террариум</div>
              <h3><a href="/ru/products/terrariums/terrarium-70x40x35.html">Террариум 70x40x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Цена по запросу</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content:center">Заинтересовались?</div>
        <h2>Свяжитесь с <b>NS Reptiles</b></h2>
        <p>По вопросам покупки, ухода или оборудования для леопардового геккона — мы на связи. Позвоните или напишите нам.</p>
        <div class="zcta-btns">
