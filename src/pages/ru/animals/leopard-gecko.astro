    "description": "Всё о леопардовом гекконе: террариум, температура, кормление и размножение. Полное руководство по разведению и уходу.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/ru/animals/leopard-gecko.html"
    },
    "image": "https://nsreptiles.net/style/img/gallery/3.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Животные",
        "item": "https://nsreptiles.net/ru/animals.html"
