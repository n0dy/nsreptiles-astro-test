---
import Base from '../../layouts/Base.astro';

import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="ru"
  title="Оплата - NS Reptiles"
  description="Оформите заказ в NS Reptiles: курьерская доставка за 2–4 рабочих дня по всей Сербии или самовывоз в Нови-Саде, оплата наложенным платежом или переводом."
  path="/ru/cart.html"
  bodyClass="checkout-page"
  cart={false}
  floatContact={false}
  translations={translationsFor("/ru/cart.html")}
>
<div class="co-top">
      <div class="wrap">
        <div class="crumb">Главная · Корзина · Оплата</div>
        <div class="co-top-row">
          <h1>Оплата</h1>
          <a href="/ru/" class="back-link">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            Продолжить покупки
          </a>
        </div>
      </div>
    </div>
<div class="co-wrap">
      <div id="coContent">
        <div class="co-grid">
          <!-- LEVO: forma -->
          <div>
            <div class="card">
              <h2><span class="step-no">1</span> Контактные данные</h2>
              <p class="sub">Чтобы мы могли уведомить вас о статусе заказа.</p>
              <div class="f-row">
                <div class="field">
                  <label>Имя</label><input type="text" id="fName" placeholder="Пётр">
                </div>
                <div class="field">
                  <label>Фамилия</label><input type="text" id="fLast" placeholder="Петрович">
                </div>
              </div>
              <div class="f-row">
                <div class="field">
                  <label>E-mail</label><input type="email" id="fEmail" placeholder="petar@email.com">
                </div>
                <div class="field">
                  <label>Телефон</label><input type="tel" id="fPhone" placeholder="+381 6x xxx xxxx">
                </div>
              </div>
            </div>

            <div class="card">
              <h2><span class="step-no">2</span> Адрес доставки</h2>
              <p class="sub">Куда отправить ваш заказ.</p>
              <div class="field full">
                <label>Улица и номер дома</label><input type="text" id="fStreet" placeholder="Бульвар Освобождения 123">
              </div>
              <div class="f-row">
                <div class="field">
                  <label>Город</label><input type="text" id="fCity" placeholder="Нови Сад">
                </div>
                <div class="field">
                  <label>Почтовый индекс</label><input type="text" id="fZip" placeholder="21000">
                </div>
              </div>
              <div class="field full">
                <label>Примечание (необязательно)</label><textarea id="fNote" placeholder="Напр. оставить у соседа, позвонить перед доставкой..."></textarea>
              </div>
            </div>

            <div class="card">
              <h2><span class="step-no">3</span> Способ доставки</h2>
              <p class="sub">Выберите, как хотите получить заказ.</p>
              <label class="opt sel" data-ship="290">
                <input type="radio" name="ship" value="290" checked=""><span class="dot"></span>
                <div class="opt-main">
                  <b>Курьерская доставка</b><small>2–4 рабочих дня, вся Сербия</small>
                </div>
                <span class="opt-price">290 дин</span>
              </label>
              <label class="opt" data-ship="0">
                <input type="radio" name="ship" value="0"><span class="dot"></span>
                <div class="opt-main">
                  <b>Самовывоз</b><small>Нови Сад, по договорённости</small>
                </div>
                <span class="opt-price">Бесплатно</span>
              </label>
            </div>

            <div class="card">
              <h2><span class="step-no">4</span> Способ оплаты</h2>
              <p class="sub">Безопасно и просто.</p>
              <label class="opt sel">
                <input type="radio" name="pay" value="pouzecem" checked=""><span class="dot"></span>
                <div class="opt-main">
                  <b>Наложенный платёж</b><small>Оплата курьеру при получении</small>
                </div>
              </label>
              <label class="opt">
                <input type="radio" name="pay" value="racun"><span class="dot"></span>
                <div class="opt-main">
                  <b>Банковский перевод</b><small>Счёт отправим на e-mail</small>
                </div>
              </label>
            </div>
          </div>

          <!-- DESNO: pregled porudžbine -->
          <div class="summary-col">
            <div class="card summary">
              <h2>Ваш заказ</h2>
              <div id="sumItems"></div>
              <div class="promo">
                <input type="text" id="promo" placeholder="Промокод">
                <button id="promoBtn">Применить</button>
              </div>
              <div class="sum-line">
                <span>Подитог</span><span id="sumSub">0 дин</span>
              </div>
              <div class="sum-line">
                <span>Доставка</span><span id="sumShip">290 дин</span>
              </div>
              <div class="sum-line" id="sumDiscRow" style="display: none">
                <span>Скидка</span><span id="sumDisc">0 дин</span>
              </div>
              <div class="sum-line total">
                <span>Итого</span><b id="sumTotal">0 дин</b>
              </div>
              <button class="btn btn-primary place-btn" id="placeBtn">
                Подтвердить заказ
              </button>
              <div class="co-secure">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0110 0v4"></path>
                </svg>
                Безопасная покупка
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>


</Base>
