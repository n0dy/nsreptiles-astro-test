---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Оборудование для террариумов и аквариумов",
    "description": "UVB освещение, обогрев, корм и добавки, живой корм, подложки и декорации для рептилий и аквариумных животных.",
    "url": "https://nsreptiles.net/ru/equipment.html",
    "inLanguage": "ru",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Главная",
          "item": "https://nsreptiles.net/ru/index.html"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Оборудование",
          "item": "https://nsreptiles.net/ru/equipment.html"
        }
      ]
    }
  }
];
