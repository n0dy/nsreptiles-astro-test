---
import Base from '../../layouts/Base.astro';

import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="ru"
  title="Галерея террариумов и рептилий, Нови-Сад | NS Reptiles"
  description="Галерея NS Reptiles - фото террариумов, аквариумов, рептилий и экзотических животных. Вдохновение для вашего будущего террариума."
  path="/ru/gallery.html"
  active="gallery"
  bodyClass="gallery-page"
  cart={false}
  translations={translationsFor("/ru/gallery.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Галерея</div>
        <h1>Наш мир экзотики</h1>
        <p>
          Фотографии наших рептилий, террариумов и аквариумов. Просмотрите наши
          работы и найдите вдохновение для будущего дома вашего питомца.
        </p>
      </div>
    </section>
<section class="section gallery">
      <div class="wrap">
        <div class="gal-grid" id="galGrid">
          <div class="gal-item gal-big" data-cat="guster">
            <img loading="lazy" decoding="async" src="/style/img/gallery/2.jpg" alt="Бородатая агама">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Ящерица</small><b>Бородатая агама</b></div>
          </div>
          <div class="gal-item" data-cat="zmija">
            <img loading="lazy" decoding="async" src="/style/img/gallery/1.jpg" alt="Шаровидный питон">
            <span class="zoom"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M21 21l-4.3-4.3M11 8v6M8 11h6"></path></svg></span>
            <div class="cap"><small>Змея</small><b>Шаровидный питон</b></div>
          </div>
          <div class="gal-item" data-cat="guster">
