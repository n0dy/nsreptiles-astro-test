---
import { twoTone } from '../../../lib/two-tone';
import Base from '../../../layouts/Base.astro';
import '../../../styles/animals.css';
import '../../../styles/usluge.css';
import { translationsFor } from '../../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Террариум для королевского питона — руководство по обустройству",
    "description": "Рекомендуемый размер террариума для королевского питона — около 80x40x40 см. Узнайте всё о субстрате, обогреве, укрытии и оборудовании.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/ru/guides/ball-python-terrarium.html"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Террариумы",
        "item": "https://nsreptiles.net/ru/terrariums.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Террариум для королевского питона",
        "item": "https://nsreptiles.net/ru/guides/ball-python-terrarium.html"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Какой размер террариума нужен королевскому питону?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Рекомендуемый размер террариума для королевского питона — около 80x40x40 см: этого достаточно для движения и укрытия."
        }
      },
      {
        "@type": "Question",
        "name": "Как поддерживать температуру в террариуме для королевского питона?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Под террариумом с одной стороны нужно разместить термоковрик, который поддерживает оптимальную температуру. В качестве субстрата используйте кокосовый торф."
        }
      },
      {
        "@type": "Question",
        "name": "Что нужно в террариуме для королевского питона?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "В террариуме нужно обеспечить укрытие и поилку. Субстратом должен быть кокосовый торф, а температура регулируется термоковриком."
        }
      }
    ]
  }
];
---
<Base
  lang="ru"
  title="Террариум для королевского питона | NS Reptiles"
  description="Террариум для королевского питона: размер 80x40x40 см, кокосовый торф, термоковрик и укрытие. Стеклянные террариумы на заказ из Нови-Сада."
  path="/ru/guides/ball-python-terrarium.html"
  keywords="террариум для королевского питона, королевский питон террариум, термоковрик для змеи, террариум для змеи на заказ, Нови-Сад"
  image="/style/img/terrariums/90x45x45.webp"
  ogType="article"
  ogDescription="Рекомендуемый размер террариума для королевского питона — около 80x40x40 см с термоковриком. Стеклянные террариумы на заказ, Нови-Сад."
  translations={translationsFor("/ru/guides/ball-python-terrarium.html")}
  schema={schema}
>
<section class="page-head" style="--ph-img: url(/style/img/izrada/terarijum.webp); --ph-img-sm: url(/style/img/izrada/terarijum.webp)">
      <div class="wrap">
        <h1 set:html={twoTone('Террариум для королевского питона')} />
        <p>Рекомендуемый размер — около 80×40×40 см с термоковриком под террариумом. Стеклянные террариумы для змей мы изготавливаем на заказ в Нови-Саде.</p>
      </div>
    </section>
<nav class="breadcrumb" aria-label="Навигационная цепочка">
      <div class="wrap">
        <a href="/ru/">Главная</a>
        <span>›</span>
        <a href="/ru/terrariums.html">Руководства</a>
        <span>›</span>
        Террариум для королевского питона
      </div>
    </nav>
<section class="animal-facts reveal">
      <div class="wrap">
        <h2>Что <b>нужно</b></h2>
        <div class="feat-grid">
          <div class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Размер террариума</h3>
            <p>Рекомендуемый минимальный размер — около 80×40×40 см: достаточно места для движения и укрытия.</p>
          </div>
          <div class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Обогрев</h3>
            <p>Термоковрик размещают под террариумом с одной стороны, чтобы создать температурный градиент.</p>
          </div>
          <div class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Субстрат и оборудование</h3>
            <p>Кокосовый торф в качестве субстрата, укрытие и поилка — обязательные элементы любого хорошо оборудованного террариума.</p>
          </div>
        </div>
      </div>
    </section>
<section class="care-sections reveal">
      <div class="wrap">

        <div class="care-section">
          <div class="care-label">Размеры</div>
          <div class="care-text">
            <p>Рекомендуемый размер террариума для королевского питона — около 80×40×40 см. Такие размеры обеспечивают достаточно места для движения и укрытия, что важно для благополучия этой змеи. В террариуме меньшего размера нельзя устроить зону отдыха, отделённую от зоны активности.</p>
            <p>Поскольку мы изготавливаем террариумы на заказ, размеры, цвет и оборудование вы выбираете сами. Если вы не уверены, какой размер оптимален для вашего питомца, смело свяжитесь с нами до оформления заказа.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Обогрев</div>
          <div class="care-text">
            <p>Температура внутри террариума регулируется термоковриком, который размещают под террариумом с одной стороны. Так формируется температурный градиент — более тёплая зона с одной стороны и более прохладная с другой, — что позволяет змее самостоятельно регулировать температуру тела, перемещаясь по террариуму.</p>
            <p>Термоковрик нельзя укладывать по всей площади дна, потому что у животного должна быть возможность перейти на более прохладную сторону, когда это нужно.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Субстрат</div>
          <div class="care-text">
            <p>Рекомендуемый субстрат в террариуме для королевского питона — кокосовый торф. Этот субстрат подходит, потому что хорошо удерживает влагу, выглядит естественно, его легко чистить и менять.</p>
            <p>Субстрат нужно регулярно проверять и при необходимости менять, чтобы поддерживать гигиену в террариуме и не допускать размножения бактерий и плесени.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Оформление внутри</div>
          <div class="care-text">
            <p>В террариуме нужно обеспечить укрытие и поилку. Укрытие необходимо, потому что королевские питоны известны своей любовью прятаться — без подходящего укрытия змея может находиться в постоянном стрессе.</p>
            <p>Поилка должна быть достаточно большой, чтобы змея могла в неё забраться, потому что этот вид регулярно использует воду и для питья, и для купания, особенно в период линьки.</p>
          </div>
        </div>

        <div class="care-section">
          <div class="care-label">Изготовление на заказ</div>
          <div class="care-text">
            <p>Все перечисленные террариумы мы изготавливаем на заказ из стекла. Цвет террариума, размер, оборудование и всё остальное вы можете выбрать сами. Возможно добавить 3D-фон из пенопласта или натурального камня-травертина, ветки для лазания и укрытия.</p>
            <p>Если вы хотите террариум, полностью оборудованный для королевского питона — с термоковриком, субстратом, укрытием и поилкой, — это можно согласовать при заказе.</p>
          </div>
        </div>

      </div>
    </section>
<section class="rec-tera reveal">
      <div class="wrap">
        <div class="rec-tera-box">
          <div class="rec-tera-info">
            <h2>Рекомендуемый <b>террариум</b></h2>
            <p>Для королевского питона мы рекомендуем террариум размером <strong>80×40×45 см</strong> или <strong>90×45×45 см</strong>. Каждый террариум мы изготавливаем вручную из стекла, с плёнкой или 3D-фоном на выбор и полным комплектом оборудования для этого вида.</p>
            <a href="/ru/terrariums.html" class="btn btn-primary" onclick="gtag('event', 'terarijum_click', {'vrsta': 'loptasti_piton'})">Смотреть террариумы</a>
          </div>
          <div class="rec-tera-visual">
            <img src="/style/img/terrariums/90x45x45.webp" alt="Стеклянный террариум 90x45x45 см для королевского питона" loading="lazy" width="1080" height="1080">
          </div>
        </div>
      </div>
    </section>
<section class="faq-sec reveal">
      <div class="wrap">
        <h2>Частые <b>вопросы</b></h2>
        <div class="faq-list">

          <div class="faq-item">
            <button class="faq-q">
              Какой размер террариума нужен королевскому питону?<span class="ic">+</span>
            </button>
            <div class="faq-a">
              <p>Рекомендуемый размер террариума для королевского питона — около 80×40×40 см: этого достаточно для движения и укрытия.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-q">
              Как поддерживать температуру в террариуме для королевского питона?<span class="ic">+</span>
            </button>
            <div class="faq-a">
              <p>Под террариумом с одной стороны нужно разместить термоковрик, который поддерживает оптимальную температуру. В качестве субстрата используйте кокосовый торф.</p>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-q">
              Что нужно в террариуме для королевского питона?<span class="ic">+</span>
            </button>
            <div class="faq-a">
              <p>В террариуме нужно обеспечить укрытие и поилку. Субстратом должен быть кокосовый торф, а температура регулируется термоковриком, размещённым под террариумом с одной стороны.</p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="related-links reveal">
      <div class="wrap">
        <h2>Полезные <b>ссылки</b></h2>
        <div class="rel-grid">
          <a href="/ru/animals/ball-python.html" class="rel-card">
            Руководство по королевскому питону
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/ru/terrariums.html" class="rel-card">
            Все террариумы
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="/ru/custom-terrariums.html" class="rel-card">
            Изготовление террариумов на заказ
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>
<section class="zcta reveal">
      <div class="wrap">
        <h2>Свяжитесь <b>с нами</b></h2>
        <p>Обращайтесь к нам за советом по террариуму или для заказа. Мы изготавливаем террариумы на заказ — цвет, размер и оборудование вы выбираете сами.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D0%BC%D0%B5%D0%BD%D1%8F%20%D0%B8%D0%BD%D1%82%D0%B5%D1%80%D0%B5%D1%81%D1%83%D0%B5%D1%82%20%D1%82%D0%B5%D1%80%D1%80%D0%B0%D1%80%D0%B8%D1%83%D0%BC%20%D0%B4%D0%BB%D1%8F%20%D0%BA%D0%BE%D1%80%D0%BE%D0%BB%D0%B5%D0%B2%D1%81%D0%BA%D0%BE%D0%B3%D0%BE%20%D0%BF%D0%B8%D1%82%D0%BE%D0%BD%D0%B0" target="_blank" rel="noopener" class="btn btn-primary" onclick="gtag('event', 'kontakt_click', {'metod': 'whatsapp', 'stranica': 'vodic_loptasti_piton'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event', 'kontakt_click', {'metod': 'poziv', 'stranica': 'vodic_loptasti_piton'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>
<style is:global>
      /* Breadcrumb */
      .breadcrumb {
        padding: 14px 0;
        background: var(--bg);
        font-size: 0.88rem;
        color: var(--ink-soft);
        border-bottom: 1px solid var(--silver);
        transition: background 0.4s, border-color 0.4s;
      }
      .breadcrumb a { color: var(--green-ink); }
      .breadcrumb span { margin: 0 7px; opacity: 0.5; }

      /* Quick info cards */
      .animal-facts {
        padding: 60px 0 30px;
        background: var(--bg);
        transition: background 0.4s;
      }
      .animal-facts h2 {
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        text-transform: uppercase;
        margin-bottom: 28px;
      }
      .animal-facts h2 b { color: var(--green-ink); }

      /* Care sections */
      .care-sections {
        padding: 40px 0 90px;
        background: var(--white);
        transition: background 0.4s;
      }
      .care-section {
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 26px;
        padding: 28px 0;
        border-bottom: 1px solid var(--silver);
        transition: border-color 0.4s;
      }
      .care-section:first-child { padding-top: 4px; }
      .care-section:last-child { border-bottom: 0; }
      .care-label {
        font-family: 'Oswald Variable', sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--green-ink);
        padding-top: 3px;
      }
      .care-text p {
        color: var(--ink-soft);
        line-height: 1.78;
        margin: 0 0 12px;
      }
      .care-text p:last-child { margin-bottom: 0; }

      /* Recommended terrarium block */
      .rec-tera {
        padding: 80px 0;
        background: var(--bg);
        transition: background 0.4s;
      }
      .rec-tera-box {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: center;
      }
      .rec-tera-info h2 {
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        text-transform: uppercase;
        margin-bottom: 16px;
      }
      .rec-tera-info h2 b { color: var(--green-ink); }
      .rec-tera-info p {
        color: var(--ink-soft);
        line-height: 1.75;
        margin-bottom: 26px;
      }
      .rec-tera-visual {
        background: var(--pattern);
        aspect-ratio: 4/3;
        overflow: hidden;
        transition: background 0.4s;
      }
      .rec-tera-visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
      }
      .rec-tera-visual:hover img { transform: scale(1.04); }

      /* FAQ section */
      .faq-sec {
        padding: 80px 0;
        background: var(--white);
        transition: background 0.4s;
      }
      .faq-sec h2 {
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        text-transform: uppercase;
        margin-bottom: 36px;
      }
      .faq-sec h2 b { color: var(--green-ink); }

      /* Internal links block */
      .related-links {
        padding: 60px 0;
        background: var(--bg);
        transition: background 0.4s;
      }
      .related-links h2 {
        font-size: clamp(1.3rem, 2.5vw, 1.8rem);
        text-transform: uppercase;
        margin-bottom: 24px;
      }
      .related-links h2 b { color: var(--green-ink); }
      .rel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }
      .rel-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 22px;
        background: var(--white);
        border-radius: 8px;
        box-shadow: var(--card-shadow);
        color: var(--ink);
        text-decoration: none;
        font-family: 'Oswald Variable', sans-serif;
        font-weight: 500;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: border-color 0.2s, color 0.2s, background 0.4s;
        gap: 12px;
      }
      .rel-card:hover { border-color: var(--green); color: var(--green-ink); }
      .rel-card svg { flex-shrink: 0; }

      @media (max-width: 860px) {
        .care-section { grid-template-columns: 1fr; gap: 8px; }
        .rec-tera-box { grid-template-columns: 1fr; }
        .rec-tera-visual { aspect-ratio: 16/9; }
      }
    </style>
</Base>
