      "description": "Практическое руководство для начинающих, которые хотят завести первый аквариум: как выбрать размер, какое оборудование необходимо и как правильно запустить аквариум.",
      "author": {
        "@type": "Organization",
        "name": "NS Reptiles"
      },
      "publisher": {
        "@type": "Organization",
        "name": "NS Reptiles",
        "url": "https://nsreptiles.net"
      },
      "url": "https://nsreptiles.net/ru/guides/beginner-aquariums.html",
      "inLanguage": "ru"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Главная",
          "item": "https://nsreptiles.net/ru/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Аквариумы",
          "item": "https://nsreptiles.net/ru/aquariums.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Аквариумы для начинающих",
