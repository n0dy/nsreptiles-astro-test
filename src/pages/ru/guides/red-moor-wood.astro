      .breadcrumb a:hover {
        color: var(--green-ink);
      }
      .breadcrumb li:last-child {
        color: var(--ink);
      }
      .guide-cta-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 28px;
      }
    </style>

</Base>
