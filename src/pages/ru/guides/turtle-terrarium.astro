---
import Base from '../../../layouts/Base.astro';
import '../../../styles/animals.css';
import '../../../styles/usluge.css';
import { translationsFor } from '../../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Террариум для черепахи — руководство по обустройству тер-аквариума",
    "description": "Подробное руководство по обустройству тер-аквариума для черепахи: размеры, оборудование, фильтр, UVB-лампа и частые ошибки.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/ru/guides/turtle-terrarium.html"
    },
    "image": "https://nsreptiles.net/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Террариумы",
        "item": "https://nsreptiles.net/ru/terrariums.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Террариум для черепахи",
        "item": "https://nsreptiles.net/ru/guides/turtle-terrarium.html"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Что такое тер-аквариум для черепахи?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Тер-аквариум — это сочетание террариума и аквариума, в котором есть и сухопутная, и водная часть; он идеально подходит для водных и полуводных черепах. Сухопутная часть служит для отдыха и прогрева под лампой, а водная — для плавания и гидратации."
        }
      },
      {
        "@type": "Question",
        "name": "Какого размера должен быть тер-аквариум для черепахи?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Минимальная рекомендация для молодых особей — основание 50x35 см, а для взрослых — 80x45 см или больше. Водная часть должна занимать 50-60% общей площади. Чем больше тер-аквариум, тем проще поддерживать стабильные условия."
        }
      },
      {
        "@type": "Question",
        "name": "Вы изготавливаете тер-аквариумы на заказ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да, мы изготавливаем тер-аквариумы на заказ. Вы можете выбрать размер, цвет, соотношение суши и воды, а также дополнительное оборудование. Свяжитесь с нами, чтобы получить предложение."
        }
      },
      {
        "@type": "Question",
        "name": "Какой фильтр подходит для тер-аквариума?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Для тер-аквариума практичнее всего внутренний или внешний фильтр достаточной производительности. Черепахи производят больше отходов, чем рыбы, поэтому рекомендуется фильтр, рассчитанный на объём в 3-4 раза больше объёма воды. Регулярное обслуживание фильтра обязательно."
        }
      }
    ]
  }
];
---
<Base
  lang="ru"
  title="Террариум для черепахи: тер-аквариум | NS Reptiles"
  description="Тер-аквариум для черепахи: размеры, оборудование, фильтр, UVB-лампа и оформление. Всё, что нужно знать перед покупкой, — NS Reptiles, Нови-Сад."
  path="/ru/guides/turtle-terrarium.html"
  keywords="террариум для черепахи, тер-аквариум для черепахи, акватеррариум для черепахи, UVB лампа для черепахи, Нови-Сад"
  image="/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
  ogType="article"
  ogTitle="Террариум для черепахи — руководство по обустройству | NS Reptiles"
  ogDescription="Всё о тер-аквариуме для черепахи: размер, оборудование, фильтр, UVB-лампа и частые ошибки. NS Reptiles, Нови-Сад."
  translations={translationsFor("/ru/guides/turtle-terrarium.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Руководства</div>
        <h1>Террариум для черепахи</h1>
        <p>
          Тер-аквариум — стеклянный дом с сухопутной и водной частью — единственный
          правильный выбор для полуводных черепах. В этом руководстве мы шаг за шагом
          разберём размеры, оборудование и оформление.
        </p>
      </div>
    </section>
<nav class="breadcrumb" aria-label="Навигационная цепочка">
      <div class="wrap">
        <ol>
          <li><a href="/ru/">Главная</a></li>
          <li><a href="/ru/terrariums.html">Террариумы</a></li>
          <li aria-current="page">Террариум для черепахи</li>
        </ol>
      </div>
    </nav>
<section class="animal-hero reveal">
      <div class="wrap">
        <img src="/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp" alt="Тер-аквариум для черепахи с сухопутной и водной частью — NS Reptiles" width="1080" height="1080" loading="eager" fetchpriority="high" class="animal-hero-img">
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="eyebrow reveal">Основы</div>
        <h2 class="sec-title reveal">Что такое тер-аквариум</h2>

        <div class="animal-detail-grid">

          <div class="animal-fact reveal">
            <h3>Сухопутная и водная часть</h3>
            <p>
              Тер-аквариум — это стеклянная конструкция, которая объединяет в одном
              пространстве сухопутную и водную часть. Черепахи используют водную часть
              для плавания и гидратации, а сухопутную — для отдыха, прогрева под
              греющей лампой и откладки яиц. Без одной из двух частей условия
              содержания не соответствуют естественному образу жизни этих животных.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Для каких видов он предназначен</h3>
            <p>
              Тер-аквариум — правильное решение для полуводных черепах, которые
              проводят значительную часть времени в воде. Сухопутным черепахам, которые
              живут на сухой местности и питаются растениями, водная часть не нужна —
              им подходит классический террариум с субстратом и нижним обогревом. Если
              вы не уверены, какой вариант вам подходит, смело свяжитесь с нами.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Изготовление на заказ</h3>
            <p>
              Каждый тер-аквариум в NS Reptiles мы изготавливаем из стекла вручную,
              по вашим размерам и пожеланиям. Вы можете выбрать размеры, цвет отделки,
              соотношение суши и воды, а также полный комплект оборудования. Мы
              изготавливаем террариумы на заказ — цвет, размер и оборудование вы
              выбираете сами. Посетите нашу
              <a href="/ru/custom-terrariums.html">страницу изготовления террариумов на заказ</a>
              или свяжитесь с нами напрямую.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Готовые модели из ассортимента</h3>
            <p>
              Помимо изготовления на заказ, мы предлагаем и готовые тер-аквариумы
              стандартных размеров — с основанием от 50x35 см до 100x45 см. Все модели
              изготовлены из стекла с декоративной плёнкой на выбор. Весь ассортимент
              можно посмотреть на
              <a href="/ru/terrariums.html">странице террариумов</a>.
            </p>
          </div>

        </div>
      </div>
    </section>
<section class="usl" style="background: var(--bg);">
      <div class="wrap">
        <div class="eyebrow reveal">Размеры</div>
        <h2 class="sec-title reveal">Какого размера должен быть тер-аквариум</h2>

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Минимальные размеры</h3>
              <p>
                Для молодых особей минимальное основание — 50x35 см, но нужно помнить,
                что черепахи растут. Взрослым особям требуется 80x45 см или больше.
                Рекомендуем сразу покупать тер-аквариум под взрослый размер —
                тогда не придётся менять оборудование по мере роста животного.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Соотношение суши и воды</h3>
              <p>
                Водная часть должна занимать от 50 до 60% общей площади тер-аквариума.
                Сухопутная часть служит для отдыха и прогрева под лампой, поэтому она
                должна быть достаточно просторной, чтобы животное могло свободно
                улечься. Уровень воды должен позволять черепахе без труда
                перевернуться со спины — обычно он вдвое больше ширины панциря.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Высота тер-аквариума</h3>
              <p>
                Высота не так критична, как в террариуме для лазающих видов, но её
                должно хватать, чтобы правильно разместить лампу на безопасной высоте над
                сухопутной частью. Для стандартных моделей рекомендуется высота минимум 40 см.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="eyebrow reveal">Оборудование</div>
        <h2 class="sec-title reveal">Необходимое оборудование</h2>

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Фильтр для воды</h3>
              <p>
                Фильтр обязателен и должен быть достаточно мощным. Черепахи производят
                значительно больше отходов, чем рыбы, поэтому рекомендуется выбирать
                фильтр производительностью в три-четыре раза больше реального объёма воды.
                Внутренние фильтры удобны для небольших тер-аквариумов, внешние фильтры —
                лучший выбор для крупных моделей. Губку фильтра промывают раз в
                неделю.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>UVB-лампа</h3>
              <p>
                UVB-освещение необходимо — без него черепаха не может синтезировать
                витамин D3, необходимый для усвоения кальция. Рекомендуется
                лампа с UVB-индексом от 5 до 10%, размещённая над сухопутной частью.
                Лампу меняют каждые 12 месяцев, потому что UVB-излучение снижается ещё
                до того, как лампа перестанет светить.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Греющая лампа</h3>
              <p>
                Над сухопутной частью устанавливают греющую лампу, которая создаёт тёплую
                зону для прогрева. Температура в тёплой зоне должна быть от 30 до 35 градусов.
                Остальная часть тер-аквариума должна быть прохладнее, около 22–26 градусов,
                чтобы животное могло регулировать температуру тела.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Нагреватель для воды</h3>
              <p>
                Температура воды должна быть от 22 до 26 градусов. Аквариумный
                нагреватель с терморегулятором поддерживает стабильную температуру и
                предотвращает резкие перепады, которые могут навредить здоровью черепахи.
                Его устанавливают в водной части, подальше от места, где черепаха часто находится.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Пандус и суша</h3>
              <p>
                Пандус или полка, по которой черепаха может беспрепятственно выбраться из
                воды на сушу, обязательны. Они должны быть устойчивыми и с шероховатой
                поверхностью, чтобы черепаха не соскальзывала. Сухопутную часть можно
                заполнить песчаным субстратом или оставить стекло, покрытое плиткой, —
                выбор зависит от предпочтений владельца и вида черепахи.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="usl" style="background: var(--bg);">
      <div class="wrap">
        <div class="eyebrow reveal">Оформление</div>
        <h2 class="sec-title reveal">Как оформить тер-аквариум</h2>

        <div class="animal-detail-grid">

          <div class="animal-fact reveal">
            <h3>Грунт в водной части</h3>
            <p>
              Дно водной части можно оставить пустым (стекло) или покрыть крупной
              галькой диаметром больше панциря черепахи. Мелкого песка и гравия следует
              избегать, так как есть риск, что черепаха их проглотит. Пустое дно
              облегчает уборку и уменьшает скопление отходов.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Декорации</h3>
            <p>
              Водную часть можно оформить каменными декорациями и вулканическими камнями,
              безопасными для животных. Пластиковые растения добавляют эстетики и укрытий.
              Живые водные растения возможны, но черепахи часто их съедают или
              выкапывают. Все декорации должны быть устойчивыми — черепахи сильные
              и переворачивают всё, что плохо закреплено.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>3D-фон</h3>
            <p>
              3D-фон из пенопласта или камня придаёт тер-аквариуму натуралистичный
              вид и служит дополнительной поверхностью для лазания и отдыха. В NS Reptiles
              мы предлагаем несколько видов 3D-фонов — от классических каменных узоров до
              декоративных моделей. Фон приклеивают до заполнения водой.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Освещение пространства</h3>
            <p>
              Помимо UVB- и греющей лампы, можно добавить декоративное LED-освещение
              для лучшего визуального эффекта. LED-ленты вдоль края крышки или за фоном
              делают вид красивее без заметного влияния на температуру. Цикл день/ночь —
              12 часов света и 12 часов темноты — нужно соблюдать круглый год.
            </p>
          </div>

        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="eyebrow reveal">На что обратить внимание</div>
        <h2 class="sec-title reveal">Частые ошибки при обустройстве тер-аквариума</h2>

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Слишком маленький тер-аквариум</h3>
              <p>
                Самая частая ошибка — покупка слишком маленькой ёмкости «пока черепаха не подрастёт».
                Нехватка пространства приводит к стрессу, агрессивному поведению и ухудшению
                здоровья. Сразу покупайте тер-аквариум подходящих размеров для
                взрослой особи вашего вида.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Недостаточно мощный фильтр</h3>
              <p>
                Фильтра, производительность которого равна объёму воды, недостаточно.
                Черепахи — грязнули: фильтр должен быть значительно мощнее
                минимального, а воду нужно частично менять раз в неделю
                независимо от того, как она выглядит.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Отсутствие UVB-лампы</h3>
              <p>
                Без UVB-освещения у черепахи разовьётся метаболическая болезнь костей
                — размягчение панциря, деформации и серьёзные проблемы со здоровьем.
                UVB-лампа — не дополнительная опция, а базовое оборудование. Её меняют каждые
                12 месяцев.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Холодная вода без нагревателя</h3>
              <p>
                Черепахи — эктотермные животные: температура среды напрямую
                влияет на обмен веществ, пищеварение и иммунитет. Вода холоднее 20
                градусов замедляет обмен веществ и повышает риск болезней. Нагреватель
                с терморегулятором — простой способ этого избежать.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Неустойчивый пандус</h3>
              <p>
                Пандус, который сдвигается или шатается, отбивает у черепахи желание выходить
                на сушу. Животное, которое не может нормально греться под лампой, не
                получает достаточно тепла, а это в долгосрочной перспективе сказывается на здоровье.
                Убедитесь, что пандус надёжно закреплён.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="usl" style="background: var(--bg);">
      <div class="wrap">
        <div class="eyebrow reveal">Вопросы и ответы</div>
        <h2 class="sec-title reveal">Частые вопросы</h2>

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Что такое тер-аквариум для черепахи?</h3>
              <p>
                Тер-аквариум — это сочетание террариума и аквариума, в котором в одной
                конструкции есть и сухопутная, и водная часть. Он идеально подходит для
                полуводных черепах, которые проводят время и на суше, и в воде.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
