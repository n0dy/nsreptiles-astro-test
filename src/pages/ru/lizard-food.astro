---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/oprema.css';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../config/site';
import { getProducts, productViewOrSr } from '../../lib/products';
import { translationsFor } from '../../i18n/routes';

const FIRST = ['oprema/dubia-zohari', 'oprema/fobasi', 'oprema/lateralis', 'oprema/brasnari-tenebrio'];
// "Ziva hrana" dok se postojeci fajlovi ne prebace na dijakritike
const food = (await getProducts())
  .filter((p) => ['Živa hrana', 'Ziva hrana'].includes(p.data.label))
  .sort((a, b) => (FIRST.indexOf(a.id) + 1 || 99) - (FIRST.indexOf(b.id) + 1 || 99));
const views = await Promise.all(food.map((p) => productViewOrSr(p, 'ru')));

const faq = [
  ['Чем кормить ящерицу?', 'Большинство ящериц питается живыми насекомыми. Мраморные тараканы дубия — основа рациона: у них высокое содержание белка, мало хитина, и они легко усваиваются. Для разнообразия к ним добавляют зофобасов, латералисов (туркменских тараканов) и мучных червей. Живой корм перед каждым кормлением нужно обсыпать кальцием.'],
  ['Какой корм лучше всего подходит для бородатой агамы?', 'Молодые бородатые агамы ежедневно съедают много насекомых — дубии и латералисы идеальны, так как они мягкие и богаты белком. Взрослые агамы едят меньше насекомых и больше овощей. Мучных червей дают умеренно, потому что у них более жёсткий хитин.'],
  ['Насекомые какого размера нужны детёнышу ящерицы?', 'Правило такое: насекомое не должно быть шире расстояния между глазами ящерицы. Для детёнышей используйте маленьких нимф дубии или мелких латералисов. По мере роста ящерицы переходят на средних и крупных насекомых. Слишком крупная добыча может вызвать проблемы с пищеварением.'],
  ['Почему тараканы дубия лучше сверчков?', 'Тараканы дубия не стрекочут, не прыгают, не лазают по гладким поверхностям и не издают неприятного запаха. Они дольше живут в террариуме и имеют лучшее соотношение белка и хитина, чем сверчки, поэтому они питательнее и удобнее в содержании.'],
  ['Как хранить живой корм для ящериц?', 'Дубий и зофобасов держат при комнатной температуре в вентилируемом контейнере с картонными лотками и небольшим количеством корма (морковь, яблоко, злаки). Мучных червей можно хранить в холодильнике, чтобы замедлить их развитие. Латералисам нужно более тёплое содержание, так как они активнее.'],
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url + '/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Оборудование', item: SITE.url + '/ru/equipment.html' },
      { '@type': 'ListItem', position: 3, name: 'Корм для ящериц', item: SITE.url + '/ru/lizard-food.html' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Корм для ящериц',
    itemListElement: views.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: v.name, url: SITE.url + v.path,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base
  lang="ru"
  title="Корм для ящериц: дубия, латералис, черви | NS Reptiles"
  description="Живой корм для ящериц и рептилий: тараканы дубия, зофобасы, латералис и мучные черви в нескольких размерах. Свежий корм в наличии. NS Reptiles, Нови-Сад."
  keywords="корм для ящериц, живой корм для рептилий, тараканы дубия, зофобасы, латералис, туркменский таракан, мучные черви, тенебрио, насекомые для ящериц, корм для бородатой агамы, корм для леопардового геккона"
  path="/ru/lizard-food.html"
  image="/style/img/oprema/dubie.webp"
  ogDescription="Живой корм для ящериц и рептилий — тараканы дубия, зофобасы, латералис и мучные черви разных размеров. Свежий и всегда в наличии."
  active="equipment"
  schema={schema}
  translations={translationsFor("/ru/lizard-food.html")}
>
  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Оборудование</div>
      <h1>Корм для ящериц</h1>
    </div>
  </section>
  <section class="intro">
    <div class="wrap">
      <div class="intro-box">
        <p>
          Живой корм — основа рациона большинства ящериц. У нас есть свежие кормовые насекомые, выращенные для
          кормления рептилий, — <strong>мраморные тараканы дубия</strong>, <strong>зофобасы</strong>, <strong>латералис (туркменский
          таракан)</strong> и <strong>мучные черви (тенебрио)</strong> разных размеров. Все виды доступны от
          самых мелких нимф для детёнышей до взрослых особей для крупных ящериц, поэтому вы можете кормить
          <a style="color: var(--green)" href="/ru/animals/bearded-dragon.html">бородатых агам</a>,
          <a style="color: var(--green)" href="/ru/animals/leopard-gecko.html">леопардовых гекконов</a>, хамелеонов, тегу и других насекомоядных.
          Цены на живой корм начинаются от <strong>400 din за 100 штук</strong>.
        </p>
        <h2 class="eyebrow" style="margin-top: 28px">Виды живого корма в наличии</h2>
        <p>
          <strong>Тараканы дубия</strong> — самое популярное кормовое насекомое: у них высокое содержание белка, мало
          хитина, и они легко усваиваются. Они не стрекочут, не прыгают, не лазают по гладким поверхностям и не пахнут,
          поэтому их удобно содержать. <strong>Зофобасы</strong> — мягкий и питательный корм, отличное дополнение
          к дубиям для разнообразия рациона.
        </p>
        <p style="margin-top: 14px">
          <strong>Латералис</strong>, или туркменский таракан, — быстрое и более мелкое насекомое, которое своим движением
          провоцирует охотничий инстинкт, — идеален для хамелеонов, молодых гекконов и ящериц, реагирующих на движение.
          <strong>Мучные черви (тенебрио)</strong> — личинки с более жёстким хитином и повышенным содержанием жира, поэтому их дают как
          лакомство и для набора кондиции, но не слишком часто.
        </p>
        <h3 class="eyebrow" style="margin-top: 28px">Как кормить ящерицу</h3>
        <p>
          Перед кормлением всегда обсыпайте живой корм кальцием (а иногда и мультивитаминами). Правило размера: насекомое
          не должно быть шире расстояния между глазами ящерицы. Детёныши едят чаще и более мелкую добычу, а взрослые
          едят реже и более крупных насекомых. Чтобы получить точную рекомендацию по виду и размеру корма для вашего животного, позвоните нам.
        </p>
      </div>
    </div>
  </section>
  <section class="op-shop">
    <div class="wrap">
      <div class="op-grid">
        {food.map((p) => <ProductCard lang="ru" product={p} catLabel="Живой корм" />)}
      </div>
    </div>
  </section>
  <section class="faq section">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow">Частые вопросы</div>
        <h2 class="sec-title">Частые вопросы о кормлении ящериц</h2>
      </div>
      <div class="faq-list">
        {faq.map(([q, a]) => (
          <div class="faq-item">
            <button class="faq-q">{q}<span class="ic">+</span></button>
            <div class="faq-a"><p>{a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
