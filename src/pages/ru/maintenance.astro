---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Обслуживание и оформление аквариумов и террариумов",
    "serviceType": "Обслуживание и оформление аквариумов и террариумов",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Novi Sad",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Сербия",
    "description": "Профессиональное обслуживание и оформление аквариумов и террариумов в Нови-Саде. Чистка, замена воды, настройка оборудования и оформление интерьера. Разово или регулярно.",
    "url": "https://nsreptiles.net/ru/maintenance.html"
  }
];
---
<Base
  lang="ru"
  title="Обслуживание аквариумов и террариумов | NS Reptiles"
  description="Обслуживание аквариумов и террариумов в Нови-Саде: чистка, замена воды, настройка оборудования и оформление интерьера. Разово или регулярно."
  path="/ru/maintenance.html"
  ogDescription="Профессиональная чистка, оформление и настройка оборудования для аквариумов и террариумов. Разово или регулярно. Нови-Сад."
  translations={translationsFor("/ru/maintenance.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Услуга</div>
        <h1>Обслуживание и оформление аквариумов и террариумов</h1>
        <p>Профессиональное обслуживание и оформление, чтобы ваш аквариум или террариум всегда выглядел безупречно, а животные были здоровы и счастливы.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Обслуживание и оформление</div>
          <p>Мы предлагаем <strong>разовые услуги</strong> чистки и оформления, а также договор на <strong>регулярное обслуживание</strong>. Свяжитесь с нами, и мы согласуем удобный для вас график и объём работ.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="feat-grid">
          <article class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Чистка аквариума</h3>
            <p>Регулярная чистка — залог здоровья рыбок и черепах. Мы проводим частичную замену воды, чистку стекла от водорослей, сифонирование грунта, промывку фильтра и проверку параметров воды. Рекомендуем обслуживание раз в месяц.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Чистка террариума</h3>
            <p>Террариум требует регулярной уборки для здоровья рептилии. Мы меняем субстрат, дезинфицируем поверхности и проверяем состояние оборудования. Особое внимание уделяем контролю температуры, влажности и UVB-освещения.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Оформление аквариума</h3>
            <p>Хотите полностью обновить интерьер? Мы укладываем грунт, устанавливаем камни, коряги (Red Moor Wood), живые и искусственные растения, 3D-фоны и декорации. Создаём природный, эстетичный облик под конкретный вид рыб или черепах.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">04</span>
            <h3>Оформление террариума</h3>
            <p>Создаём функциональное и визуально привлекательное пространство для рептилии. Устанавливаем подходящий субстрат, 3D-фоны из пенопласта или туфа, ветки для лазания, укрытия, поилки и кормушки — всё согласно потребностям вида.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">05</span>
            <h3>Настройка оборудования</h3>
            <p>Проверяем и настраиваем всё оборудование — фильтры, помпы, нагреватели, термостаты, LED и UVB/UVA-освещение. Если что-то износилось или работает неправильно, предлагаем замену и помогаем выбрать подходящее оборудование.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">06</span>
            <h3>Регулярное обслуживание</h3>
            <p>Предлагаем разовые услуги обслуживания и оформления, а также договор на регулярное обслуживание. Свяжитесь с нами, и мы согласуем удобный для вас график и объём работ.</p>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Нужна помощь?</div>
        <h2>Запишитесь на <b>обслуживание</b></h2>
        <p>Свяжитесь с нами, и мы согласуем обслуживание или оформление, удобное для вас — разово или на регулярной основе.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Позвонить нам</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Другие услуги</div>
          <h2>Всё в <b>одном месте</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/ru/custom-terrariums.html">Изготовление террариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/custom-aquariums.html">Изготовление аквариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/custom-vivariums.html">Изготовление вивариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/led-lighting.html">Изготовление LED-освещения<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/repair.html">Ремонт и сервис<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
