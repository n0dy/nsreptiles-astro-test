---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Прайс-лист",
        "item": "https://nsreptiles.net/ru/price-list.html"
      }
    ]
  }
];
---
<Base
  lang="ru"
  title="Цены на террариумы и аквариумы | NS Reptiles"
  description="Полный список товаров с ценами — террариумы, аквариумы и оборудование для рептилий. NS Reptiles, Нови-Сад. Для точной цены позвоните или напишите."
  path="/ru/price-list.html"
  keywords="цены на террариумы, прайс-лист террариумов, цены на аквариумы, террариум на заказ Нови-Сад, аквариум на заказ, оборудование для рептилий, NS Reptiles"
  image="/style/img/logo.jpg"
  ogTitle="Прайс-лист | NS Reptiles, Нови-Сад"
  ogDescription="Террариумы, аквариумы и оборудование для рептилий — посмотрите полный ассортимент NS Reptiles из Нови-Сада."
  translations={translationsFor("/ru/price-list.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Прайс-лист</h1>
        <p>Террариумы, аквариумы и оборудование, изготовленные по вашим размерам. Большинство цен рассчитывается индивидуально — для точного предложения свяжитесь с нами до оформления заказа.</p>
      </div>
    </section>
<section class="cn-section reveal">
