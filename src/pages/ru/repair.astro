---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Ремонт аквариумов и террариумов",
    "serviceType": "Ремонт аквариумов и террариумов",
    "provider": {
      "@type": "LocalBusiness",
      "name": "NS Reptiles",
      "telephone": "+381693301474",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Нови-Сад",
        "addressCountry": "RS"
      }
    },
    "areaServed": "Сербия",
    "description": "Профессиональный ремонт аквариумов и террариумов в Нови-Саде. Замена стекла и силикона, ремонт крышки и рамы, замена освещения. Бесплатная оценка, большинство ремонтов за 1–3 рабочих дня.",
    "url": "https://nsreptiles.net/ru/repair.html"
  }
];
---
<Base
  lang="ru"
  title="Ремонт аквариумов и террариумов | NS Reptiles, Нови-Сад"
  description="Ремонт аквариумов и террариумов в Нови-Саде: замена стекла, силикона и освещения, ремонт крышки и рамы. Бесплатная оценка, большинство работ за 1–3 дня."
  path="/ru/repair.html"
  ogTitle="Ремонт аквариумов и террариумов | NS Reptiles"
  ogDescription="Сервис аквариумов и террариумов — замена стекла, силикона, крышки, рамы и освещения. Бесплатная оценка. Нови-Сад, Сербия."
  translations={translationsFor("/ru/repair.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Сервис</div>
        <h1>Ремонт аквариумов и террариумов</h1>
        <p>Ваш аквариум или террариум повреждён? Покупать новый необязательно — мы отремонтируем его быстро и надёжно.</p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Ремонт и сервис</div>
          <p>Пришлите нам фотографии повреждений и размеры, и мы дадим вам <strong>бесплатную оценку</strong> стоимости и сроков. Большинство ремонтов выполняется в течение <strong>1–3 рабочих дней</strong>.</p>
        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <div class="feat-grid">
          <article class="feat-card">
            <span class="feat-idx">01</span>
            <h3>Замена стекла</h3>
            <p>Треснувшее или разбитое стекло — это ещё не конец. Мы полностью заменяем повреждённое стекло новым, подходящей толщины и качества, и возвращаем аквариум в полностью рабочее состояние.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">02</span>
            <h3>Замена силикона</h3>
            <p>Течи — распространённая проблема, особенно у старых моделей. Мы удаляем старый изношенный силикон и наносим новый, качественный аквариумный герметик, абсолютно безопасный для рыб, черепах и рептилий.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">03</span>
            <h3>Ремонт крышки</h3>
            <p>Крышка важна для безопасности животных и работы освещения. Мы ремонтируем повреждённые крышки, добавляем отверстия для кабелей или изготавливаем новые на заказ. Выполняем и модернизации — установку фильтра, двойную крышку или новый кожух.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">04</span>
            <h3>Ремонт рамы</h3>
            <p>Повреждённая рама, покороблённый кант или отслоившаяся плёнка — всё это мы устраняем. Восстанавливаем конструкцию, заменяем повреждённые части рамы и заново оклеиваем плёнкой на ваш выбор из ассортимента более 40 рисунков.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">05</span>
            <h3>Замена освещения</h3>
            <p>Сгоревшая LED-лента, неисправный выключатель или устаревшее освещение? Заменяем старое освещение новым LED с дневным и ночным режимом. Для террариумов также меняем лампы UVB/UVA, необходимые для здоровья рептилий.</p>
          </article>
          <article class="feat-card">
            <span class="feat-idx">06</span>
            <h3>Бесплатная оценка</h3>
            <p>Свяжитесь с нами по телефону, электронной почте или через социальные сети. Пришлите фотографии повреждений и размеры — мы дадим бесплатную оценку стоимости и сроков. Большинство ремонтов выполняется за 1–3 рабочих дня.</p>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content: center">Есть повреждение?</div>
        <h2>Бесплатная <b>оценка ремонта</b></h2>
        <p>Пришлите нам фотографии повреждений и размеры — мы дадим бесплатную оценку стоимости и сроков ремонта.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474" target="_blank" rel="noopener" class="btn" style="background: #fff; color: var(--green-dark)">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light">Позвонить нам</a>
        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <div class="eyebrow">Другие услуги</div>
          <h2>Всё в <b>одном месте</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/ru/custom-terrariums.html">Изготовление террариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/custom-aquariums.html">Изготовление аквариумов<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/custom-vivariums.html">Изготовление виварий<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/led-lighting.html">Монтаж LED освещения<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a class="usl-link" href="/ru/maintenance.html">Обслуживание и оформление<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
    </section>


</Base>
