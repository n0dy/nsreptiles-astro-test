---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/kompleti.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Наборы для начинающих — продажа ящериц и экзотических питомцев",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Набор «Бородатая агама»",
        "url": "https://nsreptiles.net/ru/starter-kits/bearded-dragon.html"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Набор «Леопардовый геккон»",
        "url": "https://nsreptiles.net/ru/starter-kits/leopard-gecko.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Набор «Маисовый полоз»",
        "url": "https://nsreptiles.net/ru/starter-kits/corn-snake.html"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "Набор «Скорпион»",
        "url": "https://nsreptiles.net/ru/starter-kits/scorpion.html"
      },
      {
        "@type": "ListItem",
        "position": 5,
        "name": "Набор «Тарантул»",
        "url": "https://nsreptiles.net/ru/starter-kits/tarantula.html"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://nsreptiles.net/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Наборы",
        "item": "https://nsreptiles.net/ru/starter-kits.html"
      }
    ]
  }
];
---
<Base
  lang="ru"
  title="Продажа ящериц — наборы для начинающих | NS Reptiles"
  description="Продажа ящериц собственного разведения: бородатые агамы и леопардовые гекконы, а также маисовые полозы, скорпионы и тарантулы. Наборы с террариумом."
  keywords="продажа ящериц, купить ящерицу, наборы для начинающих, бородатая агама, леопардовый геккон, маисовый полоз, тарантул, скорпион, Нови-Сад, Сербия"
  path="/ru/starter-kits.html"
  image="/style/img/gallery/2.jpg"
  translations={translationsFor("/ru/starter-kits.html")}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Питомник · Нови-Сад</div>
        <h1>Продажа ящериц</h1>
        <p>
          Бородатые агамы и леопардовые гекконы собственного разведения, а также
          маисовые полозы, скорпионы и тарантулы — каждое животное в наборе с
          террариумом и оборудованием.
        </p>
      </div>
    </section>
<nav class="breadcrumb-bar" aria-label="Навигационная цепочка">
      <div class="wrap">
        <ol class="breadcrumb">
          <li><a href="/ru/">Главная</a></li>
          <li aria-current="page">Наборы</li>
        </ol>
      </div>
    </nav>
<section class="intro">
      <div class="wrap">
        <div class="intro-box reveal">
          <div class="eyebrow">Наборы для начинающих</div>
          <p>
            Уже 10 лет мы занимаемся селекционным разведением экзотических
            домашних питомцев. Все особи здоровы, хорошо накормлены и приучены к
            рукам. Чтобы старт был как можно проще, каждое животное мы предлагаем
            в наборе — с террариумом подходящего размера и базовым оборудованием,
            по цене выгоднее, чем при покупке по отдельности.
          </p>
        </div>
      </div>
    </section>
<section class="section kompleti" id="kompleti" style="padding-top: 70px">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <div class="eyebrow">Начните здесь</div>
            <h2 class="sec-title">Выберите свой <b>набор</b></h2>
          </div>
          <a href="/ru/animals.html" class="btn btn-outline">Все животные</a>
        </div>
        <div class="kit-grid">
          <article class="kit-card reveal">
            <span class="kit-badge">Акция</span>
            <a href="/ru/starter-kits/bearded-dragon.html" class="kit-img">
              <img src="/assets/img/bradata-agama.jpg" alt="Бородатая агама — продажа ящериц, Нови-Сад">
            </a>
            <div class="kit-body">
              <h3>Бородатая агама</h3>
              <ul class="kit-incl">
                <li>Террариум 100×45×45 +3D</li>
                <li>UVB/UVA-освещение</li>
                <li>Песок, витамины</li>
                <li>Корм на месяц</li>
              </ul>
              <div class="kit-price">25 800 <span>din</span></div>
              <a href="/ru/starter-kits/bearded-dragon.html" class="btn btn-outline">
                Подробнее
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Акция</span>
            <a href="/ru/starter-kits/leopard-gecko.html" class="kit-img">
              <img src="/assets/img/leopard-gekon.jpg" alt="Леопардовый геккон — продажа ящериц, Нови-Сад">
            </a>
            <div class="kit-body">
              <h3>Леопардовый геккон</h3>
              <ul class="kit-incl">
                <li>Террариум 50×35×35</li>
                <li>Нагревательная плёнка, укрытие</li>
                <li>Субстрат, миска</li>
                <li>Корм + витамины</li>
              </ul>
              <div class="kit-price">12 500 <span>din</span></div>
              <a href="/ru/starter-kits/leopard-gecko.html" class="btn btn-outline">
                Подробнее
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Акция</span>
            <a href="/ru/starter-kits/corn-snake.html" class="kit-img">
              <img src="/assets/img/kukuruzni-smuk.jpg" alt="Маисовый полоз">
            </a>
            <div class="kit-body">
              <h3>Маисовый полоз</h3>
              <ul class="kit-incl">
                <li>Террариум 50×35×35</li>
                <li>Кокосовый субстрат</li>
                <li>Миска для воды</li>
                <li>Пещера</li>
              </ul>
              <div class="kit-price">12 500 <span>din</span></div>
              <a href="/ru/starter-kits/corn-snake.html" class="btn btn-outline">
                Подробнее
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Акция</span>
            <a href="/ru/starter-kits/scorpion.html" class="kit-img">
              <img src="/assets/img/skorpija.jpg" alt="Скорпион">
            </a>
            <div class="kit-body">
              <h3>Скорпион</h3>
              <ul class="kit-incl">
                <li>Heterometrus petersii</li>
                <li>Террариум 40×25×30</li>
                <li>Кокосовый субстрат</li>
                <li>3 размера</li>
              </ul>
              <div class="kit-price">8 500 <span>din</span></div>
              <a href="/ru/starter-kits/scorpion.html" class="btn btn-outline">
                Подробнее
              </a>
            </div>
          </article>
          <article class="kit-card reveal">
            <span class="kit-badge">Акция</span>
            <a href="/ru/starter-kits/tarantula.html" class="kit-img">
              <img src="/assets/img/tarantula.jpg" alt="Тарантул">
            </a>
            <div class="kit-body">
              <h3>Тарантул</h3>
              <ul class="kit-incl">
                <li>Террариум 11×15×20 +3D</li>
                <li>Кокосовый субстрат</li>
                <li>~10 видов</li>
                <li>Для первого паука</li>
              </ul>
              <div class="kit-price">3 000 <span>din</span></div>
              <a href="/ru/starter-kits/tarantula.html" class="btn btn-outline">
                Подробнее
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="ks-perks">
      <div class="wrap">
        <div class="reveal" style="text-align: center; max-width: 680px; margin: 0 auto">
          <div class="eyebrow" style="justify-content: center">
            Собственное разведение
          </div>
          <h2 class="sec-title">Продажа <b>ящериц</b></h2>
          <p style="color: var(--ink-soft); font-weight: 300; margin-top: 14px">
            Ящерицы — самые востребованные экзотические питомцы: ручные,
            интересные для наблюдения и простые в уходе. Бородатых агам и
            леопардовых гекконов мы разводим сами, поэтому о каждой особи вы
            знаете происхождение, возраст и привычки.
          </p>
        </div>
        <div class="ks-perks-grid">
          <div class="ks-perk reveal">
            <div class="ks-perk-num">01</div>
            <h3>Здоровые и ручные особи</h3>
            <p>
              За нами 10 лет селекционного разведения. Все животные хорошо
              накормлены, находятся под регулярным наблюдением и с малых лет
              приучены к рукам.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">02</div>
            <h3>Готовый набор вместо поисков</h3>
            <p>
              Вместе с животным вы получаете террариум подходящего размера и
              оборудование, подобранное именно для этого вида, — без догадок, что
              нужно, и покупок в разных местах.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">03</div>
            <h3>Советы и после покупки</h3>
            <p>
              Мы расскажем всё о кормлении, температуре и уходе ещё до того, как
              питомец приедет к вам, — а на вопросы отвечаем и позже, по телефону
              или в сообщениях.
            </p>
          </div>
        </div>
      </div>
    </section>
<section class="section" style="background: var(--white)">
      <div class="wrap">
        <div class="gal-head reveal">
          <div>
            <div class="eyebrow">Простой путь к питомцу</div>
            <h2 class="sec-title">Как это <b>работает</b></h2>
          </div>
        </div>
        <div class="ks-perks-grid" style="margin-top: 10px">
          <div class="ks-perk reveal">
            <div class="ks-perk-num">Шаг 1</div>
            <h3>Выберите набор</h3>
            <p>
              Посмотрите наборы и откройте тот, который вас интересует, — на каждой
              странице указаны точный состав и цена.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">Шаг 2</div>
            <h3>Отправьте запрос</h3>
            <p>
              При нажатии на «Отправить запрос» форма заполняется автоматически.
              Вы также можете написать нам в WhatsApp или Viber — мы отвечаем
              быстро.
            </p>
          </div>
          <div class="ks-perk reveal">
            <div class="ks-perk-num">Шаг 3</div>
            <h3>Самовывоз или доставка</h3>
            <p>
              Самовывоз в Нови-Саде или отправка по договорённости. Животных мы
              упаковываем надёжно и с опытом.
            </p>
          </div>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content:center">Не знаете, какой набор выбрать?</div>
        <h2>Спросите <b>NS Reptiles</b></h2>
        <p>Расскажите, сколько у вас места и времени, а мы предложим питомца, который подойдёт вам больше всего. Консультации бесплатны.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=%D0%9C%D0%B5%D0%BD%D1%8F%20%D0%B8%D0%BD%D1%82%D0%B5%D1%80%D0%B5%D1%81%D1%83%D1%8E%D1%82%20%D0%BD%D0%B0%D0%B1%D0%BE%D1%80%D1%8B%20%D0%B4%D0%BB%D1%8F%20%D0%BD%D0%B0%D1%87%D0%B8%D0%BD%D0%B0%D1%8E%D1%89%D0%B8%D1%85" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
