---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';
---
<Base
  lang="ru"
  title="Террариумы с 3D-фоном — изготовление | NS Reptiles"
  description="Стеклянные террариумы с 3D-фоном в более чем 80 размерах. Ручная работа, вентиляция, изготовление на заказ. NS Reptiles, Нови-Сад."
  path="/ru/terrariums.html"
  ogTitle="Террариумы с 3D-фоном | NS Reptiles"
  ogDescription="Стеклянные террариумы в более чем 80 размерах, с 3D-фоном. Изготовление на заказ. Нови-Сад."
  active="terrariums"
  translations={translationsFor("/ru/terrariums.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Террариумы</div>
        <h1>Стеклянные террариумы с 3D-фоном</h1>
        <p>
          Стеклянные террариумы ручной работы в более чем 80 размерах — от
          маленьких для детёнышей до больших вольеров, с 3D-фоном и вентиляцией.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Наше предложение</div>
          <p>
            Каждый террариум мы изготавливаем <strong>вручную из стекла</strong>, с
            сетчатой или пластиковой вентиляцией и опциональным 3D-фоном, который
            имитирует естественную среду обитания. Не видите нужный размер?
            Выполняем <strong>изготовление на заказ</strong> — напишите нам ваши размеры.
          </p>
        </div>
      </div>
    </section>
<section class="op-shop">
