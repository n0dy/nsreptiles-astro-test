---
import Base from '../layouts/Base.astro';
import '../styles/animals.css';
import '../styles/oprema.css';
import { translationsFor } from '../i18n/routes';
---
<Base
  lang="sr"
  title="Terarijumi sa 3D pozadinom — izrada i prodaja | NS Reptiles"
  description="Stakleni terarijumi sa 3D pozadinom u preko 80 dimenzija. Ručna izrada, ventilacija, izrada po meri. NS Reptiles, Novi Sad."
  path="/terarijumi.html"
  image="/style/img/terrariums/90x45x45.webp"
  ogTitle="Terarijumi sa 3D pozadinom | NS Reptiles"
  ogDescription="Stakleni terarijumi u preko 80 dimenzija, sa 3D pozadinom. Izrada po meri. Novi Sad."
  active="terrariums"
  translations={translationsFor("/terarijumi.html")}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Terarijumi</div>
        <h1>Stakleni terarijumi sa 3D pozadinom</h1>
        <p>
          Ručno rađeni stakleni terarijumi u preko 80 dimenzija — od malih za
          mladunce do velikih nastambi, sa 3D pozadinom i ventilacijom.
        </p>
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box">
          <div class="eyebrow">Naša ponuda</div>
          <p>
            Svaki terarijum izrađujemo <strong>ručno od stakla</strong>, sa
            mrežastom ili plastičnom ventilacijom i opcionom 3D pozadinom koja
            imitira prirodno stanište. Ne vidite dimenziju koja vam treba?
            Radimo <strong>izradu po meri</strong> — javite nam se sa merama.
          </p>
        </div>
      </div>
    </section>
