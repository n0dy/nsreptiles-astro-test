---
import { twoTone } from '../../lib/two-tone';
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "inLanguage": "sr",
    "headline": "Terarijum za kornjaču - vodič za uređenje ter-akvarijuma",
    "description": "Detaljan vodič za postavljanje ter-akvarijuma za kornjaču: dimenzije, oprema, filter, UVB lampa i česte greške.",
    "author": { "@type": "Person", "@id": "https://nsreptiles.net/#author", "name": "Dino Bata", "url": "https://nsreptiles.net/onama.html" },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/terarijumi/terarijum-za-kornjacu.html"
    },
    "image": "https://nsreptiles.net/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Početna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terarijumi",
        "item": "https://nsreptiles.net/terarijumi.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Terarijum za kornjaču",
        "item": "https://nsreptiles.net/terarijumi/terarijum-za-kornjacu.html"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Šta je ter-akvarijum za kornjaču?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ter-akvarijum je kombinacija terarijuma i akvarijuma koja ima i kopneni i vodeni deo, idealno za vodene i poluvodene kornjače. Kopneni deo služi za sunčanje i odmor pod lampom, a vodeni deo za plivanje i hidrataciju."
        }
      },
      {
        "@type": "Question",
        "name": "Koliko velik treba da bude ter-akvarijum za kornjaču?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Minimalna preporuka za mlade primerke je 50x35 cm osnovice, a za odrasle primerke 80x45 cm ili više. Vodeni deo treba da pokriva 50-60% ukupne površine. Što je ter-akvarijum veći, lakše je održavati stabilne uslove."
        }
      },
      {
        "@type": "Question",
        "name": "Da li izrađujete ter-akvarijume po meri?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Da, ter-akvarijume izrađujemo po meri. Možete odabrati veličinu, boju, odnos kopna i vode, kao i dodatnu opremu. Kontaktirajte nas za ponudu."
        }
      },
      {
        "@type": "Question",
        "name": "Koji filter je dobar za ter-akvarijum?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Za ter-akvarijum je najpraktičniji interni ili spoljni filter dovoljnog kapaciteta. Kornjače proizvode više otpada od riba, pa je preporuka filter snage 3-4 puta veće od zapremine vode. Redovno održavanje filtera je obavezno."
        }
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Terarijum za kornjaču - vodič i saveti | NS Reptiles"
  description="Vodič za ter-akvarijum za kornjaču: dimenzije, oprema, filter, UVB i uređenje. Sve što treba znati pre kupovine - NS Reptiles, Novi Sad."
  path="/terarijumi/terarijum-za-kornjacu.html"
  image="/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp"
  ogType="article"
  ogTitle="Terarijum za kornjaču - vodič za uređenje | NS Reptiles"
  ogDescription="Sve o ter-akvarijumu za kornjaču: veličina, oprema, filter, UVB lampa i česte greške. NS Reptiles, Novi Sad."
  translations={translationsFor("/terarijumi/terarijum-za-kornjacu.html")}
  schema={schema}
>
<section class="page-head" style="--ph-img: url(/style/img/izrada/terarijum.webp); --ph-img-sm: url(/style/img/izrada/terarijum.webp)">
      <div class="wrap">
        <h1 set:html={twoTone('Terarijum za kornjaču')} />
        <p>
          Ter-akvarijum - stakleni dom sa kopnenim i vodenim delom - jedini je pravi
          izbor za poluvodene kornjače. U ovom vodiču prolazimo kroz dimenzije,
          opremu i uređenje korak po korak.
        </p>
      </div>
    </section>
<nav class="breadcrumb" aria-label="Navigacioni put">
      <div class="wrap">
        <ol>
          <li><a href="/">Početna</a></li>
          <li><a href="/terarijumi.html">Terarijumi</a></li>
          <li aria-current="page">Terarijum za kornjaču</li>
        </ol>
      </div>
    </nav>
<section class="animal-hero reveal">
      <div class="wrap">
        <img src="/style/img/terrariums/ta-50x35x45x25-zuto-drvo-web.webp" alt="Ter-akvarijum za kornjaču sa kopnenim i vodenim delom - NS Reptiles" width="1080" height="1080" loading="eager" fetchpriority="high" class="animal-hero-img">
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <h2 class="sec-title reveal" set:html={twoTone('Šta je ter-akvarijum')} />

        <div class="animal-detail-grid">

          <div class="animal-fact reveal">
            <h3>Kopneni i vodeni deo</h3>
            <p>
              Ter-akvarijum je staklena konstrukcija koja u jednom prostoru spaja
              kopneni i vodeni deo. Kornjače koriste vodeni deo za plivanje i
              hidrataciju, a kopneni za odmor, sunčanje pod grejnom lampom i
              polaganje jaja. Bez jednog od dva dela, uslovi držanja ne odgovaraju
              prirodnom načinu života ovih životinja.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Za koje vrste je namenjen</h3>
            <p>
              Ter-akvarijum je pravo rešenje za poluvodene kornjače koje provode
              značajan deo vremena u vodi. Kopnene kornjače, koje žive na suvom
              terenu i jedu biljke, ne trebaju vodeni deo - njima odgovara klasičan
              terarijum sa substratom i grejanjem odozdo. Ako niste sigurni koja vrsta
              vam odgovara, slobodno nas kontaktirajte.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Izrada po meri</h3>
            <p>
              Svaki ter-akvarijum u NS Reptiles izrađujemo od stakla, ručno, po
              vašim merama i željama. Možete odabrati dimenzije, boju obloge, odnos
              kopna i vode, kao i kompletnu opremu. Terarijume izrađujemo po meri
              - boju, veličinu i opremu birate sami. Pogledajte našu
              <a href="/izrada-terarijuma.html">stranicu za izradu terarijuma po meri</a>
              ili nas kontaktirajte direktno.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Gotovi modeli iz ponude</h3>
            <p>
              Pored izrade po meri, nudimo i gotove ter-akvarijume u standardnim
              dimenzijama - od 50x35 cm pa do 100x45 cm osnovice. Svi modeli su
              izrađeni od stakla sa dekorativnom folijom po izboru. Kompletnu ponudu
              možete pogledati na
              <a href="/terarijumi.html">stranici terarijuma</a>.
            </p>
          </div>

        </div>
      </div>
    </section>
<section class="usl" style="background: var(--bg);">
      <div class="wrap">
        <h2 class="sec-title reveal" set:html={twoTone('Koliko velik treba da bude ter-akvarijum')} />

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Minimalne dimenzije</h3>
              <p>
                Za mlade primerke minimalna osnova je 50x35 cm, ali treba imati na
                umu da kornjače rastu. Odrasli primerci zahtevaju 80x45 cm ili više.
                Preporuka je da odmah kupite ter-akvarijum za odraslu veličinu -
                tako ne morate da menjate opremu kako životinja raste.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Odnos kopna i vode</h3>
              <p>
                Vodeni deo treba da pokriva 50 do 60% ukupne površine ter-akvarijuma.
                Kopneni deo služi za odmor i sunčanje pod lampom, pa mora biti
                dovoljno prostran da životinja može slobodno da legne. Visina vode
                treba da bude dovoljna da kornjača može okrenuti leđima bez
                poteškoća - obično dva puta veća od širine oklopa.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Visina ter-akvarijuma</h3>
              <p>
                Visina nije kritična kao kod terarijuma za penjače, ali mora biti
                dovoljna za ispravno postavljanje lampe na bezbednoj visini iznad
                kopnenog dela. Preporuka je minimum 40 cm visine za standardne modele.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <h2 class="sec-title reveal" set:html={twoTone('Neophodna oprema')} />

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Filter za vodu</h3>
              <p>
                Filter je obavezan i mora biti dovoljno snažan. Kornjače proizvode
                značajno više otpada od riba, pa je preporuka odabrati filter
                kapaciteta tri do četiri puta većeg od stvarne zapremine vode.
                Interni filteri su praktični za manje ter-akvarijume, spoljni filteri
                su bolji izbor za veće modele. Pranje sunđera filtera vrši se jednom
                nedeljno.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>UVB lampa</h3>
              <p>
                UVB osvetljenje je neophodno - bez njega kornjača ne može da sintetiše
                vitamin D3 koji je neophodan za apsorpciju kalcijuma. Preporučuje se
                lampa sa 5 do 10% UVB indeksom, postavljena iznad kopnenog dela.
                Lampa se menja na svako 12 meseci jer UVB emisija opada i pre nego
                što lampa prestane da svetli.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Grejna lampa</h3>
              <p>
                Iznad kopnenog dela postavlja se grejna lampa koja stvara toplu zonu
                za sunčanje. Temperatura u toploj zoni treba da bude 30 do 35 stepeni.
                Ostali deo ter-akvarijuma treba da bude hladniji, oko 22 do 26 stepeni,
                kako bi životinja mogla da reguliše telesnu temperaturu.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Grejač za vodu</h3>
              <p>
                Temperatura vode treba da bude između 22 i 26 stepeni. Akvarijumski
                grejač sa termostatom održava stabilnu temperaturu i sprečava
                nagle promene koje mogu negativno uticati na zdravlje kornjače. Postavlja
                se u vodeni deo, dalje od mesta gde kornjača često boravi.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Rampa i kopno</h3>
              <p>
                Rampa ili polica koja omogućava nesmetano izlaženje iz vode na
                kopneni deo je obavezna. Mora biti stabilna i sa hrapavom površinom
                da kornjača ne klizi. Kopneni deo može biti ispunjen peskovitim
                substratom ili ostavljen kao staklo prekriveno pločicama -
                bira se prema preferencijama vlasnika i vrsti kornjače.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="usl" style="background: var(--bg);">
      <div class="wrap">
        <h2 class="sec-title reveal" set:html={twoTone('Kako urediti ter-akvarijum')} />

        <div class="animal-detail-grid">

          <div class="animal-fact reveal">
            <h3>Podloga u vodenom delu</h3>
            <p>
              Dno vodenog dela može biti prazno (staklo) ili pokriveno krupnim
              šljunkom prečnika većeg od oklopa kornjače. Sitni pesak i šljunak treba
              izbegavati jer postoji rizik od gutanja. Prazno dno olakšava čišćenje
              i smanjuje nakupljanje otpada.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Dekoracije</h3>
            <p>
              Vodeni deo možete urediti kamenim dekoracijama i lavanim stenama koje
              su bezbedne za životinje. Plastične biljke dodaju estetiku i skrovišta.
              Žive vodene biljke su moguće, ali će ih kornjače često pojesti ili
              iskopati. Sve dekoracije moraju biti stabilne - kornjače su snažne
              i prevrću sve što nije dobro osigurano.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>3D pozadina</h3>
            <p>
              Stiroporska ili kamena 3D pozadina daje ter-akvarijumu naturalisti
              izgled i služi kao dodatna površina za penjanje i odmor. U NS Reptiles
              nudimo više vrsta 3D pozadina - od klasičnih kamenih dezena do
              dekorativnih modela. Pozadina se lepi pre punjena vodom.
            </p>
          </div>

          <div class="animal-fact reveal">
            <h3>Osvetljenje prostora</h3>
            <p>
              Pored UVB i grejne lampe, možete dodati i dekorativno LED osvetljenje
              za bolji vizuelni utisak. LED trake duž ivice poklopca ili iza pozadine
              daju lepši izgled bez značajnog uticaja na temperaturu. Dan/noć ciklus
              od 12 sati svetla i 12 sati mraka treba održavati tokom cele godine.
            </p>
          </div>

        </div>
      </div>
    </section>
<section class="usl">
      <div class="wrap">
        <h2 class="sec-title reveal" set:html={twoTone('Česte greške kod postavljanja ter-akvarijuma')} />

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Premali ter-akvarijum</h3>
              <p>
                Najčešća greška je kupovina premale posude "dok kornjača ne naraste".
                Nedovoljno prostora dovodi do stresa, agresivnog ponašanja i lošijeg
                zdravlja. Odmah kupite ter-akvarijum odgovarajućih dimenzija za
                odraslu veličinu vaše vrste.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Nedovoljno snažan filter</h3>
              <p>
                Filter čiji je kapacitet jednak zapremini vode nije dovoljan.
                Kornjače su prljave životinje - filter mora biti znatno snažniji
                od minimalnog, a voda se mora delimično menjati jednom nedeljno
                bez obzira na vidljivo stanje.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Izostavljanje UVB lampe</h3>
              <p>
                Bez UVB osvetljenja kornjača će razviti metaboličku bolest kostiju
                - omekšavanje oklopa, deformitete i ozbiljne zdravstvene probleme.
                UVB lampa nije opciona stavka već osnovna oprema. Menja se na svako
                12 meseci.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Hladna voda bez grejača</h3>
              <p>
                Kornjače su ektotermne životinje - temperatura okoline direktno
                utiče na metabolizam, varenje i imunitet. Voda hladnija od 20
                stepeni usporava metabolizam i povećava rizik od bolesti. Grejač
                sa termostatom je jednostavan način da se ovo izbegne.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Nestabilna rampa</h3>
              <p>
                Rampa koja se pomera ili klizi odvraća kornjače da izlaze na
                kopno. Životinja koja ne može da se normalno sunča pod lampom neće
                primiti dovoljno toplote, što dugoročno utiče na zdravlje. Osigurajte
                da je rampa stabilno pričvršćena.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="usl" style="background: var(--bg);">
      <div class="wrap">
        <h2 class="sec-title reveal" set:html={twoTone('Česta pitanja')} />

        <div class="proc">

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Šta je ter-akvarijum za kornjaču?</h3>
              <p>
                Ter-akvarijum je kombinacija terarijuma i akvarijuma koja u jednoj
                konstrukciji ima i kopneni i vodeni deo. Idealan je za poluvodene
                kornjače koje provode vreme i na kopnu i u vodi.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Da li izrađujete ter-akvarijume po meri?</h3>
              <p>
                Da, ter-akvarijume izrađujemo po meri - možete odabrati veličinu,
                boju obloge, odnos kopna i vode, kao i dodatnu opremu.
                Kontaktirajte nas za ponudu ili posetite
                <a href="/izrada-terarijuma.html">stranicu za izradu terarijuma po meri</a>.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Koji filter koristiti za ter-akvarijum?</h3>
              <p>
                Preporuka je filter čiji je kapacitet tri do četiri puta veći od
                zapremine vode. Interni filteri su pogodni za manje modele, spoljni
                filteri za modele 80x45 cm i veće. Redovna zamena dela vode je
                obavezna bez obzira na tip filtera.
              </p>
            </div>
          </div>

          <div class="proc-step reveal">
            <div class="proc-num"></div>
            <div class="proc-body">
              <h3>Da li kopnene kornjače trebaju ter-akvarijum?</h3>
              <p>
                Ne. Kopnene kornjače koje se hrane biljkama žive na suvom terenu
                i njima odgovara klasičan terarijum sa substratom, grejanjem odozdo
                i UVB lampom. Ter-akvarijum je namenjen poluvodenim vrstama.
                Ako niste sigurni koja vrsta odgovara vašim uslovima, slobodno
                nas pitajte.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>
<section class="usl-more">
      <div class="wrap">
        <div class="usl-more-head">
          <h2>Više o <b>terarijumima i uslugama</b></h2>
        </div>
        <div class="usl-more-grid">
          <a class="usl-link" href="/terarijumi.html">Svi terarijumi
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="usl-link" href="/izrada-terarijuma.html">Izrada terarijuma po meri
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="usl-link" href="/akvarijumi/akvarijum-za-kornjacu.html">Vodič za vodenu kornjaču - akvarijum
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="usl-link" href="/akvarijumi.html">Akvarijumi iz ponude
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Kontaktirajte nas <b>pre kupovine</b></h2>
        <p>
          Pomoći ćemo vam da odaberete pravu veličinu i opremu za vašeg ljubimca -
          bez pretpostavki i bez grešaka. Ter-akvarijume izrađujemo po meri.
