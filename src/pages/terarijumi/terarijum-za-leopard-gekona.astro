---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Terarijum za leopard gekona — dimenzije, oprema i uređenje",
    "description": "Preporučene dimenzije terarijuma za leopard gekona, grejanje folijom, kokosov treset, vlažnost i česte greške. Vodič NS Reptiles.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/terarijumi/terarijum-za-leopard-gekona.html"
    },
    "image": "https://nsreptiles.net/style/img/terrariums/50x35x35-7.webp"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Početna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terarijumi",
        "item": "https://nsreptiles.net/terarijumi.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Terarijum za leopard gekona",
        "item": "https://nsreptiles.net/terarijumi/terarijum-za-leopard-gekona.html"
      }
    ]
  }
