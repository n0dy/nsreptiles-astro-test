        display: flex;
        align-items: center;
        gap: 6px;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.85rem;
        color: var(--ink-soft);
      }
      .breadcrumb li + li::before {
        content: '›';
        margin-right: 6px;
        color: var(--ink-soft);
      }
      .breadcrumb a {
        color: var(--green-ink);
        text-decoration: none;
      }
      .breadcrumb a:hover {
        text-decoration: underline;
      }
