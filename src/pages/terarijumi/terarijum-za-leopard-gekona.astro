        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 8px;
      }
      .guide-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        border: 1.5px solid var(--green);
        border-radius: 4px;
        color: var(--green-dark);
        font-family: 'Oswald Variable', sans-serif;
        font-size: 0.9rem;
        text-transform: uppercase;
