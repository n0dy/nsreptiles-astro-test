    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/zivotinje/debelorepi-gekon.html"
    },
    "image": "https://nsreptiles.net/style/img/gallery/15.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Početna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Životinje",
        "item": "https://nsreptiles.net/zivotinje.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Debelorepi gekon",
        "item": "https://nsreptiles.net/zivotinje/debelorepi-gekon.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Debelorepi gekon — vodič za uzgoj i negu | NS Reptiles"
  description="Sve o debelorepom gekonu: poreklo, veličina, terarijum, temperatura, ishrana i nega. Mirna vrsta pogodna za početnike — NS Reptiles, Novi Sad."
  path="/zivotinje/debelorepi-gekon.html"
  image="/style/img/gallery/15.jpg"
  ogType="article"
  ogDescription="Sve o debelorepom gekonu: poreklo, veličina, terarijum, temperatura, ishrana i nega. Mirna vrsta pogodna za početnike."
  active="animals"
  translations={translationsFor("/zivotinje/debelorepi-gekon.html")}
  langLinks={{ ...{"en":"/en/animals.html","ru":"/ru/animals.html"}, ...translationsFor("/zivotinje/debelorepi-gekon.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <div class="eyebrow">Gušteri</div>
        <h1>Debelorepi gekon</h1>
        <p>Mirna i zemljana vrsta iz zapadne Afrike — odličan izbor za početnike. Lako se navikava na rukovanje i ne zahteva komplikovane uslove držanja.</p>
      </div>
    </section>
<section class="pd-crumbs">
      <div class="wrap">
        <nav class="pd-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Početna</a>
          <span class="sep">›</span>
          <a href="/zivotinje.html">Životinje</a>
          <span class="sep">›</span>
          <span class="cur" aria-current="page">Debelorepi gekon</span>
        </nav>
      </div>
    </section>
<section class="animal-photo" style="background: var(--bg); padding: 24px 0 0; line-height: 0;">
      <div class="wrap">
        <img src="/style/img/gallery/15.jpg" alt="Debelorepi gekon u terarijumu — NS Reptiles Novi Sad" loading="eager" width="1248" height="832" style="width: 100%; height: auto; display: block; max-height: 520px; object-fit: cover;">
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box reveal">
          <div class="eyebrow">O vrsti</div>
          <p>Debelorepi gekon potiče iz suvih i vlažnih savana zapadne Afrike — od Senegala do Kameruna. U prirodi se skriva u vlažnim skloništima poput termitnjaka i kamenih pukotina, a noću izlazi u potragu za hranom. Karakteristične crte su zaobljena glava, pokretni kapci i vertikalne zenice, smeđebež šare sa belom linijom duž leđa, te debeo rep koji služi kao skladište masti. Za razliku od većine gekona, nema lepljive jastučiće na prstima pa živi isključivo na tlu. U zatočeništvu je poznat po mirnoj naravi i lakom prilagođavanju rukovanju, što ga svrstava među najpopularnije početničke reptile. Uz pravilnu negu živi 15 do 20 godina.</p>
        </div>
      </div>
    </section>
<section class="zoo" style="padding-top: 40px;">
      <div class="wrap">

        <!-- Nega i postavljanje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Nega i <b>postavljanje</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Stanište u terarijumu treba obezbediti sa najmanje tri skloništa: toplim, hladnim i vlažnim — baš kao u prirodi. Ravni kamen za sunčanje, panjevi i listovi doprinose dobrobiti životinje i čine terarijum vizuelno atraktivnim.</p>
          </div>
        </div>

        <!-- Terarijum -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Terarijum</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Minimalne dimenzije za jednu jedinku su 60x40x30 cm. Terarijum treba da sadrži najmanje tri skloništa: toplo, hladno i vlažno. Kao dekoracija preporučuju se ravni kamen za sunčanje, panjevi, lišće, te veštačke ili žive biljke.</p>
          </div>
        </div>

        <!-- Podloga -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Podloga</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Za odrasle jedinke preporučuje se mešavina organske zemlje, peska i gline (40% zemlja, 40% pesak, 20% glina). Mladunci se drže na papirnim ubrusima dok ne prođu karantin. Izmet se uklanja svakodnevno, a kompletna zamena podloge vrši se svakih 3 do 6 meseci.</p>
          </div>
        </div>

        <!-- Temperatura i grejanje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Temperatura i <b>grejanje</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Topli deo terarijuma treba da bude na 30–32 °C, hladni na 21–25 °C, a noćna temperatura može pasti do 16 °C. Grejanje se obezbeđuje spot sijalicom ili grejnom podlogom sa termostatom koji sprečava pregrevanje.</p>
          </div>
        </div>

        <!-- Osvetljenje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Osvetljenje</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Dnevni ciklus osvetljenja od 10 do 12 sati je neophodan. UVB rasveta nije obavezna, ali UVB 5.0 lampa može doprineti boljem zdravlju. Noću se sva svetla gase radi simulacije prirodnog ritma.</p>
          </div>
        </div>

        <!-- Vlažnost i voda -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Vlažnost i <b>voda</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Optimalna vlažnost u terarijumu je 50–60%. Vlažno sklonište sa mahovinom ili kokosovim vlaknima pomaže pri presvlačenju. Uvek treba da bude dostupna plitka posuda sa svežom vodom — menja se svakodnevno.</p>
          </div>
        </div>

        <!-- Ishrana -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Ishrana</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Debelorepi gekoni su insektivori — jedu cvrčke, dubije, crve brašnare i larve crne vojničke muve. Pri svakom hranjenju dodaje se kalcijum sa D3, a multivitamini jednom nedeljno. Mladunci se hrane svakodnevno, odrasli 2 do 3 puta nedeljno.</p>
          </div>
        </div>

        <!-- Razmnožavanje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Razmnožavanje</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Sezona parenja započinje nakon perioda hlađenja. Ženke polažu po 2 jajeta po leglu. Inkubacija traje 55 do 70 dana na temperaturi od 27 do 29 °C — temperatura inkubacije može uticati na pol mladunaca.</p>
          </div>
        </div>

        <!-- Zdravlje i prevencija -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Zdravlje i <b>prevencija</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Česti zdravstveni problemi su metabolička bolest kostiju, zadržavanje kože pri presvlačenju i impakcija. Prevencija podrazumeva pravilnu ishranu sa kalcijumom, odgovarajuću vlažnost i temperaturu, te redovno čišćenje terarijuma. U slučaju sumnje na bolest, konsultovati veterinara specijalizovanog za egzotične životinje.</p>
          </div>
        </div>

      </div>
    </section>
<section class="pd-related section">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">Preporučeno za debelorepog gekona</div>
          <h2 class="sec-title">Preporučeni proizvodi</h2>
        </div>
        <div class="op-grid">
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-50x35x35.html">
              <img src="/style/img/terrariums/50x35x35-2.webp" alt="Terarijum 50x35x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-50x35x35.html">Terarijum 50x35x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-45x35x35.html">
              <img src="/style/img/terrariums/45x35x35.webp" alt="Terarijum 45x35x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-45x35x35.html">Terarijum 45x35x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-60x30x25.html">
              <img src="/style/img/terrariums/60x30x25.webp" alt="Terarijum 60x30x25" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-60x30x25.html">Terarijum 60x30x25</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-60x40x30.html">
              <img src="/style/img/terrariums/60x40x30.webp" alt="Terarijum 60x40x30" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-60x40x30.html">Terarijum 60x40x30</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <div class="eyebrow" style="justify-content:center">Zainteresovani?</div>
        <h2>Kontaktirajte <b>NS Reptiles</b></h2>
        <p>Za pitanja o nabavci, nezi ili opremi za debelorepog gekona — tu smo. Javite nam se pozivom ili porukom.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Zanima%20me%20debelorepi%20gekon" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
