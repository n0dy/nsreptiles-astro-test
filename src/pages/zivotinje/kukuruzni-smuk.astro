import '../../styles/animals.css';
import '../../styles/usluge.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Kukuruzni smuk — kompletni vodic za uzgoj i negu",
    "description": "Sve o kukuruznom smuku — pitomoj zmiji idealnoj za pocetnike. Terarijum, ishrana, temperatura i nega.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/zivotinje/kukuruzni-smuk.html"
    },
    "image": "https://nsreptiles.net/style/img/gallery/9.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Pocetna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Zivotinje",
        "item": "https://nsreptiles.net/zivotinje.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Kukuruzni smuk",
        "item": "https://nsreptiles.net/zivotinje/kukuruzni-smuk.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Kukuruzni smuk — vodič za negu i uzgoj | NS Reptiles"
  description="Kukuruzni smuk — pitoma zmija idealna za početnike. Saznajte sve o terarijumu, ishrani, temperaturi i nezi. NS Reptiles, Novi Sad."
  path="/zivotinje/kukuruzni-smuk.html"
  image="/style/img/gallery/9.jpg"
  ogType="article"
  ogDescription="Pitoma zmija idealna za početnike. Kompletni vodič za držanje kukuruznog smuka — terarijum, ishrana, temperatura i nega."
  active="animals"
  translations={translationsFor("/zivotinje/kukuruzni-smuk.html")}
  langLinks={{ ...{"en":"/en/animals.html","ru":"/ru/animals.html"}, ...translationsFor("/zivotinje/kukuruzni-smuk.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Kukuruzni smuk</h1>
        <p>Pitoma i lako pripitomljiva zmija — jedan od najcescih izbora za pocetnike u teraristici. Mirne prirode, sirok spektar boja i dug vek.</p>
      </div>
    </section>
<section class="pd-crumbs">
      <div class="wrap">
        <nav class="pd-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Početna</a>
          <span class="sep">›</span>
          <a href="/zivotinje.html">Životinje</a>
          <span class="sep">›</span>
          <span class="cur" aria-current="page">Kukuruzni smuk</span>
        </nav>
      </div>
    </section>
<section class="animal-photo" style="background: var(--bg); padding: 24px 0 0; line-height: 0;">
      <div class="wrap">
        <img src="/style/img/gallery/9.jpg" alt="Kukuruzni smuk u terarijumu — NS Reptiles Novi Sad" loading="eager" width="1248" height="832" style="width: 100%; height: auto; display: block; max-height: 520px; object-fit: cover;">
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box reveal">
          <p>Kukuruzni smuk je jedna od najpopularnijih zmija u teraristici sirom sveta. Poreklom iz jugoistocnih delova Sjedinjenih Americkih Drzava — od Nju Dzersija do Floride i zapadno do Luizijane — u prirodi naseljava raznovrsna stanista: sumske predele, polja, livade i napustene objekte. Dostupan u sirom spektru boja i uzoraka zahvaljujuci selektivnom uzgoju, sa duzinom odraslih primeraka od 120 do 160 cm i vekom u zatocenistvu od 15 do 20 godina.</p>
        </div>
      </div>
    </section>
<section class="zoo" style="padding-top: 40px;">
      <div class="wrap">

        <!-- Drzanje i terarijum -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Drzanje i <b>terarijum</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Za odraslu jedinku potreban je terarijum minimalnih dimenzija 90×45×45 cm. Obavezno obezbediti skrovista, grane za penjanje i posudu sa vodom za kupanje. Poklopac mora biti dobro osiguran — kukuruzni smukovi su poznati po bekstvima. Preporucene podloge su treset, kokosovo vlakno ili papir bez stampane boje. Sitne cestice treba izbegavati jer mogu izazvati impakciju.</p>
          </div>
        </div>

        <!-- Temperatura i osvetljenje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Temperatura i <b>osvetljenje</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Topli deo terarijuma odrzavati na 28–30°C, hladniji deo na 22–24°C, a nocna temperatura ne sme pasti ispod 20°C. Grejanje se postize grejnim podlogama ili kablovima prikljucenim na termostat. UVB osvetljenje nije neophodno, ali dnevni ciklus svetlosti pomaze normalnom ponasanju — koristiti tajmer za simulaciju prirodnog dana i noci.</p>
          </div>
        </div>

        <!-- Vlaznost i voda -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Vlaznost i <b>voda</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Optimalna vlaznost iznosi 40–60%. Tokom perioda presvlacenja vlaznost treba povecati, a preporucuje se i vlazna komora ili posuda sa vlaznim supstratom. Sveza voda mora biti stalno dostupna u posudi dovoljno velikoj da zmija moze da se okupa. Posudu redovno cistiti kako bi se sprecila kontaminacija.</p>
          </div>
        </div>

        <!-- Ishrana -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Ishrana</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Mladunci jedu tek izlegle miseve (pinkije) svakih 5 dana. Odrasle jedinke hrane se odraslim misevima ili pacovima svakih 7–10 dana. Hrana mora biti odgovarajuce velicine — ne sira od najuzeg dela tela zmije. Preporucuje se smrznuta-odmrznuta hrana radi sigurnosti zivotinje.</p>
          </div>
        </div>

        <!-- Ponasanje i manipulacija -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Ponasanje i <b>manipulacija</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Kukuruzni smukovi su uglavnom nocno aktivni, mada se cesto mogu videti i tokom dana. Mirne su i pitome prirode i lako se privikavaju na rukovanje, sto ih cini odlicnim izborom za pocetnike. Retko pokazuju agresiju. Preporucuje se da se ne rukuje zivotinjom 48 sati posle obroka kako bi se izbeglo regurgitiranje hrane.</p>
          </div>
        </div>

        <!-- Razmnozavanje i zdravlje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Razmnozavanje i <b>zdravlje</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Polna zrelost nastupa sa 2–3 godine. Zenke polazu 10–30 jaja po leglu, a inkubacija traje 60–65 dana na 27–29°C. Cesti zdravstveni problemi su metabolicka bolest kostiju, zadrzavanje koze tokom presvlacenja, impakcija i respiratorne infekcije. Prevencija podrazumeva pravilnu ishranu, odgovarajucu vlaznost i temperaturu i redovno odrzavanje higijene. Kod znakova bolesti obratiti se veterinaru specijalizovanom za egzoticne zivotinje.</p>
          </div>
        </div>

      </div>
    </section>
<section class="pd-related section">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2 class="sec-title">Preporučeni proizvodi</h2>
        </div>
        <div class="op-grid">
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-80x50x50.html">
              <img src="/style/img/terrariums/80x50x50.webp" alt="Terarijum 80x50x50" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-80x50x50.html">Terarijum 80x50x50</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-70x40x35.html">
              <img src="/style/img/terrariums/70x40x35.webp" alt="Terarijum 70x40x35" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-70x40x35.html">Terarijum 70x40x35</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-65x40x40.html">
              <img src="/style/img/terrariums/65x40x40.webp" alt="Terarijum 65x40x40" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-65x40x40.html">Terarijum 65x40x40</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-100x40x40.html">
              <img src="/style/img/terrariums/100x40x40-2.webp" alt="Terarijum 100x40x40" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-100x40x40.html">Terarijum 100x40x40</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Kontaktirajte <b>NS Reptiles</b></h2>
        <p>Za pitanja o nabavci, nezi ili opremi za kukuruznog smuka — tu smo. Javite nam se pozivom ili porukom.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Zanima%20me%20kukuruzni%20smuk" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
