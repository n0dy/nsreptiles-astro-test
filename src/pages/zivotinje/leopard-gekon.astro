  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Leopard Gekon — Vodič za Uzgoj i Negu",
    "description": "Sve o leopard gekonu: terarijum, temperatura, ishrana i razmnožavanje. Kompletan vodič za uzgoj i negu.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/zivotinje/leopard-gekon.html"
    },
    "image": "https://nsreptiles.net/style/img/gallery/3.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
