---
import Base from '../../layouts/Base.astro';
import '../../styles/animals.css';
import '../../styles/usluge.css';
import '../../styles/oprema.css';
import { translationsFor } from '../../i18n/routes';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Loptasti piton - Kompletni vodic za uzgoj i negu",
    "description": "Sve sto treba da znate o loptastom pitonu: ishrana, terarijum, temperatura, zdravlje i razmnozavanje.",
    "author": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "url": "https://nsreptiles.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "NS Reptiles",
      "logo": {
        "@type": "ImageObject",
        "url": "https://nsreptiles.net/style/img/logo.jpg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://nsreptiles.net/zivotinje/loptasti-piton.html"
    },
    "image": "https://nsreptiles.net/style/img/gallery/5.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Pocetna",
        "item": "https://nsreptiles.net/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Zivotinje",
        "item": "https://nsreptiles.net/zivotinje.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Loptasti piton",
        "item": "https://nsreptiles.net/zivotinje/loptasti-piton.html"
      }
    ]
  }
];
---
<Base
  lang="sr"
  title="Loptasti piton — vodič za uzgoj i negu | NS Reptiles"
  description="Vodič za loptastog pitona: terarijum, ishrana, temperatura i nega. Mirna zmija idealna za početnike. Stručni saveti iz Novog Sada."
  path="/zivotinje/loptasti-piton.html"
  image="/style/img/gallery/5.jpg"
  ogType="article"
  ogDescription="Vodič za loptastog pitona: terarijum, ishrana, temperatura i nega. Mirna zmija idealna za početnike. NS Reptiles, Novi Sad."
  active="animals"
  translations={translationsFor("/zivotinje/loptasti-piton.html")}
  langLinks={{ ...{"en":"/en/animals.html","ru":"/ru/animals.html"}, ...translationsFor("/zivotinje/loptasti-piton.html") }}
  schema={schema}
>
<section class="page-head">
      <div class="wrap">
        <h1>Loptasti piton</h1>
        <p>Jedna od najpopularnijih zmija u teraristici — mirna, pitoma i idealna za pocetnike. Dostupna u sirom spektru boja i sarenih morfova.</p>
      </div>
    </section>
<section class="pd-crumbs">
      <div class="wrap">
        <nav class="pd-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Početna</a>
          <span class="sep">›</span>
          <a href="/zivotinje.html">Životinje</a>
          <span class="sep">›</span>
          <span class="cur" aria-current="page">Loptasti piton</span>
        </nav>
      </div>
    </section>
<section class="animal-photo" style="background: var(--bg); padding: 24px 0 0; line-height: 0;">
      <div class="wrap">
        <img src="/style/img/gallery/5.jpg" alt="Loptasti piton u terarijumu — NS Reptiles Novi Sad" loading="eager" width="1248" height="832" style="width: 100%; height: auto; display: block; max-height: 520px; object-fit: cover;">
      </div>
    </section>
<section class="intro">
      <div class="wrap">
        <div class="intro-box reveal">
          <p>Loptasti piton je jedna od najpopularnijih zmija u teraristici zbog mirne naravi i dostupnosti razlicitih morfova. Mirne i pitome prirode, lako se privikavaju na rukovanje i retko pokazuju agresiju — pogodni su za pocetnike. Zahvaljujuci selektivnom uzgoju dostupni su u sirokom spektru boja i sara.</p>
        </div>
      </div>
    </section>
<section class="zoo" style="padding-top: 40px;">
      <div class="wrap">

        <!-- Poreklo i stanište -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Poreklo i <b>staniste</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Poreklo</h3>
            <p>Zapadna i centralna Afrika — savane i sumski rubovi Gane, Nigerije, Kameruna i okolnih zemalja.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Staniste</h3>
            <p>Suva podrucja sa vegetacijom, cesto u blizini vodotokova. Danju se kriju u jazbinama ili ispod kamenja, a aktivni su u sumrak i nocu.</p>
          </div>
        </div>

        <!-- Izgled i ponašanje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Izgled i <b>ponasanje</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Velicina i izgled</h3>
            <p>Duzina: 120–150 cm. Sirok spektar boja i sara zahvaljujuci selektivnom uzgoju. Vitko telo, glava blago sira od vrata, stomak sa karakteristicnim sarama.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Ponasanje</h3>
            <p>Uglavnom nocna aktivnost, ali mogu biti aktivni i tokom dana. Mirne i pitome prirode, lako se privikavaju na rukovanje. Retko pokazuju agresiju.</p>
          </div>
        </div>

        <!-- Terarijum i podloga -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Terarijum i <b>podloga</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Terarijum</h3>
            <p>Minimalne dimenzije za odraslu jedinku: 90×45×45 cm. Obezbediti skrovista, grane za penjanje i posudu sa vodom. Poklopac mora biti siguran — poznati su po bekstvima.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Podloga</h3>
            <p>Preporucene podloge: treset, kokosovo vlakno, papir bez stampe. Izbegavati sitne cestice koje mogu izazvati impakciju. Redovno menjati podlogu.</p>
          </div>
        </div>

        <!-- Temperatura i uslovi -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Temperatura i <b>uslovi</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Temperatura</h3>
            <p>Topli deo: 28–30 °C. Hladniji deo: 22–24 °C. Nocna temperatura ne sme pasti ispod 20 °C. Grejanje: grejne podloge ili kablovi sa termostatom.</p>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Osvetljenje</h3>
            <p>UVB osvetljenje nije neophodno, ali dnevna svetlost je korisna. Odrzavati prirodni ciklus dana i noci.</p>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Vlaznost</h3>
            <p>Optimalna vlaznost: 50–60 %. Povecati vlaznost tokom perioda presvlacenja. Obezbediti vlaznu komoru ili posudu sa vlaznim supstratom.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Voda</h3>
            <p>Stalno dostupna sveza voda u posudi dovoljno velikoj za kupanje. Redovno ciscenje posude kako bi se sprecila kontaminacija.</p>
          </div>
        </div>

        <!-- Ishrana i zdravlje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Ishrana i <b>zdravlje</b></h2>
            <div class="line"></div>
          </div>
          <div class="intro-box" style="margin-bottom: 24px;">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Ishrana</h3>
            <p>Mladunci: tek izlegli misevi (pinkiji) svakih 5–7 dana. Odrasli: odrasli misevi ili pacovi svakih 7–14 dana. Hranu nuditi odgovarajuce velicine — ne siru od najuzeg dela tela zmije.</p>
          </div>
          <div class="intro-box">
            <h3 style="font-family:'Oswald Variable',sans-serif;text-transform:uppercase;font-size:1rem;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:8px;">Zdravlje</h3>
            <p>Cesti problemi: metabolicka bolest kostiju, zadrzavanje koze, impakcija, respiratorne infekcije. Prevencija: pravilna ishrana, odgovarajuca vlaznost i temperatura, redovno ciscenje. U slucaju zdravstvenih problema konsultujte veterinara specijalizovanog za egzoticne zivotinje.</p>
          </div>
        </div>

        <!-- Razmnožavanje -->
        <div class="cat-block reveal">
          <div class="cat-title">
            <h2>Razmnozavanje</h2>
            <div class="line"></div>
          </div>
          <div class="intro-box">
            <p>Polna zrelost: 2–3 godine. Zenke polazu 4–10 jaja po leglu. Inkubacija: 55–60 dana na temperaturi od 30–32 °C.</p>
          </div>
        </div>

      </div>
    </section>
<section class="pd-related section">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2 class="sec-title">Preporučeni proizvodi</h2>
        </div>
        <div class="op-grid">
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-100x40x40.html">
              <img src="/style/img/terrariums/100x40x40-2.webp" alt="Terarijum 100x40x40" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-100x40x40.html">Terarijum 100x40x40</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-100x50x50.html">
              <img src="/style/img/terrariums/100x50x50.webp" alt="Terarijum 100x50x50" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-100x50x50.html">Terarijum 100x50x50</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-90x50x50.html">
              <img src="/style/img/terrariums/90x50x50.webp" alt="Terarijum 90x50x50" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-90x50x50.html">Terarijum 90x50x50</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
          <article class="op-card reveal">
            <a class="op-img" href="/proizvodi/terarijumi/terarijum-80x50x50.html">
              <img src="/style/img/terrariums/80x50x50.webp" alt="Terarijum 80x50x50" loading="lazy" width="600" height="600">
            </a>
            <div class="op-body">
              <div class="op-cat">Terarijum</div>
              <h3><a href="/proizvodi/terarijumi/terarijum-80x50x50.html">Terarijum 80x50x50</a></h3>
              <div class="op-foot">
                <span class="op-price">Pozovite za cenu</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
<section class="zcta">
      <div class="wrap">
        <h2>Kontaktirajte <b>NS Reptiles</b></h2>
        <p>Za pitanja o nabavci, nezi ili opremi za loptastog pitona — tu smo. Javite nam se pozivom ili porukom.</p>
        <div class="zcta-btns">
          <a href="https://wa.me/381693301474?text=Zanima%20me%20loptasti%20piton" target="_blank" rel="noopener" class="btn" style="background:#fff;color:var(--green-dark)" onclick="gtag('event','kontakt_click',{'metod':'whatsapp'})">WhatsApp</a>
          <a href="tel:+381693301474" class="btn btn-light" onclick="gtag('event','kontakt_click',{'metod':'poziv'})">+381 69 330 1474</a>
        </div>
      </div>
    </section>


</Base>
